{
  "functions": { "api/map-workshop.js": { "includeFiles": "api/workshop-assets/**", "maxDuration": 30 } },
  "routes": [
    { "src": "/api/workshop-assets(?:/.*)?", "status": 404 },
    { "src": "/map-editor", "headers": { "Location": "/map-editor/" }, "status": 307 },
    { "src": "/map-editor/(.*)", "dest": "/api/map-workshop?asset=$1" },
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "src": "/index.html", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
