}
function updateTownCamera(dt) {
  const cam = W3.camera, wantFov = TOWN.spec ? 50 / SPEC.zoom : 55; if (cam.near !== 0.15 || Math.abs(cam.fov - wantFov) > 0.1) { cam.near = 0.15; cam.fov = wantFov; cam.updateProjectionMatrix(); }
