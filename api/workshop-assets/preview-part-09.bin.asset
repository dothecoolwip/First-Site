    for (let y = 0; y < H * 2; y++) for (let x = 0; x < W * 2; x++) { const s = ((H * 2 - 1 - y) * W * 2 + x) * 4, d = (y * W * 2 + x) * 4; for (let k = 0; k < 3; k++) id.data[d + k] = Math.round(Math.pow(px[s + k] / 255, 1 / 2.2) * 255); id.data[d + 3] = px[s + 3]; }
    bx.putImageData(id, 0, 0);
