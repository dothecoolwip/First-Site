function isMale(f) { return G.match && G.match.category === 'men'; }
function vol(f) { if (BOUT.inSim) return boutEar(f.pos.x, f.pos.z); return G.player ? clamp(1.25 - dist2(G.player.pos, f.pos) / 18, 0.2, 1) : 0.7; }

