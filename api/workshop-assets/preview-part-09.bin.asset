    v = raw.slice(0, STD_N); while (v.length < STD_N) v.push(0);
    const used = new Set([M.rt, M.lt].filter(x => x && x.t === 'a').map(x => x.i));
    const sticks = ax.map((a, i) => [a, i]).filter(([a, i]) => !used.has(i) && !(ax.length >= 10 && i === 9)).map(([a]) => a);
    axes = gp.mapping === 'standard' ? ax.slice(0, 4).map((a, i) => used.has(i) ? 0 : a) : [sticks[0] || 0, sticks[1] || 0, sticks[2] || 0, sticks[3] || 0];
    if (M.rx) axes[2] = clamp((ax[M.rx.i] || 0) * M.rx.dir, -1, 1); if (M.ry) axes[3] = clamp((ax[M.ry.i] || 0) * M.ry.dir, -1, 1);
    if (M.rt) v[7] = Math.max(v[7], trigFrom(M.rt, raw, ax)); if (M.lt) v[6] = Math.max(v[6], trigFrom(M.lt, raw, ax));
    if (gp.mapping !== 'standard' && ax.length >= 10) { const hat = hatToDpad(ax[9]); for (let i = 0; i < 4; i++) v[12 + i] = Math.max(v[12 + i], hat[i]); }
    return finishPad(gp, v, axes);
  }
  if (gp.mapping === 'standard' || (raw.length >= STD_N && ax.length === 4)) {
    v = raw.slice(0, STD_N); while (v.length < STD_N) v.push(0); axes = ax.slice(0, 4);
  } else {
    // generic raw pad (phones and tablets often report these): face buttons usually already sit bottom/right/left/top.
    // Axes that rest at -1 are analog triggers (sticks rest at 0); a hat axis carries the d-pad; the rest are the sticks.
    v = raw.slice(0, STD_N); while (v.length < STD_N) v.push(0);
    const hatI = ax.length >= 10 ? 9 : -1, base = S ? S.rawBase : ax;
    const trig = [], sticks = [];
    ax.forEach((a, i) => { if (i === hatI) return; if (i >= 2 && base[i] != null && base[i] < -0.9) trig.push(i); else sticks.push(i); });
    if (hatI >= 0) { const hat = hatToDpad(ax[hatI]); for (let i = 0; i < 4; i++) v[12 + i] = Math.max(v[12 + i], hat[i]); }
    if (trig.length >= 2) { v[6] = Math.max(v[6], clamp((ax[trig[0]] + 1) / 2, 0, 1)); v[7] = Math.max(v[7], clamp((ax[trig[1]] + 1) / 2, 0, 1)); }
    axes = sticks.slice(0, 4).map(i => ax[i] || 0); while (axes.length < 4) axes.push(0);
    if (hatI < 0 && sticks.length >= 6) { const dx = ax[sticks[4]] || 0, dy = ax[sticks[5]] || 0; if (dy < -0.5) v[12] = 1; if (dy > 0.5) v[13] = 1; if (dx < -0.5) v[14] = 1; if (dx > 0.5) v[15] = 1; } // d-pad as two axes
  }
  return finishPad(gp, v, axes);
}
function finishPad(gp, v, axes) {
  v = v.map(x => Number.isFinite(x) ? x : 0);
  axes = axes.map(a => Number.isFinite(a) ? clamp(a, -1, 1) : 0);
  return { index: gp.index, id: gp.id || '', connected: true, mapping: 'standard', timestamp: gp.timestamp, axes, buttons: v.map(padBtn), vibrationActuator: gp.vibrationActuator, raw: gp };
}
// a pad counts as used once a button goes down, or a stick moves well away from where it sat when first seen
function padsUpdate() {
  const now = performance.now(), list = [];
  let pads = [];
  try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; }
  catch (e) { if (!PADS.blocked) { PADS.blocked = true; if (typeof toastMenu === 'function') toastMenu('This view blocks controllers. Open the game full page or as the app to use one.'); } }
  for (const gp of pads) {
    if (!gp || !gp.connected) continue;
    const key = gp.index + '|' + (gp.id || ''); let S = PADS.seen[key];
    const n = normPad(gp, S);
    let act = false;
    if (!S && gp.mapping !== 'standard' && !padMaps()[gp.id || ''] && !PADS.tipped) { PADS.tipped = true; setTimeout(() => typeof toastMenu === 'function' && toastMenu('Controller found. If a trigger does nothing: Settings, Set up controller.'), 600); }
    if (!S) { S = PADS.seen[key] = { rawBase: gp.axes.slice(), base: n.axes.slice(), moved: n.axes.map(() => false), down: n.buttons.map(b => b.pressed), born: now, first: 0, t: 0 }; act = S.down.some(Boolean); } // browsers often reveal a pad on the press that wakes it
    n.axes.forEach((a, i) => { if (Math.abs(a - S.base[i]) > 0.45) S.moved[i] = true; });
    n.axes = n.axes.map((a, i) => Math.abs(S.base[i]) > 0.5 && !S.moved[i] ? 0 : a); // an axis parked off-centre since it appeared (pedal, phantom) reads as centred
    n.buttons.forEach((b, i) => { if (b.pressed && !S.down[i]) act = S.real = true; if (!b.pressed) S.down[i] = false; });
    if (n.axes.some((a, i) => S.moved[i] && Math.abs(a) > 0.45)) act = S.real = true;
    if (act) { S.t = now; if (!S.first) S.first = now; }
    // a button held since the pad appeared counts (that is usually the press that woke it), but if it is still
    // held two seconds later it is stuck (phantom devices, a pad resting on something) and is ignored until released
    if (now - S.born > 2000) {
      n.buttons = n.buttons.map((b, i) => S.down[i] ? padBtn(0) : b);
      if (!S.real && S.down.some(Boolean)) S.first = 0; // never touched since, only a stuck button: not a player
    }
    n.used = !!S.first; n.lastUse = S.t; n.firstUse = S.first; list.push(n);
  }
  for (const k in PADS.seen) if (!list.some(n => n.index + '|' + n.id === k)) delete PADS.seen[k];
  PADS.list = list; PADS.raw = pads.filter(p => p && p.connected);
  PADS.active = list.filter(n => n.used);
  PADS.joined = PADS.active.slice().sort((a, b) => a.firstUse - b.firstUse);
  PADS.last = PADS.active.reduce((best, n) => !best || n.lastUse > best.lastUse ? n : best, null);
  // one player: every used pad drives the game together, so it never matters which one the browser lists first
  if (!PADS.active.length) { PADS.merged = null; return; }
  const m = { ...PADS.last, axes: [0, 0, 0, 0], buttons: [] };
  for (let i = 0; i < STD_N; i++) m.buttons.push(padBtn(Math.max(...PADS.active.map(n => n.buttons[i].value))));
  for (const [x, y] of [[0, 1], [2, 3]]) { const best = PADS.active.reduce((b, n) => Math.hypot(n.axes[x], n.axes[y]) > Math.hypot(b.axes[x], b.axes[y]) ? n : b); m.axes[x] = best.axes[x]; m.axes[y] = best.axes[y]; }
  PADS.merged = m;
}
// the pad the game listens to for one player (null until a controller has been pressed)
function currentPad() { return PADS.merged; }
// couch play: players in the order they first pressed something, then any other connected pads
function seatPads() { return PADS.joined.concat(PADS.list.filter(n => !n.used)); }
function padCount() { return PADS.list.length; }

// ---- Settings > Set up controller: pull each trigger once and the game remembers where it is on this controller ----
// Needed when a phone, tablet or browser reports a controller in a raw layout (common with Xbox pads on Android).
function rawPads() { try { return navigator.getGamepads ? Array.from(navigator.getGamepads() || []).filter(p => p && p.connected) : []; } catch (e) { return []; } }
function rawSnap(gp) { return { b: gp.buttons.map(b => typeof b === 'number' ? b : (b.pressed ? Math.max(1, b.value) : b.value || 0)), a: gp.axes.slice() }; }
const PAD_STEPS = [[0, 'Press A'], [1, 'Press B'], [2, 'Press X'], [3, 'Press Y'], [4, 'Press LB', 'left bumper, top left'], [5, 'Press RB', 'right bumper, top right'],
  [6, 'Pull LT all the way', 'left trigger, hold it'], [7, 'Pull RT all the way', 'right trigger, hold it'], ['rx', 'Push the RIGHT stick RIGHT', 'all the way, hold it'], ['ry', 'Push the RIGHT stick DOWN', 'all the way, hold it'],
  [10, 'Click the LEFT stick in'], [11, 'Click the RIGHT stick in'], [8, 'Press View', 'small button, two squares'], [9, 'Press Menu', 'small button, three lines'],
  [12, 'D-pad UP'], [13, 'D-pad DOWN'], [14, 'D-pad LEFT'], [15, 'D-pad RIGHT']];
function openPadSetup(back) {
  const done = back || (() => showScreen(G.paused ? 'pause' : 'settings'));
  msg('controller', 'Set up controller', `<div class="pswiz"><div class="psprompt" id="psText">Press any button on the controller</div><div class="muted" id="psSub">One button at a time. If something does nothing, tap Skip.</div>
    <div class="psprog"><i id="psProg"></i></div></div>
    <div class="psbtns"><button class="btn tape" id="psSkip">Nothing happens: skip</button></div>
    <div class="res" id="psRes"></div>
    <p class="muted small" id="psName"></p><pre id="psRaw" class="psraw">No controller yet.</pre>`,
    [['Done', () => { PADS.calib = null; done(); }, true], ['Start over', () => { PADS.calib = null; openPadSetup(back); }]]);
  const C = PADS.calib = { step: -1, phase: 'start', base: null, peak: null, t0: 0, id: null, map: { full: true, b: {}, miss: [] }, log: [] };
  const NAMES = ['A', 'B', 'X', 'Y', 'LB', 'RB', 'LT', 'RT', 'View', 'Menu', 'L3', 'R3', 'D-up', 'D-down', 'D-left', 'D-right'];
  const label = k => k === 'rx' ? 'Right stick ←→' : k === 'ry' ? 'Right stick ↑↓' : NAMES[k];
  const show = () => { const st = PAD_STEPS[C.step]; $('#psText').textContent = st ? st[1] : 'All set!'; $('#psSub').textContent = st ? (st[2] || '') : 'Saved for this controller. Press Done.'; $('#psProg').style.width = (Math.max(0, C.step) / PAD_STEPS.length * 100) + '%'; };
  const finish = () => {
    if (C.map.miss.includes('rx') || C.map.miss.includes('ry')) { C.map.miss = C.map.miss.filter(x => x !== 'rx' && x !== 'ry'); C.map.miss.push('rs'); }
    const M = padMaps(); M[C.id] = C.map; store.set('padmap2', M); PADS.seen = {}; // re-read the pad with its new map
    $('#psProg').style.width = '100%'; show(); AU.cheer && AU.cheer(0.4);
  };
  const record = (src) => {
    const k = PAD_STEPS[C.step][0];
    if (src) { if (k === 'rx' || k === 'ry') C.map[k] = src; else C.map.b[k] = src; } else C.map.miss.push(k);
    C.log.push(`<b>${label(k)}</b><span class="${src ? 'ok' : 'bad'}">${src ? (src.t === 'b' ? 'button ' + src.i : 'axis ' + src.i) : 'not received'}</span>`);
    $('#psRes').innerHTML = C.log.join(''); AU.click();
    C.step++; C.phase = 'release'; C.t1 = performance.now();
    if (C.step >= PAD_STEPS.length) { finish(); C.phase = 'done'; } else { $('#psText').textContent = 'Got it. Let go…'; }
  };
  $('#psSkip').onclick = () => { if (C.step >= 0 && C.step < PAD_STEPS.length && C.phase !== 'done') { C.peak = null; record(null); C.phase = 'arm'; show(); } };
  const tick = () => {
    if (PADS.calib !== C || G.screen !== 'msgScr') { if (PADS.calib === C) PADS.calib = null; return; }
    requestAnimationFrame(tick);
    const pads = rawPads();
    const gp = (C.id && pads.find(p => p.id === C.id)) || pads.reduce((x, y) => !x || (y.timestamp || 0) > (x.timestamp || 0) ? y : x, null); if (!gp) return;
    const now = rawSnap(gp);
    $('#psRaw').textContent = `axes: ${now.a.map((v, i) => i + ':' + (v >= 0 ? '+' : '') + v.toFixed(2)).join('  ')}\nheld: ${now.b.map((v, i) => v > 0.05 ? i + '=' + v.toFixed(2) : '').filter(Boolean).join('  ') || 'none'}`;
    if (!C.id) { C.id = gp.id; $('#psName').textContent = gp.id; }
    if (C.phase === 'done') return;
    const st = PAD_STEPS[C.step], stick = st && (st[0] === 'rx' || st[0] === 'ry');
    // what changed since the baseline: buttons, and axes other than the left stick (which drifts and gets bumped)
    const change = (base) => {
      let best = null, bm = 0.5;
      if (!stick) now.b.forEach((v, i) => { const d = v - (base.b[i] || 0); if (d > bm) { bm = d; best = { t: 'b', i }; } });
      now.a.forEach((v, i) => { if (i < 2) return; const r = base.a[i] || 0, d = Math.abs(v - r); if (d > Math.max(bm, 0.6)) { bm = d; const rest = r < -0.6 ? -1 : r > 0.6 ? 1 : 0; best = { t: 'a', i, rest, dir: v > rest ? 1 : -1 }; } });
      return best;
    };
    if (C.phase === 'start') { if (!C.base) C.base = now; if (change(C.base) || now.b.some(v => v > 0.5)) { C.phase = 'release'; C.t1 = performance.now(); C.step = 0; $('#psText').textContent = 'Got it. Let go…'; } return; }
    if (C.phase === 'release') { // move on once everything is back where it was, or after a moment
      const quiet = !now.b.some((v, i) => v - (C.base.b[i] || 0) > 0.3) && !now.a.some((v, i) => i >= 2 && Math.abs(v - (C.base.a[i] || 0)) > 0.3);
      if (quiet || performance.now() - C.t1 > 1500) { C.phase = 'arm'; show(); }
      return;
    }
    if (C.phase === 'arm') { C.base = now; C.phase = 'listen'; C.t0 = 0; return; }
    if (C.phase === 'listen') {
      const c = change(C.base);
      if (c) { if (!C.t0) C.t0 = performance.now(); if (performance.now() - C.t0 > 150) record(c); } else C.t0 = 0;
    }
  };
  requestAnimationFrame(tick);
}
// ---------- HUD ----------
const HUD = { callT: 0, statusT: 0, flashT: 0, overlays: null, toastT: 0, toastPr: 0, hmT: 0 };
// what your last move did, in big letters under the crosshair
function toast(text, kind = 'good', sub = '') {
  if ((G.attract && !TOWN.on) || G.autopilot) return;
  if (CUTE.on) { text = CUTE_WORDS[text] || text; if (kind === 'big') text = '♥ ' + text + ' ♥'; }
  const pr = { big: 3, good: 2, bad: 1, info: 1 }[kind] || 1;
  if (HUD.toastPr === 3 && HUD.toastT > 0.7 && pr < 3) return; // only a fresh takedown / big moment holds the spot
  const el = $('#toast'); el.innerHTML = ''; el.append(h('b', null, text)); if (sub) el.append(h('small', null, sub));
  el.style.setProperty('--c', kind === 'big' ? 'var(--marshal)' : kind === 'bad' ? '#aab4b8' : kind === 'info' ? '#7fb6ff' : 'var(--chalk)');
  el.classList.remove('pop'); void el.offsetWidth; el.classList.add('on', 'pop');
  HUD.toastT = kind === 'big' ? 1.3 : sub ? 1.5 : 0.8; HUD.toastPr = pr;
}
function hitMark(c) { if (G.attract || G.autopilot) return; HUD.hmT = 0.22; rumble(0.1, 0.45, 55); const el = $('#hitmark'); el.style.setProperty('--c', c); el.style.opacity = '1'; }

function feed(html, cite, color) {
  if (G.attract) return;
  const box = $('#feed');
  const e = h('div', { class: 'fe', style: `--c:${color || 'var(--dim)'}`, html: html + (cite ? ` <span class="rr">${cite}</span>` : '') });
  box.prepend(e);
  while (box.children.length > 4) box.lastChild.remove();
  setTimeout(() => { e.style.opacity = '0'; setTimeout(() => e.remove(), 700); }, 6500);
  G.feedLog.push({ t: G.simTime, text: html.replace(/<[^>]+>/g, ''), cite });
}
function showCall(big, small) {
  if (G.attract) return;
  const c = $('#call'); c.innerHTML = ''; c.append(big); if (small) c.append(h('small', null, small));
  c.classList.add('on'); HUD.callT = small ? 2.6 : 1.6;
}
function setStatus(text, color, sec = 2.5) {
  const s = $('#status'); s.textContent = text; s.style.setProperty('--c', color || 'var(--marshal)'); s.hidden = false; HUD.statusT = sec;
}
function flashHit() { HUD.flashT = G.settings.flash === false ? 0 : 0.25; FP.jolt = Math.max(FP.jolt, 0.9); rumble(0.75, 0.45, 170); }

function buildPips() {
  for (const t of [0, 1]) {
    const box = $(t === 0 ? '#pipsA' : '#pipsB'); box.innerHTML = '';
    G.fighters.filter(f => f.team === t).forEach(f => { const p = h('i', { class: 'pip', style: `--c:${t === 0 ? 'var(--flag)' : 'var(--rival)'}` }); f.pip = p; box.append(p); });
  }
}

function updateHud(dt) {
  const m = G.match;
  if (m) {
    $('#clock').textContent = m.training ? 'YARD' : fmtClock(m.clock);
    if (m.duel) { $('#rwA').textContent = m.pts[0]; $('#rwB').textContent = m.pts[1]; if (G.phase === 'fight') $('#rnd').textContent = `${m.overtime ? 'OT' : 'Rd ' + m.round} · ${m.wins[0]}–${m.wins[1]}`; }
    else { $('#rwA').textContent = m.wins[0]; $('#rwB').textContent = m.wins[1]; }
    $('#pips').hidden = !!m.duel || !!m.ffa || G.fighters.length > 24;
    for (const f of G.fighters) if (f.pip) f.pip.className = 'pip' + (f.out ? ' out' : isDown(f) ? ' down' : '');
  }
  HUD.callT -= dt; if (HUD.callT <= 0) $('#call').classList.remove('on');
  $('#touch').classList.toggle('down', !!(G.player && !isUp(G.player)));
  HUD.statusT -= dt;
  const p = G.player;
  let st = null, sc = null;
  if (p && G.phase === 'fight' && !G.autopilot) {
    if (p.state === 'grounded' && HUD.statusT <= 0) { st = p.returnAt > 0 ? 'The Knight Marshal is returning you to the fight.' : 'Grounded. Stay down until "All rise" (BR 5.2).'; sc = 'var(--dim)'; }
    else if (isUp(p) && !p.weapon && HUD.statusT <= 0) { st = p.sidearmT > 0 ? 'Drawing your sidearm…' : G.reserves[sideOf(p)] > 0 ? 'Disarmed. Get to your weapon zone (the taped box by your rail) for a reserve.' : 'Disarmed and no reserves left. Defend, grapple or yield.'; sc = 'var(--marshal)'; }
    else if (isUp(p) && p.pinned && HUD.statusT <= 0) { st = 'Pinned to the rail. Gripping it is legal (BR 3.4).'; sc = 'var(--dim)'; }
  }
  if (HUD.statusT > 0) { $('#status').hidden = false; }
  else if (st) { const s = $('#status'); s.textContent = st; s.style.setProperty('--c', sc); s.hidden = false; }
  else $('#status').hidden = true;
  // clinch meter (BR 4.10)
  const cb = $('#clinchbar');
  if (p && p.clinch && G.phase === 'fight') { cb.hidden = false; cb.firstChild.style.width = clamp(p.clinch.idle / BREAK_AFTER * 100, 0, 100) + '%'; } else cb.hidden = true;
  // bell rung and hits
  // the edges of your view close in as you run out of breath, pulsing with every gasp
  const gasp = BREATH.e > 0.05 ? BREATH.e * (0.22 + 0.16 * (0.5 + 0.5 * Math.sin(BREATH.ph))) : 0;
  $('#vig').style.opacity = p && !CAM.cine ? String(clamp(p.bell * 0.9 + (isUp(p) ? gasp + (1 - p.gas) * 0.12 : 0), 0, 0.92)) : '0';
  HUD.flashT -= dt; $('#hitflash').style.opacity = String(clamp(HUD.flashT * 3, 0, 0.8));
  HUD.toastT -= dt; if (HUD.toastT <= 0) $('#toast').classList.remove('on');
  if (HUD.hmT > 0) { HUD.hmT -= dt; $('#hitmark').style.opacity = String(clamp(HUD.hmT * 6, 0, 1)); }
  // trip window: the target is stumbling, so the Trip button lights up
  const tg = p && isUp(p) && G.phase === 'fight' && !G.autopilot ? p.softTarget : null;
  const vul = !!(tg && isUp(tg) && dist2(tg.pos, p.pos) < 2.7 && (vlen(tg.lean) / FALL_L > 0.38 || tg.stepRem > 0 || G.simTime < (tg.tripWin || 0)));
  $('#bTrip').classList.toggle('hot', vul);
  const salute = p && G.simTime < (G.saluteUntil || 0) && isUp(p) && G.phase === 'fight' && !G.autopilot;
  const pe = $('#prompt'); const wantP = (vul || salute) && IN.mode !== 'touch' && !(p && p.clinch);
  if (wantP) pe.textContent = salute && !vul ? (IN.mode === 'pad' ? 'R3 · salute the crowd' : 'G · salute the crowd') : IN.mode === 'pad' ? 'B · trip!' : 'E · trip!';
  const bs = $('#bSalute'); if (bs) bs.hidden = !(salute && IN.mode === 'touch');
  pe.hidden = !wantP;
  AU.setBell(p && !G.attract ? p.bell : 0, p && isFP() ? p.helm.muffle * 0.45 : 0); // a light muffle only: you still hear the steel
  updateLegend();
  const portrait = IN.mode === 'touch' && window.innerHeight > window.innerWidth;
  $('#rotate').hidden = !(portrait && G.phase === 'fight' && m && m.clock > ROUND_TIME - 8);
}

// ---------- how tired you are: wind meter, panting, heartbeat, heaving view ----------
// gas is the breath you have right now; fatigue builds over the whole fight and caps how much of it comes back
const BREATH = { ph: 0, e: 0, heartT: 0, breathT: 0 };
function exertion(f) { return clamp(Math.max((1 - f.gas) * 1.15 - 0.2, (f.fatigue || 0) * 1.25 - 0.18), 0, 1); }
function updateWind(dt) {
  const p = G.player, el = $('#wind');
  const live = !!(p && G.match && !G.match.training && (G.phase === 'fight' || G.phase === 'prefight' || G.phase === 'stopping') && !G.attract && !G.autopilot && !CAM.cine);
  el.hidden = !live;
  if (!p || G.paused) return;
  const e = isUp(p) ? exertion(p) : BREATH.e * 0.98;
  BREATH.e = damp(BREATH.e, e, 2.5, dt);
  const rate = lerp(0.3, 1.0, BREATH.e); BREATH.ph += dt * rate * TAU;
  if (!live) return;
  const fat = p.fatigue || 0, cap = 1 - 0.5 * fat;
  el.style.setProperty('--g', (clamp(p.gas, 0, 1) * 100).toFixed(1) + '%'); el.style.setProperty('--cap', (cap * 100).toFixed(1) + '%');
  el.classList.toggle('low', p.gas < 0.35); el.classList.toggle('empty', p.gas < 0.15);
  { const gd = $('#guardDir'); if (gd) { const on = p.guard && isUp(p); gd.hidden = !on; if (on) { const t = { L: '◀ GUARD LEFT', R: 'GUARD RIGHT ▶', H: '▲ HIGH GUARD', mid: 'GUARD (flick for a side)' }[p.gdir || 'mid']; if (gd.textContent !== t) gd.textContent = t; gd.classList.toggle('mid', !p.gdir || p.gdir === 'mid'); } } }
  { const b = isUp(p) ? 1 - leanRatio(p) : 0; el.style.setProperty('--b', (b * 100).toFixed(1) + '%'); el.classList.toggle('wobbly', b < 0.4); }
  const word = fat > 0.75 ? 'Spent' : fat > 0.5 ? 'Heavy legs' : fat > 0.25 ? 'Tiring' : 'Fresh';
  const wt = $('#windTxt'); if (wt.textContent !== word) wt.textContent = word;
  el.dataset.fat = fat > 0.75 ? '3' : fat > 0.5 ? '2' : fat > 0.25 ? '1' : '0';
  if (G.phase !== 'fight') return;
  // say it once when you cross a line, so you know why everything got slower
  const lvl = fat > 0.75 ? 2 : fat > 0.5 ? 1 : 0;
  if (lvl > (p.tiredWarn || 0)) { p.tiredWarn = lvl; if (lvl === 1) toast('Your legs are getting heavy', 'info', 'slower swings, slower feet'); else toast('Running on empty', 'bad', 'easier to knock down · rest behind a shield'); rumble(0.3, 0.1, 160); comm('tired', {}, 1); }
  // panting inside the helm, and your heart once you're spent
  if (BREATH.e > 0.08 && isUp(p)) { BREATH.breathT -= dt; if (BREATH.breathT <= 0) { BREATH.breathT = 1 / rate; AU.breath(BREATH.e); } }
  if (fat > 0.5 || p.gas < 0.15) { BREATH.heartT -= dt; if (BREATH.heartT <= 0) { BREATH.heartT = 60 / (100 + 70 * Math.max(fat, 1 - p.gas)); AU.heart(Math.max(fat - 0.4, 0.35 - p.gas) * 1.6); } }
}

function refreshTouchUI() {
  const show = IN.mode === 'touch' && ((G.phase === 'fight' || G.phase === 'prefight') && !G.attract && !G.autopilot || (G.phase === 'town' && !G.screen));
  $('#touch').hidden = !show;
  $('#lookzone').hidden = false;
}

// ---------- 3D overlays: balance ring, target marker, weapon-zone glow ----------
function buildOverlays() {
  const o = HUD.overlays = {};
  const pink = new THREE.MeshBasicMaterial({ color: '#ff3d8b', transparent: true, opacity: 0.85, depthWrite: false });
  o.ring = new THREE.Mesh(new THREE.RingGeometry(0.56, 0.62, 48), pink); o.ring.rotation.x = -Math.PI / 2; o.ring.position.y = 0.02;
  o.safe = new THREE.Mesh(new THREE.RingGeometry(0.0, 0.17 / FALL_L * 0.56, 32), new THREE.MeshBasicMaterial({ color: '#ffffff', transparent: true, opacity: 0.08, depthWrite: false })); o.safe.rotation.x = -Math.PI / 2; o.safe.position.y = 0.015;
  o.dot = new THREE.Mesh(new THREE.CircleGeometry(0.075, 16), new THREE.MeshBasicMaterial({ color: '#ffffff', depthWrite: false })); o.dot.rotation.x = -Math.PI / 2; o.dot.position.y = 0.03;
  o.gas = []; const gm = new THREE.MeshBasicMaterial({ color: '#ece8de', transparent: true, opacity: 0.55, depthWrite: false });
  for (let i = 0; i < 20; i++) { const s = new THREE.Mesh(new THREE.RingGeometry(0.68, 0.74, 3, 1, i / 20 * TAU + 0.02, TAU / 20 - 0.04), gm); s.rotation.x = -Math.PI / 2; s.position.y = 0.02; o.gas.push(s); }
  o.group = new THREE.Group(); o.group.add(o.ring, o.safe, o.dot, ...o.gas); W3.scene.add(o.group);
  o.target = new THREE.Mesh(new THREE.ConeGeometry(0.14, 0.26, 4), new THREE.MeshBasicMaterial({ color: '#ff3d8b', depthTest: false, transparent: true })); o.target.rotation.x = Math.PI; o.target.renderOrder = 9; W3.scene.add(o.target);
  o.lockRing = new THREE.Mesh(new THREE.RingGeometry(0.62, 0.74, 40), new THREE.MeshBasicMaterial({ color: '#f2c40f', transparent: true, opacity: 0.8, depthWrite: false })); o.lockRing.rotation.x = -Math.PI / 2; o.lockRing.position.y = 0.025; W3.scene.add(o.lockRing);
  o.zone = new THREE.Mesh(new THREE.RingGeometry(1.1, 1.3, 40), new THREE.MeshBasicMaterial({ color: '#f2c40f', transparent: true, opacity: 0.6, depthWrite: false })); o.zone.rotation.x = -Math.PI / 2; o.zone.position.y = 0.02; W3.scene.add(o.zone);
}
function updateOverlays(t) {
  const o = HUD.overlays, p = G.player; if (!o) return;
  const show = p && !G.attract && (G.phase === 'fight' || G.phase === 'prefight') && !CAM.cine;
  o.group.visible = !!(show && isUp(p) && !isFP());
  if (o.group.visible) {
    o.group.position.set(p.pos.x, 0, p.pos.z);
    const ringOn = G.settings.ring; o.dot.visible = o.safe.visible = ringOn; o.gas.forEach((s, i) => s.visible = ringOn && i < Math.round(p.gas * 20));
    o.ring.material.opacity = ringOn ? 0.85 : 0.45;
    const sc = 0.56 / FALL_L; o.dot.position.x = clamp(p.lean.x * sc, -0.6, 0.6); o.dot.position.z = clamp(p.lean.z * sc, -0.6, 0.6);
    o.dot.material.color.set(vlen(p.lean) > 0.26 ? '#f2c40f' : '#ffffff');
  }
  const lk = show && isUp(p) && IN.lock && isUp(IN.lock) ? IN.lock : null;
  const tg = lk || (show && isUp(p) && p.softTarget && isUp(p.softTarget) ? p.softTarget : null);
  o.target.visible = !!tg;
  if (tg) { o.target.position.set(tg.pos.x, tg.body.h * 1.17 + 0.4 + Math.sin(t * 5) * 0.06, tg.pos.z); o.target.material.color.set(lk ? '#f2c40f' : '#ff3d8b'); o.target.scale.setScalar(lk ? 1.35 : 1); o.target.rotation.y = t * 2.5; }
  o.lockRing.visible = !!lk; if (lk) { o.lockRing.position.x = lk.pos.x; o.lockRing.position.z = lk.pos.z; o.lockRing.material.opacity = 0.55 + 0.3 * Math.sin(t * 7); }
  o.zone.visible = !!(show && isUp(p) && !p.weapon && p.sidearmT <= 0 && G.reserves[sideOf(p)] > 0);
  if (o.zone.visible) { const zn = W3.zones[sideOf(p)]; o.zone.position.x = zn.x; o.zone.position.z = zn.z; o.zone.material.opacity = 0.35 + 0.3 * Math.sin(t * 6); }
}
// ---------- first person: eye on the body, the visor you look through, arms and weapon in view ----------
const FP = { yaw: Math.PI, pitch: -0.06, looking: 0, visorKey: null, visorW: 0, visorH: 0, jolt: 0, vm: null, rollS: 0, pitchS: 0, drop: 0 };
// you control the view in both cameras: first person (through the visor) or third person (over the shoulder)
const isCtl = () => !!(G.player && !G.player.out && !G.attract && ['prefight', 'fight', 'stopping'].includes(G.phase));
const isFP = () => G.settings.view !== 'tp' && isCtl();
const isTP = () => G.settings.view === 'tp' && isCtl();
const isFPView = () => isFP() && !(typeof CAM !== 'undefined' && CAM.cine) && !G.photo; // the first-person dressing (visor, hands) is off during the takedown cam
function setView(v) {
  if (v !== 'tp') v = 'fp'; if (G.settings.view === v) { updateViewBtn(); return; }
  G.settings.view = v; saveSettings();
  const o = $('#optFP'); if (o) o.checked = v !== 'tp';
  if (isCtl()) { if (v === 'fp') FP.drop = 1; else { CAM.blend = 0; CAM.from.copy(W3.camera.position); CAM.tpInit = false; } AU.click(); }
  updateViewBtn(); refreshTouchUI(); if (isCtl()) ev('view');
}
function updateViewBtn() { $$('#viewBtn span').forEach(s => s.classList.toggle('on', s.dataset.v === (G.settings.view === 'tp' ? 'tp' : 'fp'))); }

// ---- visor shapes: each helm cuts different openings out of the dark steel ----
function visorPaths(key, W, H) {
  // every opening is 15% bigger than the first pass: slits 15% taller, holes 15% more area, bars 15% thinner
  const K = 1.15, KR = Math.sqrt(1.15);
  const u = Math.min(W, H), cx = W / 2, y0 = H * 0.44; const P = [], holes = new Path2D(), deco = [];
  const rect = (x, y, w, hh, r = 0) => { const p = new Path2D(); if (p.roundRect && r) p.roundRect(x, y, w, hh, r); else p.rect(x, y, w, hh); return p; };
  const slit = (x, yc, w, hh, r) => rect(x, yc - hh * K / 2, w, hh * K, r); // centred on yc, height grown by K
  const hole = (x, y, r) => { r *= KR; holes.moveTo(x + r, y); holes.arc(x, y, r, 0, TAU); };
  if (key === 'greathelm') {
    P.push(slit(cx - 0.445 * W, y0, 0.44 * W, 0.09 * u, 0.04 * u), slit(cx + 0.005 * W, y0, 0.44 * W, 0.09 * u, 0.04 * u));
    for (const sx of [-1, 1]) for (let r = 0; r < 4; r++) for (let c = 0; c < 3; c++) if ((r + c) % 2 === 0) hole(cx + sx * (0.14 * W + c * 0.05 * u), H * 0.66 + r * 0.05 * u, 0.014 * u);
    deco.push(['brass', cx - 0.012 * W, 0, 0.024 * W, y0 - 0.055 * u], ['brass', cx - 0.012 * W, y0 + 0.055 * u, 0.024 * W, H], ['brass', 0, y0 - 0.17 * u, W, 0.03 * u]);
  } else if (key === 'pigface') {
    { const t = 0.0575 * u * K, b = 0.0575 * u * K, m = y0 - 0.0275 * u; // continuous curved slit, 15% taller
      const p = new Path2D(); p.moveTo(cx - 0.47 * W, m - t); p.quadraticCurveTo(cx, m - t + 0.065 * u, cx + 0.47 * W, m - t); p.lineTo(cx + 0.47 * W, m + b); p.quadraticCurveTo(cx, m + b + 0.07 * u, cx - 0.47 * W, m + b); p.closePath(); P.push(p); }
    for (let r = 0; r < 6; r++) { const n = 9 - r; for (let c = 0; c < n; c++) hole(cx + (c - (n - 1) / 2) * 0.052 * u, H * 0.6 + r * 0.052 * u, 0.017 * u); }
  } else if (key === 'klapp') {
    P.push(slit(cx - 0.47 * W, y0, 0.94 * W, 0.13 * u, 0.05 * u));
    for (let r = 0; r < 3; r++) for (let c = 0; c < 4; c++) hole(cx + 0.18 * W + c * 0.04 * u, H * 0.66 + r * 0.04 * u, 0.009 * u);
  } else if (key === 'cross') {
    P.push(slit(cx - 0.42 * W, y0 - 0.045 * u, 0.84 * W, 0.11 * u, 0.045 * u));
    const crossAt = (x, y) => { const s = 0.042 * u, rr = 0.017 * u; hole(x, y, rr); hole(x - s, y, rr); hole(x + s, y, rr); hole(x, y - s, rr); hole(x, y + s, rr); };
    crossAt(cx - 0.2 * W, H * 0.6); crossAt(cx + 0.2 * W, H * 0.6); crossAt(cx - 0.2 * W, H * 0.8); crossAt(cx + 0.2 * W, H * 0.8); crossAt(cx, H * 0.7);
    deco.push(['brass', cx - 0.012 * W, y0 + 0.04 * u, 0.024 * W, H]);
  } else if (key === 'grill') {
    const gw = 0.88 * W * KR, gh = Math.min(H * 0.66 * KR, H * 0.78); P.push(rect(cx - gw / 2, H * 0.49 - gh / 2, gw, gh, 0.14 * u));
    const bw = 0.03 * u / K;
    for (let i = -3; i <= 3; i++) deco.push(['bar', cx + i * 0.13 * W - bw / 2, H * 0.06, bw, H * 0.86]);
    deco.push(['bar', 0, H * 0.34, W, 0.028 * u / K]);
  } else if (key === 'sallet') {
    const t = 0.075 * u * K, m = y0 + 0.015 * u; // wide horizontal slit, 15% taller
    const p = new Path2D(); p.moveTo(0.02 * W, m - t); p.quadraticCurveTo(cx, m - t - 0.06 * u, 0.98 * W, m - t); p.lineTo(0.98 * W, m + t); p.quadraticCurveTo(cx, m + t + 0.06 * u, 0.02 * W, m + t); p.closePath(); P.push(p);
    deco.push(['brass', 0, y0 - 0.17 * u, W, 0.018 * u]);
  } else if (key === 'barbute') {
    const th = 0.21 * u * K, tw = 0.24 * W * KR;
    P.push(rect(cx - 0.42 * W, y0 - th / 2, 0.84 * W, th, 0.08 * u), rect(cx - tw / 2, y0 - th / 2, tw, H * 0.68, 0.08 * u));
  } else { // kettle hat: brim above, bevor below, open in between (15% more of the view)
    const p = new Path2D(); p.moveTo(-10, H * 0.13); p.quadraticCurveTo(cx, H * 0.21, W + 10, H * 0.13); p.lineTo(W + 10, H * 0.85); p.quadraticCurveTo(cx, H * 0.75, -10, H * 0.85); p.closePath(); P.push(p);
  }
  return { P, holes, deco, u };
}
function drawVisor(cv, key) {
  // solid steel or clear view, nothing in between
  const W = cv.width, H = cv.height, x = cv.getContext('2d');
  if (key.startsWith('foam')) return drawFoamVisor(x, W, H);
  const { P, holes, deco, u } = visorPaths(key, W, H);
  x.globalCompositeOperation = 'source-over'; x.filter = 'none'; x.globalAlpha = 1; x.clearRect(0, 0, W, H);
  const g = x.createRadialGradient(W / 2, H * 0.44, u * 0.1, W / 2, H * 0.44, Math.max(W, H) * 0.75);
  g.addColorStop(0, '#3a4044'); g.addColorStop(0.45, '#1c2023'); g.addColorStop(1, '#08090a');
  x.fillStyle = g; x.fillRect(0, 0, W, H);
  // rivets and brass trim live on the steel, never across an opening
  const paint = (kind, dx, dy, dw, dh) => {
    const gg = x.createLinearGradient(dx, 0, dx + dw, 0);
    if (kind === 'brass') { gg.addColorStop(0, '#3d2f10'); gg.addColorStop(0.5, '#8a6a26'); gg.addColorStop(1, '#3d2f10'); }
    else { gg.addColorStop(0, '#1d2123'); gg.addColorStop(0.5, '#6d777b'); gg.addColorStop(1, '#1a1d1f'); }
    x.fillStyle = gg; x.fillRect(dx, dy, dw, dh);
  };
  for (const d of deco) if (d[0] !== 'bar') paint(...d);
  x.globalCompositeOperation = 'destination-out';
  P.forEach(p => x.fill(p)); x.fill(holes);
  x.globalCompositeOperation = 'source-over';
  for (const d of deco) if (d[0] === 'bar') paint('steel', d[1], d[2], d[3], d[4]);
  x.strokeStyle = 'rgba(205,214,218,.5)'; x.lineWidth = Math.max(1.5, u * 0.005); P.forEach(p => x.stroke(p));
  x.strokeStyle = 'rgba(0,0,0,.6)'; x.lineWidth = Math.max(1, u * 0.003); x.stroke(holes);
}
// youth foam helmet: a big padded oval, pastel all round, nearly the whole view open
function drawFoamVisor(x, W, H) {
  const pal = G.player ? cutePal(G.player.club) : { base: '#ffb4d2', deep: '#ff8fbd', light: '#fff0f6' }, u = Math.min(W, H);
  x.globalCompositeOperation = 'source-over'; x.globalAlpha = 1; x.setLineDash([]); x.clearRect(0, 0, W, H);
  x.fillStyle = pal.base; x.fillRect(0, 0, W, H);
  const g = x.createRadialGradient(W / 2, H / 2, u * 0.3, W / 2, H / 2, Math.max(W, H) * 0.75); g.addColorStop(0, 'rgba(255,255,255,.3)'); g.addColorStop(1, 'rgba(0,0,0,.22)'); x.fillStyle = g; x.fillRect(0, 0, W, H);
  x.fillStyle = 'rgba(255,255,255,.35)'; for (let r = 0; r < 9; r++) for (let i = 0; i < 16; i++) { x.beginPath(); x.arc((i + (r % 2) * 0.5) * W / 15, r * H / 8, u * 0.012, 0, TAU); x.fill(); }
  const p = new Path2D(); p.ellipse(W / 2, H * 0.5, W * 0.56, H * 0.62, 0, 0, TAU);
  x.globalCompositeOperation = 'destination-out'; x.fillStyle = '#000'; x.fill(p); x.globalCompositeOperation = 'source-over';
  x.lineWidth = u * 0.05; x.strokeStyle = pal.deep; x.stroke(p);
  const q = new Path2D(); q.ellipse(W / 2, H * 0.5, W * 0.56 + u * 0.035, H * 0.62 + u * 0.035, 0, 0, TAU);
  x.lineWidth = u * 0.008; x.strokeStyle = 'rgba(255,255,255,.75)'; x.setLineDash([u * 0.02, u * 0.016]); x.stroke(q); x.setLineDash([]);
}
function visorPreview(key, w = 200, hh = 112) {
  const c = cvs(w, hh), x = c.getContext('2d');
  const bg = x.createLinearGradient(0, 0, 0, hh); bg.addColorStop(0, '#2c3a46'); bg.addColorStop(0.55, '#6f7678'); bg.addColorStop(1, '#8c908e'); x.fillStyle = bg; x.fillRect(0, 0, w, hh);
  x.fillStyle = '#7a2230'; for (let i = 0; i < 4; i++) { const px = w * (0.22 + i * 0.18); x.fillRect(px - 5, hh * 0.38, 10, hh * 0.26); x.fillStyle = '#c3cacd'; x.beginPath(); x.arc(px, hh * 0.36, 5, 0, TAU); x.fill(); x.fillStyle = i % 2 ? '#1c3454' : '#7a2230'; }
  const v = cvs(w, hh); drawVisor(v, key); x.drawImage(v, 0, 0); return c;
}
function updateVisorOverlay(dt = 0.016) {
  const cv = $('#visor'); const on = isFPView();
  cv.hidden = !on; if (!on) { FP.drop = 0; return; }
  const dpr = Math.min(window.devicePixelRatio || 1, 1.5); const W = Math.round(window.innerWidth * dpr), H = Math.round(window.innerHeight * dpr);
  const key = CUTE.on ? 'foam:' + G.player.club.key + G.player.club.tabard : G.player.spec.helm;
  if (FP.visorKey !== key || FP.visorW !== W || FP.visorH !== H) { cv.width = W; cv.height = H; drawVisor(cv, key); FP.visorKey = key; FP.visorW = W; FP.visorH = H; }
  // switching into first person: the visor snaps down over your eyes
  FP.drop = Math.max(0, FP.drop - dt * 5.5); const dropY = FP.drop > 0 ? -Math.pow(FP.drop, 2) * 100 : 0;
  const j = FP.jolt; cv.style.transform = (j > 0.01 ? `translate(${rand(-1, 1) * j * 10}px,${rand(-1, 1) * j * 8}px)` : '') + (dropY ? ` translateY(${dropY}%)` : '');
}

// ---- third person: over the right shoulder, steered by the same look controls ----
function updateTPCamera(dt) {
  const p = G.player, cam = W3.camera; const aspect = window.innerWidth / window.innerHeight;
  const fov = (aspect < 0.8 ? 74 : aspect < 1.3 ? 66 : 58) + FEEL.fov;
  if (Math.abs(cam.fov - fov) > 0.1 || cam.near !== 0.1) { cam.fov = fov; cam.near = 0.1; cam.updateProjectionMatrix(); }
  const hs = p.body.h / 1.8;
  const lying = p.state === 'grounded' || p.state === 'rising' || p.state === 'kneeling';
  const base = lying ? p.groundPos : p.pos;
  const pivot = new THREE.Vector3(base.x, (lying ? 0.9 : 1.55) * hs, base.z);
  const fw = fwd(FP.yaw), right = { x: -Math.cos(FP.yaw), z: Math.sin(FP.yaw) };
  const el = clamp(0.3 - FP.pitch * 0.9, 0.06, 1.0);       // look down = camera rises
  const dist = (aspect < 0.8 ? 4.8 : aspect < 1.3 ? 4.4 : 4.2) * (0.75 + 0.25 * hs);
  const side = aspect < 0.8 ? 0.35 : 0.75;
  const tp = new THREE.Vector3(pivot.x - fw.x * dist * Math.cos(el) + right.x * side, pivot.y + dist * Math.sin(el), pivot.z - fw.z * dist * Math.cos(el) + right.z * side);
  // stay inside the hall so the boards never block the shot
  const lim = { x: LIST.W / 2 + 2.6, z: LIST.L / 2 + 2.6 }; tp.x = clamp(tp.x, -lim.x, lim.x); tp.z = clamp(tp.z, -lim.z, lim.z);
  const tl = new THREE.Vector3(pivot.x + fw.x * 2.2 + right.x * side * 0.1, pivot.y - 0.25 + FP.pitch * 1.4, pivot.z + fw.z * 2.2 + right.z * side * 0.1);
  if (!CAM.tpInit) { CAM.tpPos.copy(tp); CAM.tpLook.copy(tl); CAM.tpInit = true; }
  const k = 1 - Math.exp(-14 * dt);
  CAM.tpPos.lerp(tp, k); CAM.tpLook.lerp(tl, 1 - Math.exp(-18 * dt));
  CAM.blend = Math.min(1, CAM.blend + dt / 0.35); const b = ease(CAM.blend);
  cam.position.copy(CAM.from).lerp(CAM.tpPos, b);
  const sh = G.shake * shakeAmt() * 0.5; if (sh > 0.01) { cam.position.x += rand(-1, 1) * sh * 0.12; cam.position.y += rand(-1, 1) * sh * 0.1; }
  G.shake = Math.max(0, G.shake - dt * 2.2);
  cam.lookAt(CAM.tpLook); applyFeel(cam, dt);
  CAM.pos.copy(cam.position); CAM.look.copy(CAM.tpLook);
}

// ---- the camera rides on the body ----
function updateFPCamera(dt) {
  const p = G.player, cam = W3.camera;
  const aspect = window.innerWidth / window.innerHeight;
  const fov = p.helm.fov * (aspect < 1 ? 1.3 : aspect < 1.4 ? 1.12 : 1) + FEEL.fov;
  if (Math.abs(cam.fov - fov) > 0.1 || cam.near !== 0.06) { cam.fov = fov; cam.near = 0.06; cam.updateProjectionMatrix(); }
  const hs = p.body.h / 1.8; let eyeH = p.body.h * 0.935 - (p.brace ? 0.12 : 0) - 0.06 * (1 - p.gas) * hs;
  let bx = p.pos.x, bz = p.pos.z, ang = 0, dir = { x: 0, z: 0 }, lyingOrSit = false;
  const s = p.state;
  if (s === 'standing' || s === 'posting') { const L = vlen(p.lean); ang = Math.atan(L); if (L > 1e-4) dir = { x: p.lean.x / L, z: p.lean.z / L }; if (s === 'posting') eyeH -= 0.32 * hs; }
  else if (s === 'falling') { ang = lerp(p.tilt0 || 0.4, 1.38, ease(p.fallT / 0.55)); dir = p.fallDir; }
  else if (s === 'grounded' || s === 'rising' || s === 'kneeling') {
    lyingOrSit = true;
    const gt = p.gt || 0;
    if (s === 'grounded' && p.groundStyle === 'fall' && gt < 0.8) { ang = 1.38; dir = p.fallDir; }
    else { const sit = s === 'grounded' && p.groundStyle === 'fall' ? ease((gt - 0.8) / 0.7) : 1; bx = lerp(p.pos.x, p.groundPos.x, sit); bz = lerp(p.pos.z, p.groundPos.z, sit); ang = 1.38 * (1 - sit); dir = p.fallDir; eyeH = lerp(eyeH, (s === 'kneeling' || p.groundStyle === 'kneel' ? 1.08 : 0.84) * hs, sit); }
    if (s === 'rising') { ang = 0; bx = p.groundPos.x; bz = p.groundPos.z; eyeH = lerp(0.84 * hs, eyeH, ease(p.riseT)); }
  }
  const eyeY = Math.max(0.22, Math.cos(ang) * eyeH);
  let ex = bx + dir.x * Math.sin(ang) * eyeH, ez = bz + dir.z * Math.sin(ang) * eyeH, ey = eyeY;
  // step bob and stagger jolts
  const spd = vlen(p.vel); const wk = clamp(spd / 3.5, 0, 1.4);
  if (s === 'standing') { ey += Math.abs(Math.sin(p.walkPh)) * 0.045 * wk - 0.02 * wk; if (p.stepRem > 0) ey -= 0.035; }
  // blown: shoulders heave with each breath and you sag lower as the fight drags on
  const we = BREATH.e, fatg = p.fatigue || 0;
  if (s === 'standing' && we > 0.03) ey += Math.sin(BREATH.ph) * 0.02 * we - 0.05 * fatg * hs;
  FP.jolt = Math.max(0, FP.jolt - dt * 3);
  const sh = G.shake * shakeAmt() * 0.6 + FP.jolt * 0.5 * Math.min(1, shakeAmt() + 0.3);
  G.shake = Math.max(0, G.shake - dt * 2.6); // (this never decayed in first person before, so one big hit left the view trembling)
  ex += rand(-1, 1) * sh * 0.05; ey += rand(-1, 1) * sh * 0.04;
  // orientation: look direction, plus the body's sway
  const sF = Math.sin(FP.yaw), cF = Math.cos(FP.yaw);
  const tf = Math.sin(ang) * (dir.x * sF + dir.z * cF), tx = Math.sin(ang) * (dir.x * cF - dir.z * sF);
  let pitch = FP.pitch - Math.asin(clamp(tf, -1, 1)) * (s === 'standing' ? 0.55 : 0.95) + (s === 'standing' ? Math.sin(BREATH.ph) * 0.014 * we - 0.05 * fatg : 0);
  let roll = Math.asin(clamp(tx, -1, 1)) * (s === 'standing' ? 0.7 : 1.0) + Math.sin(p.walkPh) * 0.012 * wk * (1 + fatg) + Math.sin(G.realTime * 7) * 0.09 * p.bell + Math.sin(BREATH.ph * 0.5 + 1.3) * 0.022 * we;
  if (lyingOrSit && s === 'grounded' && ang < 0.2) { pitch = FP.pitch; roll = 0; }
  FP.pitchS = damp(FP.pitchS, pitch, s === 'standing' ? 30 : 8, dt); FP.rollS = damp(FP.rollS, roll, s === 'standing' ? 30 : 8, dt);
  cam.position.set(ex, ey, ez);
  applyFeel(cam, dt * 1.6); cam.rotation.order = 'YXZ'; cam.rotation.set(FP.pitchS + rand(-1, 1) * sh * 0.02, FP.yaw + Math.PI + rand(-1, 1) * sh * 0.015, FP.rollS);
  CAM.pos.copy(cam.position);
}

// ---- arms, weapon and shield in view ----
function buildViewmodel() {
  const scene = new THREE.Scene(); scene.environment = W3.scene.environment;
  scene.add(new THREE.HemisphereLight('#c6d2dd', '#3a332b', 0.75));
  const d = new THREE.DirectionalLight('#fff4e4', 1.2); d.position.set(0.5, 1, 0.6); scene.add(d);
  const root = new THREE.Group(); scene.add(root);
  const mkArm = () => { // vambrace with a flared gauntlet cuff and a band of black hockey tape
    const g = new THREE.Group(); const m = new THREE.Mesh(new THREE.CylinderGeometry(0.046, 0.058, 1, 12), MAT.steel); m.rotation.x = Math.PI / 2; g.add(m);
    const cuff = new THREE.Mesh(new THREE.CylinderGeometry(0.072, 0.05, 0.11, 12, 1, true), MAT.steel); cuff.material.side = THREE.DoubleSide; cuff.rotation.x = Math.PI / 2; g.add(cuff); g.userData.cuff = cuff;
    const tape = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.035, 12, 1, true), MAT.tape.black); tape.rotation.x = Math.PI / 2; g.add(tape); g.userData.tape = tape;
    root.add(g); return g; };
  const handR = new THREE.Group(), handL = new THREE.Group(); root.add(handR, handL);
  for (const hnd of [handR, handL]) { // fist: knuckle plate and finger lames around the grip
    const back = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.085, 0.08), MAT.steel); back.position.set(0.035, 0, 0.0); hnd.add(back);
    for (let i = 0; i < 3; i++) { const l = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.026, 10, 1, false, 0, Math.PI), MAT.steel); l.rotation.set(0, 0, Math.PI / 2); l.position.set(0.0, 0.028 - i * 0.028, 0.0); l.scale.set(1, 1, 1.35); hnd.add(l); }
    const thumb = new THREE.Mesh(new THREE.CapsuleGeometry(0.014, 0.03, 2, 6), MAT.steelDark); thumb.position.set(-0.02, 0.045, -0.015); thumb.rotation.z = 0.6; hnd.add(thumb);
  }
  const wMount = new THREE.Group(); handR.add(wMount);
  const sMount = new THREE.Group(); handL.add(sMount);
  FP.vm = { scene, root, armR: mkArm(), armL: mkArm(), handR, handL, wMount, sMount, wKey: null, sKey: null, cur: {}, team: null };
}
const VMP = { // hand position and weapon orientation in view space (metres, radians)
  idle1: { r: [0.26, -0.22, -0.5, -0.4, 0, -0.25] }, idle2: { r: [0.2, -0.28, -0.42, -0.75, 0, 0.45] },
  wR2L: { r: [0.42, -0.06, -0.3, 0.55, 0, -1.15] }, sR2L: { r: [-0.34, -0.26, -0.55, -1.35, 0, 1.45] },
  wL2R: { r: [-0.3, -0.04, -0.3, 0.45, 0, 1.05] }, sL2R: { r: [0.44, -0.3, -0.55, -1.35, 0, -1.45] },
  wO: { r: [0.2, 0.12, -0.24, 1.35, 0, -0.2] }, sO: { r: [0.08, -0.38, -0.62, -1.95, 0, -0.05] },
  guardW: { r: [0.06, -0.06, -0.48, 0, 0, 1.5] }, grab: { r: [0.16, -0.26, -0.45, -0.3, 0, -0.1] }, down: { r: [0.3, -0.85, -0.4, -0.4, 0, -0.3] },
};
function updateViewmodel(dt) {
  const vm = FP.vm, p = G.player; if (!vm) return;
  const on = isFP() && isUp(p) && p.state !== 'posting';
  vm.root.visible = isFPView();
  vm.root.position.copy(W3.camera.position); vm.root.quaternion.copy(W3.camera.quaternion);
  if (!isFPView()) return;
  if (cuteViewmodel(vm, p)) { vm.wKey = vm.sKey = '__'; }
  const wk = p.weapon ? p.weapon.key : null, sk = p.shield ? p.shield.key : null;
  const wkSk = wk ? wk + '|' + (p.isPlayer && !G.attract ? skinFor(wk) || '' : '') : wk;
  if (vm.wKey !== wkSk || vm.team !== p.club.key) { while (vm.wMount.children.length) vm.wMount.remove(vm.wMount.children[0]); if (wk) { const w = p.isPlayer && !G.attract ? buildMyWeapon(wk, p.club) : buildWeapon(wk, p.club); vm.wMount.add(w); } vm.wKey = wkSk; }
  if (vm.sKey !== sk || vm.team !== p.club.key) { while (vm.sMount.children.length) vm.sMount.remove(vm.sMount.children[0]); if (sk) { const s = buildShield(sk, p.club); s.rotation.y = Math.PI; vm.sMount.add(s); } vm.sKey = sk; vm.team = p.club.key; }
  const twoH = p.weapon && p.weapon.hands === 2;
  const a = p.action; let key = twoH ? 'idle2' : 'idle1', rate = 12;
  if (a && a.kind === 'swing') { if (a.phase === 'windup') { key = 'w' + a.arc; rate = 13; } else if (a.phase === 'strike') { key = 's' + a.arc; rate = 42; } else rate = 9; }
  else if (p.guard && !p.shield) { key = 'guardW'; rate = 18; }
  else if (a && ['grab', 'knee', 'throw', 'disarm'].includes(a.kind) || p.clinch) { key = 'grab'; rate = 18; }
  if (!on) { key = 'down'; rate = 6; }
  const t = VMP[key].r.slice();
  if (a && a.kind === 'swing' && a.phase === 'windup') { t[2] += 0.08 * a.charge; t[1] += 0.05 * a.charge; }
  if (twoH && key !== 'down') { t[0] -= 0.06; t[2] += 0.04; }
  const spd = vlen(p.vel), wkk = clamp(spd / 3.5, 0, 1.3);
  t[1] += Math.sin(p.walkPh * 2) * 0.012 * wkk; t[0] += Math.sin(p.walkPh) * 0.012 * wkk;
  // tired arms: the weapon sags, rises and falls with your breathing, and shakes when you're spent
  const fatv = p.fatigue || 0;
  if (key === 'guardW') { t[0] += { L: -0.18, R: 0.16 }[p.gdir] || 0; t[1] += p.gdir === 'H' ? 0.16 : 0; t[5] += { L: 0.5, R: -0.5 }[p.gdir] || 0; }
  if (key === 'idle1' || key === 'idle2' || key === 'guardW') { t[1] -= 0.09 * fatv + 0.03 * (1 - p.gas); t[3] -= 0.35 * fatv; t[1] += Math.sin(BREATH.ph) * 0.014 * BREATH.e; }
  if (fatv > 0.45) { const tr = (fatv - 0.45) * 0.008; t[0] += Math.sin(G.realTime * 31) * tr; t[1] += Math.sin(G.realTime * 27 + 1) * tr; }
  // left hand: shield or haft
  let L;
  if (twoH) L = null;
  const gsx = p.guard ? ({ L: -0.16, R: 0.14, H: 0 }[p.gdir] || 0) : 0, gsy = p.guard && p.gdir === 'H' ? 0.14 : 0;
  if (p.shield && p.shield.key === 'heater') L = p.guard ? [-0.1 + gsx, -0.16 + gsy, -0.4, 0, 0.02 + gsx * 1.5, 0] : a && a.kind === 'shove' && a.phase === 'recover' && a.t < 0.14 ? [-0.06, -0.2, -0.7, 0, 0, 0] : [-0.4, -0.42, -0.55, 0.1, 0.55, 0.05];
  else if (p.shield) L = p.guard ? [-0.06 + gsx, -0.1 + gsy, -0.42, 0, gsx * 1.5, 0] : a && a.kind === 'shove' && a.phase === 'recover' && a.t < 0.14 ? [-0.04, -0.16, -0.68, 0, 0, 0] : [-0.32, -0.32, -0.52, 0, 0.3, 0];
  else L = key === 'grab' ? [-0.16, -0.26, -0.45, -0.3, 0, 0.1] : [-0.3, -0.38, -0.5, 0, 0, 0];
  if (a && a.kind === 'tackle' && a.phase !== 'recover') { t[2] -= 0.1; t[1] -= 0.08; if (L) { L[2] -= 0.18; L[0] += 0.1; } }
  if (!on) { if (L) { L[1] = -0.9; } }
  const k = 1 - Math.exp(-rate * dt), kl = 1 - Math.exp(-16 * dt);
  const c = vm.cur; if (!c.r) { c.r = t.slice(); c.l = (L || t).slice(); }
  for (let i = 0; i < 6; i++) c.r[i] += (t[i] - c.r[i]) * k;
  vm.handR.position.set(c.r[0], c.r[1], c.r[2]); vm.handR.rotation.set(c.r[3], c.r[4], c.r[5]);
  if (twoH) { // left hand rides the haft below the right
    const v = new THREE.Vector3(0, -0.3, 0).applyEuler(vm.handR.rotation); vm.handL.position.copy(vm.handR.position).add(v); vm.handL.rotation.copy(vm.handR.rotation);
  } else {
    for (let i = 0; i < 6; i++) c.l[i] += (L[i] - c.l[i]) * kl;
    vm.handL.position.set(c.l[0], c.l[1], c.l[2]); vm.handL.rotation.set(c.l[3], c.l[4], c.l[5]);
  }
  vm.sMount.position.set(-0.05, 0, -0.02);
  // forearms run from off-screen elbows to the hands
  vm.root.updateMatrixWorld(true);
  const arm = (g, hand, sx) => { const s = new THREE.Vector3(sx * 0.32, -0.62, 0.05); const e = hand.position; const L = s.distanceTo(e); g.position.copy(s).add(e).multiplyScalar(0.5); g.updateMatrixWorld(); g.lookAt(vm.root.localToWorld(e.clone())); g.scale.set(1, 1, 1); g.children[0].scale.set(1, L, 1); g.userData.cuff.position.z = L / 2 - 0.07; g.userData.tape.position.z = L / 2 - 0.15; };
  arm(vm.armR, vm.handR, 1); arm(vm.armL, vm.handL, -1);
}

// ---- balance gauge (practice aid) ----
function updateBalanceGauge() {
  const el = $('#bal'), p = G.player; const on = isFP() && isUp(p) && G.settings.ring;
  el.hidden = !on; if (!on) return;
  const sF = Math.sin(FP.yaw), cF = Math.cos(FP.yaw);
  const lf = p.lean.x * sF + p.lean.z * cF, lx = p.lean.x * cF - p.lean.z * sF;
  const k = 22 / FALL_L; const dot = $('#baldot');
  dot.style.transform = `translate(${clamp(-lx * k, -22, 22)}px,${clamp(-lf * k, -22, 22)}px)`;
  dot.style.background = vlen(p.lean) > 0.26 ? 'var(--marshal)' : 'var(--chalk)';
  el.style.setProperty('--gas', Math.round(p.gas * 100) + '%');
}

// ---- arrows at the screen edge for fighters you can't see ----
const EDGES = [];
function updateEdges() {
  const box = $('#edges'); const p = G.player;
  if (!EDGES.length) for (let i = 0; i < 6; i++) { const e = h('i', { class: 'edge' }); e.hidden = true; box.append(e); EDGES.push(e); }
  let n = 0;
  if (isCtl() && isUp(p) && !CAM.cine) {
    const cam = W3.camera; const hfov = 2 * Math.atan(Math.tan(cam.fov * Math.PI / 360) * cam.aspect);
    const list = G.fighters.filter(o => o !== p && isUp(o) && dist2(o.pos, p.pos) < 6.5).sort((a, b) => dist2(a.pos, p.pos) - dist2(b.pos, p.pos));
    for (const o of list) {
      if (n >= EDGES.length) break;
      const rel = angDiff(FP.yaw, angTo(p.pos, o.pos)); if (Math.abs(rel) < hfov * 0.45) continue;
      const e = EDGES[n++]; const d = dist2(o.pos, p.pos);
      const threat = o.team !== p.team && o.action && o.action.phase === 'windup' && d < reachOf(o) + 0.5;
      e.className = 'edge ' + (rel > 0 ? 'l' : 'r') + (threat && G.settings.tele !== 'off' ? ' threat' : '');
      e.style.setProperty('--c', threat ? 'var(--marshal)' : o.team === p.team ? 'rgba(255,61,139,.75)' : 'var(--rival)');
      const behind = Math.abs(rel) > Math.PI * 0.6;
      e.style.top = `calc(${behind ? 72 : 46}% - 12px)`; e.style.opacity = String(clamp(1.3 - d / 6.5, 0.35, 1));
      e.hidden = false;
    }
  }
  for (let i = n; i < EDGES.length; i++) EDGES[i].hidden = true;
}
// ---------- impact feel: tiered hitstop, shake that pushes the way the blow went, a field-of-view punch ----------
// (after Sakurai's hitstop notes and Vlambeer's "art of screenshake": cosmetic only, hit detection never moves)
const FEEL = { kick: new THREE.Vector3(), fov: 0, reduced: false };
try { FEEL.reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { }
function shakeAmt() { return (G.settings.shake ? 1 : 0) * (G.settings.shakeAmt == null ? (FEEL.reduced ? 0.35 : 1) : G.settings.shakeAmt) * (CUTE.on ? 0.6 : 1); }
// kind: 'light' | 'heavy' | 'takedown' | 'block' | 'taken'; dir: world xz direction the blow travelled
function impactFeel(kind, dir, mag = 1) {
  if (G.attract || G.autopilot) return;
  const stop = { light: 0.045, heavy: 0.09, takedown: 0.16, block: 0.035, taken: 0.07 }[kind] || 0.04;
  const crowd = G.fighters.length > 12 ? 0.5 : 1; // big melees use less stop, or the fight stutters
  G.hitstop = Math.max(G.hitstop, stop * crowd * (CUTE.on ? 0.7 : 1));
  const s = shakeAmt(); if (s <= 0) return;
  const push = { light: 0.035, heavy: 0.075, takedown: 0.11, block: 0.025, taken: 0.09 }[kind] * mag * s;
  if (dir) { FEEL.kick.x += dir.x * push; FEEL.kick.z += dir.z * push; }
  FEEL.kick.y -= push * (kind === 'heavy' || kind === 'takedown' ? 0.8 : 0.3); // heavy blows drive the view down
  FEEL.fov += ({ heavy: 3, takedown: 4, taken: 2.5 }[kind] || 0) * s;
  G.shake = Math.max(G.shake, ({ light: 0.12, heavy: 0.22, takedown: 0.3, block: 0.1, taken: 0.32 }[kind] || 0.1) * mag);
}
// called by every camera mode after it has placed the camera
function applyFeel(cam, dt) {
  cam.position.add(FEEL.kick);
  FEEL.kick.multiplyScalar(Math.exp(-dt * 11));
  FEEL.fov *= Math.exp(-dt * 9);
}
// ---------- commentary booth, sound captions, attack glints, text size, fullscreen, share text ----------
// Two voices call the fight: the arena announcer on the PA, and the colour man next to him.
const COMM = { q: [], t: 0, busy: 0, last: {}, firstDown: false, lastLine: '' };
const COMM_LINES = {
  start: [['pa', 'Round {r}! Fighters ready… and here we go!'], ['pa', 'Round {r} at the Red Deer Rumble. Let’s hear some noise!'], ['co', 'Watch the polearms early. They decide these openings.']],
  final: [['pa', 'Final round! Everything on this one!'], ['co', 'One round, one trophy. Nobody saves anything now.']],
  first: [['co', 'First body on the floor goes to {team}!'], ['co', 'And {team} draw first blood. Well, first concrete.'], ['pa', 'Down goes one! {team} strike first!']],
  takedown: [['co', 'Oh, textbook. {how} and they’re down.'], ['co', 'You love to see it. Clean {how}.'], ['pa', 'What a takedown from {who}!'], ['co', 'That’s the {how} we’ve been waiting for.']],
  pdown: [['co', 'Ooh, {who} is on the concrete. That’ll sting tomorrow.'], ['co', 'And {who} goes down. Too far forward.'], ['pa', '{who} is grounded!']],
  ratio: [['pa', 'Three to one! That’s the round!'], ['co', 'Outnumbered three to one, the marshals stop it.']],
  card: [['co', 'The marshal’s not having any of that. {card} for {who}.'], ['co', '{card}. Control is a skill, folks.']],
  red: [['pa', 'Red card! {who} is out of the list!'], ['co', 'Red card. That team fights short now, and it might cost them the match.']],
  armour: [['co', 'Strap’s gone! That’s why you bring the hockey tape.'], ['co', 'Armour failure. They’re headed to the squire for repairs.']],
  matchpoint: [['pa', 'Match point for {team}!'], ['co', 'One more round and {team} take it.']],
  comeback: [['co', 'What a comeback from {team}!'], ['pa', 'They were down, and now they’re level!']],
  lead: [['co', '{who} takes the lead, {score}.'], ['pa', 'Lead change! {score}.']],
  head: [['co', 'Right on the helmet. Three points.'], ['co', 'Head shot! The visor rang like a bell.']],
  tired: [['co', 'Look at those shoulders heave. Somebody’s cooked.'], ['co', 'The legs are going. This is where fitness wins fights.']],
  perfect: [['co', 'Perfect block! Timed it to the hair.'], ['co', 'Read that one like a book. Perfect parry.']],
  repair: [['co', 'Lovely tape job. Very Alberta.'], ['co', 'Neat wraps. That strap will hold.']],
  rival: [['pa', 'Grudge match! {who} has been waiting for this one.'], ['co', '{who} and our fighter do not like each other. At all.'], ['co', 'Last time it was {last}. {who} has been practising.']],
  win: [['pa', '{team} win the match!'], ['co', 'Well earned. {team} were the better side today.']],
  // youth day
  cstart: [['pa', 'Little knights, ready? Gooo!'], ['co', 'Look at those helmets. Adorable and terrifying.']],
  cdown: [['co', 'Boop! Down they go!'], ['co', 'Whoopsie! Straight onto the bum.'], ['pa', 'What a bonk!']],
  ccard: [['co', 'Uh oh, the moose marshal says gentle hands please.']],
  cwin: [['pa', 'Everybody gets a juice box! {team} win!']],
};
function comm(type, d = {}, pri = 1) {
  if (!G.settings.comm || G.attract || G.autopilot || !G.match || G.match.training) return;
  if (CUTE.on) { const ct = { start: 'cstart', final: 'cstart', first: 'cdown', takedown: 'cdown', pdown: 'cdown', card: 'ccard', red: 'ccard', win: 'cwin' }[type]; if (ct) type = ct; }
  const lines = COMM_LINES[type]; if (!lines) return;
  if (G.realTime - (COMM.last[type] || -99) < (pri >= 3 ? 2 : 12)) return; // don't repeat the same kind of call
  let pickL = lines[(Math.random() * lines.length) | 0]; if (lines.length > 1 && pickL[1] === COMM.lastLine) pickL = lines[(lines.indexOf(pickL) + 1) % lines.length];
  const txt = pickL[1].replace(/\{(\w+)\}/g, (_, k) => d[k] != null ? d[k] : '');
  COMM.last[type] = G.realTime;
  if (pri < 3 && COMM.q.length >= 2) return;
  COMM.q.push({ type, who: pickL[0], txt, pri, raw: pickL[1] }); COMM.q.sort((a, b) => b.pri - a.pri);
}
function updateComm(dt) {
  const el = $('#comm'); if (!el) return;
  COMM.busy -= dt;
  if (COMM.busy <= 0) {
    if (COMM.q.length && !CAM.cine) {
      const c = COMM.q.shift(); COMM.lastLine = c.raw;
      el.innerHTML = ''; el.append(h('b', null, c.who === 'pa' ? 'ANNOUNCER' : 'COLOUR'), h('span', null, c.txt));
      el.className = 'on ' + c.who; COMM.busy = 2.6 + c.txt.length * 0.03;
      if (G.settings.spokenComm) speakComm(c);
    } else el.className = '';
  }
}

// sound captions: words and arrows for sounds you might miss (helmets muffle a lot)
const CAP = { t: 0, last: {} };
function caption(key, text, side) {
  if (!G.settings.cap || G.attract) return;
  if (G.realTime - (CAP.last[key] || -99) < 3) return; CAP.last[key] = G.realTime;
  const el = $('#capline'); el.textContent = (side === 'l' ? '◀ ' : '') + '[' + text + ']' + (side === 'r' ? ' ▶' : ''); el.hidden = false; CAP.t = 2.2;
}
function updateCaptions(dt) {
  CAP.t -= dt; if (CAP.t <= 0) $('#capline').hidden = true;
  const p = G.player; if (!G.settings.cap || !p || !isUp(p) || G.phase !== 'fight') return;
  for (const o of G.fighters) { // footsteps behind you
    if (o.team === p.team || !isUp(o) || vlen(o.vel) < 2.2) continue;
    const d = dist2(o.pos, p.pos); if (d > 4.5) continue;
    const rel = angDiff(FP.yaw, angTo(p.pos, o.pos)); if (Math.abs(rel) < 1.6) continue;
    caption('steps', o.sprint ? 'someone charging at you' : 'footsteps behind you', rel > 0 ? 'l' : 'r'); break;
  }
}

// a glint on the weapon of anyone winding up a swing at you
const TELE = { sprites: [] };
function updateTelegraphs(t) {
  const mode = G.settings.tele || 'subtle', p = G.player;
  if (!TELE.sprites.length) for (let i = 0; i < 4; i++) { const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: TEX.spark, color: '#fff3b0', blending: THREE.AdditiveBlending, depthWrite: false, depthTest: false, transparent: true })); s.visible = false; s.renderOrder = 6; (W3.matchRoot || W3.scene).add(s); TELE.sprites.push(s); }
  let n = 0;
  if (mode !== 'off' && p && isUp(p) && G.phase === 'fight' && !G.autopilot && !CAM.cine) {
    for (const o of G.fighters) {
      if (n >= TELE.sprites.length) break;
      const a = o.action; if (o.team === p.team || !isUp(o) || !a || a.kind !== 'swing' || a.phase !== 'windup' || o.ai.target !== p) continue;
      if (dist2(o.pos, p.pos) > reachOf(o) + 1.2 || !o.model || !o.model.weapon) continue;
      const s = TELE.sprites[n++]; const wp = new THREE.Vector3(0, (o.weapon && o.weapon.len || 0.9) * 0.85, 0); o.model.weapon.localToWorld(wp);
      s.position.copy(wp); const k = clamp(a.t / Math.max(0.05, swingTimes(o).wind), 0, 1);
      s.scale.setScalar((mode === 'strong' ? 0.55 : 0.32) * (0.6 + 0.6 * k) * (1 + 0.15 * Math.sin(t * 40)));
      s.material.color.set(a.arc === 'O' ? '#ff6a5a' : a.arc === 'R2L' ? '#6fc9ff' : '#ffd177'); s.visible = true;
    }
  }
  for (let i = n; i < TELE.sprites.length; i++) TELE.sprites[i].visible = false;
}

function applyTextSize() { document.documentElement.style.setProperty('--ts', String(+G.settings.ts || 1)); document.documentElement.style.fontSize = (16 * (+G.settings.ts || 1)) + 'px'; }
// fullscreen first, then the landscape lock (lock only works once fullscreen is on); iPhones support neither
const FS = { pending: false };
function fullscreenActive() { return !!(document.fullscreenElement || document.webkitFullscreenElement); }
function syncFullscreenControl() {
  const b = $('#btnFull'); if (b) { b.textContent = fullscreenActive() ? 'Exit fullscreen' : 'Enter fullscreen'; b.setAttribute('aria-pressed', String(fullscreenActive())); }
}
async function goFullscreen(manual) {
  if (!manual || FS.pending) return;
  FS.pending = true;
  const el = document.documentElement;
  try {
    if (fullscreenActive()) {
      if (document.exitFullscreen) await document.exitFullscreen(); else if (document.webkitExitFullscreen) await document.webkitExitFullscreen();
      if (screen.orientation && screen.orientation.unlock) screen.orientation.unlock();
    } else {
      if (el.requestFullscreen) await el.requestFullscreen({ navigationUI: 'hide' });
      else if (el.webkitRequestFullscreen) await el.webkitRequestFullscreen();
      else throw new Error('Fullscreen unsupported');
      try { if (fullscreenActive() && screen.orientation && screen.orientation.lock && IN.mode === 'touch') await screen.orientation.lock('landscape'); } catch (e) { }
    }
  } catch (e) { toastMenu('Fullscreen isn’t allowed here. Use your browser’s menu, or add the page to your home screen.'); }
  finally { FS.pending = false; syncFullscreenControl(); }
}
function watchContext() { // if the phone drops the GPU (backgrounded, low memory), say so instead of freezing
  const c = W3.renderer && W3.renderer.domElement; if (!c) return;
  c.addEventListener('webglcontextlost', e => { e.preventDefault(); G.ctxLost = true; if (G.phase === 'fight' && !G.paused) togglePause(true); toastMenu('Graphics paused by the phone. Hang on…'); }, false);
  c.addEventListener('webglcontextrestored', () => { G.ctxLost = false; toastMenu('Back!'); }, false);
}

document.addEventListener('click', e => { const b = e.target.closest && e.target.closest('[data-share]'); if (b) { AU.click(); copyShare(G.shareKind || 'match', G.shareExtra || {}); } });
// spoiler-free share text: one square per scoring hit or round
function shareText(kind, extra = {}) {
  const m = G.match; if (!m) return '';
  const head = kind === 'daily' ? `BUHURT Daily #${extra.day} ${extra.mod || ''}` : kind === 'run' ? `BUHURT Gauntlet ${extra.code}` : `BUHURT: Steel & Tape`;
  const lines = [head.trim(), `${m.wins[0] > m.wins[1] ? '🏆' : m.wins[0] === m.wins[1] ? '🤝' : '🛡️'} ${m.duelForfeit!=null?m.pts[0]:m.wins[0]}–${m.duelForfeit!=null?m.pts[1]:m.wins[1]}${m.duelForfeit!=null?" recorded points":""} vs ${CLUBS[m.opp] ? CLUBS[m.opp].short : ''}${m.category === 'youth' ? ' 🧸' : ''}`];
  const rnd = m.results.map((r, i) => `R${r.round}${r.winner === 0 ? '🟩' : r.winner === 1 ? '🟥' : '⬜'}`).join(' ');
  lines.push(rnd);
  if(m.duelForfeit!=null)lines.push('Technical decision: '+(m.technicalReason==='withdrawal'?'withdrawal':'equipment unavailable')+'. Recorded scores shown above.');
  const hits = (MT.zones || []).slice(0, 14).map(z => ({ helmet: '🟩', torso: '🟨', armL: '🟦', armR: '🟦', legs: '🟦', down: '💥' })[z] || '⬛').join('');
  if (hits) lines.push(hits);
  const tape = G.tourney ? '' : `🩹 tape ${MT.tape || 0} · 🟨 cards ${m.cards.filter(c => c.team === 0 && c.card !== 'warning').length}`;
  lines.push(tape); if (extra.streak) lines.push(`🔥 streak ${extra.streak}`);
  return lines.filter(Boolean).join('\n');
}
async function copyShare(kind, extra) {
  const txt = shareText(kind, extra);
  try { if (navigator.share && IN.mode === 'touch') { await navigator.share({ text: txt }); return; } } catch (e) { }
  try { await navigator.clipboard.writeText(txt); toastMenu('Result copied. Paste it anywhere.'); }
  catch (e) { const ta = h('textarea', null, txt); ta.style.cssText = 'position:fixed;left:-999px'; document.body.append(ta); ta.select(); try { document.execCommand('copy'); toastMenu('Result copied.'); } catch (e2) { toastMenu('Could not copy here.'); } ta.remove(); }
}

// ---- hype: the crowd and a war drum build with the moment (close score, match point, last fighters standing) ----
const HYPE = { v: 0, next: 0, beat: 0 };
function hype(add) { HYPE.v = Math.min(1, HYPE.v + add); }
function updateHype(dt) {
  if (!AU.ctx || AU.muted || G.phase !== 'fight' || G.attract || G.paused || !G.match || G.match.training) { HYPE.v *= 0.995; HYPE.next = 0; return; }
  const m = G.match; let base = 0.12;
  if (m.round >= 3 || m.champion || m.wins[0] === 1 || m.wins[1] === 1) base += 0.22;
  if (m.duel) { if (Math.abs(m.pts[0] - m.pts[1]) <= 2 && m.pts[0] + m.pts[1] >= 4) base += 0.22; if (m.clock < 15) base += 0.15; }
  else { const a = standing(0), b = standing(1); if (a + b <= 5 && Math.abs(a - b) <= 1) base += 0.25; if (a === 1 || b === 1) base += 0.15; }
  HYPE.v = Math.max(base, HYPE.v - dt * 0.035);
  const t = AU.ctx.currentTime, spb = 60 / (84 + 52 * HYPE.v);
  if (HYPE.next < t) HYPE.next = t + 0.05;
  while (HYPE.next < t + 0.2) {
    const b = HYPE.beat++ % 8, when = HYPE.next - t, v = 0.1 + 0.32 * HYPE.v, h = HYPE.v;
    if (h > 0.25) { if (b % 4 === 0) AU.play('drum0', v, CUTE.on ? 1.3 : 1, when); if (b % 4 === 2 && h > 0.42) AU.play('drum1', v * 0.8, CUTE.on ? 1.3 : 1, when); if (h > 0.65 && (b === 3 || b === 7)) AU.play('drum0', v * 0.55, 1.15, when); }
    if (h > 0.58 && (b === 2 || b === 6)) { AU.any('clap', 0.3 * h, rand(0.95, 1.05), when); AU.any('clap', 0.22 * h, rand(0.9, 1.1), when + 0.012); } // the crowd claps along
    HYPE.next += spb / 2;
  }
}

// ---- hit map: where your blows landed this match, on a little figure ----
function hitMapHtml() {
  const z = MT.zones || []; if (!z.length) return '';
  const c = { helmet: 0, torso: 0, arm: 0, legs: 0, down: 0 }; for (const k of z) { if (k === 'armL' || k === 'armR') c.arm++; else if (c[k] != null) c[k]++; }
  const max = Math.max(1, c.helmet, c.torso, c.arm, c.legs), fill = n => `rgba(255,61,139,${0.12 + 0.88 * n / max})`;
  return `<div class="hitmap"><svg viewBox="0 0 120 170" aria-label="Where your hits landed">
    <circle cx="60" cy="22" r="16" fill="${fill(c.helmet)}" stroke="#ece8de" stroke-width="1.5"/>
    <rect x="38" y="42" width="44" height="58" rx="8" fill="${fill(c.torso)}" stroke="#ece8de" stroke-width="1.5"/>
    <rect x="18" y="44" width="16" height="54" rx="7" fill="${fill(c.arm)}" stroke="#ece8de" stroke-width="1.5"/><rect x="86" y="44" width="16" height="54" rx="7" fill="${fill(c.arm)}" stroke="#ece8de" stroke-width="1.5"/>
    <rect x="40" y="104" width="17" height="60" rx="7" fill="${fill(c.legs)}" stroke="#ece8de" stroke-width="1.5"/><rect x="63" y="104" width="17" height="60" rx="7" fill="${fill(c.legs)}" stroke="#ece8de" stroke-width="1.5"/>
    <g font-family="Big Shoulders Display, sans-serif" font-weight="900" font-size="14" fill="#fff" text-anchor="middle"><text x="60" y="27">${c.helmet}</text><text x="60" y="76">${c.torso}</text><text x="26" y="76">${c.arm}</text><text x="60" y="140">${c.legs}</text></g></svg>
    <div><b>Where you hit</b><span>Head ${c.helmet} · Body ${c.torso} · Arms ${c.arm} · Legs ${c.legs}</span><span>Takedowns ${c.down}</span><span class="muted">${c.helmet >= c.torso ? 'Hunting the helmet. Big points in duels.' : 'Working the body. Look up for head shots.'}</span></div></div>`;
}

// Pre-rendered audio is keyed to the exact caption text. Dynamic lines remain
// captions only until a recording of their fully rendered words exists.
function commClipName(line) {
  let hash = 0x811c9dc5;
  for (let i = 0; i < line.length; i++) { hash ^= line.charCodeAt(i); hash = Math.imul(hash, 0x01000193); }
  return 'comm_line_' + (hash >>> 0).toString(16).padStart(8, '0');
}
const COMM_AUDIO = {
  source: null, lastClip: '', lastAt: -99,
  stop() {
    if (!this.source) return;
    const source = this.source; this.source = null;
    source.onended = null; try { source.stop(); } catch (e) { }
    VOICE.duck(false);
  },
  play(c) {
    if (!AU.ctx || AU.muted || !G.settings.spokenComm) return;
    if (!c.raw || c.raw.includes('{') || c.txt !== c.raw) return;
    const clip = commClipName(c.txt); if (!AU.buf[clip]) return;
    if (this.source && c.pri < 3) return;
    if (this.lastClip === clip && G.realTime - this.lastAt < 3) return;
    if (this.source) this.stop();
    const source = AU.play(clip, 0.9);
    if (!source) return;
    this.source = source; this.lastClip = clip; this.lastAt = G.realTime;
    VOICE.duck(true);
    source.onended = () => { if (this.source === source) { this.source = null; VOICE.duck(false); } };
  }
};
function speakComm(c) { COMM_AUDIO.play(c); }
// ---- broadcast touches: fighter cards before round one, a live stats strip ----
function showIntro() {
  const m = G.match; if (!m || m.training || G.attract || m.round !== 1) return;
  const el = $('#intro'); if (!el) return;
  const side = t => G.fighters.filter(f => (m.ffa ? true : f.team === t) && !f.out).slice(0, m.ffa ? 8 : 5);
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const card = f => `<div class="icard"><b>${esc(f.isPlayer ? (CAREER.name === 'You' ? 'You' : CAREER.name) : f.name)}</b><span>${f.weapon ? f.weapon.name : ''} · ${f.body.h.toFixed(2)} m</span></div>`;
  el.innerHTML = m.ffa ? `<div class="iside">${side(0).map(card).join('')}</div>` : `<div class="iside a"><h4>${esc(m.versus && VS.names ? VS.names[0] : CLUBS.reavers.name)}</h4>${side(0).map(card).join('')}</div><div class="ivs">VS</div><div class="iside b"><h4>${esc(m.versus && VS.names ? VS.names[1] || '' : CLUBS[m.opp] ? CLUBS[m.opp].name : '')}</h4>${side(1).map(card).join('')}</div>`;
  el.hidden = false; el.classList.remove('out'); clearTimeout(showIntro.t); showIntro.t = setTimeout(() => { el.classList.add('out'); setTimeout(() => el.hidden = true, 400); }, 2300);
}
function updateStatsStrip() {
  const el = $('#statstrip'), m = G.match; if (!el) return;
  const on = m && !m.training && !m.duel && !m.ffa && G.phase === 'fight' && !CAM.cine && G.settings.stats !== false;
  el.hidden = !on; if (!on) return;
  const h2 = m.hitsT || [0, 0], d = m.takedowns || [0, 0]; const txt = `Hits ${h2[0]}–${h2[1]} · Downs ${d[0]}–${d[1]}`; if (el.textContent !== txt) el.textContent = txt;
}
// ---------- the repair bench: rip, wrap, smooth (BR 2.1.5, BR 2.3, WR 7.2.2) ----------

const REP = { piece: null, tape: null, roll: 'black', step: null, timer: 45, ripT: 0, wraps: [], sloppy: 0, side: 0, wrinkles: [], smoothT: 0, q: {}, ptr: null, active: false, onDone: null, onFail: null, log: [], squire: 1, pop: null, lastSec: 99, trail: [], forcedPiece: null, failuresOnly: false, emergency: false };

const PIECE_SHORT = { helmet: ['Helmet', '⛑️'], armL: ['Left arm', '💪'], armR: ['Right arm', '💪'], legs: ['Legs', '🦵'], haft: ['Haft', '🪓'] };

const ZONE = { a: 0.36, b: 0.64 }; // the tear, as a fraction of the bench width

const BAND = { top: 0.42, bot: 0.6 };



function openRepair(seconds, onDone, options) {

  REP.player = G.player;

  options = options || {};

  if (!options.proper && !options.fixedDuration && !options.emergency && CAREER.skills && CAREER.skills['show.tape']) seconds += 15; // Tape artist

  if (!options.proper && !options.fixedDuration && !options.emergency && typeof shopFx === 'function') seconds += shopFx('repairSec'); // good scissors

  Object.assign(REP, { piece: null, tape: null, step: null, timer: seconds, duration: seconds, active: true, onDone, onFail: options.onFail || null, wraps: [], wrinkles: [], squire: 1 + (G.boon && G.boon.squire ? 1 : 0) + (typeof shopState === 'function' ? shopState().squires : 0), pop: null, lastSec: 99, trail: [], forcedPiece: options.forcedPiece || null, failuresOnly: !!options.failuresOnly, emergency: !!options.emergency, requireSafeArmour: !!options.requireSafeArmour });

  REP.roll = REP.roll && TAPES[REP.roll] && TAPES[REP.roll].legal && tapeLeft(REP.roll) > 0 ? REP.roll : (['black', 'grey', 'white', 'pro', 'kevlar'].find(x => tapeLeft(x) > 0) || 'black');

  Object.assign(REP, { proper: !!options.proper, untimed: !!options.proper || !!options.untimed, workshop: !!options.workshop, training: !!options.training, task: null, wrapSaved: null });

  for (const k of pieceKeys()) normalizeRepairPiece(REP.player.kit[k], k);

  if (!squireActive()) REP.squire = 0;

  REP.fieldSpares = Math.max(0, shopState().lv.straps || 0);

  const leave = $('#repair [data-leave]'); if (leave) leave.onclick = () => {

    if (REP.workshop) { closeRepair(); return; }

    persistPlayerKit(); REP.active = false; REP.step = null; REP.task = null; REP.onDone = REP.onFail = null; toTitle();

  };

  $('#repSub').textContent = REP.proper ? 'Proper servicing restores durability. Field patches remain temporary.' : 'Make your equipment safe; proper servicing waits until town.';

  renderKitList(); renderDrawer(); setSteps(null); renderRepairActions();

  const worst = worstPiece();

  $('#benchMsg').textContent = worst ? `Tap a strap to fix it. ${PIECE_SHORT[worst][0]} is the worst.` : 'Everything is in good shape. Tap Done, or top anything up.';

  if (REP.forcedPiece || REP.failuresOnly) {

    $('#benchMsg').textContent = squireActive() ? `${teamSquire().name} is ready to help. Repair the failed armour before returning. Tap a failed piece to begin.` : 'No squire recruited: use the bench to repair the failed armour yourself. Tap a failed piece to begin.';

    if (REP.forcedPiece) selectPiece(REP.forcedPiece);

  }

  showScreen('repair'); sizeBench();

}

function worstPiece() { const kit = REP.player.kit; let w = null; for (const k of pieceKeys()) { const pc = kit[k]; const v = pc.failed ? -1 : pc.cond; if (v < (REP.proper ? 0.999 : 0.7) && (w === null || v < (kit[w].failed ? -1 : kit[w].cond))) w = k; } return w; }

// the bench canvas matches its box on screen (sharp on phones, no clipping)

function sizeBench() {

  const cv = $('#bench'); if (!cv) return; const r = cv.getBoundingClientRect(); if (r.width < 10) return;

  const d = Math.min(2, window.devicePixelRatio || 1); const w = Math.round(r.width * d), hh = Math.round(r.height * d);

  if (cv.width !== w || cv.height !== hh) { cv.width = w; cv.height = hh; }

}

window.addEventListener('resize', () => { if (G.screen === 'repair') sizeBench(); });

function repPop(text, col) { REP.pop = { text, col: col || '#ece8de', t: 1.4 }; }

function pieceKeys() {

  const p = REP.player; const keys = ['helmet', 'armL', 'armR', 'legs'];

  if (WEAPONS[p.spec.weapon].haft) keys.push('haft');

  return keys;

}

function pieceStatus(k, pc) {

  const bits = [Math.round(pc.cond * 100) + '%'];

  if (k === 'haft' && pc.failed) bits.push('torn: weapon refused until rewrapped');

  else if (pc.failed && pc.covered) bits.push('let go, covered for now');

  else if (pc.cond < 0.3) bits.push('about to let go');

  if (pc.tape) bits.push('taped: ' + TAPES[pc.tape].name.toLowerCase());

  return bits.join(' · ');

}

function renderKitList() {

  const box = $('#kitlist'); box.innerHTML = '';

  const kit = REP.player.kit, worst = worstPiece();

  for (const k of pieceKeys().filter(k => (!REP.forcedPiece || k === REP.forcedPiece) && (!REP.failuresOnly || REP.player.kit[k].failed))) {

    const pc = kit[k]; const col = pc.failed || pc.cond < 0.3 ? 'var(--card-red)' : pc.cond < 0.55 ? 'var(--marshal)' : pc.cond < 0.8 ? '#9fb0b4' : 'var(--card-green)';

    const [nm, ic] = PIECE_SHORT[k];

    const st = k === 'haft' && pc.failed ? 'torn!' : pc.failed ? 'broken' : pc.cond < 0.3 ? 'about to go' : pc.cond >= 0.9 ? 'solid' : pc.tape ? TAPES[pc.tape].name.split(' ')[0].toLowerCase() + ' tape' : '';

    const b = h('button', { class: 'piece' + (k === worst ? ' worst' : '') + (k === 'armL' ? ' flipx' : ''), 'aria-pressed': String(REP.piece === k), title: PIECE_NAMES[k], onclick: () => selectPiece(k) },

      h('span', { class: 'pic' }, ic), h('span', { class: 'nm' }, nm), h('span', { class: 'pct num', style: `color:${col}` }, Math.round(pc.cond * 100) + '%'),

      h('span', { class: 'meter', html: `<i style="width:${Math.round(pc.cond * 100)}%;--c:${col}"></i>` }), h('span', { class: 'st' }, (k === worst ? 'fix first · ' : '') + (pc.fault ? REPAIR_FAULTS[pc.fault].name : st) + (pc.temporary ? ' · temporary' : '')));

    box.append(b);

  }

  const sq = $('#btnSquire'); if (sq) { sq.hidden = REP.squire <= 0; sq.textContent = `Squire, patch it for me (${REP.squire})`; }

}function renderDrawer() {

  const box = $('#drawer'); box.innerHTML = '';

  for (const k of ['gold', 'kevlar', 'pro', 'black', 'white', 'grey', 'duct', 'zip']) {

    const t = TAPES[k]; const onHaft = REP.piece === 'haft', left = tapeLeft(k);

    if ((k === 'pro' || k === 'kevlar' || k === 'gold') && left <= 0) continue; // premium rolls only show once you've bought some

    let lg = t.legal ? 'legal' : 'not legal', cls = t.legal ? 'ok' : 'no';

    if (onHaft && t.haft === 'warn') { lg = 'odd on a haft'; cls = 'warn'; }

    if (left !== Infinity) lg += left > 0 ? ` · ${left} left` : ' · empty';

    const b = h('button', { class: 'tapechip' + (t.legal ? '' : ' illegal') + (left <= 0 ? ' empty' : ''), 'aria-pressed': String(REP.roll === k), title: t.note, onclick: () => selectTape(k) },

      h('span', { class: 'roll', style: `--c:${t.color}` }), h('span', null, h('div', null, t.name.replace(' hockey tape', '').replace(' cloth tape', ' cloth')), h('div', { class: 'lg ' + cls }, lg)));

    box.append(b);

  }

}

function setSteps(s) { $('#repair').dataset.stage = s ? 'bench' : 'pick'; $$('#steps span').forEach(e => { const order = ['rip', 'wrap', 'smooth']; e.classList.toggle('on', e.dataset.s === s); e.classList.toggle('done', s && order.indexOf(e.dataset.s) < order.indexOf(s)); }); }



function selectPiece(k) {

  if (REP.step) { $('#benchMsg').textContent = 'Finish this strap first.'; return; }

  AU.click(); REP.piece = k; renderKitList(); renderDrawer();

  startTaping(REP.roll);

}

function selectTape(k) {

  if (REP.step) return;

  if (tapeLeft(k) <= 0) { // an empty roll: refill it right here if the purse allows

    const T = TAPE_STOCK[k];

    if (CAREER.purse >= T.refill && refillTape(k)) { REP.roll = k; renderDrawer(); const say = `Bought ${T.pack} more wraps of ${TAPES[k].name.toLowerCase()} for ${fmtMoney(T.refill)}.`; if (REP.piece) startTaping(k); $('#benchMsg').textContent = say + (REP.piece ? ' ' + $('#benchMsg').textContent : ' Now tap a strap.'); return; }

    else { $('#benchMsg').textContent = `That roll is empty. A refill costs ${fmtMoney(T.refill)}. Use another roll, or let your squire do it.`; AU.click(); return; }

  }

  AU.click(); REP.roll = k; renderDrawer();

  if (REP.piece) startTaping(k); else $('#benchMsg').textContent = `${TAPES[k].name} ready. Now tap a strap.`;

}

function startTaping(k) {

  const piece = REP.player.kit[REP.piece]; normalizeRepairPiece(piece, REP.piece);

  const fault = piece.fault || (REP.piece === 'haft' ? 'wrap' : piece.cond < 0.55 ? 'strap' : 'buckle');

  if (fault !== 'wrap') { startRepairTask(fault); return; }

  if (tapeLeft(k) <= 0) { const alt = ['black', 'grey', 'white', 'pro', 'kevlar'].find(x => tapeLeft(x) > 0); if (!alt) { $('#benchMsg').textContent = 'All your legal tape is used up. Refill in the Shop, or use your squire.'; return; } k = REP.roll = alt; renderDrawer(); }

  REP.tape = k; const t = TAPES[k]; const pc = REP.player.kit[REP.piece];

  if (t.instant) { // duct tape and zip ties: fast, strong, and they fail the kit check

    const before = pc.cond; AU.rip(1); pc.cond = Math.min(0.92, pc.cond + (k === 'duct' ? 0.55 : 0.42)); pc.tape = k; pc.failed = false; pc.covered = false;

    logTape(REP.piece, k, null); repPop(k === 'duct' ? 'SLAPPED ON' : 'ZIPPED', '#f08a3c');

    $('#benchMsg').textContent = `${t.name}: it holds, but ${t.note.split('. ')[0].toLowerCase()} (BR 2.1.5). The Technical Marshal noticed.`;

    pc.cond = Math.max(before, Math.min(pc.cond, 0.7)); pc.temporary = true; pc.fault = 'wrap'; persistPlayerKit(); finishPiece(); return;

  }

  $('#steps').innerHTML = '<span data-s="rip">1 Rip</span><span data-s="wrap">2 Wrap</span><span data-s="smooth">3 Smooth</span>';

  REP.step = 'rip'; REP.ripT = 0; REP.wraps = []; REP.sloppy = 0; REP.side = 0; REP.q = {}; REP.trail = []; setSteps('rip'); sizeBench();

  $('#benchMsg').textContent = IN.mode === 'pad' ? 'Rip: press A when the needle is in the gold.' : 'Rip: tap when the needle is in the gold.'; renderRepairActions();

  if (piece.work?.fault === 'wrap' && piece.work.proper === !!REP.proper && ['rip','wrap','smooth'].includes(piece.work.step)) { Object.assign(REP, {step:piece.work.step, wraps:piece.work.wraps || [], wrinkles:piece.work.wrinkles || [], q:piece.work.q || {}, side:piece.work.side || 0, sloppy:piece.work.sloppy || 0, tape:piece.work.tape || k}); setSteps(REP.step); $('#benchMsg').textContent = 'Continue your '+REP.step+' step. Completed work is saved.'; renderRepairActions(); }

}

// your squire tapes a strap for you: decent, not as good as doing it well yourself

function squirePatch() {

  if (!squireActive() || REP.squire <= 0 || REP.step) return;

  const k = REP.forcedPiece || (REP.piece && (REP.player.kit[REP.piece].failed || REP.player.kit[REP.piece].cond < 0.7) ? REP.piece : worstPiece()); if (!k) { $('#benchMsg').textContent = 'Nothing needs patching.'; return; }

  REP.squire--; REP.piece = k; REP.tape = 'black';

  const pc = REP.player.kit[k], q = 0.62; normalizeRepairPiece(pc, k);

  if (pc.fault === 'haft' && !squireBook().stock.hafts) { REP.squire++; $('#benchMsg').textContent = 'A snapped haft needs a spare haft.'; return; }

  if (pc.fault === 'haft') squireBook().stock.hafts--;

  pc.cond = Math.max(pc.cond, Math.min(0.7, pc.cond + 0.12 + 0.62 * q)); pc.tape = 'black'; pc.failed = false; pc.covered = false; pc.temporary = true; persistPlayerKit();

  logTape(k, 'black', q); AU.wrap(); AU.rip(0.6); repPop('SQUIRE DID IT', '#62c462');

  $('#benchMsg').textContent = `Your squire taped the ${PIECE_SHORT[k][0].toLowerCase()} strap: ${Math.round(pc.cond * 100)}%.`;

  finishPiece();

}

function finishPiece() {

  REP.step = null; setSteps(null); renderKitList(); applyTapeVisuals(REP.player);

  if (REP.piece === 'helmet' && !REP.player.kit.helmet.failed) rebuildHelmet(REP.player);

  renderRepairActions();

}

function rebuildHelmet(f) {

  if (!f.model || !W3.matchRoot) return;

  W3.matchRoot.remove(f.model.root); buildFighterModel(f); W3.matchRoot.add(f.model.root); f.model.root.visible = !f.out;

}

function logTape(piece, tape, q) {

  const where = REP.workshop ? 'Town workshop' : G.match ? `${G.match.stage}, after round ${G.match.round}` : 'practice';

  const entry = { piece: piece === 'haft' ? `${WEAPONS[REP.player.spec.weapon].name} haft wrap` : PIECE_NAMES[piece], tape: TAPES[tape].name, q, where };

  REP.log.push(entry); if (G.tourney) G.tourney.tapeLog.push(entry);

  ev('repair'); MT.tape = (MT.tape || 0) + 1;

}



function benchPos(e) { const r = $('#bench').getBoundingClientRect(); return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height }; }

// one set of bench handlers for finger, mouse and the controller cursor

function benchDown(p) {

  REP.ptr = p;

  if (REP.step === 'task') { repairTaskPointer(p, false); return; }

  if (REP.step === 'rip') { const n = ripNeedle(), d = Math.abs(n - 0.5); const q = d < 0.05 ? 1 : clamp(1 - (d - 0.05) / 0.4, 0, 1); REP.q.rip = q; AU.rip(0.5 + q * 0.6); REP.step = 'wrap'; setSteps('wrap'); REP.side = p.y < BAND.top ? -1 : p.y > BAND.bot ? 1 : 0; repPop(q >= 1 ? 'PERFECT RIP!' : q > 0.7 ? 'CLEAN' : q > 0.4 ? 'RAGGED' : 'FRAYED', q >= 1 ? '#f2c40f' : q > 0.4 ? '#ece8de' : '#ff5a4a'); $('#benchMsg').textContent = IN.mode === 'pad' ? 'Wrap: sweep the left stick up and down across the strap. Fill the red gaps.' : 'Wrap: swipe up and down across the strap. Fill the red gaps.'; rumble(0.2, 0.5, 90); saveWrapWork(); renderRepairActions(); }

}

function benchMove(p) {

  if (REP.step === 'task') { repairTaskPointer(p, true); return; }

  if (REP.step === 'wrap') {

    const s = p.y < BAND.top - 0.03 ? -1 : p.y > BAND.bot + 0.03 ? 1 : 0;

    if (s !== 0 && REP.side !== 0 && s !== REP.side) { REP.wraps.push({ x: p.x, skew: rand(-0.025, 0.025) }); AU.wrap(); rumble(0.05, 0.25, 40); if (p.x < ZONE.a - 0.04 || p.x > ZONE.b + 0.04) REP.sloppy++; checkWrap(); }

    if (s !== 0) REP.side = s; renderRepairActions();

  } else if (REP.step === 'smooth') {

    if (p.y > BAND.top - 0.1 && p.y < BAND.bot + 0.1) for (const w of REP.wrinkles) if (!w.gone && Math.abs(w.x - p.x) < 0.045) { w.gone = true; AU.wrap(); rumble(0.03, 0.2, 30); }

    if (REP.wrinkles.every(w => w.gone)) finishSmooth();

  }

  if (REP.step) { REP.trail.push({ x: p.x, y: p.y, t: 0.35 }); if (REP.trail.length > 24) REP.trail.shift(); }

  REP.ptr = p; saveWrapWork(); renderRepairActions();

}

function initBench() {

  const cv = $('#bench');

  cv.addEventListener('pointerdown', e => { AU.init(); try { cv.setPointerCapture(e.pointerId); } catch (er) { } benchDown(benchPos(e)); });

  cv.addEventListener('pointermove', e => {

    if (!REP.ptr && e.pointerType !== 'mouse') return; const down = e.buttons || e.pointerType !== 'mouse';

    if (down) benchMove(benchPos(e));

  });

  const up = () => { REP.ptr = null; }; cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);

}

function coverage() {

  const w = 0.07; const segs = REP.wraps.map(r => [r.x - w / 2, r.x + w / 2]).sort((a, b) => a[0] - b[0]);

  let cov = 0, cur = ZONE.a;

  for (const [a, b] of segs) { const s = Math.max(a, cur), e = Math.min(b, ZONE.b); if (e > s) { cov += e - s; cur = e; } }

  return cov / (ZONE.b - ZONE.a);

}

function checkWrap() {

  const c = coverage();

  if (c >= 0.97 || REP.wraps.length >= 11) {

    REP.q.wrap = clamp(c * (1 - 0.09 * REP.sloppy), 0, 1);

    REP.step = 'smooth'; setSteps('smooth'); REP.smoothT = 6;

    REP.wrinkles = Array.from({ length: 6 }, () => ({ x: rand(ZONE.a + 0.02, ZONE.b - 0.02), y: rand(BAND.top + 0.03, BAND.bot - 0.03), gone: false }));

    repPop(REP.q.wrap > 0.9 ? 'NICE WRAP' : 'WRAPPED', '#ece8de'); $('#benchMsg').textContent = IN.mode === 'pad' ? 'Smooth: run the cursor along the strap to pop the bubbles.' : 'Smooth: rub along the strap to pop the bubbles.';

  }

}

function finishSmooth() {

  if (REP.step !== 'smooth') return;

  REP.q.smooth = REP.wrinkles.filter(w => w.gone).length / REP.wrinkles.length;

  let q = 0.25 * (REP.q.rip || 0) + 0.5 * (REP.q.wrap || 0) + 0.25 * REP.q.smooth;

  repairFinish(q, REP.tape);

}

function ripNeedle() { return 0.5 + 0.5 * Math.sin(REP.ripT * 3.4); }



function updateRepair(dt) {

  if (!REP.active) return;

  if (!REP.untimed) REP.timer -= dt; $('#repTimer').textContent = REP.untimed ? 'Untimed' : fmtClock(REP.timer);

  const sec = Math.ceil(REP.timer); $('#repTimer').classList.toggle('low', !REP.untimed && REP.timer <= 10);

  if (sec !== REP.lastSec) { REP.lastSec = sec; if (sec <= 10 && sec > 0) AU.tone(sec <= 3 ? 1320 : 880, 0.06, 0.06, 'square'); }

  if (REP.pop) { REP.pop.t -= dt; if (REP.pop.t <= 0) REP.pop = null; }

  REP.trail.forEach(t => t.t -= dt); REP.trail = REP.trail.filter(t => t.t > 0);

  if (REP.step === 'rip' || REP.step === 'task') REP.ripT += dt;

  sizeBench(); drawBench();

  if (!REP.untimed && REP.timer <= 0) { $('#benchMsg').textContent = 'Time. The Technical Marshal calls it.'; closeRepair(); }

}

function closeRepair() {

  if (!REP.active) return;

  let unfixed = (REP.emergency || REP.requireSafeArmour) && REP.player && ['helmet', 'armL', 'armR', 'legs'].filter(k => REP.player.kit[k].failed);

  if (unfixed && unfixed.length && REP.timer > 0) {

    $('#benchMsg').textContent = `Repair ${unfixed.map(k => PIECE_SHORT[k][0].toLowerCase()).join(', ')} before returning to the list.`;

    return;

  }

  if (!REP.training) { if (REP.workshop) storeCareerKit(REP.player.kit, REP.player.spec.weapon); else persistPlayerKit(); }

  REP.step = null; REP.task = null; setSteps(null);

  if (REP.requireSafeArmour && REP.player) unfixed = ['helmet', 'armL', 'armR', 'legs'].filter(k => REP.player.kit[k].failed);

  REP.active = false;

  const cb = unfixed && unfixed.length ? (REP.onFail || REP.onDone) : REP.onDone;

  REP.onDone = REP.onFail = null;

  REP.workshop = false;

  if (cb) cb();

}



function drawBench() {

  const cv = $('#bench'); const x = cv.getContext('2d'); const W = cv.width, H = cv.height; const k = H / 300, t = G.realTime;

  const font = (px, f) => `${Math.round(px * k)}px ${f || '"Permanent Marker", cursive'}`;

  x.fillStyle = '#3b2c1f'; x.fillRect(0, 0, W, H);

  x.strokeStyle = 'rgba(0,0,0,.25)'; x.lineWidth = k; for (let i = 0; i < 18; i++) { const yy = i * H / 14; x.beginPath(); x.moveTo(0, yy + 6 * k); x.bezierCurveTo(W * 0.3, yy + 2 * k, W * 0.6, yy + 12 * k, W, yy + 5 * k); x.stroke(); }

  if (!REP.step) {

    x.fillStyle = 'rgba(236,232,222,.6)'; x.font = font(30); x.textAlign = 'center'; x.textBaseline = 'middle';

    x.fillText(REP.piece && !REP.pop ? 'tap another strap' : REP.pop ? '' : 'tap a strap above', W / 2, H / 2);

    drawPop(x, W, H, k); return;

  }

  if (REP.step === 'task' && REP.task) { drawRepairTask(x, W, H); drawPop(x, W, H, k); return; }

  const top = BAND.top * H, bot = BAND.bot * H;

  if (REP.piece === 'haft') {

    const g = x.createLinearGradient(0, top - 8 * k, 0, bot + 8 * k); g.addColorStop(0, '#5a3d24'); g.addColorStop(0.45, '#9a7048'); g.addColorStop(1, '#3d2816');

    x.fillStyle = g; x.fillRect(0, top - 8 * k, W, bot - top + 16 * k);

  } else {

    const g = x.createLinearGradient(0, 0, 0, H); g.addColorStop(0, '#5c6468'); g.addColorStop(0.3, '#c9d0d3'); g.addColorStop(0.5, '#8d969a'); g.addColorStop(0.75, '#d2d8da'); g.addColorStop(1, '#5c6468');

    x.fillStyle = g; x.beginPath(); x.ellipse(W / 2, H / 2, W * 0.46, H * 0.44, 0, 0, TAU); x.fill();

    x.fillStyle = '#5e3a21'; x.fillRect(0, top, W, bot - top);

    x.strokeStyle = 'rgba(230,210,180,.45)'; x.setLineDash([8 * k, 7 * k]); x.lineWidth = 2 * k; x.beginPath(); x.moveTo(0, top + 6 * k); x.lineTo(W, top + 6 * k); x.moveTo(0, bot - 6 * k); x.lineTo(W, bot - 6 * k); x.stroke(); x.setLineDash([]);

    x.strokeStyle = '#b8913f'; x.lineWidth = 6 * k; x.strokeRect(W * 0.84, top - 12 * k, W * 0.07, bot - top + 24 * k);

  }

  // the tear

  x.strokeStyle = 'rgba(15,10,6,.9)'; x.lineWidth = 3 * k; x.beginPath(); x.moveTo(W * 0.5, top); for (let i = 1; i <= 6; i++) x.lineTo(W * (0.5 + (i % 2 ? 0.015 : -0.012)), top + (bot - top) * i / 6); x.stroke();

  // wrap: the gaps still to cover glow red

  if (REP.step === 'wrap') {

    const w = 0.07, segs = REP.wraps.map(r => [r.x - w / 2, r.x + w / 2]).sort((a, b) => a[0] - b[0]); let cur = ZONE.a; const gaps = [];

    for (const [a, b] of segs) { if (a > cur) gaps.push([cur, Math.min(a, ZONE.b)]); cur = Math.max(cur, b); if (cur >= ZONE.b) break; } if (cur < ZONE.b) gaps.push([cur, ZONE.b]);

    x.fillStyle = `rgba(255,70,60,${0.28 + 0.14 * Math.sin(t * 6)})`; for (const [a, b] of gaps) if (b > a) x.fillRect(a * W, top - 14 * k, (b - a) * W, bot - top + 28 * k);

    if (gaps.length) { // a bouncing up-down arrow over the first gap shows the swipe

      const gx = ((gaps[0][0] + gaps[0][1]) / 2) * W, bob = Math.sin(t * 5) * 22 * k, cy = (top + bot) / 2 + bob;

      x.strokeStyle = 'rgba(255,255,255,.9)'; x.lineWidth = 4 * k; x.lineCap = 'round'; x.beginPath(); x.moveTo(gx, cy - 34 * k); x.lineTo(gx, cy + 34 * k);

      x.moveTo(gx - 10 * k, cy - 24 * k); x.lineTo(gx, cy - 34 * k); x.lineTo(gx + 10 * k, cy - 24 * k); x.moveTo(gx - 10 * k, cy + 24 * k); x.lineTo(gx, cy + 34 * k); x.lineTo(gx + 10 * k, cy + 24 * k); x.stroke(); x.lineCap = 'butt';

    }

  } else { x.strokeStyle = 'rgba(242,196,15,.7)'; x.setLineDash([6 * k, 6 * k]); x.lineWidth = 2 * k; x.strokeRect(W * ZONE.a, top - 16 * k, W * (ZONE.b - ZONE.a), bot - top + 32 * k); x.setLineDash([]); }

  // wraps laid so far

  const col = REP.tape ? TAPES[REP.tape].color : '#18191a';

  for (const w of REP.wraps) {

    const cx = w.x * W, hw = W * 0.035;

    x.fillStyle = col; x.beginPath(); x.moveTo(cx - hw + w.skew * W, top - 10 * k); x.lineTo(cx + hw + w.skew * W, top - 10 * k); x.lineTo(cx + hw - w.skew * W, bot + 10 * k); x.lineTo(cx - hw - w.skew * W, bot + 10 * k); x.closePath(); x.fill();

    x.strokeStyle = 'rgba(255,255,255,.1)'; x.lineWidth = k; for (let j = 0; j < 5; j++) { x.beginPath(); x.moveTo(cx - hw + j * hw / 2.5, top - 10 * k); x.lineTo(cx - hw + j * hw / 2.5, bot + 10 * k); x.stroke(); }

  }

  if (REP.step === 'smooth') for (const w of REP.wrinkles) {

    if (w.gone) continue; const r = (10 + 2 * Math.sin(t * 7 + w.x * 20)) * k;

    x.fillStyle = 'rgba(255,255,255,.45)'; x.beginPath(); x.ellipse(w.x * W, w.y * H, r * 1.6, r, 0.3, 0, TAU); x.fill(); x.strokeStyle = 'rgba(0,0,0,.55)'; x.lineWidth = 1.5 * k; x.stroke();

    x.fillStyle = 'rgba(255,255,255,.9)'; x.beginPath(); x.arc(w.x * W - r * 0.5, w.y * H - r * 0.3, r * 0.25, 0, TAU); x.fill();

  }

  if (REP.step === 'rip') {

    const gx = W * 0.12, gw = W * 0.76, gy = H * 0.07, gh = 34 * k;

    x.fillStyle = 'rgba(10,13,15,.88)'; x.fillRect(gx - 10 * k, gy - 10 * k, gw + 20 * k, gh + 20 * k);

    x.fillStyle = '#2a3136'; x.fillRect(gx, gy, gw, gh);

    x.fillStyle = 'rgba(236,232,222,.85)'; x.fillRect(gx + gw * 0.3, gy, gw * 0.4, gh);

    x.fillStyle = '#f2c40f'; x.fillRect(gx + gw * 0.45, gy, gw * 0.1, gh);

    const n = ripNeedle(); x.fillStyle = '#ff3d8b'; x.fillRect(gx + gw * n - 4 * k, gy - 8 * k, 8 * k, gh + 16 * k);

    x.fillStyle = col; x.fillRect(W * 0.08, H * 0.7, W * 0.84, 34 * k);

    x.fillStyle = 'rgba(236,232,222,.92)'; x.font = font(26); x.textAlign = 'center'; x.textBaseline = 'alphabetic'; x.fillText(IN.mode === 'pad' ? 'press A in the gold' : 'tap in the gold', W / 2, H * 0.94);

  }

  // finger trail

  for (const p of REP.trail) { x.fillStyle = `rgba(255,255,255,${p.t * 0.9})`; x.beginPath(); x.arc(p.x * W, p.y * H, 6 * k * (p.t / 0.35), 0, TAU); x.fill(); }

  if (IN.mode === 'pad' && REP.step) { const cx = PAD.cursor.x * W, cy = PAD.cursor.y * H; x.strokeStyle = '#f2c40f'; x.lineWidth = 3 * k; x.beginPath(); x.arc(cx, cy, 13 * k, 0, TAU); x.moveTo(cx - 20 * k, cy); x.lineTo(cx - 6 * k, cy); x.moveTo(cx + 6 * k, cy); x.lineTo(cx + 20 * k, cy); x.moveTo(cx, cy - 20 * k); x.lineTo(cx, cy - 6 * k); x.moveTo(cx, cy + 6 * k); x.lineTo(cx, cy + 20 * k); x.stroke(); }

  if (REP.step === 'wrap') { // progress bar along the top

    const c = coverage(); x.fillStyle = 'rgba(10,13,15,.8)'; x.fillRect(W * 0.25, H * 0.06, W * 0.5, 22 * k); x.fillStyle = c > 0.96 ? '#62c462' : '#ece8de'; x.fillRect(W * 0.25 + 3 * k, H * 0.06 + 3 * k, (W * 0.5 - 6 * k) * c, 16 * k);

    x.fillStyle = '#ece8de'; x.font = font(18); x.textAlign = 'center'; x.textBaseline = 'alphabetic'; x.fillText(`covered ${Math.round(c * 100)}%`, W / 2, H * 0.06 + 44 * k);

  }

  if (REP.step === 'smooth') { const left = REP.wrinkles.filter(w => !w.gone).length; x.fillStyle = '#ece8de'; x.font = font(20); x.textAlign = 'center'; x.textBaseline = 'alphabetic'; x.fillText(`${left} bubble${left === 1 ? '' : 's'} left · ${Math.ceil(REP.smoothT)}s`, W / 2, H * 0.14); }

  drawPop(x, W, H, k);

}

function drawPop(x, W, H, k) {

  const P = REP.pop; if (!P) return;

  const a = Math.min(1, P.t / 0.4), s = 1 + (1.4 - P.t) * 0.15;

  x.save(); x.globalAlpha = a; x.translate(W / 2, H * 0.5); x.scale(s, s); x.rotate(-0.05);

  x.font = `${Math.round(54 * k)}px "Big Shoulders Display", Impact, sans-serif`; x.textAlign = 'center'; x.textBaseline = 'middle';

  x.lineWidth = 8 * k; x.strokeStyle = 'rgba(10,13,15,.9)'; x.strokeText(P.text, 0, 0); x.fillStyle = P.col; x.fillText(P.text, 0, 0); x.restore();

}
// ---------- your fighter & career: profile, purse, kit upgrades, achievements, lifetime stats ----------
const CAREER_DEFAULT = () => ({
  name: 'You', num: 4,
  club: { name: 'Reavers', short: 'RVR', tabard: '#6d1b28', trim: '#e8e1cf', charge: 'chevron' },
  purse: 150, upgrades: { harness: 0, padding: 0, boots: 0, gauntlets: 0, cardio: 0 }, ach: {},
  stats: { matches: 0, wins: 0, takedowns: 0, trips: 0, hits: 0, bigHits: 0, blocks: 0, throws: 0, disarms: 0, tackles: 0, repairs: 0, views: 0, earned: 0, rumbleWins: 0 },
  ladder: { rung: 0 }, trained: false
});
const CAREER = (() => { const d = CAREER_DEFAULT(), s = store.get('career', null); if (!s) return d; return { ...d, ...s, club: { ...d.club, ...(s.club || {}) }, upgrades: { ...d.upgrades, ...(s.upgrades || {}) }, stats: { ...d.stats, ...(s.stats || {}) }, ladder: { ...d.ladder, ...(s.ladder || {}) }, ach: s.ach || {} }; })();
CAREER.level = clamp(Math.floor(Number(CAREER.level) || 1), 1, 100);
if (CAREER.level === 100) CAREER.xp = 0;
function saveCareer() {
  if (typeof testAdminApply === 'function' && typeof BOS !== 'undefined' && BOS.testAdmin) testAdminApply(false);
  store.set('career', CAREER);
}

const UPGRADES = [
  { key: 'harness', name: 'Spring-steel harness', desc: 'Lighter plates. +3% speed per level.' },
  { key: 'boots', name: 'Grippy boots', desc: 'Better footing. +3.5% balance per level.' },
  { key: 'padding', name: 'Thicker gambeson', desc: 'Soaks blows. Hits on you push 5% less per level.' },
  { key: 'gauntlets', name: 'Riveted gauntlets', desc: 'Hold on tight: 25% fewer disarms per level, better throws.' },
  { key: 'cardio', name: 'Cardio block', desc: 'Summer training. +10% stamina recovery per level.' },
];
const UP_COST = [120, 240, 400, 650, 1000, 1500, 2200, 3100, 4300, 6000];
const TABARDS = ['#6d1b28', '#1c3454', '#2a3d26', '#3d2a4f', '#5b4a2a', '#111214', '#1f4a4a', '#7a4a12', '#8a8f92', '#b8241f'];
const TRIMS = ['#e8e1cf', '#d4b44a', '#d8dde2', '#f0c27a', '#ff3d8b', '#7fb6ff', '#111214'];
const CHARGES = [['chevron', 'Chevron'], ['pale', 'Pale'], ['bend', 'Bend'], ['cross', 'Cross'], ['saltire', 'Saltire'], ['chief', 'Chief'], ['quarterly', 'Quarterly']];

const ACH = [
  { id: 'writ1', name: 'Through the gate', desc: 'Beat Sergeant Brask and earn the Bailey writ.' },
  { id: 'writ2', name: 'Seen at court', desc: 'Beat the King’s Guard and earn the Royal writ.' },
  { id: 'explorer', name: 'Explorer', desc: 'Find all six hidden places in the realm.' },
  { id: 'rider', name: 'Saddled up', desc: 'Ride a horse across the realm.' },
  { id: 'spectator', name: 'From the stands', desc: 'Watch a full bout at any arena.' },
  { id: 'crowned', name: 'Crowned', desc: 'Take the King’s or the Queen’s seat in the Great Hall.' },
  { id: 'season', name: 'Prairie Cup', desc: 'Top the league table at the end of a summer season.' },
  { id: 'streak3', name: 'Regular', desc: 'Win the Rumble of the Day three days running.' },
  { id: 'gauntlet', name: 'Ran the gauntlet', desc: 'Win all five fights of a Gauntlet run.' },
  { id: 'perfect5', name: 'Wall of steel', desc: 'Five perfect blocks in one match.' },
  { id: 'first', name: 'First one down', desc: 'Take an opponent to the floor.' },
  { id: 'hat', name: 'Hat trick', desc: 'Three takedowns in one match.' },
  { id: 'combo', name: 'Shove, then trip', desc: 'Take someone down with a trip right after a shove.' },
  { id: 'trips', name: 'Ankle collector', desc: '10 successful trips.' },
  { id: 'wall', name: 'Wall of steel', desc: 'Block 25 blows.' },
  { id: 'throws', name: 'Clinch king', desc: 'Throw 3 people from the clinch.' },
  { id: 'disarm', name: 'Mine now', desc: 'Disarm an opponent.' },
  { id: 'big', name: 'Heavy hitter', desc: 'Land a big hit.' },
  { id: 'tackle', name: 'Freight train', desc: 'Take someone down with a tackle.' },
  { id: 'grad', name: 'Graduate', desc: 'Finish every lesson in the Training Yard.' },
  { id: 'champ', name: 'Rumble champion', desc: 'Win the Red Deer Rumble.' },
  { id: 'clean', name: 'Clean fighter', desc: 'Win the Rumble without a single card.' },
  { id: 'ladder', name: 'Top of the ladder', desc: 'Beat the Duel Ladder champion.' },
  { id: 'massacre', name: 'Last one standing', desc: 'Win a 12v12 Massacre round while still on your feet.' },
  { id: 'pan', name: 'Kitchen duty', desc: 'Take someone down with the frying pan.' },
  { id: 'chicken', name: 'Fowl play', desc: 'Win a match with the rubber chicken.' },
  { id: 'fantasy', name: 'Storybook', desc: 'Win a match with a fantasy weapon.' },
  { id: 'taped', name: 'Gear bag', desc: 'Repair 10 straps.' },
  { id: 'shopper', name: 'Garage forge', desc: 'Buy a kit upgrade.' },
  { id: 'hopper', name: 'Camera operator', desc: 'Switch between first and third person 10 times.' },
];
function unlock(id, force) {
  if (CAREER.ach[id] || (!force && (G.autopilot || G.attract))) return;
  const a = ACH.find(x => x.id === id); if (!a) return;
  CAREER.ach[id] = Date.now(); skillsState();
  saveCareer();
  if (a.tier) { const xp = 60 * a.tier * a.tier, cash = 50 * a.tier; ACHQ.push({ ...a, kicker: `Award, tier ${['I', 'II', 'III', 'IV', 'V'][a.tier - 1]} · +${xp} XP, +$${cash}${a.tier === 5 ? ', +1 skill point' : ''}` }); gainXP(xp); pay(cash); }
  else ACHQ.push(a);
  if (!ACHQ.busy) showAch(); if (typeof progressSoon === 'function') progressSoon();
}
const ACHQ = [];
function showAch() {
  const a = ACHQ.shift(); const el = $('#achPop'); if (!a) { ACHQ.busy = false; el.classList.remove('on'); return; }
  ACHQ.busy = true; el.innerHTML = ''; el.append(h('span', { class: 'k' }, a.kicker || 'Achievement, +1 skill point'), h('b', null, a.name), h('small', null, a.desc));
  el.classList.add('on'); AU.click(); setTimeout(() => { el.classList.remove('on'); setTimeout(showAch, 350); }, 2800);
}
// per-match tallies feed the achievements and the purse
const MT = { takedowns: 0 };
function resetMatchTally() { MT.takedowns = 0; MT.xp = 0; MT.zones = []; MT.tape = 0; MT.firstDownT = null; MT.brokenRecords = []; }

// one bus for every notable thing you do: the tutorial, achievements and lifetime stats all listen here
const EV_LISTENERS = [];
function ev(type, d = {}) {
  if (G.autopilot || G.attract) return;
  const S = CAREER.stats;
  switch (type) {
    case 'hit': if (!d.blocked) { S.hits++; if (d.big) { S.bigHits++; unlock('big'); } } break;
    case 'block': S.blocks++; if (S.blocks >= 25) unlock('wall'); break;
    case 'trip': if (d.ok) { S.trips++; if (S.trips >= 10) unlock('trips'); } break;
    case 'throw': S.throws++; if (S.throws >= 3) unlock('throws'); break;
    case 'disarm': S.disarms++; unlock('disarm'); break;
    case 'tackle': S.tackles++; break;
    case 'takedown':
      S.takedowns++; MT.takedowns++; unlock('first'); if (MT.takedowns >= 3) unlock('hat');
      if (d.combo) unlock('combo'); if (d.how === 'tackle') unlock('tackle'); if (d.weapon === 'x_pan') unlock('pan');
      break;
    case 'view': S.views++; if (S.views >= 10) unlock('hopper'); break;
    case 'repair': S.repairs++; if (S.repairs >= 10) unlock('taped'); break;
  }
  for (const fn of EV_LISTENERS) { try { fn(type, d); } catch (e) { G.stats.errors.push(String(e)); } }
  if (type !== 'hit' && type !== 'miss') saveCareer();
}

function pay(amount, why) { if (amount <= 0) return 0; CAREER.purse += amount; CAREER.stats.earned += amount; saveCareer(); return amount; }
function fmtMoney(n) { return '$' + Math.round(n).toLocaleString('en-CA'); }

// your club's name, colours and charge, and your number, go on the Reavers' kit
function applyProfile() {
  const C = CLUBS.reavers, P = CAREER.club;
  C.name = C.full = P.name || 'Reavers'; C.short = (P.short || C.name.slice(0, 3)).toUpperCase().slice(0, 3); C.tabard = P.tabard; C.trim = P.trim; C.charge = P.charge;
  C.roster[0].dispNum = CAREER.num; C.bos = P.bos || null;
  if (typeof ROSTER !== 'undefined' && !ROSTER.teams.some(t => t.slug === C.bos)) C.bos = null; // No imported bot identity; preserve the player's own banner.
  delete _tabardCache.reavers; delete _shieldCache.reavers;
  if (FP.vm) { FP.vm.team = null; }
  updateTitlePurse();
}
function updateTitlePurse() {
  const el = $('#titleStats'); if (!el) return;
  const n = Object.keys(CAREER.ach).length;
  skillsState();
  el.innerHTML = ''; el.append(h('span', { class: 'cnum' }, String(CAREER.num)), h('span', null, h('b', null, `${CAREER.name === 'You' ? 'Your fighter' : CAREER.name}${shopState().title ? ' ' + shopState().title : ''}, level ${CAREER.level}`), h('br'), h('span', { class: 'crank' }, rankOf(CAREER.level)), h('br'), `${CAREER.club.name}, `, h('span', { class: 'cpurse' }, fmtMoney(CAREER.purse)), `, ${n} of ${ACH.length} achievements`), CAREER.sp > 0 ? h('span', { class: 'spbadge' }, `${CAREER.sp} skill point${CAREER.sp === 1 ? '' : 's'}`) : null);
}

// ---- the Your fighter screen ----
function shieldPreview(club, size = 96) {
  const c = cvs(size, size * 1.15), x = c.getContext('2d');
  x.save(); x.beginPath(); x.moveTo(4, 4); x.lineTo(size - 4, 4); x.lineTo(size - 4, size * 0.55); x.quadraticCurveTo(size - 6, size * 0.95, size / 2, size * 1.12); x.quadraticCurveTo(6, size * 0.95, 4, size * 0.55); x.closePath(); x.clip();
  x.fillStyle = club.tabard; x.fillRect(0, 0, size, size * 1.2); drawCharge(x, club, size / 2, size * 0.5, size * 0.8, size * 0.8); x.restore();
  x.strokeStyle = '#aab4b8'; x.lineWidth = 3; x.beginPath(); x.moveTo(4, 4); x.lineTo(size - 4, 4); x.lineTo(size - 4, size * 0.55); x.quadraticCurveTo(size - 6, size * 0.95, size / 2, size * 1.12); x.quadraticCurveTo(6, size * 0.95, 4, size * 0.55); x.closePath(); x.stroke();
  return c;
}
function renderCareer() {
  const box = $('#careerBody'), section = () => (G.careerTab || 'profile') + ':' + !!G.appearanceEditor;
  const reset = G.screen !== 'career' || box.dataset.menuSection !== section();
  const result = redrawMenu(box, renderCareerBody, { reset }); box.dataset.menuSection = section(); return result;
}
function renderCareerBody() {
  const P = CAREER.club, box = $('#careerBody'); box.innerHTML = '';
  if (['forge', 'forge-gone'].includes(G.careerTab)) G.careerTab = 'shop'; if (G.careerTab === '__oldach') G.careerTab = 'ach'; // the Forge lives at the blacksmith now
  const tab = G.careerTab || 'profile';
  $$('#careerTabs [data-tab]').forEach(x => x.setAttribute('aria-pressed', String(x.dataset.tab === tab)));
  if (['progress', 'ach', 'record'].includes(tab)) {
    box.append(h('div', { class: 'seg', role: 'tablist', 'aria-label': 'Progress sections' }, ...[['progress', 'Progress'], ['ach', 'Achievements'], ['record', 'Record']].map(([key, name]) => h('button', { role: 'tab', 'aria-pressed': String(tab === key), onclick: () => { G.careerTab = key; renderCareer(); } }, name))));
    const parent = $('#careerTabs [data-tab="progress"]'); if (parent) parent.setAttribute('aria-pressed', 'true');
  }
  if (G.appearanceEditor && tab === 'profile') {
    box.append(h('button', { class: 'btn tape small', 'data-back': '', onclick: () => { G.appearanceEditor = false; renderCareer(); } }, 'Back to Profile'));
    const editor = h('div', { class: 'appearance-editor' }); box.append(editor); renderVendor(editor, 'barber', renderCareer); return;
  }
  if (tab === 'skills') { renderSkills(box); return; }
  if (tab === 'profile') {
    const field = (label, input) => h('label', { class: 'fld' }, h('span', { class: 'label' }, label), input);
    const nameIn = h('input', { type: 'text', maxlength: '16', value: CAREER.name === 'You' ? '' : CAREER.name, placeholder: 'Your name', autocomplete: 'off' });
    nameIn.oninput = () => { CAREER.name = nameIn.value.trim() || 'You'; saveCareer(); updateTitlePurse(); };
    const numIn = h('input', { type: 'number', min: '1', max: '99', value: String(CAREER.num), inputmode: 'numeric' });
    numIn.oninput = () => { const v = clamp(parseInt(numIn.value || '4', 10) || 4, 1, 99); CAREER.num = v; saveCareer(); applyProfile(); prev(); };
    const clubIn = h('input', { type: 'text', maxlength: '22', value: P.name, placeholder: 'Club name', autocomplete: 'off' });
    clubIn.oninput = () => { P.name = clubIn.value.trim() || 'Reavers'; saveCareer(); applyProfile(); prev(); };
    const shortIn = h('input', { type: 'text', maxlength: '3', value: P.short, placeholder: 'RVR', style: 'text-transform:uppercase', autocomplete: 'off' });
    shortIn.oninput = () => { P.short = shortIn.value.trim().toUpperCase() || P.name.slice(0, 3).toUpperCase(); saveCareer(); applyProfile(); prev(); };
    const pv = h('div', { class: 'shieldpv' });
    const prev = () => { pv.innerHTML = ''; pv.append(shieldPreview(P, 92), h('b', null, P.name), h('span', { class: 'muted' }, `${P.short} · number ${CAREER.num}`)); };
    const sw = (list, key) => { const row = h('div', { class: 'swatches' }); for (const c of list) row.append(h('button', { class: 'sw', style: `--c:${c}`, 'aria-pressed': String(P[key] === c), 'aria-label': c, onclick: () => { P[key] = c; saveCareer(); applyProfile(); renderCareer(); AU.click(); } })); return row; };
    const chg = h('div', { class: 'seg small' }); for (const [v, t] of CHARGES) chg.append(h('button', { 'aria-pressed': String(P.charge === v), onclick: () => { P.charge = v; saveCareer(); applyProfile(); renderCareer(); AU.click(); } }, t));
    const teamRow = h('div', { class: 'up vcard vwide' }, h('div', null, h('b', null, P.bos ? `Team: ${P.name}` : 'Not on a team'), h('div', { class: 'muted small' }, P.bos ? 'Your BuhurtOS team. Your real team-mates fill the roster.' : 'Fighting under your own banner.')), h('button', { class: 'btn tape small', onclick: () => { AU.click(); G.creatorReturn = () => { renderCareer(); showScreen('career'); }; CAREER.teamPicked = false; saveCareer(); openCreator(); } }, 'Change team'));
    box.append(teamRow);
    box.append(h('div', { class: 'up vcard vwide' }, h('div', null, h('b', null, 'Appearance'), h('div', { class: 'muted small' }, 'Change your body style, height, build, skin, hair, facial hair and eyes.')), h('button', { class: 'btn primary flagtape small', onclick: () => { AU.click(); G.appearanceEditor = true; renderCareer(); } }, 'Edit fighter')));
    box.append(h('div', { class: 'profgrid' },
      h('div', { class: 'stack' }, h('div', { class: 'row fields' }, field('Fighter name', nameIn), field('Number', numIn)), h('div', { class: 'row fields' }, field('Club', clubIn), field('Short name', shortIn)),
        h('span', { class: 'label' }, 'Tabard'), sw(TABARDS, 'tabard'), h('span', { class: 'label' }, 'Trim'), sw(TRIMS, 'trim'), h('span', { class: 'label' }, 'Charge'), chg),
      pv));
    prev();
  } else if (tab === 'shop') { renderShop(box);
  } else if (tab === 'inv') { renderInventory(box);
  } else if (tab === 'trades') { renderTrades(box);
  } else if (tab === 'progress') { renderProgress(box);
  } else if (tab === 'ach') { renderAwards(box); } else {
    const S = CAREER.stats;
    const rows = [['Matches', S.matches], ['Wins', S.wins], ['Takedowns', S.takedowns], ['Successful trips', S.trips], ['Throws', S.throws], ['Disarms', S.disarms], ['Tackles', S.tackles], ['Hits landed', S.hits], ['Big hits', S.bigHits], ['Blocks', S.blocks], ['Straps repaired', S.repairs], ['Rumble titles', S.rumbleWins], ['Duel Ladder', `${CAREER.ladder.rung} of ${LADDER.length}`], ['Prize money earned', fmtMoney(S.earned)]];
    const RC = CAREER.records || {}; rows.push(['Best win streak', RC.streak || 0], ['Most takedowns in a match', RC.tdMatch || 0], ['Most helmet hits in a match', RC.heads || 0], ['Most duel points in a round', RC.duelPts || 0], ['Fastest takedown', RC.fastTd != null ? RC.fastTd + ' s' : '–']);
    box.append(h('div', { class: 'statgrid', html: rows.map(([k, v]) => `<span>${k}</span><b class="num">${v}</b>`).join('') }));
    box.append(h('div', { class: 'row end' }, h('button', { class: 'btn tape small quiet', onclick: () => { if (!confirmReset.armed) { confirmReset.armed = true; setTimeout(() => confirmReset.armed = false, 3000); toastMenu('Press again to wipe your career'); return; } Object.assign(CAREER, CAREER_DEFAULT()); saveCareer(); applyProfile(); renderCareer(); } }, 'Reset career')));
  }
}
const confirmReset = { armed: false };
function toastMenu(text) { const el = $('#achPop'); el.innerHTML = ''; el.append(h('b', null, text)); el.classList.add('on'); setTimeout(() => el.classList.remove('on'), 2200); }
function openCareer(tab) { const restore=!tab&&G.careerLastTab===G.careerTab?G.careerViewRestore:null; G.appearanceEditor=false; G.backTo='title'; skillsState(); G.careerTab=tab||G.careerTab||(CAREER.sp>0?'skills':'profile'); renderCareer(); showScreen('career'); if(restore)restore(); }

// prize money and match achievements at full time
function careerMatchEnd(m, won) {
  if (typeof eventMatch === 'function') eventMatch(m, won);
  if (G.autopilot || G.attract || m.training) return null;
  const S = CAREER.stats; S.matches++; if (won) S.wins++;
  if (m.category === 'youth') { sticker('unicorn'); if (won) sticker('star'); }
  // personal bests
  const R = CAREER.records || (CAREER.records = {}), brk = [];
  const best = (k, v, label, low) => { if (v == null || v <= 0) return; if (R[k] == null || (low ? v < R[k] : v > R[k])) { if (R[k] != null) brk.push(label); R[k] = v; } };
  R.streak = won ? (R.streakNow = (R.streakNow || 0) + 1) && Math.max(R.streak || 0, R.streakNow) : (R.streakNow = 0, R.streak || 0);
  best('tdMatch', MT.takedowns, 'Most takedowns in a match');
  if (m.duel) best('duelPts', Math.max(...m.results.map(r => r.a || 0), 0), 'Most duel points in a round');
  best('heads', (MT.zones || []).filter(z => z === 'helmet').length, 'Most helmet hits in a match');
  if (MT.firstDownT != null) best('fastTd', Math.round(MT.firstDownT * 10) / 10, 'Fastest takedown', true);
  MT.brokenRecords = brk;
  // A first win buys an entry cosmetic after a few fights; a loss still pays enough to progress.
  const base = { 1: 100, 2: 130, 3: 160, 5: 180, 12: 250 }[m.mode] || 160;
  let money = won ? base : Math.round(base * 0.45), lines = [`${won ? 'Win' : 'Appearance'} ${fmtMoney(money)}`];
  gainXP(65 + (won ? 135 : 0) + 35 * m.wins[0] + (m.ladder != null && won ? 100 : 0));
  const tb = MT.takedowns * 15; if (tb) { money += tb; lines.push(`${MT.takedowns} takedown${MT.takedowns === 1 ? '' : 's'} ${fmtMoney(tb)}`); }
  if (m.ladder != null && won) { const lb = 50 * (m.ladder + 1); money += lb; lines.push(`Ladder rung ${m.ladder + 1} ${fmtMoney(lb)}`); }
  const p = G.player, w = p && p.spec ? WEAPONS[p.spec.weapon] : null;
  if (won && w && w.key === 'x_chicken') unlock('chicken');
  if (won && w && w.fantasy && !w.specialSet) unlock('fantasy');
  const pb = (CAREER.skills && CAREER.skills['show.purse']) || 0; if (pb) { const extra = Math.round(money * 0.12 * pb); money += extra; lines.push(`Crowd pleaser ${fmtMoney(extra)}`); }
  const sm = shopPrizeMult(); if (sm > 1) { const extra = Math.round(money * (sm - 1)); if (extra) { money += extra; lines.push(`Shop bonuses ${fmtMoney(extra)}`); } }
  const inc = sponsorIncome(); if (inc) { money += inc; lines.push(`Sponsors ${fmtMoney(inc)}`); }
  shopMatchEnd();
  if (MT.xp) lines.push(`+${MT.xp} XP`);
  if (CAREER.sp > 0) lines.push(`Level ${CAREER.level}, ${CAREER.sp} skill point${CAREER.sp === 1 ? '' : 's'} to spend`);
  pay(money, 'match'); saveCareer(); updateTitlePurse();
  progressMatch(m, won);
  return { money, lines };
}
// ---------- Training Yard: a pell, a sparring partner, and one lesson per button ----------
const TR = { on: false, i: 0, n: 0, set: new Set(), doneT: -1, ring: null, lastYaw: 0, yawAcc: 0 };
const T_TXT = (touch, kb, pad) => ({ touch, kb, pad });
const LESSONS = [
  { id: 'move', title: 'Move', need: 1, text: T_TXT('Drag on the left side of the screen to walk into the yellow ring. Push forward past the stick ring to run.', 'Walk into the yellow ring with W A S D. Hold Shift to run.', 'Walk into the yellow ring with the left stick. Push it all the way forward, or click L3, to run.'),
    setup() { place(0, 'still', -6, -9, 8); place(1, 'still', 6, -9, 8); const p = G.player, fw = fwd(FP.yaw); TR.target = { x: clamp(p.pos.x + fw.x * 5 + 1.2, -7, 7), z: clamp(p.pos.z + fw.z * 5, -10, 10) }; },
    tick() { const p = G.player, t = TR.target; if (!t) return 0; return Math.hypot(p.pos.x - t.x, p.pos.z - t.z) < 1.0 ? 1 : 0; } },
  { id: 'look', title: 'Look around', need: 1, text: T_TXT('Drag on the right side of the screen to look around. Take a full look round the list.', 'Move the mouse to look around (click the game first so it can grab the mouse). Take a full look round.', 'Use the right stick to look around. Take a full look round.'),
    setup() { TR.yawAcc = 0; TR.lastYaw = FP.yaw; }, tick() { TR.yawAcc += Math.abs(angDiff(TR.lastYaw, FP.yaw)); TR.lastYaw = FP.yaw; return TR.yawAcc > 5 ? 1 : 0; } },
  { id: 'view', title: 'Two cameras', need: 2, text: T_TXT('Tap 1P / 3P at the top right to switch to third person, then switch back. You can do this any time, even mid-fight.', 'Press V (or click 1P / 3P at the top right) to switch to third person, then back.', 'Tap the View button to switch to third person, then back.'),
    on: t => t === 'view' },
  { id: 'swing', title: 'Swing', need: 3, text: T_TXT('Walk up to the pell (yellow marker). Hold SWING to wind up, let go to strike. Land 3 hits. Hold longer for a heavier blow.', 'Walk up to the pell (yellow marker). Hold the left mouse button to wind up, release to strike. Land 3 hits.', 'Walk up to the pell (yellow marker). Hold RT to wind up, release to strike. Land 3 hits.'),
    setup() { place(0, 'still', 0, 0, 8, 2.2); place(1, 'still', 7, -10, 8); }, on: (t, d) => t === 'hit' && !d.blocked },
  { id: 'arcs', title: 'Pick your arc', need: 3, text: T_TXT('While holding SWING, swipe left, right, or up (overhead) before you let go. Land one of each.', 'While holding the mouse button, drag left, right or up (overhead) before you release. Land one of each.', 'While holding RT, push the right stick left, right or up (overhead). Land one of each.'),
    setup() { TR.set = new Set(); place(0, 'still', 0, 0, 8, 2.0); }, on: (t, d) => { if (t !== 'hit' || d.blocked || TR.set.has(d.arc)) return false; TR.set.add(d.arc); return true; } },
  { id: 'aim', title: 'Aim for the helmet', need: 2, text: T_TXT('You hit where you look. Look up at the pell’s helmet and strike: two helmet hits. In duels the head is worth 3.', 'You hit where you look. Raise the mouse to aim at the pell’s helmet and strike: two helmet hits. In duels the head is worth 3.', 'You hit where you look. Tilt the right stick up to aim at the helmet and strike: two helmet hits. In duels the head is worth 3.'),
    setup() { place(1, 'still', 7, -10, 8); place(0, 'still', 0, 0, 8, 1.6); }, on: (t, d) => t === 'hit' && d.zone === 'helmet' && !d.blocked },
  { id: 'guard', title: 'Guard', need: 3, text: T_TXT('Coach will swing at you, slowly. Hold GUARD as the blow comes in. Block 3.', 'Coach will swing at you, slowly. Hold the right mouse button to guard as the blow comes in. Block 3.', 'Coach will swing at you, slowly. Hold LT to guard as the blow comes in. Block 3.'),
    setup() { place(0, 'still', -7, -10, 8); place(1, 'swinger', 0, 0, 8, 1.7); }, on: t => t === 'block' },
  { id: 'perfect', title: 'Perfect block', need: 2, text: T_TXT('Don’t hold GUARD early: tap it just before Coach’s blow lands. Get it right and they stagger. Two perfect blocks.', 'Don’t hold guard early: click the right button just before Coach’s blow lands. Two perfect blocks.', 'Don’t hold LT early: pull it just before Coach’s blow lands. Two perfect blocks.'),
    setup() { place(0, 'still', -7, -10, 8); place(1, 'swinger', 0, 0, 8, 1.7); }, on: t => t === 'perfect' },
  { id: 'combo', title: 'Shove, then trip', need: 1, text: T_TXT('SHOVE to make them stumble, then hit TRIP while it flashes yellow. Put the pell on the floor.', 'Q to shove so they stumble, then E to trip while the prompt flashes. Put the pell on the floor.', 'X to shove so they stumble, then B to trip while the prompt flashes. Put the pell on the floor.'),
    setup() { place(1, 'still', 7, -10, 8); place(0, 'still', 0, 0, 1, 1.8); }, on: (t, d) => t === 'takedown' && d.how === 'trip' },
  { id: 'clinch', title: 'Clinch and throw', need: 1, text: T_TXT('GRAB to clinch. Inside the clinch: SWING knees, TRIP throws, GRAB disarms. Knee them a couple of times, then throw.', 'F to grab and clinch. Inside: left click knees, E throws, F disarms. Knee them a couple of times, then throw.', 'LB or RB to grab. Inside: RT knees, B throws, LB/RB disarms. Knee them a couple of times, then throw.'),
    setup() { place(0, 'still', 0, 0, 1, 1.5); }, on: t => t === 'throw' },
  { id: 'tackle', title: 'Run and tackle', need: 1, text: T_TXT('Back off a few steps, run at the pell and hit TACKLE as you arrive. Miss and you over-commit.', 'Back off, run at the pell (Shift) and press C as you arrive. Miss and you over-commit.', 'Back off, run at the pell (push the stick all the way) and press Y as you arrive. Miss and you over-commit.'),
    setup() { place(0, 'still', 0, 0, 1, 4.2); }, on: t => t === 'tackle' },
  { id: 'lock', title: 'Target lock', need: 2, text: T_TXT('Your view follows the yellow-marked opponent. Tap the right side of the screen to switch between the two partners. Twice.', 'Your view gently follows the yellow-marked opponent. Press Tab to switch target. Twice.', 'Your view follows the yellow-marked opponent. Click R3 to switch target. Twice.'),
    setup() { place(0, 'still', -1.6, 0, 8, 3.2); place(1, 'still', 1.6, 0, 8, 3.2); }, on: t => t === 'lock' },
  { id: 'spar', title: 'Free spar', need: 0, text: T_TXT('That’s every button. Spar with both partners as long as you like, or tap Exit.', 'That’s every key. Spar with both partners as long as you like, or press Exit.', 'That’s every button. Spar with both partners as long as you like, or press Exit.'),
    setup() { place(0, 'easy', -2, 0, 1, 5); place(1, 'easy', 2, 0, 1, 5); } },
];
// put a partner somewhere: relative to the player when ahead > 0 (that far in front, offset sideways by dx), else at an absolute spot
function place(i, mode, dx, dz, stab, ahead) {
  const f = G.fighters.filter(o => o.team === 1)[i]; if (!f) return; const p = G.player;
  if (f.clinch) breakClinch(f);
  let x = dx, z = dz;
  if (ahead) { const fw = fwd(FP.yaw), rt = { x: -Math.cos(FP.yaw), z: Math.sin(FP.yaw) }; x = p.pos.x + fw.x * ahead + rt.x * dx; z = p.pos.z + fw.z * ahead + rt.z * dx; }
  x = clamp(x, -LIST.W / 2 + 1, LIST.W / 2 - 1); z = clamp(z, -LIST.L / 2 + 1, LIST.L / 2 - 1);
  Object.assign(f, { state: 'standing', touched: false, returnAt: -1, action: null, cd: 0, vel: { x: 0, z: 0 }, lean: { x: 0, z: 0 }, leanV: { x: 0, z: 0 }, pos: { x, z }, stabMul: stab, slowT: 0, noStep: 0 });
  f.ai.mode = mode; f.prof = mode === 'easy' ? DIFF.rookie : null; f.ai.next = 0.3; f.ai.swingT = 1.5;
  if (!f.weapon) { f.weapon = WEAPONS[f.spec.weapon]; setWeaponModel(f); }
  f.facing = f.wantFace = angTo(f.pos, p.pos);
}
function startTraining() {
  G.attract = false; G.tourney = null; REP.log = [];
  setupMatch({ mode: 'train', opp: 'sparring', stage: 'Fairground Training Yard', training: true, venue: 'training' });
  startRound(); TR.on = true; $('#app').classList.add('training');
  beginFight();
  setLesson(CAREER.trained ? LESSONS.length - 1 : 0);
}
function setLesson(i) {
  TR.i = clamp(i, 0, LESSONS.length - 1); TR.n = 0; TR.doneT = -1;
  const L = LESSONS[TR.i]; if (L.setup) L.setup();
  renderLesson();
}
function renderLesson() {
  const L = LESSONS[TR.i], el = $('#lesson'); el.hidden = !TR.on;
  const txt = typeof L.text === 'string' ? L.text : L.text[IN.mode] || L.text.touch;
  $('#lNum').textContent = `${TR.i + 1}/${LESSONS.length}`; $('#lTitle').textContent = L.title; $('#lText').textContent = txt;
  $('#lProg').textContent = L.need ? `${Math.min(TR.n, L.need)}/${L.need}` : '';
  $('#lSkip').textContent = TR.i >= LESSONS.length - 1 ? 'Restart lessons' : 'Skip';
}
function lessonCount(k = 1) {
  const L = LESSONS[TR.i]; if (!L.need || TR.doneT >= 0) return;
  TR.n += k; renderLesson();
  if (TR.n >= L.need) {
    TR.doneT = 1.4; toast('Lesson done!', 'big', `${L.title}, +15 XP`); AU.cheer(1); gainXP(15);
    if (L.id === 'lock' && !CAREER.trained) { CAREER.trained = true; unlock('grad'); const m = pay(100); setTimeout(() => toast('Graduated!', 'big', `${fmtMoney(m)} to your purse`), 1500); }
  }
}
EV_LISTENERS.push((type, d) => { if (!TR.on) return; const L = LESSONS[TR.i]; if (L.on && L.on(type, d)) lessonCount(); });
function updateTraining(dt) {
  if (!TR.on || !G.match || !G.match.training) return;
  const L = LESSONS[TR.i];
  if (G.phase === 'fight' && L.tick && TR.doneT < 0) { const k = L.tick(dt); if (k) lessonCount(k); }
  if (TR.doneT >= 0) { TR.doneT -= dt; if (TR.doneT < 0) setLesson(TR.i + 1); }
  // the yellow ring for the walking lesson
  if (!TR.ring) {
    const g = new THREE.Group();
    const r = new THREE.Mesh(new THREE.RingGeometry(0.75, 0.95, 40), new THREE.MeshBasicMaterial({ color: '#f2c40f', transparent: true, opacity: 0.85, depthWrite: false })); r.rotation.x = -Math.PI / 2; r.position.y = 0.03; g.add(r);
    const b = new THREE.Mesh(new THREE.CylinderGeometry(0.85, 0.85, 3, 24, 1, true), new THREE.MeshBasicMaterial({ color: '#f2c40f', transparent: true, opacity: 0.22, depthWrite: false, side: THREE.DoubleSide })); b.position.y = 1.5; g.add(b); r.renderOrder = 5; b.renderOrder = 5;
    W3.scene.add(g); TR.ring = g;
  }
  TR.ring.visible = L.id === 'move' && TR.doneT < 0 && (G.phase === 'fight' || G.phase === 'prefight');
  if (TR.ring.visible) { TR.ring.position.set(TR.target.x, 0, TR.target.z); TR.ring.children[1].material.opacity = 0.2 + 0.08 * Math.sin(G.realTime * 4); }
  // keep the pell standing in the swing lessons even if it gets bowled over
  for (const f of G.fighters) if (f.team === 1 && f.ai.mode === 'still' && f.stabMul > 4 && isDown(f) && f.returnAt < 0) f.returnAt = G.simTime + 1;
}
function endTraining() { TR.on = false; $('#lesson').hidden = true; $('#app').classList.remove('training'); if (TR.ring) TR.ring.visible = false; }
// ---------- skill trees: XP, levels, five trees of perks ----------
