  status() {
    if (!this.ctx) return 'Tap a sound to start audio.';
    if (this.loaded < this.total && !this.failed) return `Loading recorded sounds: ${this.loaded} of ${this.total}…`;
    return `Recorded sounds ready: ${this.loaded} of ${this.total}` + (this.failed ? ` (${this.failed} could not decode, using synth for those)` : '') + (this.muted ? '. Sound is muted in the fight HUD.' : '.');
  },
  setBell(b, muffle = 0) { if (!this.lp) return; const f = Math.min(b > 0.05 ? lerp(18000, 900, b) : 18000, lerp(18000, 2400, muffle)); if (Math.abs(f - (this._lpF || 0)) > 50) { this._lpF = f; this.lp.frequency.setTargetAtTime(f, this.ctx.currentTime, 0.05); } }
};

// The announcer and the marshal speak through the device's speech engine. The best voice the device has is picked
// (the natural / premium / Google ones first, deep male ones for the ring), the music ducks while they talk, and the
// lines are delivered with a ring announcer's cadence. Settings lets you pick any English voice instead.
const VOICE = {
  q: [], busy: false, voice: null, co: null, enabled: true,
  score(v) {
    const n = v.name || '', l = v.lang || ''; let s = 0;
    if (!/^en/i.test(l)) return -1;
    if (/natural|premium|enhanced|neural/i.test(n)) s += 40;
    if (/google/i.test(n)) s += 18;
    if (/\b(daniel|oliver|arthur|george|ryan|guy|christopher|eric|roger|brian|james|aaron|alex|fred|david|mark|rishi|thomas|liam|andrew)\b/i.test(n)) s += 14;
    if (/male/i.test(n) && !/female/i.test(n)) s += 10;
    if (/female|zira|susan|hazel|aria|jenny|michelle|libby|sonia|emma|ana|samantha|karen|moira|tessa|fiona|victoria|zoe|catherine|hayley|clara|siri/i.test(n)) s -= 12;
    if (/en-(GB|CA|AU|IE)/i.test(l)) s += 6; else if (/en-US/i.test(l)) s += 4;
    if (/compact|eloquence|novelty|whisper|bad news|bells|boing|bubbles|cellos|zarvox|trinoids|organ|jester|wobble|superstar|grandma|grandpa|rocko|shelley|junior|kathy|ralph|albert|flo/i.test(n)) s -= 40;
    if (v.localService) s += 2;
    return s;
  },
  list() { if (!window.speechSynthesis) return []; return speechSynthesis.getVoices().filter(v => /^en/i.test(v.lang || '')).sort((a, b) => this.score(b) - this.score(a)); },
  pickVoice() {
    const vs = this.list(); if (!vs.length) return;
    const want = (typeof G !== 'undefined' && G.settings && G.settings.voiceName) || '';
    this.voice = (want && vs.find(v => v.name === want)) || vs[0];
    this.co = vs.find(v => v !== this.voice && /female|zira|susan|hazel|aria|jenny|libby|sonia|emma|samantha|karen|moira|fiona|victoria|zoe|catherine|clara|natural|google/i.test(v.name)) || vs.find(v => v !== this.voice) || this.voice;
  },
  // a ring announcer's cadence: the big word first, a beat, then the rest
  shape(text) { return String(text).replace(/\s+/g, ' ').replace(/^([A-Z][A-Z ]{2,}!?)\s/, '$1. ').replace(/\.\s/g, '. ').trim(); },
  duck(on) { try { if (AU.musicGain && AU.ctx) { AU.musicGain.gain.cancelScheduledValues(AU.ctx.currentTime); AU.musicGain.gain.setTargetAtTime(on ? 0.08 : (AU.wantMusic ? 0.32 : 0), AU.ctx.currentTime, on ? 0.08 : 0.6); } } catch (e) { } },
  speak(text, who, priority) {
    if (!window.speechSynthesis) return;
    if (priority >= 3) speechSynthesis.cancel(); else if (speechSynthesis.speaking && priority < 2) return;
    if (!this.voice) this.pickVoice();
    const u = new SpeechSynthesisUtterance(this.shape(text));
    const v = who === 'co' ? this.co : this.voice; if (v) u.voice = v;
    if (who === 'co') { u.rate = 1.06; u.pitch = 1.0; u.volume = 0.85; } else if (who === 'marshal') { u.rate = 1.04; u.pitch = 0.9; u.volume = 1; } else { u.rate = 0.96; u.pitch = 0.78; u.volume = 1; }
    u.onstart = () => this.duck(true); u.onend = u.onerror = () => { if (!speechSynthesis.speaking) this.duck(false); };
    speechSynthesis.speak(u);
  },
  say(text, priority = 1) {
    if (!this.enabled || AU.muted) return;
    try { this.speak(text, 'marshal', priority); } catch (e) { /* no speech engine */ }
  },
  // Settings: a dropdown of the device's English voices, best first, with a Test button
  fillPicker(sel) {
    if (!sel) return; const vs = this.list(); sel.innerHTML = '';
    sel.append(h('option', { value: '' }, vs.length ? `Best available (${vs[0].name})` : 'No voices on this device'));
    for (const v of vs) sel.append(h('option', { value: v.name, selected: G.settings.voiceName === v.name ? '' : null }, `${v.name} (${v.lang})`));
    sel.onchange = () => { G.settings.voiceName = sel.value; store.set('settings3', G.settings); this.voice = null; this.pickVoice(); this.test(); };
  },
  test() { try { AU.init(); const was = this.enabled; this.enabled = true; this.speak('Ladies and gentlemen. The Reavers take the list. Fighters, to your marks!', 'pa', 3); this.enabled = was; } catch (e) { } }
};
if (window.speechSynthesis) { try { speechSynthesis.onvoiceschanged = () => VOICE.pickVoice(); } catch (e) { } }
// Android browsers keep Web Audio running after the app is minimized unless we suspend it.
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    if (AU.ctx && AU.ctx.state === 'running') AU.ctx.suspend().catch(() => {});
    if (window.speechSynthesis) speechSynthesis.cancel();
  } else if (AU.ctx && AU.ctx.state === 'suspended') AU.ctx.resume().catch(() => {});
});
// ---------- canvas textures ----------
function cvs(w, hgt) { const c = document.createElement('canvas'); c.width = w; c.height = hgt; return c; }
function texFrom(c, repeat) {
  const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding; t.anisotropy = 4;
  if (repeat) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(repeat[0], repeat[1]); }
  return t;
}
function speckle(ctx, w, hh, n, cols, rmin, rmax) {
  for (let i = 0; i < n; i++) { ctx.fillStyle = pick(cols); ctx.globalAlpha = rand(0.04, 0.22); const r = rand(rmin, rmax); ctx.beginPath(); ctx.arc(rand(0, w), rand(0, hh), r, 0, TAU); ctx.fill(); }
  ctx.globalAlpha = 1;
}

const TEX = {};
function buildTextures() {
  // concrete pad of a summer hockey arena (ice out)
  {
    const c = cvs(1024, 1024), x = c.getContext('2d');
    x.fillStyle = '#7b7f7e'; x.fillRect(0, 0, 1024, 1024);
    speckle(x, 1024, 1024, 9000, ['#5f6362', '#8e9291', '#6d716f', '#9a9c98'], 0.6, 2.2);
    speckle(x, 1024, 1024, 60, ['#5a5e5c', '#666a68'], 30, 120);
    x.strokeStyle = 'rgba(30,32,32,.55)'; x.lineWidth = 3; // expansion joints
    for (const p of [256, 768]) { x.beginPath(); x.moveTo(p, 0); x.lineTo(p, 1024); x.stroke(); x.beginPath(); x.moveTo(0, p); x.lineTo(1024, p); x.stroke(); }
    x.strokeStyle = 'rgba(25,25,25,.25)'; x.lineWidth = 1.2; // hairline cracks and scuffs
    for (let i = 0; i < 26; i++) { x.beginPath(); let px = rand(0, 1024), py = rand(0, 1024); x.moveTo(px, py); for (let k = 0; k < 6; k++) { px += rand(-40, 40); py += rand(-40, 40); x.lineTo(px, py); } x.stroke(); }
    for (let i = 0; i < 40; i++) { x.strokeStyle = 'rgba(20,20,20,' + rand(0.05, 0.15) + ')'; x.lineWidth = rand(2, 6); x.beginPath(); const px = rand(0, 1024), py = rand(0, 1024); x.moveTo(px, py); x.quadraticCurveTo(px + rand(-60, 60), py + rand(-60, 60), px + rand(-90, 90), py + rand(-90, 90)); x.stroke(); }
    TEX.concrete = texFrom(c, [9, 13]);
  }
  // rough lumber for the rails
  {
    const c = cvs(512, 64), x = c.getContext('2d');
    x.fillStyle = '#8a6a48'; x.fillRect(0, 0, 512, 64);
    for (let i = 0; i < 40; i++) { x.strokeStyle = `rgba(${rand(60, 90) | 0},${rand(40, 60) | 0},${rand(25, 40) | 0},${rand(0.2, 0.5)})`; x.lineWidth = rand(0.5, 2); x.beginPath(); const y = rand(0, 64); x.moveTo(0, y); for (let px = 0; px <= 512; px += 32) x.lineTo(px, y + Math.sin(px * 0.02 + i) * rand(1, 4)); x.stroke(); }
    for (let i = 0; i < 4; i++) { x.fillStyle = 'rgba(60,40,24,.55)'; x.beginPath(); x.ellipse(rand(20, 490), rand(10, 54), rand(4, 8), rand(2, 4), 0, 0, TAU); x.fill(); }
    TEX.wood = texFrom(c, [1, 1]);
  }
  // arena banner
  {
    const c = cvs(1024, 256), x = c.getContext('2d');
    x.fillStyle = '#121619'; x.fillRect(0, 0, 1024, 256);
    x.fillStyle = '#ff3d8b'; x.fillRect(0, 0, 1024, 14); x.fillRect(0, 242, 1024, 14);
    x.fillStyle = '#ece8de'; x.textAlign = 'center';
    x.font = '900 118px "Big Shoulders Display", Impact, "Arial Narrow", sans-serif'; x.fillText('RED DEER RUMBLE', 512, 140);
    x.font = '700 34px "Barlow Semi Condensed", "Arial Narrow", sans-serif'; x.fillStyle = '#aab4b8'; x.fillText('SUMMER STEEL  ·  5v5 BUHURT  ·  BI RULES', 512, 200);
    TEX.banner = texFrom(c);
  }
  // spark sprite
  {
    const c = cvs(64, 64), x = c.getContext('2d'); const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, 'rgba(255,250,220,1)'); g.addColorStop(0.25, 'rgba(255,200,90,.9)'); g.addColorStop(1, 'rgba(255,120,20,0)');
    x.fillStyle = g; x.fillRect(0, 0, 64, 64); TEX.spark = new THREE.CanvasTexture(c);
  }
  {
    const c = cvs(64, 64), x = c.getContext('2d'); const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, 'rgba(200,195,185,.55)'); g.addColorStop(1, 'rgba(200,195,185,0)'); x.fillStyle = g; x.fillRect(0, 0, 64, 64); TEX.dust = new THREE.CanvasTexture(c);
  }
  // soft blob shadow for marshals and crowd
  {
    const c = cvs(64, 64), x = c.getContext('2d'); const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, 'rgba(0,0,0,.55)'); g.addColorStop(1, 'rgba(0,0,0,0)'); x.fillStyle = g; x.fillRect(0, 0, 64, 64); TEX.blob = new THREE.CanvasTexture(c);
  }
}

function drawCharge(x, club, cx, cy, w, hh) {
  x.fillStyle = club.trim;
  if (club.charge === 'chevron') {
    x.beginPath(); x.moveTo(cx - w * 0.5, cy + hh * 0.35); x.lineTo(cx, cy - hh * 0.2); x.lineTo(cx + w * 0.5, cy + hh * 0.35); x.lineTo(cx + w * 0.5, cy + hh * 0.08); x.lineTo(cx, cy - hh * 0.47); x.lineTo(cx - w * 0.5, cy + hh * 0.08); x.closePath(); x.fill();
  } else if (club.charge === 'pale') {
    x.fillRect(cx - w * 0.16, cy - hh * 0.5, w * 0.32, hh);
  } else if (club.charge === 'cross') {
    x.fillRect(cx - w * 0.12, cy - hh * 0.5, w * 0.24, hh); x.fillRect(cx - w * 0.5, cy - hh * 0.2, w, hh * 0.24);
  } else if (club.charge === 'saltire') {
    x.save(); x.translate(cx, cy); for (const r of [-0.75, 0.75]) { x.save(); x.rotate(r); x.fillRect(-w, -hh * 0.1, w * 2, hh * 0.2); x.restore(); } x.restore();
  } else if (club.charge === 'chief') {
    x.fillRect(cx - w, cy - hh * 0.5, w * 2, hh * 0.3);
  } else if (club.charge === 'quarterly') {
    x.fillRect(cx - w * 0.5, cy - hh * 0.5, w * 0.5, hh * 0.5); x.fillRect(cx, cy, w * 0.5, hh * 0.5);
  } else {
    x.save(); x.translate(cx, cy); x.rotate(-0.75); x.fillRect(-w, -hh * 0.11, w * 2, hh * 0.22); x.restore();
  }
}
const _tabardCache = {}, _shieldCache = {};
function tabardTex(club) {
  if (_tabardCache[club.key]) return _tabardCache[club.key];
  const c = cvs(512, 256), x = c.getContext('2d');
  x.fillStyle = club.tabard; x.fillRect(0, 0, 512, 256);
  for (let i = 0; i < 2600; i++) { x.fillStyle = Math.random() < 0.5 ? 'rgba(0,0,0,.07)' : 'rgba(255,255,255,.035)'; x.fillRect(rand(0, 512), rand(0, 256), rand(1, 3), 1); }
  x.save(); x.beginPath(); x.rect(0, 0, 512, 256); x.clip();
  drawCharge(x, club, 256, 110, 150, 150); // front (centre after offset)
  drawCharge(x, club, 0, 110, 150, 150); drawCharge(x, club, 512, 110, 150, 150); // back
  x.restore();
  x.fillStyle = club.trim; x.globalAlpha = 0.8; x.fillRect(0, 238, 512, 6); x.globalAlpha = 1;
  x.fillStyle = 'rgba(40,30,20,.25)'; for (let i = 0; i < 30; i++) { x.beginPath(); x.arc(rand(0, 512), rand(150, 256), rand(4, 18), 0, TAU); x.fill(); }
  const t = texFrom(c); t.wrapS = THREE.RepeatWrapping; t.offset.x = 0.5; _tabardCache[club.key] = t; return t;
}
function shieldTex(club) {
  if (_shieldCache[club.key]) return _shieldCache[club.key];
  const c = cvs(256, 256), x = c.getContext('2d');
  x.fillStyle = club.tabard; x.fillRect(0, 0, 256, 256);
  for (let i = 0; i < 900; i++) { x.fillStyle = 'rgba(0,0,0,.08)'; x.fillRect(rand(0, 256), rand(0, 256), rand(1, 4), 1); }
  drawCharge(x, club, 128, 120, 170, 170);
  for (let i = 0; i < 26; i++) { x.strokeStyle = 'rgba(210,205,195,' + rand(0.15, 0.4) + ')'; x.lineWidth = rand(1, 2.5); x.beginPath(); const px = rand(20, 236), py = rand(20, 236); x.moveTo(px, py); x.lineTo(px + rand(-30, 30), py + rand(-12, 12)); x.stroke(); }
  const t = texFrom(c); _shieldCache[club.key] = t; return t;
}

// number written in marker on a strip of black hockey tape, with the side's flagging tape behind it
function tagTexture(num, flag, isPlayer) {
  const c = cvs(160, 80), x = c.getContext('2d');
  x.fillStyle = flag; x.fillRect(8, 30, 144, 20);
  x.fillStyle = '#141516';
  x.beginPath(); x.moveTo(30, 12); for (let i = 0; i <= 6; i++) x.lineTo(30 + (i % 2) * 5, 12 + i * 9.3); x.lineTo(130, 68); for (let i = 6; i >= 0; i--) x.lineTo(130 - (i % 2) * 5, 12 + i * 9.3); x.closePath(); x.fill();
  x.fillStyle = isPlayer ? flag : '#ece8de'; x.textAlign = 'center'; x.textBaseline = 'middle';
  x.font = '40px "Permanent Marker", "Marker Felt", "Comic Sans MS", cursive'; x.fillText(String(num), 80, 42);
  const t = new THREE.CanvasTexture(c); t.encoding = THREE.sRGBEncoding; return t;
}
// CC0 asset library: generated source data is embedded by build.py for standalone and offline builds.
const LIBRARY = { textures: {}, models: {}, loading: {} };
function libraryIcon(key, size = 28) {
  const src = LIBRARY_DATA.icons[key];
  return src ? h('img', { src, alt: '', width: size, height: size, class: 'libicon' }) : null;
}
function librarySurface(kind) {
  const src = LIBRARY_DATA.surfaces[kind]; if (!src) return null;
  if (LIBRARY.textures[kind]) return LIBRARY.textures[kind];
  const t = new THREE.TextureLoader().load(src);
  t.encoding = THREE.sRGBEncoding; t.wrapS = t.wrapT = THREE.RepeatWrapping;
  const repeats = { grass: [30, 40], dirt: [4, 6], path: [4, 6], cobble: [8, 8], forest: [8, 8] };
  t.repeat.set(...(repeats[kind] || [4, 4])); t.anisotropy = 4;
  return LIBRARY.textures[kind] = t;
}
function libraryModel(key, done) {
  if (key.startsWith('Dock_')) {
    if (LIBRARY.models[key]) { done(LIBRARY.models[key].clone(true)); return; }
    libraryModel('WoodenDockSet', pack => {
      const part = pack && pack.getObjectByName(key.slice(5));
      if (!part) { done(null); return; }
      const piece = new THREE.Group(), model = part.clone(true);
      model.traverse(o => {
        if (!o.isMesh) return;
        const wood = m => {
          const finish = m.clone();
          finish.color.set(m.name === 'BoatTrim_Mat' ? '#765337' : '#3f3025');
          finish.roughness = 1; return finish;
        };
        o.material = Array.isArray(o.material) ? o.material.map(wood) : wood(o.material);
      });
      model.position.set(0, 0, 0); piece.add(model);
      LIBRARY.models[key] = piece; done(piece.clone(true));
    });
    return;
  }
  if (!LIBRARY_DATA.models[key]) { done(null); return; }
  if (LIBRARY.models[key]) { done(LIBRARY.models[key].clone(true)); return; }
  if (LIBRARY.loading[key]) { LIBRARY.loading[key].push(done); return; }
  LIBRARY.loading[key] = [done];
  const source = LIBRARY_DATA.models[key];
  const payload = source.startsWith('data:')
    ? Uint8Array.from(atob(source.slice(source.indexOf(',') + 1)), c => c.charCodeAt(0)).buffer
    : source;
  new GLTFX.GLTFLoader().parse(payload, '', result => {
    LIBRARY.models[key] = result.scene;
    for (const cb of LIBRARY.loading[key]) cb(result.scene.clone(true));
    delete LIBRARY.loading[key];
  }, err => {
    console.warn('library model', key, err);
    for (const cb of LIBRARY.loading[key]) cb(null);
    delete LIBRARY.loading[key];
  });
}
function libraryPlace(parent, key, x, z, height, rotation = 0) {
  const anchor = new THREE.Group(); anchor.position.set(x, typeof gy === 'function' ? gy(x, z) : 0, z); anchor.rotation.y = rotation; parent.add(anchor);
  libraryModel(key, scene => {
    if (!scene) return;
    const box = new THREE.Box3().setFromObject(scene), span = box.max.y - box.min.y;
    if (!Number.isFinite(span) || span <= 0) return;
    const scale = height / span; scene.scale.setScalar(scale);
    scene.position.y = -box.min.y * scale;
    scene.traverse(o => { if (o.isMesh) { o.castShadow = SHADOWS; o.receiveShadow = true; } });
    anchor.add(scene);
  });
  return anchor;
}
function libraryWeapon(model, wkey) {
  const g = new THREE.Group(), fallback = buildWeapon(wkey, CLUBS.reavers); g.add(fallback);
  libraryModel(model, scene => {
    if (!scene) return;
    let box = new THREE.Box3().setFromObject(scene);
    const size = new THREE.Vector3(); box.getSize(size);
    if (size.x > size.y && size.x > size.z) scene.rotation.z = Math.PI / 2;
    else if (size.z > size.y) scene.rotation.x = -Math.PI / 2;
    box = new THREE.Box3().setFromObject(scene); box.getSize(size);
    const W = playerWeaponDef(wkey), scale = (W ? W.len : 0.9) / Math.max(size.y, 0.001);
    scene.scale.setScalar(scale);
    scene.position.set(-(box.min.x + box.max.x) * scale / 2, -box.min.y * scale - (W && W.haft ? 0.1 : 0.15), -(box.min.z + box.max.z) * scale / 2);
    g.add(scene); fallback.visible = false;
  });
  g.userData.skinModel = model;
  return g;
}
function libraryThumb(key, W = 96, H = 96) {
  const c = cvs(W, H), x = c.getContext('2d');
  libraryModel(key, scene => {
    if (!scene || !W3.renderer) return;
    try {
      const box = new THREE.Box3().setFromObject(scene), size = new THREE.Vector3(); box.getSize(size);
      const mid = new THREE.Vector3(); box.getCenter(mid);
      const scale = 2.3 / Math.max(size.x, size.y, size.z, 0.01);
      scene.scale.setScalar(scale); scene.position.copy(mid).multiplyScalar(-scale);
      scene.rotation.y = -0.5;
      const sc = new THREE.Scene(); sc.add(new THREE.HemisphereLight('#ffffff', '#8a7c64', 2.5));
      const dl = new THREE.DirectionalLight('#ffffff', 2.5); dl.position.set(3, 5, 5); sc.add(dl, scene);
      const cam = new THREE.PerspectiveCamera(35, W / H, 0.1, 20); cam.position.set(1.8, 1.2, 3.2); cam.lookAt(0, 0, 0);
      const R = W3.renderer, rt = new THREE.WebGLRenderTarget(W, H), prev = R.getRenderTarget(), pc = R.getClearColor(new THREE.Color()), pa = R.getClearAlpha();
      R.setRenderTarget(rt); R.setClearColor(0x000000, 0); R.clear(); R.render(sc, cam);
      const px = new Uint8Array(W * H * 4), id = x.createImageData(W, H); R.readRenderTargetPixels(rt, 0, 0, W, H, px);
      for (let y = 0; y < H; y++) for (let j = 0; j < W * 4; j++) id.data[y * W * 4 + j] = px[(H - 1 - y) * W * 4 + j];
      x.putImageData(id, 0, 0); R.setRenderTarget(prev); R.setClearColor(pc, pa); rt.dispose();
    } catch (e) { console.warn('library thumbnail', key, e); }
  });
  return c;
}
// ---------- renderer, arena, particles ----------
const W3 = { renderer: null, scene: null, camera: null, sun: null, root: null, crowd: null, crowdBase: [], fx: [], dust: [], matchRoot: null };
const MAT = {};

function initThree() {
  const host = $('#gl');
  const renderer = new THREE.WebGLRenderer({ antialias: !IS_TOUCH, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, IS_TOUCH ? 1.3 : 1.75));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.outputEncoding = THREE.sRGBEncoding;
  renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.08;
  renderer.shadowMap.enabled = SHADOWS; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  host.appendChild(renderer.domElement);
  const scene = new THREE.Scene();
  scene.background = new THREE.Color('#0c1013');
  scene.fog = new THREE.Fog('#0c1013', 40, 105);
  const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.4, 220);
  camera.position.set(0, 18, 22); camera.lookAt(0, 0, 0);
  Object.assign(W3, { renderer, scene, camera });

  // light: arena halides overhead
  const hemi = new THREE.HemisphereLight('#b9c6d2', '#3a332b', 0.5); scene.add(hemi); W3.hemi = hemi;
  const sun = new THREE.DirectionalLight('#fff4e4', 1.45);
  sun.position.set(7, 26, 12); sun.target.position.set(0, 0, 0);
  sun.castShadow = true; const sm = IS_SMALL ? 1024 : 2048; sun.shadow.mapSize.set(sm, sm);
  Object.assign(sun.shadow.camera, { left: -17, right: 17, top: 21, bottom: -21, near: 5, far: 60 });
  sun.shadow.bias = -0.0006; sun.shadow.normalBias = 0.02;
  scene.add(sun, sun.target); W3.sun = sun;
  const fill = new THREE.DirectionalLight('#9fb6ff', 0.35); fill.position.set(-10, 12, -14); scene.add(fill); W3.fill = fill;

  // environment map so the steel has something to reflect
  const pm = new THREE.PMREMGenerator(renderer);
  const env = new THREE.Scene();
  env.add(new THREE.Mesh(new THREE.BoxGeometry(60, 30, 60), new THREE.MeshBasicMaterial({ color: '#1d2329', side: THREE.BackSide })));
  const panel = new THREE.MeshBasicMaterial({ color: '#ffffff' });
  for (let i = -2; i <= 2; i++) for (let j = -1; j <= 1; j++) { const p = new THREE.Mesh(new THREE.PlaneGeometry(5, 2.2), panel); p.position.set(i * 10, 14.5, j * 14); p.rotation.x = Math.PI / 2; env.add(p); }
  const warm = new THREE.Mesh(new THREE.PlaneGeometry(40, 4), new THREE.MeshBasicMaterial({ color: '#b78a52' })); warm.position.set(0, 3, -29.5); env.add(warm);
  const floorEnv = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), new THREE.MeshBasicMaterial({ color: '#4a4c4b' })); floorEnv.rotation.x = -Math.PI / 2; floorEnv.position.y = -14; env.add(floorEnv);
  scene.environment = pm.fromScene(env, 0.035).texture;

  buildMaterials();
  buildArena();
  buildFx();
  window.addEventListener('resize', onResize);
}

function onResize() {
  const w = window.innerWidth, hh = window.innerHeight;
  W3.renderer.setSize(w, hh); W3.camera.aspect = w / hh; W3.camera.updateProjectionMatrix();
}

function buildMaterials() {
  MAT.steel = new THREE.MeshStandardMaterial({ color: '#c3cacd', metalness: 0.92, roughness: 0.3 });
  MAT.steelWorn = new THREE.MeshStandardMaterial({ color: '#9aa2a6', metalness: 0.85, roughness: 0.45 });
  MAT.steelDark = new THREE.MeshStandardMaterial({ color: '#6c7478', metalness: 0.85, roughness: 0.5 });
  MAT.mail = new THREE.MeshStandardMaterial({ color: '#6f777b', metalness: 0.8, roughness: 0.62 });
  MAT.brass = new THREE.MeshStandardMaterial({ color: '#b8913f', metalness: 0.9, roughness: 0.35 });
  MAT.leather = new THREE.MeshStandardMaterial({ color: '#4b2f1c', roughness: 0.82 });
  MAT.leatherDark = new THREE.MeshStandardMaterial({ color: '#2a1a10', roughness: 0.85 });
  MAT.gambeson = new THREE.MeshStandardMaterial({ color: '#3d3833', roughness: 0.95 });
  MAT.slit = new THREE.MeshBasicMaterial({ color: '#050607' });
  MAT.haft = new THREE.MeshStandardMaterial({ color: '#6b4a2e', roughness: 0.75 });
  MAT.blade = new THREE.MeshStandardMaterial({ color: '#e2e7e9', metalness: 0.8, roughness: 0.34 });
  MAT.black = new THREE.MeshStandardMaterial({ color: '#1a1c1f', roughness: 0.9 });
  MAT.skin = new THREE.MeshStandardMaterial({ color: '#c99a7a', roughness: 0.8 });
  MAT.marshalYellow = new THREE.MeshStandardMaterial({ color: '#f2c40f', roughness: 0.7, emissive: '#3a2e00' });
  MAT.tape = {};
  for (const k in TAPES) MAT.tape[k] = new THREE.MeshStandardMaterial({ color: TAPES[k].color, roughness: k === 'duct' ? 0.42 : 0.92, metalness: k === 'duct' ? 0.35 : 0 });
  MAT.flagPink = new THREE.MeshStandardMaterial({ color: '#ff3d8b', roughness: 0.4, emissive: '#5c0b2a' });
  MAT.flagBlue = new THREE.MeshStandardMaterial({ color: '#3b93ff', roughness: 0.4, emissive: '#0b2a5c' });
  MAT.woodBar = new THREE.MeshStandardMaterial({ map: TEX.wood, roughness: 0.85 });
  MAT.woodBar.map = TEX.wood.clone(); MAT.woodBar.map.needsUpdate = true; MAT.woodBar.map.wrapS = THREE.RepeatWrapping; MAT.woodBar.map.repeat.set(12, 1);
  MAT.woodPost = new THREE.MeshStandardMaterial({ map: TEX.wood, roughness: 0.85 });
  MAT.whiteTape = new THREE.MeshStandardMaterial({ color: '#e7e4da', roughness: 0.9 });
  MAT.blob = new THREE.MeshBasicMaterial({ map: TEX.blob, transparent: true, depthWrite: false });
  for (const c of ['#3b2a1c', '#7a4b26', '#1d1712', '#b88a52', '#5a3a22']) HAIR.push(new THREE.MeshStandardMaterial({ color: c, roughness: 0.85 }));
}

function buildArena() {
  const S = W3.scene; const root = new THREE.Group(); S.add(root); W3.root = root;
  const { W, L } = LIST;

  // list rails: posts, wide top bar, bottom rail (wooden)
  const postGeo = new THREE.BoxGeometry(0.12, 1.22, 0.12);
  const posts = []; const step = 2.5;
  for (let x = -W / 2; x <= W / 2 + 0.01; x += step) { posts.push([x, -L / 2], [x, L / 2]); }
  for (let z = -L / 2 + step; z <= L / 2 - step + 0.01; z += step) { posts.push([-W / 2, z], [W / 2, z]); }
  const postMesh = new THREE.InstancedMesh(postGeo, MAT.woodPost, posts.length);
  const m4 = new THREE.Matrix4();
  posts.forEach((p, i) => { m4.makeTranslation(p[0], 0.61, p[1]); postMesh.setMatrixAt(i, m4); });
  postMesh.castShadow = true; postMesh.receiveShadow = true; root.add(postMesh);
  const bar = (len, w, hgt, x, y, z, rotY) => { const m = new THREE.Mesh(new THREE.BoxGeometry(len, hgt, w), MAT.woodBar); m.position.set(x, y, z); m.rotation.y = rotY; m.castShadow = true; m.receiveShadow = true; root.add(m); };
  for (const sz of [-1, 1]) { bar(W + 0.2, 0.2, 0.06, 0, 1.22, sz * L / 2, 0); bar(W + 0.2, 0.08, 0.14, 0, 0.22, sz * L / 2, 0); bar(W + 0.2, 0.06, 0.12, 0, 0.72, sz * L / 2, 0); }
  for (const sx of [-1, 1]) { bar(L + 0.2, 0.2, 0.06, sx * W / 2, 1.22, 0, Math.PI / 2); bar(L + 0.2, 0.08, 0.14, sx * W / 2, 0.22, 0, Math.PI / 2); bar(L + 0.2, 0.06, 0.12, sx * W / 2, 0.72, 0, Math.PI / 2); }

  // white tape on the floor: start lines and weapon-zone boxes
  const strip = (x, z, len, rot) => { const m = new THREE.Mesh(new THREE.PlaneGeometry(len, 0.06), MAT.whiteTape); m.rotation.x = -Math.PI / 2; m.rotation.z = rot; m.position.set(x, 0.006, z); m.receiveShadow = true; root.add(m); };
  for (const sz of [-1, 1]) strip(0, sz * (L / 2 - 3), W - 2, 0);
  W3.zones = [{ x: W / 2 - 0.9, z: L / 2 - 5 }, { x: -W / 2 + 0.9, z: -(L / 2 - 5) }];
  // weapon-zone rectangles (3 m along the rail, 1.4 m deep)
  for (const zn of W3.zones) {
    const sx = Math.sign(zn.x), inner = sx * (W / 2 - 1.4);
    strip(inner, zn.z, 3, Math.PI / 2);
    strip((inner + sx * W / 2) / 2, zn.z - 1.5, 1.4, 0);
    strip((inner + sx * W / 2) / 2, zn.z + 1.5, 1.4, 0);
  }

  W3.matchRoot = new THREE.Group(); S.add(W3.matchRoot);
  setVenue(store.get('venue', 'arena'));
}

// the summer hockey arena: concrete pad, boards and glass, bleachers, halide lights
function buildVenueArena(root) {
  const m4 = new THREE.Matrix4();
  const floor = new THREE.Mesh(new THREE.PlaneGeometry(90, 120), new THREE.MeshStandardMaterial({ map: TEX.concrete, color: '#a3a7a8', roughness: 0.93, metalness: 0 }));
  floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; root.add(floor);
  // hockey boards, kick plate and glass around a rounded rink
  const RW = 26, RL = 61, R = 8.5, pts = [];
  const seg = (cx, cz, a0, a1, n) => { for (let i = 0; i < n; i++) { const a = a0 + (a1 - a0) * i / n; pts.push([cx + Math.cos(a) * R, cz + Math.sin(a) * R]); } };
  const line = (x0, z0, x1, z1, n) => { for (let i = 0; i < n; i++) pts.push([lerp(x0, x1, i / n), lerp(z0, z1, i / n)]); };
  const hx = RW / 2, hz = RL / 2;
  line(hx, -hz + R, hx, hz - R, 22); seg(hx - R, hz - R, 0, Math.PI / 2, 9);
  line(hx - R, hz, -hx + R, hz, 6); seg(-hx + R, hz - R, Math.PI / 2, Math.PI, 9);
  line(-hx, hz - R, -hx, -hz + R, 22); seg(-hx + R, -hz + R, Math.PI, Math.PI * 1.5, 9);
  line(-hx + R, -hz, hx - R, -hz, 6); seg(hx - R, -hz + R, Math.PI * 1.5, Math.PI * 2, 9);
  const n = pts.length;
  const boardG = new THREE.BoxGeometry(1, 1, 0.14);
  const board = new THREE.InstancedMesh(boardG, new THREE.MeshStandardMaterial({ color: '#e9ebe8', roughness: 0.55 }), n);
  const kick = new THREE.InstancedMesh(boardG, new THREE.MeshStandardMaterial({ color: '#d9b21c', roughness: 0.6 }), n);
  const cap = new THREE.InstancedMesh(boardG, new THREE.MeshStandardMaterial({ color: '#b3242b', roughness: 0.5 }), n);
  const glass = new THREE.InstancedMesh(boardG, new THREE.MeshStandardMaterial({ color: '#cfe6ff', roughness: 0.05, metalness: 0.1, transparent: true, opacity: 0.1, depthWrite: false }), n);
  const q = new THREE.Quaternion(), sc = new THREE.Vector3(), pv = new THREE.Vector3(), up = new THREE.Vector3(0, 1, 0);
  for (let i = 0; i < n; i++) {
    const a = pts[i], b = pts[(i + 1) % n]; const dx = b[0] - a[0], dz = b[1] - a[1]; const len = Math.hypot(dx, dz) + 0.02;
    q.setFromAxisAngle(up, Math.atan2(-dz, dx)); const mx = (a[0] + b[0]) / 2, mz = (a[1] + b[1]) / 2;
    sc.set(len, 0.87, 1); pv.set(mx, 0.635, mz); m4.compose(pv, q, sc); board.setMatrixAt(i, m4);
    sc.set(len, 0.2, 1.02); pv.set(mx, 0.1, mz); m4.compose(pv, q, sc); kick.setMatrixAt(i, m4);
    sc.set(len, 0.06, 1.6); pv.set(mx, 1.1, mz); m4.compose(pv, q, sc); cap.setMatrixAt(i, m4);
    sc.set(len, 1.8, 0.12); pv.set(mx, 2.03, mz); m4.compose(pv, q, sc); glass.setMatrixAt(i, m4);
  }
  board.receiveShadow = true; root.add(board, kick, cap, glass);

  // bleachers with a modest summer crowd
  const tier = new THREE.MeshStandardMaterial({ color: '#2b3236', roughness: 0.8 });
  const seat = new THREE.MeshStandardMaterial({ color: '#27313b', roughness: 0.7 });
  for (const sx of [-1, 1]) for (let r = 0; r < 9; r++) {
    const t = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.55, 46), tier); t.position.set(sx * (15.2 + r * 0.95), 0.28 + r * 0.55, 0); t.scale.y = 1 + r * 2; t.position.y = (0.55 * (1 + r * 2)) / 2; root.add(t);
    const s = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.12, 46), seat); s.position.set(sx * (15.0 + r * 0.95), 0.55 * (1 + r * 2) + 0.06, 0); root.add(s);
  }
  const people = IS_TOUCH ? 220 : 380; const bodyG = new THREE.BoxGeometry(0.46, 0.62, 0.34); const headG = new THREE.IcosahedronGeometry(0.13, 1);
  const bodies = new THREE.InstancedMesh(bodyG, new THREE.MeshStandardMaterial({ roughness: 0.85 }), people);
  const heads = new THREE.InstancedMesh(headG, new THREE.MeshStandardMaterial({ roughness: 0.8 }), people);
  const shirt = ['#2f4b7c', '#7c2f3a', '#3a3f44', '#d6d1c4', '#526b3a', '#b87a2a', '#1f1f22', '#ff3d8b', '#3b93ff', '#6a5a8a', '#9c3d2a'];
  const skins = ['#e0b896', '#c69373', '#8d5a3c', '#f1cfb4', '#5e3a26', '#b07b5a'];
  const col = new THREE.Color(); W3.crowdBase = [];
  for (let i = 0; i < people; i++) {
    const sx = i % 2 ? 1 : -1; const r = (Math.random() * 9) | 0; const z = rand(-22, 22);
    const x = sx * (15.0 + r * 0.95); const y = 0.55 * (1 + r * 2) + 0.42;
    W3.crowdBase.push({ x, y, z, ph: rand(0, TAU), amp: rand(0.02, 0.06), ex: 0 });
    bodies.setColorAt(i, col.set(pick(shirt))); heads.setColorAt(i, col.set(pick(skins)));
  }
  W3.crowd = { bodies, heads }; updateCrowd(0, 0);
  root.add(bodies, heads);

  // roof light fixtures
  const fixt = new THREE.InstancedMesh(new THREE.BoxGeometry(1.6, 0.25, 0.8), new THREE.MeshBasicMaterial({ color: '#fff6dd' }), 24);
  let k = 0; for (let i = -1; i <= 1; i++) for (let j = -3; j <= 4; j++) { m4.makeTranslation(i * 9, 15, j * 9 - 4); fixt.setMatrixAt(k++, m4); }
  root.add(fixt);
  // banner over the far end
  const ban = new THREE.Mesh(new THREE.PlaneGeometry(14, 3.5), new THREE.MeshBasicMaterial({ map: TEX.banner, fog: true }));
  ban.position.set(0, 6.4, -30); root.add(ban);
  const ban2 = new THREE.Mesh(new THREE.PlaneGeometry(10, 2.5), new THREE.MeshBasicMaterial({ map: TEX.banner })); ban2.position.set(-23.5, 8.5, 0); ban2.rotation.y = Math.PI / 2; root.add(ban2);
  const ban3 = ban2.clone(); ban3.position.x = 23.5; ban3.rotation.y = -Math.PI / 2; root.add(ban3);
  // far wall
  const wall = new THREE.Mesh(new THREE.PlaneGeometry(80, 20), new THREE.MeshStandardMaterial({ color: '#1b2126', roughness: 1 })); wall.position.set(0, 9, -33); root.add(wall);
}

function updateCrowd(t, excite) {
  const { bodies, heads } = W3.crowd; const m4 = new THREE.Matrix4();
  for (let i = 0; i < W3.crowdBase.length; i++) {
    const c = W3.crowdBase[i]; const e = Math.max(c.ex, excite * 0.6);
    const up = Math.max(0, Math.sin(t * (2 + e * 6) + c.ph)) * (c.amp + e * 0.18) + e * 0.25;
    m4.makeTranslation(c.x, c.y + up, c.z); bodies.setMatrixAt(i, m4);
    m4.makeTranslation(c.x, c.y + up + 0.45, c.z); heads.setMatrixAt(i, m4);
    c.ex = Math.max(0, c.ex - 0.01);
  }
  bodies.instanceMatrix.needsUpdate = true; heads.instanceMatrix.needsUpdate = true;
}

// ---------- particles ----------
function buildFx() {
  const sm = new THREE.SpriteMaterial({ map: TEX.spark, color: '#ffffff', blending: THREE.AdditiveBlending, depthWrite: false, transparent: true });
  for (let i = 0; i < 90; i++) { const s = new THREE.Sprite(sm.clone()); s.visible = false; s.scale.setScalar(0.12); (W3.matchRoot || W3.scene).add(s); W3.fx.push({ s, life: 0, v: new THREE.Vector3() }); }
  const dm = new THREE.SpriteMaterial({ map: TEX.dust, depthWrite: false, transparent: true });
  for (let i = 0; i < 24; i++) { const s = new THREE.Sprite(dm.clone()); s.visible = false; (W3.matchRoot || W3.scene).add(s); W3.dust.push({ s, life: 0, max: 1 }); }
}
function sparks(pos, n = 10, power = 1, color = '#ffffff') {
  let c = 0; const cute = CUTE.on; if (cute) n = Math.max(3, Math.round(n * 0.55)); // youth: hearts and stars float up instead of sparks
  for (const p of W3.fx) {
    if (p.life > 0) continue; p.s.visible = true; p.s.position.copy(pos); const m = p.s.material; p.cute = cute;
    if (cute) { m.map = cuteTex(c % 2 ? 'star' : 'heart'); m.blending = THREE.NormalBlending; m.color.set(CUTE_POPS[(Math.random() * CUTE_POPS.length) | 0]); m.rotation = rand(-0.5, 0.5); m.opacity = 1; p.life = p.max = rand(0.6, 1.0); p.v.set(rand(-1, 1), rand(0.9, 1.8), rand(-1, 1)).multiplyScalar(rand(1.1, 2.2) * Math.min(power, 1.4)); p.s.scale.setScalar(rand(0.11, 0.2)); }
    else { if (m.map !== TEX.spark) { m.map = TEX.spark; m.blending = THREE.AdditiveBlending; m.rotation = 0; } m.opacity = 1; m.color.set(color); p.life = rand(0.18, 0.45); p.v.set(rand(-1, 1), rand(0.2, 1.4), rand(-1, 1)).multiplyScalar(rand(2, 5) * power); p.s.scale.setScalar(rand(0.06, 0.14)); }
    if (++c >= n) break;
  }
}
function breathPuff(x, y, z, k) {
  const d = W3.dust.find(p => p.life <= 0); if (!d) return;
  d.life = d.max = rand(0.6, 0.9); d.s.visible = true; d.s.position.set(x, y, z); d.size = 0.25 + 0.35 * k; d.s.scale.setScalar(0.1); d.breath = true;
}
function dustPuff(x, z, size = 1) {
  for (let i = 0; i < 4; i++) {
    const d = W3.dust.find(p => p.life <= 0); if (!d) return;
    d.life = d.max = rand(0.7, 1.2); d.s.visible = true; d.s.position.set(x + rand(-0.5, 0.5), 0.2, z + rand(-0.5, 0.5)); d.size = size * rand(1, 1.8); d.s.scale.setScalar(0.3);
  }
}
function updateFx(dt) {
  for (const p of W3.fx) { if (p.life <= 0) continue; p.life -= dt; if (p.cute) { p.v.y -= 2.2 * dt; p.v.multiplyScalar(1 - 1.5 * dt); p.s.material.opacity = clamp(p.life * 3, 0, 1); p.s.position.addScaledVector(p.v, dt); if (p.life <= 0) p.s.visible = false; continue; } p.v.y -= 9.8 * dt; p.s.position.addScaledVector(p.v, dt); if (p.s.position.y < 0.02) { p.s.position.y = 0.02; p.v.y *= -0.3; p.v.x *= 0.6; p.v.z *= 0.6; } if (p.life <= 0) p.s.visible = false; }
  for (const d of W3.dust) { if (d.life <= 0) continue; d.life -= dt; const k = 1 - d.life / d.max; d.s.scale.setScalar(0.3 + d.size * k); d.s.material.opacity = (d.breath ? (W3.venue === 'castle' ? 0.55 : 0.35) : 0.6) * (1 - k); d.s.position.y += dt * (d.breath ? 0.45 : 0.3); if (d.life <= 0) d.breath = false; if (d.life <= 0) d.s.visible = false; }
}
// ---------- venues: the summer arena, an outdoor summer field, a castle courtyard at night ----------
const VENUES = {
  arena:  { key: 'arena',  name: 'Arena',          sub: 'Westerner Park, Red Deer. Concrete pad, boards and glass.' },
  field:  { key: 'field',  name: 'Summer field',   sub: 'Outdoors on packed earth, tents and a roped-off crowd.' },
  castle: { key: 'castle', name: 'Bailey Stone Lists', sub: 'Torchlit courtyard, stone walls, moon overhead.' },
};
const VTEX = {};
function venueTex(kind) {
  if (VTEX[kind]) return VTEX[kind];
  const pack = librarySurface(kind); if (pack) return VTEX[kind] = pack;
  const c = cvs(512, 512), x = c.getContext('2d');
  if (kind === 'grass') {
    x.fillStyle = '#4f6b2e'; x.fillRect(0, 0, 512, 512);
    speckle(x, 512, 512, 7000, ['#3f5a24', '#5d7a36', '#6a8a3e', '#46632a'], 0.5, 1.8);
    for (let i = 0; i < 2600; i++) { x.strokeStyle = `rgba(${rand(70, 120) | 0},${rand(100, 150) | 0},${rand(40, 70) | 0},.5)`; x.lineWidth = 1; x.beginPath(); const px = rand(0, 512), py = rand(0, 512); x.moveTo(px, py); x.lineTo(px + rand(-2, 2), py - rand(3, 7)); x.stroke(); }
    VTEX[kind] = texFrom(c, [30, 40]);
  } else if (kind === 'dirt') {
    x.fillStyle = '#8a7556'; x.fillRect(0, 0, 512, 512);
    speckle(x, 512, 512, 8000, ['#76624a', '#9a8564', '#6b583f', '#a8936f'], 0.6, 2.2);
    speckle(x, 512, 512, 40, ['#6f5c43', '#7f6a4e'], 20, 70);
    for (let i = 0; i < 70; i++) { x.strokeStyle = 'rgba(70,55,35,.1)'; x.lineWidth = rand(1, 3); x.beginPath(); const px = rand(0, 512), py = rand(0, 512); x.moveTo(px, py); x.lineTo(px + rand(-18, 18), py + rand(-18, 18)); x.stroke(); } // boot scuffs
    VTEX[kind] = texFrom(c, [4, 6]);
  } else if (kind === 'whitestone') { // dressed white stone: the castle hill
    x.fillStyle = '#bdb6a9'; x.fillRect(0, 0, 512, 512);
    for (let r = 0; r < 8; r++) for (let k = 0; k < 6; k++) { const w = 512 / 6, hgt = 512 / 8, ox = (r % 2) * w / 2; const g = rand(214, 238) | 0; x.fillStyle = `rgb(${g},${g - 3},${g - 10})`; x.fillRect(k * w + ox + 2, r * hgt + 2, w - 4, hgt - 4); x.fillRect(k * w + ox - 512 + 2, r * hgt + 2, w - 4, hgt - 4); }
    speckle(x, 512, 512, 2500, ['#cfc8ba', '#f2ede4', '#e0d9cc'], 0.5, 2);
    VTEX[kind] = texFrom(c, [10, 14]);
  } else if (kind === 'stone') {
    x.fillStyle = '#5a5c5e'; x.fillRect(0, 0, 512, 512);
    for (let r = 0; r < 8; r++) for (let k = 0; k < 6; k++) { const w = 512 / 6, hgt = 512 / 8, ox = (r % 2) * w / 2; const g = rand(70, 110) | 0; x.fillStyle = `rgb(${g},${g + 2},${g + 5})`; x.fillRect(k * w + ox + 2, r * hgt + 2, w - 4, hgt - 4); x.fillRect(k * w + ox - 512 + 2, r * hgt + 2, w - 4, hgt - 4); }
    speckle(x, 512, 512, 4000, ['#3e4143', '#7d8083', '#55585a'], 0.5, 2);
    VTEX[kind] = texFrom(c, [10, 14]);
  } else if (kind === 'wall') {
    x.fillStyle = '#4a4744'; x.fillRect(0, 0, 512, 512);
    for (let r = 0; r < 12; r++) for (let k = 0; k < 5; k++) { const w = 512 / 5, hgt = 512 / 12, ox = (r % 2) * w / 2; const g = rand(62, 96) | 0; x.fillStyle = `rgb(${g + 4},${g},${g - 4})`; x.fillRect(k * w + ox + 2, r * hgt + 2, w - 4, hgt - 3); x.fillRect(k * w + ox - 512 + 2, r * hgt + 2, w - 4, hgt - 3); }
    speckle(x, 512, 512, 3000, ['#2f2d2b', '#6d6964'], 0.5, 2);
    VTEX[kind] = texFrom(c, [6, 1.5]);
  } else if (kind === 'canvas') {
    const cols = ['#e9e1cc', '#8a1f2a']; for (let i = 0; i < 16; i++) { x.fillStyle = cols[i % 2]; x.fillRect(i * 32, 0, 32, 512); }
    speckle(x, 512, 512, 1500, ['#000'], 0.5, 2);
    VTEX[kind] = texFrom(c, [1, 1]);
  } else if (kind === 'canvas2') {
    const cols = ['#e9e1cc', '#1c3454']; for (let i = 0; i < 16; i++) { x.fillStyle = cols[i % 2]; x.fillRect(i * 32, 0, 32, 512); }
    VTEX[kind] = texFrom(c, [1, 1]);
  }
  return VTEX[kind];
}
// a crowd of simple people at the given spots
function buildCrowd(root, spots) {
  const n = spots.length; const bodyG = new THREE.BoxGeometry(0.46, 0.62, 0.34), headG = new THREE.IcosahedronGeometry(0.13, 1);
  const bodies = new THREE.InstancedMesh(bodyG, new THREE.MeshStandardMaterial({ roughness: 0.85 }), n);
  const heads = new THREE.InstancedMesh(headG, new THREE.MeshStandardMaterial({ roughness: 0.8 }), n);
  const shirt = ['#2f4b7c', '#7c2f3a', '#3a3f44', '#d6d1c4', '#526b3a', '#b87a2a', '#1f1f22', '#ff3d8b', '#3b93ff', '#6a5a8a', '#9c3d2a'], skins = ['#e0b896', '#c69373', '#8d5a3c', '#f1cfb4', '#5e3a26', '#b07b5a'];
  const col = new THREE.Color(); W3.crowdBase = [];
  spots.forEach((s, i) => { W3.crowdBase.push({ x: s[0], y: s[1], z: s[2], ph: rand(0, TAU), amp: rand(0.02, 0.06), ex: 0 }); bodies.setColorAt(i, col.set(pick(shirt))); heads.setColorAt(i, col.set(pick(skins))); });
  W3.crowd = { bodies, heads }; root.add(bodies, heads); updateCrowd(0, 0);
  // your club's supporters wave flags in its colours
  const C = CLUBS.reavers, nf = Math.floor(n / 9); if (nf > 0) {
    const fg = new THREE.PlaneGeometry(0.55, 0.36); fg.translate(0.3, 0, 0);
    const cv = cvs(64, 40), x = cv.getContext('2d'); x.fillStyle = C.tabard; x.fillRect(0, 0, 64, 40); x.fillStyle = C.trim; x.fillRect(0, 16, 64, 8); x.fillRect(28, 0, 8, 40);
    const flags = new THREE.InstancedMesh(fg, new THREE.MeshStandardMaterial({ map: texFrom(cv), side: THREE.DoubleSide, roughness: 0.9 }), nf), m4 = new THREE.Matrix4(), q = new THREE.Quaternion();
    W3.crowdFlags = []; for (let i = 0; i < nf; i++) { const s = spots[(i * 9 + 4) % n]; W3.crowdFlags.push({ x: s[0], y: s[1] + 0.95, z: s[2], ph: rand(0, TAU) }); m4.compose(new THREE.Vector3(s[0], s[1] + 0.95, s[2]), q, new THREE.Vector3(1, 1, 1)); flags.setMatrixAt(i, m4); }
    root.add(flags); W3.flagMesh = flags;
  }
}
function setVenue(key) {
  if (!VENUES[key]) key = 'arena';
  if (W3.venue === key && W3.venueRoot) return;
  if (W3.venueRoot) { W3.scene.remove(W3.venueRoot); W3.venueRoot.traverse(o => { if (o.geometry) o.geometry.dispose(); }); }
  const root = new THREE.Group(); W3.scene.add(root); W3.venueRoot = root; W3.venue = key; W3.torches = []; W3.venueExtras = [];
  const S = W3.scene;
  if (key === 'arena') {
    S.background = new THREE.Color('#0c1013'); S.fog = new THREE.Fog('#0c1013', 40, 105);
    W3.hemi.color.set('#b9c6d2'); W3.hemi.groundColor.set('#3a332b'); W3.hemi.intensity = 0.5;
    W3.sun.color.set('#fff4e4'); W3.sun.intensity = 1.45; W3.sun.position.set(7, 26, 12); W3.fill.intensity = 0.35;
    buildVenueArena(root);
  } else if (key === 'field') buildVenueField(root);
  else if (key === 'fair') buildVenueFair(root);
  else if (key === 'rink') buildVenueRink(root);
  else if (key === 'stadium') buildVenueStadium(root);
  else if (VENUES[key].build) VENUES[key].build(root);
  else buildVenueCastle(root);
  store.set('venue', key); AU.amb(key);
  if (typeof applyGfx === 'function') applyGfx();
}

function buildVenueField(root) {
  const S = W3.scene, { W, L } = LIST;
  S.background = new THREE.Color('#a9cbe8'); S.fog = new THREE.Fog('#b9d3ea', 45, 150);
  W3.hemi.color.set('#cfe3f7'); W3.hemi.groundColor.set('#4d5e2c'); W3.hemi.intensity = 0.85;
  W3.sun.color.set('#fff1d6'); W3.sun.intensity = 1.9; W3.sun.position.set(-12, 30, 10); W3.fill.intensity = 0.25;
  const grass = new THREE.Mesh(new THREE.PlaneGeometry(220, 260), new THREE.MeshStandardMaterial({ map: venueTex('grass'), roughness: 1 })); grass.rotation.x = -Math.PI / 2; grass.receiveShadow = true; root.add(grass); W3.venueGrass = grass;
  const dirt = new THREE.Mesh(new THREE.PlaneGeometry(W + 4, L + 4), new THREE.MeshStandardMaterial({ map: venueTex('dirt'), roughness: 1 })); dirt.rotation.x = -Math.PI / 2; dirt.position.y = 0.02; dirt.receiveShadow = true; root.add(dirt);
  // rope line on stakes around the list
  const RX = W / 2 + 4, RZ = L / 2 + 4, stake = new THREE.MeshStandardMaterial({ color: '#7a5a36', roughness: 0.9 }), rope = new THREE.MeshStandardMaterial({ color: '#d8ccaa', roughness: 0.9 });
  const sg = new THREE.CylinderGeometry(0.05, 0.06, 1.1, 6), stakes = [];
  for (let x = -RX; x <= RX + 0.01; x += 3) stakes.push([x, -RZ], [x, RZ]); for (let z = -RZ + 3; z <= RZ - 3 + 0.01; z += 3) stakes.push([-RX, z], [RX, z]);
  const st = new THREE.InstancedMesh(sg, stake, stakes.length); const m4 = new THREE.Matrix4(); stakes.forEach((p, i) => { m4.makeTranslation(p[0], 0.55, p[1]); st.setMatrixAt(i, m4); }); st.castShadow = true; root.add(st);
  for (const sz of [-1, 1]) { const r = new THREE.Mesh(new THREE.BoxGeometry(RX * 2, 0.03, 0.03), rope); r.position.set(0, 0.95, sz * RZ); root.add(r); }
  for (const sx of [-1, 1]) { const r = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.03, RZ * 2), rope); r.position.set(sx * RX, 0.95, 0); root.add(r); }
  // standing crowd behind the rope, three deep
  const spots = []; const n = IS_TOUCH ? 200 : 320;
  for (let i = 0; i < n; i++) { const side = i % 4, d = 1.2 + ((Math.random() * 3) | 0) * 0.8 + rand(-0.2, 0.2); let x, z; if (side < 2) { x = rand(-RX, RX); z = (side ? 1 : -1) * (RZ + d); } else { z = rand(-RZ + 2, RZ - 2); x = (side === 2 ? 1 : -1) * (RX + d); } spots.push([x, 0.95 + rand(-0.06, 0.08), z]); }
  buildCrowd(root, spots);
  // pavilions: striped tents with pennants
  const tents = [[-RX - 9, -10, 'canvas'], [-RX - 10, 4, 'canvas2'], [-RX - 9, 16, 'canvas'], [RX + 9, -14, 'canvas2'], [RX + 10, 2, 'canvas'], [RX + 9, 15, 'canvas2'], [-8, -RZ - 10, 'canvas'], [9, -RZ - 10, 'canvas2']];
  for (const [x, z, t] of tents) {
    const g = new THREE.Group(); g.position.set(x, 0, z); root.add(g);
    const mat = new THREE.MeshStandardMaterial({ map: venueTex(t), roughness: 0.9, side: THREE.DoubleSide });
    const wall = new THREE.Mesh(new THREE.CylinderGeometry(2.4, 2.4, 2.2, 16, 1, true), mat); wall.position.y = 1.1; wall.castShadow = true; g.add(wall);
    const roof = new THREE.Mesh(new THREE.ConeGeometry(2.8, 2.0, 16), mat); roof.position.y = 3.2; roof.castShadow = true; g.add(roof);
    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 1.4, 6), stake); pole.position.y = 4.6; g.add(pole);
    const flag = new THREE.Mesh(new THREE.PlaneGeometry(0.8, 0.4), new THREE.MeshStandardMaterial({ color: t === 'canvas' ? '#8a1f2a' : '#1c3454', side: THREE.DoubleSide })); flag.position.set(0.4, 5.05, 0); g.add(flag); W3.torches.push({ flag });
  }
  // a tree line on the horizon
  const trunk = new THREE.MeshStandardMaterial({ color: '#5a4430', roughness: 1 }), leaf = new THREE.MeshStandardMaterial({ color: '#3e5a2a', roughness: 1 });
  const tg = new THREE.ConeGeometry(2.6, 7, 7), kg = new THREE.CylinderGeometry(0.3, 0.4, 2, 6); const N = 60;
  const trees = new THREE.InstancedMesh(tg, leaf, N), trunks = new THREE.InstancedMesh(kg, trunk, N);
  for (let i = 0; i < N; i++) { const a = i / N * TAU + rand(-0.04, 0.04), r = rand(62, 78); const x = Math.cos(a) * r, z = Math.sin(a) * r * 1.15; const s = rand(0.8, 1.4); m4.makeScale(s, s, s).setPosition(x, 4.5 * s, z); trees.setMatrixAt(i, m4); m4.makeScale(s, s, s).setPosition(x, 1 * s, z); trunks.setMatrixAt(i, m4); }
  root.add(trees, trunks); (W3.venueExtras = W3.venueExtras || []).push(trees, trunks);
  buildHamlet(root);
  // the event banner on two poles at the far end
  const ban = new THREE.Mesh(new THREE.PlaneGeometry(12, 3), new THREE.MeshBasicMaterial({ map: TEX.banner, side: THREE.DoubleSide })); ban.position.set(0, 4.2, -RZ - 3); root.add(ban);
  for (const sx of [-1, 1]) { const p = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 6, 6), stake); p.position.set(sx * 6.1, 3, -RZ - 3); root.add(p); }
}

function buildVenueCastle(root) {
  const S = W3.scene, { W, L } = LIST;
  S.background = new THREE.Color('#0b0f1c'); S.fog = new THREE.Fog('#0b0f1c', 30, 85);
  W3.hemi.color.set('#5b6c94'); W3.hemi.groundColor.set('#1c1712'); W3.hemi.intensity = 0.42;
  W3.sun.color.set('#a9bde6'); W3.sun.intensity = 0.65; W3.sun.position.set(14, 30, -10); W3.fill.intensity = 0.12;
  const floor = new THREE.Mesh(new THREE.PlaneGeometry(90, 110), new THREE.MeshStandardMaterial({ map: venueTex('stone'), roughness: 0.95 })); floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; root.add(floor);
  const sand = new THREE.Mesh(new THREE.PlaneGeometry(W + 3, L + 3), new THREE.MeshStandardMaterial({ map: venueTex('dirt'), color: '#c9b48c', roughness: 1 })); sand.rotation.x = -Math.PI / 2; sand.position.y = 0.004; sand.receiveShadow = true; root.add(sand);
  // curtain walls with crenellations and a wall-walk crowd
  const CX = W / 2 + 9, CZ = L / 2 + 8, H = 7.5; const wm = new THREE.MeshStandardMaterial({ map: venueTex('wall'), roughness: 0.95 });
  const wall = (len, x, z, ry) => { const m = new THREE.Mesh(new THREE.BoxGeometry(len, H, 2), wm); m.position.set(x, H / 2, z); m.rotation.y = ry; m.receiveShadow = true; root.add(m); };
  wall(CX * 2 + 2, 0, -CZ, 0); wall(CX * 2 + 2, 0, CZ, 0); wall(CZ * 2 + 2, -CX, 0, Math.PI / 2); wall(CZ * 2 + 2, CX, 0, Math.PI / 2);
  const mg = new THREE.BoxGeometry(0.9, 0.9, 0.5), merl = []; const m4 = new THREE.Matrix4();
  for (let x = -CX; x <= CX; x += 1.8) merl.push([x, -CZ + 0.75, 0], [x, CZ - 0.75, 0]);
  for (let z = -CZ + 1.8; z <= CZ - 1.8; z += 1.8) merl.push([-CX + 0.75, z, 1], [CX - 0.75, z, 1]);
  const mm = new THREE.InstancedMesh(mg, wm, merl.length); merl.forEach((p, i) => { m4.makeRotationY(p[2] ? Math.PI / 2 : 0).setPosition(p[0], H + 0.45, p[1]); mm.setMatrixAt(i, m4); }); root.add(mm);
  // corner towers
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) { const t = new THREE.Mesh(new THREE.CylinderGeometry(2.6, 2.9, H + 4, 12), wm); t.position.set(sx * CX, (H + 4) / 2, sz * CZ); root.add(t); const r = new THREE.Mesh(new THREE.ConeGeometry(3.1, 3.2, 12), new THREE.MeshStandardMaterial({ color: '#2b3442', roughness: 0.8 })); r.position.set(sx * CX, H + 5.6, sz * CZ); root.add(r); }
  // hanging banners in club colours
  const banners = [['#6d1b28', -6], ['#1c3454', 6], ['#2a3d26', 0]];
  for (const [c, x] of banners) { const b = new THREE.Mesh(new THREE.PlaneGeometry(2.2, 4.6), new THREE.MeshStandardMaterial({ color: c, roughness: 0.9, side: THREE.DoubleSide })); b.position.set(x, H - 2.6, -CZ + 1.02); root.add(b); }
  const ban = new THREE.Mesh(new THREE.PlaneGeometry(10, 2.5), new THREE.MeshBasicMaterial({ map: TEX.banner })); ban.position.set(0, H + 2.4, -CZ - 0.5); root.add(ban);
  // crowd up on the walls and along the courtyard edge
  const spots = []; const n = IS_TOUCH ? 180 : 300;
  for (let i = 0; i < n; i++) {
    const side = i % 4, onWall = i % 3 !== 0;
    if (onWall) { if (side < 2) spots.push([rand(-CX + 2, CX - 2), H + 0.42 + 0.31, (side ? 1 : -1) * (CZ - 0.2)]); else spots.push([(side === 2 ? 1 : -1) * (CX - 0.2), H + 0.42 + 0.31, rand(-CZ + 2, CZ - 2)]); }
    else { const d = rand(3.5, 6.5); if (side < 2) spots.push([rand(-W / 2 - 3, W / 2 + 3), 0.95, (side ? 1 : -1) * (L / 2 + d)]); else spots.push([(side === 2 ? 1 : -1) * (W / 2 + d), 0.95, rand(-L / 2, L / 2)]); }
  }
  buildCrowd(root, spots);
  // torches: posts with flames round the list, and a few real lights
  const post = new THREE.MeshStandardMaterial({ color: '#2b2118', roughness: 0.9 });
  const flameM = new THREE.MeshBasicMaterial({ color: '#ffb347', transparent: true, opacity: 0.95 });
  const glowM = new THREE.SpriteMaterial({ map: TEX.spark, color: '#ff9a3c', blending: THREE.AdditiveBlending, depthWrite: false, transparent: true, opacity: 0.85 });
  const spotsT = []; for (const sx of [-1, 1]) for (const z of [-L / 2 + 1, -L / 4, 0, L / 4, L / 2 - 1]) spotsT.push([sx * (W / 2 + 2.2), z]);
  spotsT.push([0, -L / 2 - 2.4], [0, L / 2 + 2.4]);
  const lightIdx = new Set([0, 4, 7, 9]); // four real lights, the rest are glow
  spotsT.forEach(([x, z], i) => {
    const p = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.09, 2.2, 6), post); p.position.set(x, 1.1, z); p.castShadow = true; root.add(p);
    const bowl = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.12, 0.22, 8), MAT.steelDark); bowl.position.set(x, 2.3, z); root.add(bowl);
    const flame = new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.5, 7), flameM); flame.position.set(x, 2.62, z); root.add(flame);
    const glow = new THREE.Sprite(glowM); glow.position.set(x, 2.65, z); glow.scale.setScalar(1.6); root.add(glow);
    let light = null; if (lightIdx.has(i)) { light = new THREE.PointLight('#ff9a4a', 1.6, 16, 1.6); light.position.set(x, 2.8, z); root.add(light); }
    W3.torches.push({ flame, glow, light, ph: rand(0, TAU) });
  });
  // stars
  const sg = new THREE.BufferGeometry(); const pos = []; for (let i = 0; i < 500; i++) { const a = rand(0, TAU), e = rand(0.25, 1.3), r = 140; pos.push(Math.cos(a) * Math.cos(e) * r, Math.sin(e) * r, Math.sin(a) * Math.cos(e) * r); }
  sg.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
  root.add(new THREE.Points(sg, new THREE.PointsMaterial({ color: '#dfe8ff', size: 0.9, sizeAttenuation: true, fog: false })));
  const moon = new THREE.Mesh(new THREE.CircleGeometry(5, 24), new THREE.MeshBasicMaterial({ color: '#e8eefc', fog: false })); moon.position.set(60, 75, -80); moon.lookAt(0, 0, 0); root.add(moon);
}
// torches flicker, pennants flap
function updateCrowdFlags(t) {
  const F = W3.crowdFlags, M = W3.flagMesh; if (!F || !M || !M.parent) return; const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler(), one = new THREE.Vector3(1, 1, 1), p = new THREE.Vector3();
  for (let i = 0; i < F.length; i++) { const f = F[i]; e.set(0, Math.sin(t * 2 + f.ph) * 0.9, Math.sin(t * 3.1 + f.ph) * 0.15); q.setFromEuler(e); p.set(f.x, f.y + Math.max(0, Math.sin(t * 2.3 + f.ph)) * 0.1, f.z); m4.compose(p, q, one); M.setMatrixAt(i, m4); }
  M.instanceMatrix.needsUpdate = true;
}
function updateVenue(t) {
  updateCrowdFlags(t);
  for (const T of W3.torches || []) {
    if (T.flag) { T.flag.rotation.y = Math.sin(t * 3 + T.flag.position.x) * 0.35; continue; }
    const f = 0.85 + 0.15 * Math.sin(t * 13 + T.ph) + 0.08 * Math.sin(t * 29 + T.ph * 2);
    T.flame.scale.set(1, f * 1.1, 1); T.glow.material.opacity = 0.6 + 0.3 * f; if (T.light) T.light.intensity = 1.35 + 0.45 * f;
  }
}
// ---------- cottages, wagons and crates from Quaternius' Medieval Village MegaKit (CC0), flat-coloured ----------
const VMAT = {};
const VCOL = { MI_WoodTrim: '#6e4d31', MI_WoodTrim_Wear: '#6a4b30', MI_Plaster: '#d9ccb0', MI_RoundTiles: '#a4472a', MI_UnevenBrick: '#8d8478', MI_Brick: '#9a6a52', MI_RockTrim: '#8f877c' };
function vmat(m) { return VMAT[m.n] || (VMAT[m.n] = new THREE.MeshStandardMaterial({ color: VCOL[m.n] || new THREE.Color(m.c[0], m.c[1], m.c[2]), roughness: 0.92, flatShading: true })); }
function vpiece(parent, key, x, y, z, ry = 0, s = 1) {
  const src = typeof VILLAGE_GEO !== 'undefined' && VILLAGE_GEO[key]; if (!src) return null;
  const g = new THREE.Group(); g.position.set(x, y, z); g.rotation.y = ry; g.scale.setScalar(s); parent.add(g);
  src.mats.forEach((m, i) => {
    const gg = geo('vil:' + key + i, () => { const b = new THREE.BufferGeometry(); b.setAttribute('position', new THREE.Float32BufferAttribute(m.v.map(q => q / 100), 3)); b.setIndex(m.i); const nb = b.toNonIndexed(); nb.computeVertexNormals(); nb.setAttribute('uv', new THREE.Float32BufferAttribute(new Float32Array(nb.attributes.position.count * 2), 2)); nb.computeBoundingSphere(); return nb; });
    const me = new THREE.Mesh(gg, vmat(m)); me.castShadow = SHADOWS; me.receiveShadow = true; g.add(me);
  });
  return g;
}
// a 4x4 m (or 4x6) cottage: plaster or stone walls, a window or two, a door facing the list, a tiled roof and a chimney
function cottage(parent, x, z, ry, seed) {
  const r = seeded('cot' + seed), h = new THREE.Group(); h.position.set(x, 0, z); h.rotation.y = ry; parent.add(h);
  const long = r() < 0.5, D = long ? 3 : 2, stone = r() < 0.4;
  const plain = stone ? 'Wall_UnevenBrick_Straight' : r() < 0.5 ? 'Wall_Plaster_WoodGrid' : 'Wall_Plaster_Straight';
  const win = stone ? 'Wall_UnevenBrick_Window_Wide_Round' : 'Wall_Plaster_Window_Wide_Round';
  // front and back (along x, 2 segments), sides (along z, D segments)
  for (const [sx, nm] of [[-1, 'Wall_Plaster_Door_Round'], [1, win]]) vpiece(h, nm, sx, 0, D, 0);
  for (const sx of [-1, 1]) vpiece(h, r() < 0.5 ? win : plain, sx, 0, -D, Math.PI);
  for (let i = 0; i < D; i++) { const zc = -D + 1 + i * 2; vpiece(h, i === 1 ? win : plain, 2, 0, zc, Math.PI / 2); vpiece(h, plain, -2, 0, zc, -Math.PI / 2); }
  vpiece(h, long ? 'Roof_RoundTiles_4x6' : 'Roof_RoundTiles_4x4', 0, 3.1, 0, long ? Math.PI / 2 : 0);
  vpiece(h, 'Prop_Chimney', 1.2, 3.1, -D + 0.9, 0, 0.8);
  mergeChildren(h);
  return h;
}
function buildHamlet(root0) {
  if (typeof VILLAGE_GEO === 'undefined') return;
  const root = new THREE.Group(); root0.add(root); (W3.venueExtras = W3.venueExtras || []).push(root); // hidden in town, where the festival has its own layout
  const spots = IS_TOUCH ? [[-36, -30], [37, -26], [-38, 26], [35, 31], [-2, -50]] : [[-36, -30], [37, -26], [-38, 26], [35, 31], [-2, -50], [-20, -47], [19, 49], [46, 2], [-47, -4]];
  spots.forEach(([x, z], i) => cottage(root, x, z, Math.atan2(-x, -z) + rand(-0.25, 0.25), i));
  // a hay wagon and crates behind the tents, a fence run past the cottages
  vpiece(root, 'Prop_Wagon', -LIST.W / 2 - 13, 0, -4, 0.4);
  for (const [x, z, s] of [[-LIST.W / 2 - 11.5, 7, 1], [-LIST.W / 2 - 12.2, 8.2, 0.8], [LIST.W / 2 + 12.5, -6, 0.9], [LIST.W / 2 + 13.3, -5, 0.7]]) vpiece(root, 'Prop_Crate', x, 0, z, rand(0, 1.5), s);
  for (let i = 0; i < 8; i++) vpiece(root, 'Prop_WoodenFence_Single', -30 + i * 2.05, 0, -40, 0);
}
// ---------- flipbook effects: impact flashes, dust clouds on takedowns, star bursts for the kids ----------
const FLIP = { base: {}, pool: [] };
function flipBase(key) {
  if (FLIP.base[key] || typeof VFX_IMG === 'undefined' || !VFX_IMG[key]) return FLIP.base[key];
  const [uri, cols, rows] = VFX_IMG[key]; const img = new Image(); img.src = uri;
  return FLIP.base[key] = { img, cols, rows };
}
function flipFx(key, pos, size = 1, dur = 0.4, color = '#ffffff', additive = false) {
  const B = flipBase(key); if (!B || !W3.scene) return;
  let p = FLIP.pool.find(q => q.life <= 0);
  if (!p) { if (FLIP.pool.length >= 10) return; const s = new THREE.Sprite(new THREE.SpriteMaterial({ transparent: true, depthWrite: false })); s.renderOrder = 4; (W3.matchRoot || W3.scene).add(s); p = { s, life: 0, tex: {} }; FLIP.pool.push(p); }
  if (!p.tex[key]) { const t = new THREE.Texture(B.img); t.encoding = THREE.sRGBEncoding; t.repeat.set(1 / B.cols, 1 / B.rows); if (B.img.complete) t.needsUpdate = true; else B.img.addEventListener('load', () => t.needsUpdate = true, { once: true }); p.tex[key] = t; }
  const m = p.s.material; m.map = p.tex[key]; m.color.set(color); m.blending = additive ? THREE.AdditiveBlending : THREE.NormalBlending; m.opacity = 1; m.rotation = rand(0, TAU); m.needsUpdate = true;
  p.key = key; p.B = B; p.life = p.dur = dur; p.s.position.copy(pos); p.s.scale.setScalar(size); p.s.visible = true;
}
function updateFlip(dt) {
  for (const p of FLIP.pool) {
    if (p.life <= 0) continue; p.life -= dt; if (p.life <= 0) { p.s.visible = false; continue; }
    const n = p.B.cols * p.B.rows, f = Math.min(n - 1, Math.floor((1 - p.life / p.dur) * n)), t = p.tex[p.key];
    t.offset.set((f % p.B.cols) / p.B.cols, 1 - (Math.floor(f / p.B.cols) + 1) / p.B.rows);
    if (p.key === 'cloud') { p.s.position.y += dt * 0.25; p.s.material.opacity = Math.min(1, p.life / p.dur * 2) * 0.8; }
  }
}
// ---------- weather: rain (slick footing, a hiss on the PA) and snow; plus armour that scuffs, dulls and muddies ----------
const WX = { kind: 'clear', obj: null, n: 0, pos: null, vel: null, noise: null };
function setWeather(kind) {
  kind = kind === 'random' ? pick(['clear', 'clear', 'rain', 'snow']) : (kind || 'clear');
  if (W3.venue === 'arena') kind = 'clear'; // the hockey arena has a roof
  if (WX.obj) { W3.scene.remove(WX.obj); WX.obj.geometry.dispose(); WX.obj = null; }
  WX.kind = kind; W3.weather = kind;
  if (WX.noise) { try { WX.noise.g.gain.setTargetAtTime(0, AU.ctx.currentTime, 0.5); const s = WX.noise.s; setTimeout(() => { try { s.stop(); } catch (e) { } }, 1500); } catch (e) { } WX.noise = null; }
  if (kind === 'clear') { applyVenueLight(); return; }
  const N = WX.n = IS_TOUCH ? 900 : 1800, rain = kind === 'rain';
  const g = new THREE.BufferGeometry(), p = new Float32Array(N * (rain ? 6 : 3)); WX.pos = p; WX.vel = new Float32Array(N);
  for (let i = 0; i < N; i++) { const x = rand(-22, 22), y = rand(0, 16), z = rand(-26, 26); WX.vel[i] = rain ? rand(12, 16) : rand(0.6, 1.3); if (rain) p.set([x, y, z, x + 0.03, y + 0.38, z], i * 6); else p.set([x, y, z], i * 3); }
  g.setAttribute('position', new THREE.BufferAttribute(p, 3));
  WX.obj = rain ? new THREE.LineSegments(g, new THREE.LineBasicMaterial({ color: '#b8cde0', transparent: true, opacity: 0.6, depthWrite: false }))
    : new THREE.Points(g, new THREE.PointsMaterial({ color: '#ffffff', size: 0.09, transparent: true, opacity: 0.9, depthWrite: false }));
  WX.obj.frustumCulled = false; W3.scene.add(WX.obj); applyVenueLight();
  if (rain && AU.ctx && AU.noiseBuf) { const s = AU.ctx.createBufferSource(); s.buffer = AU.noiseBuf; s.loop = true; const f = AU.ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 2600; f.Q.value = 0.4; const gg = AU.ctx.createGain(); gg.gain.value = 0; gg.gain.setTargetAtTime(0.07, AU.ctx.currentTime, 1); s.connect(f); f.connect(gg); gg.connect(AU.master); s.start(); WX.noise = { s, g: gg }; }
}
// greyer sky and softer sun in rain, colder light in snow
function applyVenueLight() {
  // Outdoor weather must not restore the surface fog distance underground.
  // In particular, near=70 with the mine's far=65 hides the whole chamber.
  if (typeof TOWN !== 'undefined' && TOWN.on && TOWN.mineOn) {
    W3.sun.intensity = 0.12; W3.hemi.intensity = 0.35;
    if (W3.scene.fog) { W3.scene.fog.near = 9; W3.scene.fog.far = 65; }
    if (WX.obj) WX.obj.visible = false;
    return;
  }
  if (WX.obj) WX.obj.visible = true;
  if (!W3.sun) return; const base = W3.sunBase || (W3.sunBase = { i: W3.sun.intensity, v: W3.venue });
  if (base.v !== W3.venue) { base.i = W3.sun.intensity; base.v = W3.venue; }
  W3.sun.intensity = base.i * (WX.kind === 'rain' ? 0.55 : WX.kind === 'snow' ? 0.8 : 1);
  const fg = W3.scene.fog; if (fg) { if (fg.userData === undefined || fg.userData.v !== W3.venue || fg.userData.fog !== fg) { W3.fogBase = { v: W3.venue, near: fg.near, fog: fg }; fg.userData = W3.fogBase; } fg.near = WX.kind !== 'clear' && W3.venue !== 'arena' ? (WX.kind === 'rain' ? 25 : 30) : W3.fogBase.near; }
}
function updateWeather(dt) {
  if (!WX.obj || dt <= 0) return; const p = WX.pos, rain = WX.kind === 'rain', st = rain ? 6 : 3, t = G.realTime;
  for (let i = 0; i < WX.n; i++) {
    const o = i * st; let y = p[o + 1] - WX.vel[i] * dt;
    if (rain) { if (y < 0) { y = rand(12, 16); } p[o + 1] = y; p[o + 4] = y + 0.38; }
    else { p[o] += Math.sin(t * 0.7 + i) * dt * 0.3; if (y < 0) y = rand(12, 16); p[o + 1] = y; }
  }
  WX.obj.geometry.attributes.position.needsUpdate = true;
  if (W3.camera) WX.obj.position.set(Math.round(W3.camera.position.x / 8) * 8 * 0, 0, 0);
}
function weatherStab() { return (WX.kind === 'rain' ? 0.9 : WX.kind === 'snow' ? 0.94 : 1) * (W3.venue === 'rink' ? 0.9 : 1); } // ice is slick

// ---- battle wear: each fighter's steel dulls and darkens as their kit takes damage, and picks up mud on the field ----
const WEAR_COL = { dull: new THREE.Color('#858c8f'), snow: new THREE.Color('#dfe6ea'), mud: new THREE.Color('#6d5c45') };
function wearUpdate(f, dt) {
  const J = f.model; if (!J || !J.steelMat) return;
  f.wearT = (f.wearT || 0) - dt; if (f.wearT > 0) return; f.wearT = 0.5;
  const k = f.kit, avg = (k.helmet.cond + k.armL.cond + k.armR.cond + k.legs.cond) / 4, dmg = clamp(1 - avg, 0, 1);
  const mud = clamp(f.mud || 0, 0, 1) * (W3.venue === 'field' ? 1 : 0.35);
  const c = J.steelMat.color; c.set('#c3cacd').lerp(WEAR_COL.dull, dmg * 0.8).lerp(WX.kind === 'snow' ? WEAR_COL.snow : WEAR_COL.mud, mud * 0.55);
  J.steelMat.roughness = 0.3 + dmg * 0.35 + mud * 0.3 + (WX.kind === 'rain' ? -0.12 : 0); J.steelMat.metalness = 0.92 - mud * 0.4;
}
// ---------- more venues: a rainy medieval fair, a winter outdoor rink, and the floodlit stadium final ----------
Object.assign(VENUES, {
  fair: { key: 'fair', name: 'Medieval fair', sub: 'Market stalls, bunting and grey skies over the fairground.', weather: 'rain' },
  rink: { key: 'rink', name: 'Winter rink', sub: 'An outdoor rink at dusk, snowbanks and string lights.', weather: 'snow' },
  stadium: { key: 'stadium', name: 'Stadium final', sub: 'Floodlights, a packed bowl and the Prairie Cup on the line.' },
});
function buildVenueFair(root) {
  buildVenueField(root);
  const S = W3.scene; S.background = new THREE.Color('#9aa6ad'); S.fog = new THREE.Fog('#a3adb3', 35, 120);
  W3.hemi.color.set('#c5cdd2'); W3.hemi.intensity = 0.75; W3.sun.intensity = 1.0; W3.sun.color.set('#e8eef2');
  const { W, L } = LIST, stripes = [['#8a1f2a', '#e8e1cf'], ['#1c3454', '#e8e1cf'], ['#2a5a2a', '#f2c40f'], ['#5a2a6a', '#e8e1cf']];
  const wood = new THREE.MeshStandardMaterial({ color: '#6b4a2e', roughness: 0.9 }), goods = ['#c9a227', '#8a1f2a', '#d6d1c4', '#526b3a', '#b87a2a'];
  for (let i = 0; i < 12; i++) { // market stalls in a loose ring behind the crowd
    const a = i / 12 * TAU + 0.15, r = 27 + (i % 3) * 2.5, x = Math.sin(a) * r * 0.85, z = Math.cos(a) * r;
    const g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = a + Math.PI; root.add(g);
    mk(g, geo('stallT', () => new THREE.BoxGeometry(3, 0.9, 1.4)), wood, 0, 0.45, 0);
    for (const sx of [-1.4, 1.4]) for (const sz of [-0.6, 0.6]) mk(g, geo('stallP', () => new THREE.BoxGeometry(0.1, 2.4, 0.1)), wood, sx, 1.2, sz);
    const [c1, c2] = stripes[i % stripes.length]; const cv = cvs(64, 64), x2 = cv.getContext('2d'); for (let s = 0; s < 8; s++) { x2.fillStyle = s % 2 ? c1 : c2; x2.fillRect(s * 8, 0, 8, 64); }
    const aw = mk(g, geo('awn', () => new THREE.BoxGeometry(3.4, 0.08, 1.9)), new THREE.MeshStandardMaterial({ map: texFrom(cv), roughness: 0.9 }), 0, 2.45, 0.15); aw.rotation.x = -0.2;
    for (let k = 0; k < 4; k++) mk(g, geo('good', () => new THREE.BoxGeometry(0.4, 0.3, 0.4)), new THREE.MeshStandardMaterial({ color: goods[(i + k) % goods.length], roughness: 0.8 }), -1.1 + k * 0.7, 1.05, 0);
  }
}
function buildVenueRink(root) {
  const S = W3.scene, { W, L } = LIST;
  S.background = new THREE.Color('#2b2d4a'); S.fog = new THREE.Fog('#3a3c5c', 35, 110);
  W3.hemi.color.set('#aab6e0'); W3.hemi.groundColor.set('#e6ecf2'); W3.hemi.intensity = 0.7;
  W3.sun.color.set('#ffd2b0'); W3.sun.intensity = 0.9; W3.sun.position.set(-20, 14, -12); W3.fill.intensity = 0.3;
  const snow = new THREE.Mesh(new THREE.PlaneGeometry(220, 260), new THREE.MeshStandardMaterial({ color: '#eef2f6', roughness: 0.95 })); snow.rotation.x = -Math.PI / 2; snow.receiveShadow = true; root.add(snow);
  const ice = new THREE.Mesh(new THREE.PlaneGeometry(W + 6, L + 6), new THREE.MeshStandardMaterial({ color: '#d9ecf5', roughness: 0.18, metalness: 0.05 })); ice.rotation.x = -Math.PI / 2; ice.position.y = 0.02; ice.receiveShadow = true; root.add(ice);
  // snowbanks around the boards, a crowd in parkas, pines and string lights
  const bankM = new THREE.MeshStandardMaterial({ color: '#f4f7fa', roughness: 1 });
  for (let i = 0; i < 40; i++) { const a = i / 40 * TAU, x = Math.sin(a) * (W / 2 + 6.5) * 1.05, z = Math.cos(a) * (L / 2 + 6.5); const b = mk(root, geo('bank', () => new THREE.SphereGeometry(1.6, 10, 6, 0, TAU, 0, Math.PI / 2)), bankM, x, 0, z); b.scale.set(1.3, rand(0.4, 0.7), 1); }
  const spots = []; const RX = W / 2 + 4, RZ = L / 2 + 4; for (let i = 0; i < (IS_TOUCH ? 160 : 260); i++) { const side = i % 4, d = 1.2 + ((Math.random() * 3) | 0) * 0.8; let x, z; if (side < 2) { x = rand(-RX, RX); z = (side ? 1 : -1) * (RZ + d); } else { z = rand(-RZ + 2, RZ - 2); x = (side === 2 ? 1 : -1) * (RX + d); } spots.push([x, 0.95, z]); }
  buildCrowd(root, spots);
  const pine = new THREE.MeshStandardMaterial({ color: '#2c4a36', roughness: 1 }), trunk = new THREE.MeshStandardMaterial({ color: '#4a3626' });
  const N = 50, tg = new THREE.ConeGeometry(2.4, 8, 7), trees = new THREE.InstancedMesh(tg, pine, N), m4 = new THREE.Matrix4();
  for (let i = 0; i < N; i++) { const a = i / N * TAU, r = rand(48, 70), s = rand(0.8, 1.3); m4.makeScale(s, s, s).setPosition(Math.cos(a) * r, 4 * s, Math.sin(a) * r * 1.1); trees.setMatrixAt(i, m4); } root.add(trees);
  const bulbCols = ['#ffd27a', '#ff6a6a', '#7fd8ff', '#9cff8a'];
  for (const [ax, az, bx, bz] of [[-W / 2 - 2, -L / 2 - 2, W / 2 + 2, -L / 2 - 2], [-W / 2 - 2, L / 2 + 2, W / 2 + 2, L / 2 + 2]]) for (let k = 0; k <= 24; k++) { const t = k / 24; const b = mk(root, geo('bulb', () => new THREE.SphereGeometry(0.07, 6, 4)), new THREE.MeshBasicMaterial({ color: bulbCols[k % 4] }), lerp(ax, bx, t), 4.2 - Math.sin(Math.PI * t) * 0.8, lerp(az, bz, t), false); }
  const glow = new THREE.PointLight('#ffcf8a', 0.8, 40); glow.position.set(0, 6, 0); root.add(glow);
}
function buildVenueStadium(root) {
  const S = W3.scene, { W, L } = LIST;
  S.background = new THREE.Color('#05070c'); S.fog = new THREE.Fog('#05070c', 60, 150);
  W3.hemi.color.set('#9fb0c8'); W3.hemi.groundColor.set('#202020'); W3.hemi.intensity = 0.55;
  W3.sun.color.set('#ffffff'); W3.sun.intensity = 1.8; W3.sun.position.set(0, 40, 8); W3.fill.intensity = 0.45;
  const turf = new THREE.Mesh(new THREE.PlaneGeometry(120, 150), new THREE.MeshStandardMaterial({ color: '#2f5a2a', roughness: 1 })); turf.rotation.x = -Math.PI / 2; turf.receiveShadow = true; root.add(turf);
  const pad = new THREE.Mesh(new THREE.PlaneGeometry(W + 4, L + 4), new THREE.MeshStandardMaterial({ map: TEX.concrete, roughness: 0.9 })); pad.rotation.x = -Math.PI / 2; pad.position.y = 0.02; pad.receiveShadow = true; root.add(pad);
  // the bowl: rings of seating stepping up, packed with fans
  const seatM = new THREE.MeshStandardMaterial({ color: '#30343a', roughness: 0.9 }); const spots = [];
  for (let r = 0; r < 9; r++) { const rx = 22 + r * 2.2, rz = 28 + r * 2.2, y = 0.6 + r * 1.1;
    const ring = new THREE.Mesh(new THREE.TorusGeometry(1, 0.06, 4, 48), seatM); ring.scale.set(rx, rz, 12); ring.rotation.x = Math.PI / 2; ring.position.y = y - 0.3; root.add(ring);
    const n = IS_TOUCH ? 40 : 70; for (let i = 0; i < n; i++) { const a = i / n * TAU + r * 0.05; spots.push([Math.cos(a) * rx, y + 0.35, Math.sin(a) * rz]); } }
  buildCrowd(root, spots);
  const towerM = new THREE.MeshStandardMaterial({ color: '#6d747a', metalness: 0.6, roughness: 0.5 });
  for (const [x, z] of [[-30, -36], [30, -36], [-30, 36], [30, 36]]) { mk(root, geo('ftower', () => new THREE.CylinderGeometry(0.4, 0.6, 26, 8)), towerM, x, 13, z); const lamp = mk(root, geo('flamp', () => new THREE.BoxGeometry(4, 2, 0.6)), new THREE.MeshBasicMaterial({ color: '#fffbe6' }), x, 26.5, z, false); lamp.lookAt(0, 0, 0); }
  const c = cvs(1024, 256), x = c.getContext('2d'); x.fillStyle = '#0f1316'; x.fillRect(0, 0, 1024, 256); x.fillStyle = '#f2c40f'; x.fillRect(0, 0, 1024, 12); x.fillRect(0, 244, 1024, 12); x.fillStyle = '#ece8de'; x.textAlign = 'center'; x.font = '900 120px "Big Shoulders Display", Impact, sans-serif'; x.fillText('PRAIRIE CUP FINAL', 512, 160);
  const ban = new THREE.Mesh(new THREE.PlaneGeometry(16, 4), new THREE.MeshBasicMaterial({ map: texFrom(c) })); ban.position.set(0, 12, -48); root.add(ban);
}
// ---------- the realm's arenas as venues you can fight in: Peasants' arena, Forest arena, Beach arena, the Great Hall ----------
// (the Dome is the summer field's list, the Castle arena is the castle courtyard)
Object.assign(VENUES, {
  peasant: { key: 'peasant', name: 'Millbrook Mudlists', sub: 'Millbrook village: mud, hay bales and the pigs watching.', build: buildVenuePeasant },
  forest: { key: 'forest', name: 'Old Woods Clearing', sub: 'A glade in the Old Woods, a log fence and torches.', build: buildVenueForest },
  beach: { key: 'beach', name: 'Mirror Lake Strand', sub: 'Mirror Lake’s sandy shore, driftwood and gulls.', build: buildVenueBeach },
  hall: { key: 'hall', name: 'King’s Great Hall', sub: 'Inside the keep: banners, chandeliers and the king watching.', build: buildVenueHall },
  training: { key: 'training', name: 'Fairground Training Yard', sub: 'A quiet practice list with pells and a coach.', build: buildVenueTraining, practice: true }
});
function v3ring(root, keys, n, r0, r1, seed, s0, s1) {
  const rnd = seeded(seed);
  for (let i = 0; i < n; i++) { const a = rnd() * TAU, r = r0 + rnd() * (r1 - r0); const x = Math.cos(a) * r * 0.85, z = Math.sin(a) * r; if (Math.abs(x) < LIST.W / 2 + 9 && Math.abs(z) < LIST.L / 2 + 9) continue; kpiece(root, keys[Math.floor(rnd() * keys.length)], x, 0, z, rnd() * TAU, s0 + rnd() * (s1 - s0)); }
}
function v3plane(root, w, l, col, tex, y) { const m = new THREE.Mesh(new THREE.PlaneGeometry(w, l), new THREE.MeshStandardMaterial({ map: tex ? venueTex(tex) : null, color: col, roughness: 1 })); m.rotation.x = -Math.PI / 2; m.position.y = y; m.receiveShadow = true; root.add(m); return m; }
function buildVenueTraining(root) {
  const S = W3.scene;
  S.background = new THREE.Color('#a9cbe8'); S.fog = new THREE.Fog('#b9d3ea', 45, 145);
  W3.hemi.color.set('#cfe3f7'); W3.hemi.groundColor.set('#4d5e2c'); W3.hemi.intensity = 0.85;
  W3.sun.color.set('#fff1d6'); W3.sun.intensity = 1.9; W3.sun.position.set(-12, 30, 10); W3.fill.intensity = 0.25;
  v3plane(root, 180, 200, '#86a86b', 'grass', 0);
  v3plane(root, LIST.W + 4, LIST.L + 4, '#b08d62', 'dirt', 0.03);
  for (const x of [-16, 16]) for (const z of [-9, 0, 9]) kpiece(root, 'mk_Dummy', x, 0, z, x < 0 ? Math.PI / 2 : -Math.PI / 2, 1);
  for (const [key, x, z, ry, scale] of [['dp_weapon_rack', -19, 18, Math.PI / 2, 1], ['dp_bench', 18, 18, -Math.PI / 2, 1], ['slv_tower', -33, -28, 0.3, 1], ['ps_tent', 30, 24, 0, 1.2]]) kpiece(root, key, x, 0, z, ry, scale);
  v3ring(root, ['kf_tree_1_a', 'kf_tree_3_b', 'kf_bush_3_a'], IS_TOUCH ? 14 : 28, 42, 72, 'trainingv', 1, 1.4);
}
function buildVenuePeasant(root) {
  buildVenueField(root);
  const { W, L } = LIST;
  v3plane(root, W + 3, L + 3, '#6b5236', 'dirt', 0.03);
  for (let i = 0; i < 14; i++) { const a = i / 14 * TAU, x = Math.cos(a) * (W / 2 + 7), z = Math.sin(a) * (L / 2 + 7); kpiece(root, i % 3 ? 'cr_wheat_crop' : 'mk_Barrel', x, 0, z, a, i % 3 ? 1.2 : 1.1); }
  const hay = new THREE.MeshStandardMaterial({ color: '#d8bf6a', roughness: 1 }), hg = new THREE.CylinderGeometry(0.6, 0.6, 1.1, 14);
  for (let i = 0; i < 12; i++) { const m = new THREE.Mesh(hg, hay); m.rotation.z = Math.PI / 2; m.position.set((i % 2 ? 1 : -1) * (W / 2 + 5.4), 0.6, -L / 2 + 3 + i * 2.2); m.castShadow = true; root.add(m); }
  for (const [k, x, z, r] of [['fb_barn', -34, -18, 1.2], ['fb_smallbarn', 30, -30, -0.8], ['fb_windmill', 36, 22, -1.4], ['fb_chickencoop', -30, 24, 0.6], ['fb_well', 22, 34, 0], ['fb_silo', -40, 6, 0]]) kpiece(root, k, x, 0, z, r, 1.6);
  v3ring(root, ['kf_tree_1_c', 'kf_tree_2_c', 'kf_bush_1_a'], IS_TOUCH ? 20 : 40, 48, 80, 'peasantv', 1, 1.5);
}
function buildVenueForest(root) {
  buildVenueField(root);
  const S = W3.scene; S.background = new THREE.Color('#9fbcc9'); S.fog = new THREE.Fog('#7f9a7a', 30, 95); W3.sun.intensity = 1.4; W3.hemi.color.set('#b9d6b0');
  const { W, L } = LIST;
  v3plane(root, W + 3, L + 3, '#6e7a48', 'grass', 0.03);
  for (let i = 0; i < 12; i++) { const a = i / 12 * TAU; kpiece(root, 'nt_log', Math.cos(a) * (W / 2 + 6), 0, Math.sin(a) * (L / 2 + 6), a + Math.PI / 2, 1.5); }
  v3ring(root, ['kf_tree_1_c', 'kf_tree_2_c', 'kf_tree_2_d', 'kf_tree_3_b', 'kf_tree_4_b', 'kf_tree_1_b', 'kf_bush_1_a', 'kf_rock_3_e'], IS_TOUCH ? 60 : 120, 26, 75, 'forestv', 1, 1.8);
}
function buildVenueBeach(root) {
  buildVenueField(root);
  const S = W3.scene; S.background = new THREE.Color('#9fd0f0'); S.fog = new THREE.Fog('#bfe0f4', 50, 170); W3.sun.intensity = 2.0;
  const { W, L } = LIST;
  v3plane(root, 230, 270, '#d8c690', 'dirt', 0.01);
  v3plane(root, W + 3, L + 3, '#cdb67c', 'dirt', 0.03);
  const water = v3plane(root, 260, 120, '#4f8fb8', null, 0.05); water.position.set(0, 0.05, -L / 2 - 75); water.material.roughness = 0.2; water.material.metalness = 0.1;
  for (const [k, x, z, r, s] of [['rt_dock_side', -12, -L / 2 - 18, 0, 3], ['rt_dock_side', -12, -L / 2 - 24, 0, 3], ['nt_log', W / 2 + 7, 4, 0.4, 1.6], ['nt_log', -W / 2 - 8, -6, 1.2, 1.6], ['rt_barrels', W / 2 + 9, -12, 0, 2.5], ['fy_rock_big_1', -40, 20, 0.5, 1.6], ['fy_rock_big_3', 44, 10, 1.2, 1.4]]) kpiece(root, k, x, 0, z, r, s);
  v3ring(root, ['kf_tree_4_b', 'kf_tree_4_c', 'kf_bush_4_a'], IS_TOUCH ? 14 : 28, 50, 85, 'beachv', 1, 1.4);
}
function buildVenueHall(root) {
  buildVenueCastle(root);
  const S = W3.scene; S.background = new THREE.Color('#1a120c'); S.fog = new THREE.Fog('#1a120c', 30, 80);
  W3.hemi.color.set('#ffd9a6'); W3.hemi.groundColor.set('#2a1c12'); W3.hemi.intensity = 0.62; W3.sun.color.set('#ffcf8a'); W3.sun.intensity = 0.9; W3.sun.position.set(6, 30, 8); W3.fill.intensity = 0.25;
  const { W, L } = LIST, CX = W / 2 + 9, CZ = L / 2 + 8;
  // a timber roof on great beams, stone pillars, a royal dais, banners and chandeliers
  const wood = new THREE.MeshStandardMaterial({ color: '#4a3020', roughness: 0.9 }), stone = new THREE.MeshStandardMaterial({ map: venueTex('wall'), roughness: 0.95 });
  const roof = new THREE.Mesh(new THREE.BoxGeometry(CX * 2 + 4, 0.6, CZ * 2 + 4), wood); roof.position.y = 13.5; root.add(roof);
  for (let z = -CZ + 4; z <= CZ - 4; z += 6) { const b = new THREE.Mesh(new THREE.BoxGeometry(CX * 2, 0.7, 0.6), wood); b.position.set(0, 12.6, z); root.add(b); }
  for (const sx of [-1, 1]) for (let z = -CZ + 4; z <= CZ - 4; z += 8) { const p = new THREE.Mesh(new THREE.CylinderGeometry(0.7, 0.8, 12.6, 10), stone); p.position.set(sx * (CX - 3), 6.3, z); p.castShadow = true; root.add(p); }
  const dais = new THREE.Mesh(new THREE.BoxGeometry(10, 0.8, 4), stone); dais.position.set(0, 0.4, -CZ + 3.5); root.add(dais);
  kpiece(root, 'mk_Chair_1', 0, 0.8, -CZ + 3.5, 0, 2.2); kpiece(root, 'rp_crown', 0, 3.2, -CZ + 3.5, 0, 1);
  for (const [c, x] of [['#5b2a86', -9], ['#8a6a12', 9], ['#1c2a5a', -15], ['#6d1b28', 15]]) { const b = new THREE.Mesh(new THREE.PlaneGeometry(2.4, 6), new THREE.MeshStandardMaterial({ color: c, roughness: 0.9, side: THREE.DoubleSide })); b.position.set(x, 8, -CZ + 1.1); root.add(b); }
  for (const z of [-10, 0, 10]) { kpiece(root, 'mk_Chandelier', 0, 9.5, z, 0, 2.4); const l = new THREE.PointLight('#ffb35a', 0.6, 26, 2); l.position.set(0, 9, z); root.add(l); }
}
// ---------- procedural armoured fighters, marshals, support crew ----------
const GEO = {};
function geo(key, make) { return GEO[key] || (GEO[key] = make()); }
function mk(parent, g, mat, x = 0, y = 0, z = 0, cast = true) { const m = new THREE.Mesh(g, mat); m.position.set(x, y, z); m.castShadow = cast; m.receiveShadow = false; parent.add(m); return m; }
function grp(parent, x = 0, y = 0, z = 0) { const g = new THREE.Group(); g.position.set(x, y, z); parent.add(g); return g; }
function lathe(pts, seg = 16) { return new THREE.LatheGeometry(pts.map(p => new THREE.Vector2(p[0], p[1])), seg); }

function buildHelmet(head, type, S = MAT.steel) {
  const skull = () => mk(head, geo('bas', () => lathe([[0, 0.31], [0.035, 0.3], [0.085, 0.26], [0.122, 0.19], [0.136, 0.11], [0.132, 0.02], [0.12, -0.03]])), S, 0, 0, 0);
  const aventail = () => mk(head, geo('avent', () => new THREE.CylinderGeometry(0.13, 0.21, 0.15, 14, 1, true)), MAT.mail, 0, -0.08, 0);
  const dot = (x, y, z) => mk(head, geo('perf', () => new THREE.SphereGeometry(0.008, 4, 3)), MAT.slit, x, y, z, false);
  if (type === 'greathelm') {
    mk(head, geo('gh', () => new THREE.CylinderGeometry(0.135, 0.128, 0.32, 16)), S, 0, 0.11, 0);
    mk(head, geo('ghtop', () => new THREE.SphereGeometry(0.135, 16, 8, 0, TAU, 0, Math.PI / 2)), S, 0, 0.27, 0).scale.y = 0.35;
    mk(head, geo('slit', () => new THREE.BoxGeometry(0.21, 0.016, 0.03)), MAT.slit, 0, 0.16, 0.124, false);
    mk(head, geo('ghv', () => new THREE.BoxGeometry(0.03, 0.26, 0.025)), MAT.brass, 0, 0.1, 0.131, false);
    mk(head, geo('ghh', () => new THREE.BoxGeometry(0.25, 0.022, 0.02)), MAT.brass, 0, 0.185, 0.13, false);
    for (let i = 0; i < 3; i++) for (let j = 0; j < 2; j++) dot(0.045 + i * 0.018, 0.02 + j * 0.03, 0.13);
  } else if (type === 'sallet') {
    const sk = mk(head, geo('sal', () => new THREE.SphereGeometry(0.142, 16, 10, 0, TAU, 0, Math.PI * 0.58)), S, 0, 0.1, -0.015); sk.scale.set(1, 1.05, 1.28);
    mk(head, geo('bev', () => new THREE.CylinderGeometry(0.125, 0.1, 0.15, 14, 1, false, -Math.PI * 0.62, Math.PI * 1.24)), S, 0, 0.0, 0.0);
    mk(head, geo('slit2', () => new THREE.BoxGeometry(0.2, 0.02, 0.04)), MAT.slit, 0, 0.085, 0.118, false);
    mk(head, geo('salbr', () => new THREE.BoxGeometry(0.2, 0.012, 0.02)), MAT.brass, 0, 0.11, 0.13, false);
  } else if (type === 'barbute') {
    mk(head, geo('bar', () => lathe([[0, 0.29], [0.06, 0.28], [0.112, 0.23], [0.137, 0.13], [0.136, 0.02], [0.124, -0.07]])), S, 0, 0, 0);
    mk(head, geo('barv', () => new THREE.BoxGeometry(0.038, 0.15, 0.04)), MAT.slit, 0, 0.03, 0.12, false);
    mk(head, geo('barh', () => new THREE.BoxGeometry(0.15, 0.036, 0.04)), MAT.slit, 0, 0.11, 0.115, false);
  } else if (type === 'kettle') {
    mk(head, geo('kcrown', () => new THREE.SphereGeometry(0.128, 14, 8, 0, TAU, 0, Math.PI / 2)), S, 0, 0.13, 0).scale.y = 1.15;
    mk(head, geo('kbrim', () => new THREE.CylinderGeometry(0.215, 0.24, 0.014, 22)), S, 0, 0.13, 0);
    mk(head, geo('kface', () => new THREE.SphereGeometry(0.1, 10, 8)), MAT.gambeson, 0, 0.08, 0.01);
    mk(head, geo('kbev', () => new THREE.CylinderGeometry(0.125, 0.11, 0.13, 14, 1, false, -Math.PI * 0.6, Math.PI * 1.2)), S, 0, 0.0, 0.0);
    aventail();
  } else if (type === 'grill') {
    skull(); aventail();
    mk(head, geo('gface', () => new THREE.SphereGeometry(0.1, 10, 8)), MAT.slit, 0, 0.08, 0.04, false);
