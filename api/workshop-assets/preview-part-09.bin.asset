    let a = angTo(tg.pos, f.pos);
    if (flank) { const behind = tg.facing + Math.PI; a = behind + clamp(angDiff(behind, a), -1.3, 1.3); }
    a += ai.strafe * 0.25;
    gx = tg.pos.x + Math.sin(a) * want; gz = tg.pos.z + Math.cos(a) * want;
