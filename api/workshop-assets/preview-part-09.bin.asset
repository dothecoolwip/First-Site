function townTalk(S) { if (!townInteractionActive(S)) { TOWN.near=null; townPrompt(); return; } if (typeof playtestAction === 'function') playtestAction('interact', { target: S.V.name, role: S.V.role || '' }); if (typeof questEvent === 'function') questEvent('talk', { key: S.V.key }); if (S.open) S.open(); else openVendor(S.V.key); }
