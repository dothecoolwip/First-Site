  el.setAttribute('aria-label', `Waypoint ${W.label}, ${Math.round(d)} metres. ${direction}.`);
  const a = el.querySelector('.wpauto'); a.textContent = TRAVEL.auto ? 'Stop' : 'Walk there'; a.classList.toggle('on', TRAVEL.auto);
