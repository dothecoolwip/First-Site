// ---------- Rumble of the Day (same fight for everyone on a date) and the Gauntlet run (five fights, one life) ----------

// match modifiers: G.mod applies to everyone, G.boon only to you (Gauntlet boons)

function mod(f, key) { return ((G.mod && G.mod[key]) || 1) * (f && f.isPlayer && G.boon && G.boon[key] || 1); }

function dateKey(d = new Date()) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }

function dayNumber(d = new Date()) { return Math.floor((new Date(d.getFullYear(), d.getMonth(), d.getDate()) - new Date(2026, 0, 1)) / 864e5) + 1; }



const DAILY_MODS = [

  { key: 'rain', icon: '🌧️', name: 'Rain on the field', desc: 'Wet grass: everyone is less steady on their feet.', venue: 'field', mod: { stab: 0.88 } },

  { key: 'tape', icon: '🩹', name: 'Tape shortage', desc: 'Half the usual time at the repair bench.', mod: { repair: 0.5 } },

  { key: 'heat', icon: '🥵', name: 'Heat wave', desc: 'Fatigue builds half again as fast.', mod: { fat: 1.5 } },

  { key: 'heavy', icon: '🔨', name: 'Heavy hitters', desc: 'Every blow lands 15% harder.', mod: { imp: 1.15 } },

  { key: 'night', icon: '🔥', name: 'Torchlight', desc: 'A night fight in the castle yard.', venue: 'castle', mod: {} },

  { key: 'kids', icon: '🧸', name: 'Little Knights day', desc: 'Youth division. Foam kit, rubber swords.', cat: 'youth', mod: {} },

  { key: 'noshield', icon: '⚔️', name: 'Two-hander day', desc: 'Nobody gets a shield.', mod: { noshield: true } },

  { key: 'duel', icon: '🎯', name: 'Duel day', desc: 'One on one. Points by where you hit.', mode: 1, mod: {} },

];

function dailyPlan(key = dateKey()) {

  const r = seeded('BUHURT' + key);

  const M = DAILY_MODS[Math.floor(r() * DAILY_MODS.length)];

  const mode = M.mode || [3, 5, 5, 2][Math.floor(r() * 4)];

  const opp = mode === 1 ? 'ladder' + (2 + Math.floor(r() * 4)) : ['wardens', 'rabble'][Math.floor(r() * 2)];

  const venue = M.venue || ['arena', 'field', 'castle'][Math.floor(r() * 3)];

  return { key, day: dayNumber(), M, mode, opp, venue, cat: M.cat || null };

}

function dailyState() { return store.get('daily', { last: null, streak: 0, best: 0, done: {} }); }

function openDaily() {

  AU.init(); const P = dailyPlan(), S = dailyState(), done = S.done[P.key];

  const modeName = P.mode === 1 ? 'Duel, 1 v 1' : `${P.mode} v ${P.mode}`;

  const oppName = CLUBS[P.opp] ? CLUBS[P.opp].full || CLUBS[P.opp].name : P.opp;

  msg('rumble of the day', `Daily #${P.day}`, `<div class="daily"><div class="dmod"><span class="dicon">${P.M.icon}</span><div><b>${P.M.name}</b><span>${P.M.desc}</span></div></div>

    <p>${modeName} against <b>${oppName}</b> at the ${VENUES[P.venue].name.toLowerCase()}. Everyone playing today gets the same fight.</p>

    <p class="muted">${done ? `Today's result: <b>${done.won ? 'won' : 'lost'} ${done.score}</b>. Replays are practice and don't change your streak.` : 'Your first try today counts for the streak.'} 🔥 Streak ${S.streak} · best ${S.best}</p></div>`,

    [['Fight', () => startDaily(P), true], ['Title', toTitle]]);

}

function startDaily(P) {

  G.attract = false; G.tourney = null; REP.log = []; endTraining(); G.boon = null; G.run = null;

  const catWas = G.category; if (P.cat) G.category = P.cat;

  setupMatch({ mode: P.mode, opp: P.opp, stage: `Daily #${P.day}`, venue: P.venue, mod: P.M.mod, daily: P, weather: P.M.key === 'rain' ? 'rain' : 'clear' });

  G.category = catWas; G.shareKind = 'daily'; toTactics();

}

function dailyEnd(m, won, withPurse) {

  const P = m.daily, S = dailyState(); let note = '';

  if (!S.done[P.key]) {

    const y = new Date(); y.setDate(y.getDate() - 1);

    S.streak = won ? (S.last === dateKey(y) || S.last === P.key ? S.streak + 1 : 1) : 0; S.best = Math.max(S.best, S.streak);

    S.last = P.key; S.done[P.key] = { won, score: `${m.wins[0]}–${m.wins[1]}` };

    const keys = Object.keys(S.done).sort(); while (keys.length > 40) delete S.done[keys.shift()];

    store.set('daily', S); note = won ? `<p>🔥 Streak ${S.streak}. Come back tomorrow for a new fight.</p>` : '<p>Streak reset. Tomorrow is another Rumble.</p>';

    if (won && S.streak >= 3) unlock('streak3');

    bump('dailies');

  } else note = '<p class="muted">Practice replay. Your counted result stays.</p>';

  G.shareExtra = { day: P.day, mod: P.M.icon, streak: S.streak }; G.shareKind = 'daily';

  msg('rumble of the day', won ? 'Daily won' : 'Daily lost', withPurse(note), [['Replay', () => startDaily(P)], ['Title', toTitle, true]]);

}



// ---- Gauntlet: a seeded weekend of five fights. Kit damage carries, one loss ends the run, a boon after every win ----

const RUN_STEPS = [{ mode: 1, rung: [0, 1] }, { mode: 3 }, { mode: 1, rung: [2, 3] }, { mode: 5 }, { mode: 1, rung: [5, 5], boss: true }];

const BOONS = [

  { key: 'tape', icon: '🩹', name: 'Lucky roll of tape', desc: '+20 seconds at every repair bench.', apply: B => B.repairAdd = (B.repairAdd || 0) + 20 },

  { key: 'squire', icon: '🧽', name: 'A keen squire', desc: 'A free proper-service labour voucher. Redeem it explicitly at the workshop.', apply: () => { const B = squireBook(); B.serviceCredits = (B.serviceCredits || 0) + 1; saveCareer(); } },

  { key: 'lungs', icon: '🫁', name: 'Second lungs', desc: 'Fatigue builds 20% slower.', apply: B => B.fat = (B.fat || 1) * 0.8 },

  { key: 'iron', icon: '🦶', name: 'Planted feet', desc: '12% steadier against shoves and hits.', apply: B => B.stab = (B.stab || 1) * 1.12 },

  { key: 'edge', icon: '💪', name: 'Heavy arm', desc: 'Your blows land 10% harder.', apply: B => B.imp = (B.imp || 1) * 1.1 },

  { key: 'sponsor', icon: '💰', name: 'Local sponsor', desc: '+$120 to your purse, paid now.', apply: () => { pay(120); updateTitlePurse(); } },

  { key: 'wind', icon: '🌬️', name: 'Iron lungs', desc: 'Breath comes back 25% faster.', apply: B => B.regen = (B.regen || 1) * 1.25 },

];

function runCode(n) { return 'RDR-' + (n >>> 0).toString(16).toUpperCase().padStart(4, '0').slice(-4); }

function runPlan(code) {

  const r = seeded('gauntlet' + code);

  return RUN_STEPS.map((s, i) => {

    if (s.mode === 1) { const rung = s.rung[0] + Math.floor(r() * (s.rung[1] - s.rung[0] + 1)); return { mode: 1, opp: 'ladder' + rung, venue: ['arena', 'field', 'castle'][Math.floor(r() * 3)], boss: !!s.boss }; }

    return { mode: s.mode, opp: ['wardens', 'rabble'][Math.floor(r() * 2)], venue: ['arena', 'field', 'castle'][Math.floor(r() * 3)] };

  });

}

function openRun() {

  AU.init(); const R = store.get('run', null), best = store.get('runBest', 0);

  const steps = c => runPlan(c).map((s, i) => `<li${R && R.code === c && i < R.step ? ' class="done"' : R && R.code === c && i === R.step ? ' class="now"' : ''}><b>${i + 1}</b> ${s.mode === 1 ? 'Duel' : s.mode + ' v ' + s.mode} · ${i === 2 ? 'your rival' : CLUBS[s.opp] ? (CLUBS[s.opp].full || CLUBS[s.opp].name) : s.opp}${s.boss ? ' · the champion' : ''}</li>`).join('');

  const body = `<div class="runbox"><p>Five fights across one weekend. Kit damage carries between fights, one loss ends the run, and every win earns a boon. You get 30 seconds to repair between rounds and 60 seconds after choosing your reward between fights. These timers are fixed. Share your run code so friends can fight the exact same bracket.</p>

    ${R && R.boons.includes('tape') ? '<p class="muted">Your saved Lucky roll of tape is still recorded. Gauntlet repair windows now have fixed timers, so it no longer adds time here.</p>' : ''}

    ${R ? `<p><b>Run ${R.code}</b>, fight ${R.step + 1} of 5${R.boons.length ? ' · boons: ' + R.boons.map(k => BOONS.find(b => b.key === k).icon).join(' ') : ''}</p><ol class="runsteps">${steps(R.code)}</ol>` : ''}

    <label class="runcode"><span>Play a friend's bracket</span><input id="runCodeIn" placeholder="RDR-7F3A" maxlength="8" autocomplete="off"></label>

    <p class="muted">Best run: ${best} of 5 fights won.</p></div>`;

  const btns = []; if (R) btns.push(['Continue run', () => startRunFight(), true]);

  btns.push(['New run', () => { const v = ($('#runCodeIn') && $('#runCodeIn').value || '').trim().toUpperCase(); newRun(/^RDR-[0-9A-F]{4}$/.test(v) ? v : runCode(Math.random() * 65536)); }, !R]);

  btns.push(['Title', toTitle]);

  msg('gauntlet', 'Gauntlet run', body, btns);

}

function newRun(code) {

  const R = { code, step: 0, boons: [], kit: careerKit(playerSpec(CLUBS.reavers.roster[0])), weapon: G.loadout.weapon, cat: G.category };

  store.set('run', R); startRunFight();

}

function runBoon(R) { const B = {}; for (const k of R.boons) { const b = BOONS.find(x => x.key === k); if (b && b.key !== 'squire' && b.key !== 'sponsor') b.apply(B, R); } return B; }

function startRunFight() {

  const R = store.get('run', null); if (!R) return openRun();

  const s = runPlan(R.code)[R.step];

  G.attract = false; G.tourney = null; REP.log = []; endTraining(); G.run = R; G.boon = runBoon(R);

  const catWas = G.category; G.category = R.cat || G.category;

  if (R.step === 2) { rivalClub(); s.opp = 'rival'; }

  setupMatch({ mode: s.mode, opp: s.opp, stage: `Gauntlet ${R.code}, fight ${R.step + 1}${s.boss ? ' (the champion)' : ''}`, venue: s.venue, run: R.code });

  G.category = catWas; G.shareKind = 'run'; G.shareExtra = { code: R.code }; toTactics();

}

function openGauntletRepair(seconds, done, onFail) {

  const m = G.match;

  openRepair(seconds, () => { if (G.match === m) done(); }, {

    fixedDuration: true, requireSafeArmour: true,

    onFail: () => { if (G.match === m && onFail) onFail(); }

  });

}

function gauntletRepairFailed(R) {

  if (store.get('run', null)?.code !== R.code) return;

  store.del('run'); store.set('runBest', Math.max(store.get('runBest', 0), R.step));

  msg('gauntlet', 'Run over', `<p>Repair time expired after fight ${R.step}. Unsafe armour means you cannot return to the list. Your earned rewards are kept.</p>`, [['New run', openRun, true], ['Title', toTitle]]);

}

function runEnd(m, won, withPurse) {

  if (m.gauntletRunEnded) return;

  const R = store.get('run', null); if (!R) { toTitle(); return; }

  m.gauntletRunEnded = true;

  if (G.player) R.kit = JSON.parse(JSON.stringify(G.player.kit)); // the damage comes with you

  G.shareKind = 'run'; G.shareExtra = { code: R.code };

  if (!won) {

    store.del('run'); store.set('runBest', Math.max(store.get('runBest', 0), R.step));

    msg('gauntlet', 'Run over', withPurse(`<p>Out at fight ${R.step + 1} of 5 on run <b>${R.code}</b>. Send a friend the code and see if they get further.</p>`), [['New run', openRun, true], ['Title', toTitle]]);

    return;

  }

  R.step++;

  if (R.step >= 5) {

    store.del('run'); store.set('runBest', 5); pay(500); updateTitlePurse(); unlock('gauntlet'); bump('gauntlets');

    msg('gauntlet', 'Gauntlet champion', withPurse(`<p>Five fights, five wins on run <b>${R.code}</b>. +$500 from the organisers.</p>`), [['Title', toTitle, true]]);

    return;

  }

  store.set('run', R);

  const r = seeded('boon' + R.code + R.step); const pool = BOONS.filter(b => b.key !== 'tape'); const offer = [];

  while (offer.length < 3) offer.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);

  let chosen = false;

  const choose = b => {

    if (chosen || G.match !== m) return; chosen = true;

    b.apply({}, R); R.boons.push(b.key);

    if (G.player) G.player.kit = R.kit;

    G.run = R; G.boon = runBoon(R); store.set('run', R);

    openGauntletRepair(60, () => { teamRepairs(); if (G.player) { R.kit = JSON.parse(JSON.stringify(G.player.kit)); store.set('run', R); } startRunFight(); }, () => gauntletRepairFailed(R));

  };

  msg('gauntlet', `Fight ${R.step} won`, withPurse(`<p>Pick one boon for the rest of the run. Then you have 60 seconds at the repair bench: your kit carries its damage into fight ${R.step + 1}.</p><div class="boons">${offer.map((b, i) => `<div class="boon"><span class="dicon">${b.icon}</span><b>${b.name}</b><span>${b.desc}</span></div>`).join('')}</div>`),

    offer.map((b, i) => [b.icon + ' ' + b.name, () => choose(b), i === 0]));

}
// ---------- your rival: one named fighter who remembers how you beat them and comes back better ----------
const RIVAL_NAMES = { men: ['Brannock Vale', 'Casimir Rook', 'Garrick Stone', 'Torvald Kane'], women: ['Sigrun Holt', 'Morwen Ashby', 'Ilse Varga', 'Reyna Cole'], youth: ['Dex Thorne', 'Wren Ashby', 'Max Rook', 'Juno Vale'] };
function rivalState() {
  if (!CAREER.rival) { const i = (Math.random() * 4) | 0; CAREER.rival = { pick: i, arch: pick(['striker', 'grappler', 'heavy', 'runner']), helm: pick(['greathelm', 'pigface', 'sallet', 'barbute']), w: 0, l: 0, brace: 0, guard: 0, react: 0, last: null, taunt: 0 }; saveCareer(); }
  return CAREER.rival;
}
function rivalName(cat) { const R = rivalState(); if (CLUBS.rival && CLUBS.rival.roster[0].keep) return CLUBS.rival.roster[0].name; R.names = R.names || {}; if (!R.names[cat]) { R.names[cat] = poolName({}); saveCareer(); } return R.names[cat]; }
function rivalClub() {
  const R = rivalState(), cat = G.category, nm = rivalName(cat);
  const lvl = R.w + R.l, prof = { react: Math.max(0.1, 0.26 - 0.02 * lvl - 0.04 * R.react), aggr: 1.0 + 0.04 * lvl, guard: Math.min(0.85, 0.5 + 0.08 * R.guard + 0.02 * lvl), cancel: 0.9 };
  const RT = typeof ROSTER !== 'undefined' && ROSTER.rebranded ? (() => { const r = seeded('rival' + (CAREER.club.bos || '') + R.pick); const ts = ROSTER.teams.filter(t => t.slug !== CAREER.club.bos && ROSTER.fighters.some(f => f.team === t.slug)); return ts.length ? ts[Math.floor(r() * ts.length)] : null; })() : null;
  const RB = RT && CLUBS['bos:' + RT.slug], rnm = RT ? (ROSTER.fighters.filter(f => f.team === RT.slug && (cat === 'women' ? f.g !== 'm' : f.g !== 'f'))[R.pick % 4] || ROSTER.fighters.find(f => f.team === RT.slug)) : null;
  CLUBS.rival = { key: 'rival', name: RB ? RB.name : 'Festival Company', full: `${rnm ? rnm.name : nm} of ${RB ? RB.full : 'Festival Company'}`, short: RB ? RB.short : 'BLK', tabard: RB ? RB.tabard : '#231a2e', trim: RB ? RB.trim : '#c9a227', charge: RB ? RB.charge : 'saltire', flag: '#3b93ff', bos: RT ? RT.slug : null,
    roster: [{ num: 13, name: rnm ? rnm.name : nm, keep: !!rnm, bos: rnm ? { id: rnm.id, team: rnm.team } : null, arch: R.arch, weapon: 'sword', shield: 'heater', helm: R.helm, prof, stab: 1.02 + 0.03 * Math.min(6, lvl) + 0.05 * R.brace }] };
  return CLUBS.rival;
}
function startGrudge() {
  AU.init(); G.attract = false; G.tourney = null; REP.log = []; endTraining(); rivalClub();
  setupMatch({ mode: 1, opp: 'rival', stage: 'Grudge match', venue: G.quickVenue || 'castle', rival: true }); toTactics();
}
function openRival() {
  const R = rivalState(), nm = rivalName(G.category), lvl = R.w + R.l;
  const read = R.last === 'trip' ? 'Since you tripped them last time, they plant their feet and brace more.' : R.last === 'hit' ? 'Since you out-struck them last time, their guard comes up faster.' : 'They have been watching your fights.';
  msg('rival', nm, `<p><b>${nm}</b> of ${CLUBS.rival?.name || 'Festival Company'}. ${ARCH[R.arch].name}, ${HELMS[R.helm].name.toLowerCase()}.</p>
    <p>Record against you: <b class="num">${R.l} wins for you, ${R.w} for them</b>. ${lvl ? read : ''}</p>
    <p class="muted">Every grudge match they learn from how you beat them, and they get a little steadier and quicker each time. Beating them pays double.</p>`,
    [['Grudge match', startGrudge, true], ['Back', openModes]]);
}
// after a grudge match: they remember what beat them
function rivalAfter(m, won) {
  const R = rivalState(); const p = G.player;
  if (won) { R.l++; const trips = (MT.zones || []).filter(z => z === 'down').length, hits = (MT.zones || []).length - trips; R.last = trips >= 1 && trips * 3 >= hits ? 'trip' : 'hit'; if (R.last === 'trip') R.brace++; else R.guard++; R.react = Math.min(3, R.react + 0.5); }
  else R.w++;
  saveCareer();
  return won ? `<p>${rivalName(G.category)} won't forget that. Next time they'll ${R.last === 'trip' ? 'brace harder against your trips' : 'get their guard up faster'}. Rival purse doubled.</p>` : `<p>${rivalName(G.category)} goes up ${R.w}–${R.l} on you. They'll be back.</p>`;
}
// ---------- party modes: free-for-all melee, friends' bracket, couch kit picks ----------
const FFA_COLS = ['#ff3d8b', '#3b93ff', '#f2c40f', '#2fd18a', '#b07cff', '#ff8a3c', '#ffffff', '#34d4e0'];
const FFA_MATS = [];
function ffaColor(f) { return FFA_COLS[(f.team || 0) % FFA_COLS.length]; }
function ffaFlagMat(f) { const i = (f.team || 0) % FFA_COLS.length; return FFA_MATS[i] || (FFA_MATS[i] = new THREE.MeshStandardMaterial({ color: FFA_COLS[i], roughness: 0.4, emissive: new THREE.Color(FFA_COLS[i]).multiplyScalar(0.25) })); }
function sideOf(f) { return f.side != null ? f.side : f.team; }
// everyone in a ring, everyone against everyone; last one standing takes the round, two rounds take the match
function startFFA(n = 6, humans = 0) {
  AU.init(); G.attract = false; G.tourney = null; REP.log = []; endTraining();
  const qm = {}; for (const k of (G.quickMods || store.get('quickMods', []))) qm[k] = true;
  const half = Math.ceil(n / 2);
  setupMatch({ mod: qm, mode: half >= 5 ? 5 : half, opp: pick(['wardens', 'rabble']), stage: 'Free-for-all', venue: G.quickVenue || W3.venue || 'arena', weather: G.quickWeather, ffa: true, versus: humans > 0, local: humans ? 'ffa' : null });
  // trim to n fighters, give each their own colour and spot on a ring facing the middle
  while (G.fighters.length > n) { const f = G.fighters.filter(x => !x.isPlayer).pop(); W3.matchRoot.remove(f.model.root); G.fighters.splice(G.fighters.indexOf(f), 1); }
  G.fighters.forEach((f, i) => {
    f.side = f.team; f.team = i; const a = i / G.fighters.length * TAU, r = 7.5;
    f.home = { x: Math.sin(a) * r, z: Math.cos(a) * r }; f.ffaFace = a + Math.PI;
    W3.matchRoot.remove(f.model.root); buildFighterModel(f); W3.matchRoot.add(f.model.root);
  });
  const m = G.match; m.ffa = true; m.ffaWins = {}; G.fighters.forEach(f => m.ffaWins[f.team] = 0);
  if (humans) {
    VS.on = true; VS.kind = 'ffa'; VS.vins = Array.from({ length: humans }, newVin); VS.prev = [[], [], [], []]; SPLIT.init = [false, false, false, false];
    G.fighters.forEach(f => f.isPlayer = false); G.player = null;
    VS.humans = G.fighters.slice(0, humans); VS.humans.forEach((f, i) => { f.ai.role = null; f.combatProfile = careerCombatProfile(); f.vin = VS.vins[i]; f.name = VS.names && VS.names[i] || 'Player ' + (i + 1); f.pslot = i; applyPick(f, i); f.weapon = profileWeapon(f.spec.weapon, f.combatProfile); recalcBody(f); });
    document.body.classList.toggle('split', SPLIT.on); document.body.classList.toggle('split4', SPLIT.on && humans > 2); $('#splitLabels').innerHTML = '';
  }
  $('#sbA').textContent = humans ? 'P1' : 'YOU'; $('#sbB').textContent = 'BEST';
  startRound(); beginFight();
}
function ffaRoundCheck() {
  const alive = G.fighters.filter(f => !f.out && isUp(f));
  if (alive.length <= 1) endRound('ffa');
}
function ffaWinner(reason) {
  const alive = G.fighters.filter(f => !f.out && isUp(f));
  if (alive.length === 1) return alive[0];
  if (!alive.length) return null;
  return alive.sort((a, b) => b.stats.takedowns - a.stats.takedowns)[0]; // time: most takedowns among those still up
}
// a tie at the top is broken by takedowns; still tied means nobody wins the melee
function ffaLeader() { const w = G.match.ffaWins, s = G.fighters.slice().sort((a, b) => (w[b.team] - w[a.team]) || (b.stats.takedowns - a.stats.takedowns)); if (s.length > 1 && w[s[0].team] === w[s[1].team] && s[0].stats.takedowns === s[1].stats.takedowns) return null; return s[0] || null; }
function ffaMatchEnd() {
  const m = G.match, lead = ffaLeader(), me = VS.on ? null : G.player;
  VS.on = false; document.body.classList.remove('split', 'split4'); $('#splitLabels').innerHTML = '';
  const table = G.fighters.slice().sort((a, b) => m.ffaWins[b.team] - m.ffaWins[a.team]).map(f => `<div><span><i class="ffadot" style="background:${ffaColor(f)}"></i>${f.isPlayer ? 'You' : f.name}</span><span class="num">${m.ffaWins[f.team]} round${m.ffaWins[f.team] === 1 ? '' : 's'} · ${f.stats.takedowns} down</span></div>`).join('');
  const won = me && lead === me;
  if (me) careerMatchEnd({ ...m, wins: [won ? 2 : 0, won ? 0 : 2] }, won);
  if (G.bracket && m.versus && !m.ffa) return;
  msg('free-for-all', lead ? `${lead.isPlayer ? 'You' : lead.name} win${lead.isPlayer ? '' : 's'} the melee` : 'Nobody standing', `<div class="taplog">${table}</div>`, [['Rematch', () => startFFA(G.fighters.length, m.local ? (VS.humans || []).length : 0), true], ['Title', toTitle]]);
}

// ---- couch kit picks: each player chooses a weapon style and a helm before the fight ----
const PICK_WEAPONS2 = [['sword', 'heater', 'Sword & shield'], ['sword', 'buckler', 'Sword & buckler'], ['longsword', null, 'Longsword'], ['polearm', null, 'Polearm'], ['axe', 'heater', 'Axe & shield'], ['mace', 'heater', 'Mace & shield'], ['longaxe', null, 'Long axe']];
const PICK_HELMS = ['greathelm', 'pigface', 'sallet', 'barbute', 'kettle'];
function applyPick(f, i) {
  VS.picks = VS.picks || store.get('couchPicks', []); const P = VS.picks[i]; if (!P) return;
  f.spec = { ...f.spec, weapon: P.weapon, shield: P.shield, helm: P.helm }; f.weapon = WEAPONS[P.weapon]; f.shield = P.shield ? SHIELDS[P.shield] : null; resetFighterForRound(f);
}
function openPicks(players, go) {
  VS.picks = VS.picks || store.get('couchPicks', []);
  for (let i = 0; i < players; i++) VS.picks[i] = VS.picks[i] || { weapon: 'sword', shield: 'heater', helm: PICK_HELMS[i % PICK_HELMS.length], w: 0 };
  const rows = Array.from({ length: players }, (_, i) => `<div class="pickrow"><b>${VS.names && VS.names[i] || 'Player ' + (i + 1)}</b>
    <div class="seg small" data-pw="${i}">${PICK_WEAPONS2.map((w, j) => `<button data-j="${j}" aria-pressed="${VS.picks[i].w === j}">${w[2]}</button>`).join('')}</div>
    <div class="seg small" data-ph="${i}">${PICK_HELMS.map(k => `<button data-k="${k}" aria-pressed="${VS.picks[i].helm === k}">${HELMS[k].name.replace(/ with .*/, '')}</button>`).join('')}</div></div>`).join('');
  msg('couch play', 'Pick your kit', `<div class="picks">${rows}</div>`, [['Fight', () => { store.set('couchPicks', VS.picks); go(); }, true], ['Back', openVersus]]);
  $$('#msgPanel [data-pw] button').forEach(b => b.onclick = () => { const i = +b.parentNode.dataset.pw, w = PICK_WEAPONS2[+b.dataset.j]; Object.assign(VS.picks[i], { weapon: w[0], shield: w[1], w: +b.dataset.j }); $$('button', b.parentNode).forEach(x => x.setAttribute('aria-pressed', String(x === b))); AU.click(); });
  $$('#msgPanel [data-ph] button').forEach(b => b.onclick = () => { const i = +b.parentNode.dataset.ph; VS.picks[i].helm = b.dataset.k; $$('button', b.parentNode).forEach(x => x.setAttribute('aria-pressed', String(x === b))); AU.click(); });
}

// ---- friends' bracket: 4 or 8 names, one-on-one duels, the game keeps the draw and passes the controllers ----
function openBracket() {
  const saved = store.get('bracketNames', ['', '', '', '', '', '', '', '']);
  msg('friends’ bracket', 'Tournament night', `<p>Type 4 or 8 names. Each match is a one-on-one duel on two controllers (or keyboard and controller); hand them over between matches.</p>
    <div class="namegrid">${saved.map((n, i) => `<input class="bname" maxlength="14" placeholder="Fighter ${i + 1}" value="${String(n).replace(/"/g, '')}" autocomplete="off">`).join('')}</div>`,
    [['Start bracket', () => { const names = $$('.bname').map(e => e.value.trim().replace(/[<>&"]/g, '')).filter(Boolean); store.set('bracketNames', $$('.bname').map(e => e.value.trim())); if (names.length !== 4 && names.length !== 8) { toastMenu('Enter exactly 4 or 8 names.'); return; } startBracket(names); }, true], ['Back', openVersus]]);
}
function startBracket(names) {
  const sh = names.slice().sort(() => Math.random() - 0.5);
  G.bracket = { rounds: [sh.map(n => n)], cur: 0, match: 0, results: [] };
  showBracket();
}
function bracketPairs() { const B = G.bracket, r = B.rounds[B.cur]; const out = []; for (let i = 0; i < r.length; i += 2) out.push([r[i], r[i + 1]]); return out; }
function showBracket() {
  const B = G.bracket, names = ['Quarter-finals', 'Semi-finals', 'Final']; const total = Math.log2(B.rounds[0].length);
  const html = B.rounds.map((r, ri) => `<div class="bcol"><b>${names[names.length - (total - ri)] || 'Round ' + (ri + 1)}</b>${Array.from({ length: r.length / 2 }, (_, k) => { const a = r[2 * k], b = r[2 * k + 1], w = B.results[ri] && B.results[ri][k]; return `<div class="bmatch${ri === B.cur && k === B.match ? ' now' : ''}"><span class="${w === a ? 'win' : w ? 'lose' : ''}">${a}</span><span class="${w === b ? 'win' : w ? 'lose' : ''}">${b}</span></div>`; }).join('')}</div>`).join('');
  const champ = B.champion;
  if (champ) { msg('friends’ bracket', `${champ} wins the night`, `<div class="bracket">${html}</div>`, [['New bracket', () => { G.bracket = null; VS.names = null; openBracket(); }, true], ['Title', () => { G.bracket = null; toTitle(); }]]); return; }
  const [a, b] = bracketPairs()[B.match];
  msg('friends’ bracket', `${a} vs ${b}`, `<div class="bracket">${html}</div><p>Player 1: <b>${a}</b>. Player 2: <b>${b}</b>. Pass the controllers.</p>`, [['Fight', () => { VS.names = [a, b]; startVersus('duel'); }, true], ['Quit bracket', () => { G.bracket = null; toTitle(); }]]);
}
function bracketResult(winnerSlot) {
  const B = G.bracket, [a, b] = bracketPairs()[B.match], w = winnerSlot === 0 ? a : b;
  (B.results[B.cur] = B.results[B.cur] || [])[B.match] = w;
  B.match++;
  if (B.match >= B.rounds[B.cur].length / 2) { const next = B.results[B.cur].slice(); if (next.length === 1) B.champion = next[0]; else { B.rounds.push(next); B.cur++; B.match = 0; } }
  VS.names = null; showBracket();
}
// ---------- season: a summer of events around central Alberta, a league table, kit damage that lasts, and recruiting ----------

const LEAGUE_EXTRA = [

  { key: 'lancers', name: 'Lacombe Lancers', short: 'LAC', tabard: '#5b4a2a', trim: '#e3d6a8', charge: 'bend', base: 'wardens', str: 0.9 },

  { key: 'pikes', name: 'Ponoka Pikes', short: 'PON', tabard: '#3d2a4f', trim: '#d8c9e6', charge: 'cross', base: 'rabble', str: 1.0 },

  { key: 'crows', name: 'Camrose Crows', short: 'CAM', tabard: '#24324f', trim: '#e8e1cf', charge: 'quarterly', base: 'wardens', str: 1.1 },

];

function ensureLeagueClubs() {

  for (const L of LEAGUE_EXTRA) if (!CLUBS[L.key]) CLUBS[L.key] = { key: L.key, name: L.name, full: L.name, short: L.short, tabard: L.tabard, trim: L.trim, charge: L.charge, flag: '#3b93ff', roster: CLUBS[L.base].roster.map(s => ({ ...s })) };

}

const SEASON_STOPS = [

  { town: 'Lacombe', venue: 'field', mode: 3, opp: 'lancers', note: 'Fall fair, on the grass behind the grandstand.' },

  { town: 'Ponoka', venue: 'arena', mode: 5, opp: 'pikes', note: 'Stampede grounds arena. Concrete and a big crowd.' },

  { town: 'Sylvan Lake', venue: 'rink', mode: 2, opp: 'wardens', note: 'Pairs on the frozen lake rink. Watch your footing.' },

  { town: 'Olds', venue: 'castle', mode: 5, opp: 'rabble', note: 'A night card in the college’s mock castle.' },

  { town: 'Camrose', venue: 'fair', mode: 3, opp: 'crows', note: 'Medieval fair weekend. Triples between the market stalls.' },

  { town: 'Red Deer', venue: 'stadium', mode: 5, opp: 'wardens', note: 'The season final under the stadium floodlights.', final: true },

];

const LEAGUE_KEYS = ['reavers', 'wardens', 'rabble', 'lancers', 'pikes', 'crows'];

function seasonState() { return store.get('season', null); }

function newSeason() {

  ensureLeagueClubs(); const S = { stop: 0, table: {}, squad: 0, kit: careerKit(playerSpec(CLUBS.reavers.roster[0])), weapon: G.loadout.weapon, log: [] };

  LEAGUE_KEYS.forEach(k => S.table[k] = { p: 0, w: 0, d: 0, l: 0, pts: 0 }); store.set('season', S); openSeason();

}

function tableHtml(S) {

  const rows = LEAGUE_KEYS.slice().sort((a, b) => S.table[b].pts - S.table[a].pts || S.table[b].w - S.table[a].w).map((k, i) => { const T = S.table[k]; return `<tr class="${k === 'reavers' ? 'me' : ''}"><td>${i + 1}</td><td>${CLUBS[k].name}</td><td>${T.p}</td><td>${T.w}</td><td>${T.d}</td><td>${T.l}</td><td><b>${T.pts}</b></td></tr>`; }).join('');

  return `<div class="sheet"><div class="tblwrap"><table><thead><tr><th>#</th><th>Club</th><th>P</th><th>W</th><th>D</th><th>L</th><th>Pts</th></tr></thead><tbody>${rows}</tbody></table></div></div>`;

}

function openSeason() {

  ensureLeagueClubs(); const S = seasonState();

  if (!S) { msg('season', 'Summer season', `<p>Six stops around central Alberta, one match at each, and a league table. Your kit damage lasts the whole summer, so tape well, and spend prize money signing better teammates. Top of the table at the end wins the Prairie Cup.</p>`, [['Start the season', newSeason, true], ['Back', toTitle]]); return; }

  if (S.stop >= SEASON_STOPS.length) return seasonEnd(S);

  const st = SEASON_STOPS[S.stop], recruitCost = 150 + 100 * S.squad;

  msg('season', `Stop ${S.stop + 1}: ${st.town}`, `<p><b>${st.mode} v ${st.mode}</b> against <b>${CLUBS[st.opp].name}</b> at the ${VENUES[st.venue].name.toLowerCase()}. ${st.note}</p>${tableHtml(S)}

    <p class="muted">Squad level ${S.squad}: your teammates are ${S.squad ? `${S.squad * 6}% steadier and quicker to react` : 'the usual Reavers'}. Purse ${fmtMoney(CAREER.purse)}.</p>`,

    [['Fight', () => startSeasonMatch(), true], [`Sign a veteran · ${fmtMoney(recruitCost)}`, () => { if (CAREER.purse < recruitCost) { toastMenu('Not enough in the purse.'); return; } if (S.squad >= 5) { toastMenu('Your squad is as good as it gets.'); return; } CAREER.purse -= recruitCost; S.squad++; store.set('season', S); saveCareer(); updateTitlePurse(); toastMenu('A veteran joins the Reavers.'); openSeason(); }], ['Abandon season', () => { store.del('season'); toTitle(); }]]);

}

function startSeasonMatch() {

  const S = seasonState(), st = SEASON_STOPS[S.stop];

  G.attract = false; G.tourney = null; REP.log = []; endTraining(); G.run = { kit: S.kit }; G.boon = null;

  setupMatch({ mode: st.mode, opp: st.opp, stage: `Season, ${st.town}`, venue: st.venue, season: true, run: 'season' });

  G.shareKind = 'match'; G.shareExtra = {};

  for (const f of G.fighters) if (f.team === 0 && !f.isPlayer) { f.stabMul *= 1 + 0.06 * S.squad; f.prof = { react: Math.max(0.12, 0.26 - 0.025 * S.squad), aggr: 1, guard: 0.5 + 0.06 * S.squad, cancel: 0.92 }; }

  toTactics();

}

function simResult(a, b) { const sa = (LEAGUE_EXTRA.find(x => x.key === a) || { str: 1 }).str, sb = (LEAGUE_EXTRA.find(x => x.key === b) || { str: 1 }).str, r = Math.random() * (sa + sb + 0.3); return r < sa ? 0 : r < sa + sb ? 1 : -1; }

function seasonAfter(m, won, drawn, withPurse) {

  const S = seasonState(); if (!S) return false;

  const st = SEASON_STOPS[S.stop];

  if (G.player) S.kit = JSON.parse(JSON.stringify(G.player.kit));

  const rec = (k, res) => { const T = S.table[k]; T.p++; if (res === 'w') { T.w++; T.pts += 3; } else if (res === 'd') { T.d++; T.pts += 1; } else T.l++; };

  rec('reavers', won ? 'w' : drawn ? 'd' : 'l'); rec(st.opp, won ? 'l' : drawn ? 'd' : 'w');

  const others = LEAGUE_KEYS.filter(k => k !== 'reavers' && k !== st.opp).sort(() => Math.random() - 0.5);

  const lines = [];

  for (let i = 0; i + 1 < others.length; i += 2) { const a = others[i], b = others[i + 1], r = simResult(a, b); rec(a, r === 0 ? 'w' : r === 1 ? 'l' : 'd'); rec(b, r === 1 ? 'w' : r === 0 ? 'l' : 'd'); lines.push(`${CLUBS[a].name} ${r === 0 ? 'beat' : r === 1 ? 'lost to' : 'drew with'} ${CLUBS[b].name}`); }

  S.stop++; store.set('season', S);

  msg('season', won ? `Won in ${st.town}` : drawn ? `Drawn in ${st.town}` : `Lost in ${st.town}`, withPurse(`<p>Elsewhere: ${lines.join('; ')}.</p>${tableHtml(S)}<p class="muted">Your kit damage carries to the next stop.</p>`), [[S.stop >= SEASON_STOPS.length ? 'Final standings' : 'Next stop', openSeason, true], ['Title', toTitle]]);

  return true;

}

function seasonEnd(S) {

  const order = LEAGUE_KEYS.slice().sort((a, b) => S.table[b].pts - S.table[a].pts || S.table[b].w - S.table[a].w), top = order[0] === 'reavers';

  if (top && !S.paid) { pay(600); S.paid = true; store.set('season', S); unlock('season'); bump('seasons'); updateTitlePurse(); }

  msg('season', top ? 'Prairie Cup champions' : `Season over: ${order.indexOf('reavers') + 1}${['st', 'nd', 'rd'][order.indexOf('reavers')] || 'th'} place`, `${tableHtml(S)}${top ? '<p>+$600 and the Prairie Cup. The Reavers are the best club in central Alberta.</p>' : '<p>Tape up, recruit, and go again next summer.</p>'}`, [['New season', () => { store.del('season'); newSeason(); }, true], ['Title', toTitle]]);

}
// ---------- Little Knights: foam-dummy knockdown, balloon pop, catch the pig, and a sticker book ----------
const KID = { on: false, kind: null, t: 0, score: 0, objs: [], pig: null };
const KID_GAMES = {
  dummies: { name: 'Foam dummy knockdown', icon: '🧸', desc: 'Knock the foam dummies over as many times as you can in a minute. Shove, trip, bonk!' },
  balloons: { name: 'Balloon pop', icon: '🎈', desc: 'Balloons float around the list. Swing at them to pop them. Aim up for the high ones!' },
  pig: { name: 'Catch the pig', icon: '🐷', desc: 'A very fast piggy is loose! Run it down and GRAB it. Then it escapes again…' },
};
const STICKERS = [
  ['unicorn', '🦄', 'Unicorn', 'Play a Youth match'], ['star', '⭐', 'Gold star', 'Win a Youth match'], ['teddy', '🧸', 'Teddy', 'Knock down 5 foam dummies in one game'],
  ['balloon', '🎈', 'Balloon', 'Pop 10 balloons in one game'], ['piggy', '🐷', 'Piggy', 'Catch the pig 3 times in one game'], ['shield', '🛡️', 'Shield', 'A perfect block in the Youth division'],
  ['bullseye', '🎯', 'Bullseye', 'A helmet hit in the Youth division'], ['rainbow', '🌈', 'Rainbow', 'Salute the crowd in the Youth division'], ['lolly', '🍭', 'Lolly', 'Play all three Little Knights games'],
  ['trophy', '🏆', 'Trophy', 'Win the Red Deer Rumble in the Youth division'],
];
function sticker(id) {
  CAREER.stickers = CAREER.stickers || {}; if (CAREER.stickers[id] || G.autopilot || G.attract) return;
  const S = STICKERS.find(s => s[0] === id); if (!S) return;
  CAREER.stickers[id] = Date.now(); saveCareer(); ACHQ.push({ kicker: 'New sticker!', name: `${S[1]} ${S[2]}`, desc: S[3] }); if (!ACHQ.busy) showAch(); AU.boing(0.6);
}
EV_LISTENERS.push((type, d) => {
  if (!CUTE.on) return;
  if (type === 'perfect') sticker('shield');
  if (type === 'hit' && d && d.zone === 'helmet' && !d.blocked) sticker('bullseye');
  if (type === 'salute') sticker('rainbow');
});
function openKids() {
  AU.init(); const played = CAREER.kidsPlayed || {};
  msg('little knights', 'Little Knights games', `<div class="modes">${Object.entries(KID_GAMES).map(([k, g]) => `<button class="mode" data-kid="${k}"><span class="big">${g.icon}</span><b>${g.name}</b><span>${g.desc}</span><span class="muted">${played[k] ? 'Best: ' + played[k] : 'New!'}</span></button>`).join('')}</div>`,
    [['Sticker book', openStickers], ['Back', openModes, true]]);
  $$('#msgPanel [data-kid]').forEach(b => b.onclick = () => { AU.click(); startKid(b.dataset.kid); });
}
function openStickers() {
  const got = CAREER.stickers || {};
  msg('little knights', 'Sticker book', `<p class="muted">${Object.keys(got).length} of ${STICKERS.length} stickers.</p><div class="stickers">${STICKERS.map(([id, e, n, d]) => `<div class="stk${got[id] ? ' on' : ''}"><span class="se">${got[id] ? e : '?'}</span><b>${got[id] ? n : '???'}</b><small>${d}</small></div>`).join('')}</div>`, [['Back', openKids, true]]);
}
function startKid(kind) {
  G.attract = false; G.tourney = null; REP.log = []; endTraining();
  const catWas = G.category; G.category = 'youth';
  setupMatch({ mode: 'train', opp: 'sparring', stage: 'Little Knights', training: true, kids: kind, venue: 'field' });
  G.category = catWas;
  startRound(); beginFight();
  Object.assign(KID, { on: true, kind, t: 60, score: 0, objs: [], pig: null });
  const partners = G.fighters.filter(f => f.team === 1);
  if (kind === 'dummies') partners.forEach((f, i) => { f.ai.mode = 'still'; f.stabMul = 0.55; f.pos = f.home = { x: (i ? 3 : -3), z: 4 }; });
  else partners.forEach(f => { f.out = true; f.model.root.visible = false; });
  if (kind === 'balloons') for (let i = 0; i < 6; i++) spawnBalloon();
  if (kind === 'pig') spawnPig();
  $('#lesson').hidden = false; $('#lSkip').hidden = true; $('#app').classList.add('training'); $('#lExit').onclick = () => endKid(true);
  updateKidCard();
}
function updateKidCard() {
  const g = KID_GAMES[KID.kind]; $('#lNum').textContent = g.icon; $('#lTitle').textContent = g.name; $('#lProg').textContent = `${Math.ceil(KID.t)}s · ${KID.score}`;
  $('#lText').textContent = KID.kind === 'dummies' ? 'Knock the dummies down! They bounce right back up.' : KID.kind === 'balloons' ? 'Swing at the balloons to pop them. Look up for the high ones.' : 'Run up to the piggy and GRAB it!';
}
function spawnBalloon() {
  const col = CUTE_POPS[(Math.random() * CUTE_POPS.length) | 0];
  const b = new THREE.Mesh(geo('kballoon', () => { const s = new THREE.SphereGeometry(0.22, 16, 12); s.scale(1, 1.2, 1); return s; }), cuteMat(col, { roughness: 0.25, emissive: new THREE.Color(col).multiplyScalar(0.15).getHex() }));
  b.position.set(rand(-7, 7), rand(0.7, 1.7), rand(-9, 9)); b.userData = { base: b.position.clone(), ph: rand(0, TAU) }; W3.matchRoot.add(b); KID.objs.push(b);
}
function spawnPig() {
  const g = new THREE.Group(), pink = cuteMat('#ffaec9'), dark = cuteMat('#e07a9e');
  mk(g, geo('pigB', () => new THREE.SphereGeometry(0.32, 16, 12)), pink, 0, 0.35, 0).scale.set(1, 0.85, 1.3);
  mk(g, geo('pigH', () => new THREE.SphereGeometry(0.2, 14, 10)), pink, 0, 0.45, 0.42);
  mk(g, geo('pigS', () => new THREE.CylinderGeometry(0.08, 0.09, 0.08, 12)), dark, 0, 0.42, 0.6).rotation.x = Math.PI / 2;
  for (const sx of [-1, 1]) { mk(g, geo('pigE', () => new THREE.ConeGeometry(0.06, 0.12, 8)), dark, sx * 0.1, 0.63, 0.4).rotation.z = -sx * 0.5; mk(g, geo('pigEye', () => new THREE.SphereGeometry(0.025, 8, 6)), cuteBasic('#2a1d22'), sx * 0.08, 0.5, 0.58); for (const fz of [-0.25, 0.25]) mk(g, geo('pigL', () => new THREE.CylinderGeometry(0.05, 0.05, 0.2, 8)), pink, sx * 0.17, 0.1, fz); }
  mk(g, geo('pigT', () => new THREE.TorusGeometry(0.05, 0.015, 6, 12, Math.PI * 1.5)), dark, 0, 0.45, -0.42);
  g.position.set(rand(-6, 6), 0, rand(-8, 8)); W3.matchRoot.add(g); KID.pig = { g, vel: { x: 0, z: 0 }, dir: rand(0, TAU), hop: 0 };
}
function updateKids(dt) {
  if (!KID.on || !G.match || !G.match.kids) return;
  if (G.phase !== 'fight' || G.paused) return;
  KID.t -= dt; const p = G.player;
  if (KID.kind === 'balloons') {
    for (const b of KID.objs.slice()) {
      b.position.y = b.userData.base.y + Math.sin(G.realTime * 1.4 + b.userData.ph) * 0.15; b.position.x = b.userData.base.x + Math.sin(G.realTime * 0.6 + b.userData.ph) * 0.4;
      const a = p.action, hs = p.body.h / 1.8;
      if (a && a.kind === 'swing' && a.phase === 'strike' && !a.kidHit) {
        const dx = b.position.x - p.pos.x, dz = b.position.z - p.pos.z, d = Math.hypot(dx, dz), front = Math.cos(angDiff(p.facing, Math.atan2(dx, dz)));
        const aimY = p.body.h * 0.935 + Math.tan(FP.pitch) * d;
        if (d < reachOf(p) + 0.35 && front > 0.5 && Math.abs(aimY - b.position.y) < 0.55 * Math.max(hs, 0.7) + 0.2) { a.kidHit = true; KID.score++; sparks(b.position.clone(), 14, 1.2); AU.noise(0.12, 3000, 0.8, 0.5, 'highpass'); AU.boing(0.5); W3.matchRoot.remove(b); KID.objs.splice(KID.objs.indexOf(b), 1); spawnBalloon(); toast('Pop!', 'good', `${KID.score} popped`); }
      }
    }
  }
  if (KID.kind === 'pig' && KID.pig) {
    const P = KID.pig, g = P.g, dx = g.position.x - p.pos.x, dz = g.position.z - p.pos.z, d = Math.hypot(dx, dz) || 1;
    if (d < 4.5) P.dir = Math.atan2(dx, dz) + Math.sin(G.realTime * 3) * 0.7; else if (Math.random() < dt * 0.8) P.dir += rand(-1.5, 1.5);
    const sp = d < 4.5 ? 3.3 : 1.2; P.vel.x = damp(P.vel.x, Math.sin(P.dir) * sp, 6, dt); P.vel.z = damp(P.vel.z, Math.cos(P.dir) * sp, 6, dt);
    g.position.x = clamp(g.position.x + P.vel.x * dt, -LIST.W / 2 + 0.6, LIST.W / 2 - 0.6); g.position.z = clamp(g.position.z + P.vel.z * dt, -LIST.L / 2 + 0.6, LIST.L / 2 - 0.6);
    if (Math.abs(g.position.x) > LIST.W / 2 - 0.8 || Math.abs(g.position.z) > LIST.L / 2 - 0.8) P.dir += Math.PI * 0.6;
    g.rotation.y = Math.atan2(P.vel.x, P.vel.z); P.hop += dt * 14; g.position.y = Math.abs(Math.sin(P.hop)) * 0.08;
    const a = p.action; if (a && a.kind === 'grab' && d < 1.25 && !a.kidHit) { a.kidHit = true; KID.score++; toast('Gotcha piggy!', 'big', `${KID.score} caught`); AU.boing(0.9); sparks(g.position.clone().setY(0.6), 16, 1.2); g.position.set(rand(-7, 7), 0, rand(-10, 10)); }
  }
  updateKidCard();
  if (KID.t <= 0) endKid(false);
}
EV_LISTENERS.push(type => { if (KID.on && KID.kind === 'dummies' && type === 'takedown') { KID.score++; toast('Bonk! Down it goes', 'good', `${KID.score} down`); } });
function endKid(quit) {
  const kind = KID.kind, score = KID.score; KID.on = false;
  KID.objs.forEach(o => W3.matchRoot.remove(o)); KID.objs = []; if (KID.pig) { W3.matchRoot.remove(KID.pig.g); KID.pig = null; }
  $('#lSkip').hidden = false; $('#lesson').hidden = true; $('#lExit').onclick = lExitDefault; document.getElementById('app').classList.remove('training'); setHud(false); G.phase = 'over';
  if (quit) { openKids(); return; }
  bump('kidsGames');
  const P = CAREER.kidsPlayed = CAREER.kidsPlayed || {}; const best = Math.max(P[kind] || 0, score); P[kind] = best; saveCareer();
  if (kind === 'dummies' && score >= 5) sticker('teddy'); if (kind === 'balloons' && score >= 10) sticker('balloon'); if (kind === 'pig' && score >= 3) sticker('piggy');
  if (P.dummies != null && P.balloons != null && P.pig != null) sticker('lolly');
  msg('little knights', `${KID_GAMES[kind].icon} ${score}!`, `<p>${KID_GAMES[kind].name}: <b>${score}</b>. Best ever: ${best}.</p>`, [['Again!', () => startKid(kind), true], ['Other games', openKids], ['Sticker book', openStickers]]);
}
// ---------- animation, camera, main loop, boot ----------
const P = {};
const WIND = {
  R2L: { 'torso.y': -0.55, 'shR.x': -2.0, 'shR.z': -0.7, 'elR.x': -1.5, 'wrR.x': 0, 'wrR.y': -1.1 },
  L2R: { 'torso.y': 0.55, 'shR.x': -1.8, 'shR.z': 0.7, 'elR.x': -1.7, 'wrR.x': 0, 'wrR.y': 1.3 },
  O: { 'torso.x': -0.12, 'shR.x': -2.9, 'shR.z': -0.15, 'elR.x': -1.3, 'wrR.x': 0, 'wrR.y': 0 },
};
const STRIKE = {
  R2L: { 'torso.y': 0.6, 'shR.x': -1.45, 'shR.z': 0.5, 'elR.x': -0.25, 'wrR.x': 0, 'wrR.y': 1.3 },
  L2R: { 'torso.y': -0.6, 'shR.x': -1.4, 'shR.z': -0.85, 'elR.x': -0.2, 'wrR.x': 0, 'wrR.y': -1.3 },
  O: { 'torso.x': 0.35, 'shR.x': -1.0, 'shR.z': -0.05, 'elR.x': -0.1, 'wrR.x': 1.3, 'wrR.y': 0 },
};

function animateFighter(f, dt, t) {
  const J = f.model; if (!J) return;
  J.root.visible = !f.out; if (f.out) return;
  const twoH = f.weapon && f.weapon.hands === 2;
  const speed = vlen(f.vel);
  const prevStep = Math.floor(f.walkPh / Math.PI);
  const fat = f.fatigue || 0;
  f.walkPh += dt * (speed * 3.3 * (1 - 0.2 * fat) + (f.stepRem > 0 ? 10 : 0));
  if (Math.floor(f.walkPh / Math.PI) !== prevStep && (speed > 0.9 || f.stepRem > 0) && isUp(f) && G.phase !== 'title') { const v = f.isPlayer && isCtl() ? (isFP() ? 0.55 : 0.42) : vol(f) * 0.28; if (v > 0.06 && (f.isPlayer || chance(0.5))) AU.step(v); }
  const wk = clamp(speed / 3, 0, 1) + (f.stepRem > 0 ? 0.7 : 0);
  const sF = Math.sin(f.facing), cF = Math.cos(f.facing);
  let rate = 14;
  // ---- base stance ----
  P.hipsY = 0.98 - (f.brace ? 0.13 : 0) - 0.05 * (1 - f.gas);
  P['legL.x'] = Math.sin(f.walkPh) * 0.55 * wk; P['legR.x'] = -Math.sin(f.walkPh) * 0.55 * wk;
  P['kneeL.x'] = 0.12 + Math.max(0, Math.sin(f.walkPh + 1.4)) * 0.75 * wk; P['kneeR.x'] = 0.12 + Math.max(0, -Math.sin(f.walkPh + 1.4)) * 0.75 * wk;
  P['legL.z'] = f.brace ? 0.21 : 0.06; P['legR.z'] = f.brace ? -0.21 : -0.06;
  const sideStep = clamp((f.vel.x * cF - f.vel.z * sF) / 4, -1, 1);
  P['legL.z'] += sideStep * 0.18 * wk; P['legR.z'] += sideStep * 0.18 * wk;
  if (f.brace) { P['legL.x'] -= 0.28; P['legR.x'] += 0.32; P['kneeL.x'] += 0.38; P['kneeR.x'] += 0.38; }
  P['torso.x'] = 0.06 + 0.2 * (1 - f.gas) + 0.24 * fat + (f.brace ? 0.12 : 0) + Math.sin(t * (2 + 3 * fat) + f.id) * 0.05 * fat; P['torso.y'] = 0; P['torso.z'] = 0; // tired fighters hunch and heave
  P['head.x'] = -0.05 + 0.18 * fat; P['head.z'] = Math.sin(t * 9) * 0.22 * f.bell;
  if (twoH) Object.assign(P, { 'shR.x': -0.5, 'shR.y': 0, 'shR.z': -0.05, 'elR.x': -0.5, 'wrR.x': 0, 'wrR.y': 0.4, 'shL.x': -0.95, 'shL.y': 0, 'shL.z': -0.55, 'elL.x': -0.7, 'wrL.x': 0 });
  else Object.assign(P, { 'shR.x': -0.55, 'shR.y': 0, 'shR.z': -0.2, 'elR.x': -1.05, 'wrR.x': 0, 'wrR.y': 0, 'shL.x': -0.45, 'shL.y': 0, 'shL.z': 0.18, 'elL.x': -1.2, 'wrL.x': 0 });
  if (!f.weapon) Object.assign(P, { 'shR.x': -0.75, 'shR.z': -0.25, 'elR.x': -0.9 });
  if (fat > 0.2 && !f.guard) { P['shR.x'] += 0.35 * fat; P['shL.x'] += 0.35 * fat; P['elR.x'] += 0.3 * fat; P['elL.x'] += 0.3 * fat; } // the weapon hangs lower
  const heater = f.shield && f.shield.key === 'heater';
  if (f.shield) Object.assign(P, heater ? { 'shp.x': 0.33, 'shp.y': 0.1, 'shp.z': 0.24, 'shp.rx': 0, 'shp.ry': 0.55 } : { 'shp.x': 0.3, 'shp.y': 0.02, 'shp.z': 0.34, 'shp.rx': 0, 'shp.ry': 0.2 });
  else Object.assign(P, { 'shp.x': 0.3, 'shp.y': 0, 'shp.z': 0.2, 'shp.rx': 0, 'shp.ry': 0 });
  if (f.guard) {
    if (f.shield) { Object.assign(P, heater ? { 'shp.x': 0.08, 'shp.y': 0.25, 'shp.z': 0.4, 'shp.rx': -0.1, 'shp.ry': 0.04 } : { 'shp.x': 0.06, 'shp.y': 0.3, 'shp.z': 0.5, 'shp.rx': 0, 'shp.ry': 0 }); Object.assign(P, { 'shL.x': -1.15, 'shL.z': -0.25, 'elL.x': -1.15 }); }
    else Object.assign(P, { 'shR.x': -1.55, 'shR.z': -0.15, 'elR.x': -0.55, 'wrR.y': 1.45, 'shL.x': -1.45, 'shL.z': -0.6, 'elL.x': -0.55 });
    rate = 18;
  }
  // ---- actions ----
  const a = f.action;
  if (a && a.kind === 'swing') {
    const w = WIND[a.arc] || WIND.R2L, s = STRIKE[a.arc] || STRIKE.R2L, T = swingTimes(f);
    const blend = (from, to, u) => { for (const key of new Set([...Object.keys(from), ...Object.keys(to)])) P[key] = lerp(from[key] == null ? P[key] || 0 : from[key], to[key] == null ? P[key] || 0 : to[key], ease(u)); };
    if (a.phase === 'windup') { const base = { ...P }; blend(base, w, clamp(a.t / Math.max(0.05, a.wind || T.wind), 0, 1)); P['torso.y'] = (w['torso.y'] || 0) * (1 + 0.45 * a.charge) * clamp(a.t / Math.max(0.05, a.wind || T.wind), 0, 1); rate = 16; }
    else if (a.phase === 'strike') { blend(w, s, clamp(a.t / T.strike, 0, 1)); rate = 40; }
    else { const base = { ...P }; blend(s, base, clamp(a.t / T.rec, 0, 1)); rate = 18; }
    if (twoH && a.phase !== 'recover') { P['shL.x'] = P['shR.x'] * 0.92; P['shL.z'] = P['shR.z'] + 0.5; P['elL.x'] = P['elR.x']; }
  } else if (a && a.kind === 'shove') {
    if (a.phase === 'windup') { P['shp.z'] = 0.12; P['torso.x'] = -0.05; }
    else if (a.t < 0.12) { P['shp.z'] = 0.66; P['shp.ry'] = 0.05; P['shp.x'] = 0.1; P['shp.y'] = 0.2; P['torso.x'] = 0.3; P['shL.x'] = -1.4; P['elL.x'] = -0.4; if (!f.shield) Object.assign(P, { 'shR.x': -1.3, 'elR.x': -0.5, 'wrR.y': 1.5, 'shL.x': -1.3, 'elL.x': -0.5 }); rate = 30; }
  } else if (a && a.kind === 'trip') {
    if (a.phase === 'windup') { P['legR.x'] = -0.65; P['kneeR.x'] = 0.2; P['torso.y'] = 0.25; rate = 22; }
    else if (a.t < 0.18) { P['legR.x'] = 0.75; P['kneeR.x'] = 0.55; P['torso.y'] = 0.45; P['torso.x'] = 0.25; rate = 26; }
  } else if (a && a.kind === 'tackle') {
    Object.assign(P, { 'torso.x': 0.5, 'shp.z': 0.5, 'shp.y': 0.2, 'shp.x': 0.12, 'shp.ry': 0.05, 'shL.x': -1.2, 'elL.x': -0.8, 'legL.x': -0.7, 'legR.x': 0.6 }); rate = 24;
  } else if (a) { // grab, knee, throw, disarm
    Object.assign(P, { 'shR.x': -1.35, 'shR.z': 0.3, 'elR.x': -0.6, 'shL.x': -1.35, 'shL.z': -0.3, 'elL.x': -0.6, 'torso.x': 0.3 }); rate = 22;
    if (a.kind === 'knee' && a.phase === 'recover' && a.t < 0.12) { P['legR.x'] = -1.1; P['kneeR.x'] = 1.2; }
    if (a.kind === 'throw' && a.phase === 'recover' && a.t < 0.2) { P['torso.y'] = 0.9; P['legR.x'] = 0.8; }
  }
  if (f.clinch) { Object.assign(P, { 'shR.x': -1.3, 'shR.z': 0.35, 'elR.x': -0.75, 'shL.x': -1.3, 'shL.z': -0.35, 'elL.x': -0.75, 'torso.x': 0.42, 'shp.x': 0.42, 'shp.z': 0.0, 'shp.ry': 1.3 }); P.hipsY -= 0.05; }
  if (f.bindT > 0) { f.bindT = Math.max(0, f.bindT - dt); Object.assign(P, { 'shR.x': -1.45, 'shR.z': 0.1, 'elR.x': -0.55, 'shL.x': -1.25, 'shL.z': -0.25, 'elL.x': -0.6, 'torso.x': 0.26 }); P.hipsY -= 0.06; rate = 24; }
  if (f.saluteT > 0) { f.saluteT -= dt; Object.assign(P, { 'shR.x': -2.95, 'shR.z': -0.15, 'elR.x': -0.15, 'wrR.x': 0.3, 'torso.x': -0.12, 'head.x': -0.25 }); rate = 16; } // weapon raised to the crowd
  if (f.plantFx > 0) { f.plantFx -= dt; Object.assign(P, { 'shR.x': -0.6, 'elR.x': -0.2, 'wrR.x': 1.5, 'shL.x': -0.7, 'elL.x': -0.3 }); }
  // stagger: the stepping leg reaches out
  if (f.stepRem > 0) {
    const sf = f.stepDir.x * sF + f.stepDir.z * cF; const leg = f.stepFlip > 0 ? 'legL' : 'legR';
    P[leg + '.x'] = -0.75 * sf; P[(f.stepFlip > 0 ? 'kneeL' : 'kneeR') + '.x'] = 0.3; rate = Math.max(rate, 20);
  }
  // ---- whole-body state ----
  let rootX = f.pos.x, rootZ = f.pos.z, tx = 0, tz = 0, tagY = 2.25;
  const lf = f.lean.x * sF + f.lean.z * cF, lx = f.lean.x * cF - f.lean.z * sF;
  if (f.state === 'standing' || f.state === 'posting') { tx = Math.atan(lf); tz = -Math.atan(lx); }
  if (f.state === 'posting') Object.assign(P, { hipsY: 0.78, 'torso.x': 0.55, 'shL.x': -0.3, 'shL.z': 0.75, 'elL.x': -0.2 });
  if (f.state === 'falling' || f.state === 'grounded') {
    if (f.state === 'falling') f.gt = 0; else f.gt = (f.gt || 0) + dt;
    const dfw = f.fallDir.x * sF + f.fallDir.z * cF, dxs = f.fallDir.x * cF - f.fallDir.z * sF;
    if (f.groundStyle === 'fall') {
      const k = f.state === 'falling' ? ease(f.fallT / 0.55) : 1;
      const sit = f.state === 'grounded' ? ease((f.gt - 0.8) / 0.7) : 0;
