    const g = new THREE.PlaneGeometry(w, d, Math.ceil(w / 9.5), Math.ceil(d / 9.5)); g.rotateX(-Math.PI / 2);
    const p = g.attributes.position, colours = new Float32Array(p.count * 3), c = new THREE.Color();
    for (let i = 0; i < p.count; i++) {
