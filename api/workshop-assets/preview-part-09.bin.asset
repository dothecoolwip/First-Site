    const tint = '#' + new THREE.Color('#ffffff').lerp(new THREE.Color(L.b || '#888888'), 0.18).getHexString();
    J = costumePerson({ outfit, tex: 'peasant_light', tint, skin: SKIN_TONES.includes(L.s) ? L.s : SKIN_TONES[2], h: ht || 1.8, anim: 'Idle_Loop' });
