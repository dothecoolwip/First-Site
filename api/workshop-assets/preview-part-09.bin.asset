  if (TOWN.mineOn) { mineCollide(P, r); return; }
  for (let it = 0; it < 2; it++) {
    for (const A of ARENAS) {
      // The rope, not just the wooden list, is the public boundary.
      townPushRect(P, A.x, A.z, LIST_BLOCK.x, LIST_BLOCK.z, r);
