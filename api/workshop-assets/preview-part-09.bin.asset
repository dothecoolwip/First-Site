    if (a) { g.add(a); const wrap = new THREE.Mesh(geo('grip', () => new THREE.CylinderGeometry(0.021, 0.021, 0.14, 8)), MAT.tape.black); wrap.visible = false; wrap.userData.keep = true; g.add(wrap); g.userData.wrap = wrap; return g; }
  }
