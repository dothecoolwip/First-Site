function worldMapSurfaceAt(x,z) {
  for(const p of MAP_WORLD.surfaces){const dx=x-p.x,dz=z-p.z,c=Math.cos(p.ry),s=Math.sin(p.ry);if(Math.abs(dx*c-dz*s)<p.hx&&Math.abs(dx*s+dz*c)<p.hz)return p.y;}return null;
