  const key = IN.mode === 'pad' ? (NIN && NIN.on ? 'A' : 'A') : IN.mode === 'touch' ? 'Tap' : 'E';
  b.innerHTML = ''; b.append(h('kbd', null, key), h('span', null, `${S.verb || 'Talk to'} ${S.V.name}`), h('small', null, `${S.V.icon} ${S.V.role}`)); b.hidden = false;
