  } else if (walking) { const speed = (TOWN.mounted ? 7 : 4.2) * (typeof BOS !== 'undefined' && BOS.testAdmin ? (TOWN.testRunSpeed || 1) : 1); const a = travelAutoVel(speed, dt); if (a) { vx = a.vx; vz = a.vz; } }
