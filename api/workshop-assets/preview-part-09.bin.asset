function townInteractionActive(S) {
  if (!S) return false;
  const visual=S.visual || (S.g?.children?.length ? S.g : null);
  if (!visual) return true; // Deliberate label-only destinations keep their existing presentation.
  let attached = false;
  for (let node = visual; node; node = node.parent) { if (!node.visible) return false; if (node === TOWN.root) attached = true; }
  if (!attached) return false;
