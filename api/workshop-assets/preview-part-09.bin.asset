    let i = (Math.random() * n) | 0; if (n > 1 && i === this['last_' + prefix]) i = (i + 1) % n; this['last_' + prefix] = i;
    return this.play(prefix + i, vol, rate, when);
  },
  // crowd bed (Gregor Quendel, CC BY 4.0) looping under everything
  startBed() {
