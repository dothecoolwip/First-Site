  add('mk_Stall_Cart_Empty', 56, -160, -0.3, 1.2, 1.6); add('mk_Crate_Wooden', 60, -164, 0.2, 1.2, 0.6); add('mk_Barrel', 62, -162, 0, 1.2, 0.5);
