  for (let i = 0; i < 12; i++) groundMesh(R, geo('sc_rung', () => new THREE.BoxGeometry(0.6, 0.05, 0.05)), tmat('#7a5a36'), -238, 0.4 + i * 0.55, -122.7);
  for (const sx of [-0.3, 0.3]) groundMesh(R, geo('sc_rail', () => new THREE.BoxGeometry(0.06, 6.8, 0.06)), tmat('#6a4a2a'), -238 + sx, 3.4, -122.7);
  groundMesh(R, geo('sc_plat', () => new THREE.BoxGeometry(3, 0.2, 3)), tmat('#6e4d31'), -238, 7, -123.4); add('kf_tree_1_c', -238, -123.4, 0, 1.6, 6);
  finish('lookout'); begin('boat');
  // the wreck in the reeds
  { const hull = groundMesh(R, geo('sc_hull', () => new THREE.SphereGeometry(1.4, 10, 6, 0, TAU, 0, Math.PI / 2)), lmat({ color: '#5a4630', roughness: 0.95, side: THREE.DoubleSide }), 226, 0.86, 128); hull.scale.set(1, 0.5, 2.4); hull.rotation.x = Math.PI + 0.08; TOWN.obst.push({ x: 226, z: 128, r: 1.8 }); }
  for (let i = 0; i < 10; i++) add('cr_grass_1', 222 + (i % 5) * 2, 124 + Math.floor(i / 5) * 6, i, 1.6);
  finish('boat'); begin('cellar');
  // cellar steps in the ward
