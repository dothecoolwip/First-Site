function navDir(d) { navMove(d === 'l' ? -1 : d === 'r' ? 1 : 0, d === 'u' ? -1 : d === 'd' ? 1 : 0); }
// keyboard: arrows move, Enter/Space press, Escape goes back
window.addEventListener('keydown', e => {
