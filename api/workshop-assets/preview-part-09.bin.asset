  else left.append(h('p', { class: 'muted small' }, `You fight in ${P.name}’s colours.`));
  left.append(h('span', { class: 'label' }, 'Charge'), seg(CHARGES, () => P.charge, v => { P.charge = v; saveCareer(); applyProfile(); }),
