  for (const sx of [-1, 1]) { const p = mk(roof, new THREE.BoxGeometry(Math.hypot(w / 2, rise) + 0.6, 0.3, d + 1.4), rm, cx + sx * w / 4, ht + rise / 2, cz); p.rotation.z = -sx * Math.atan2(rise, w / 2); }
