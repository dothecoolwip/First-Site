  const ratio = vlen(t.lean) / FALL_L;
  const fromSide = facingDot(t, f) < 0.35;
  let p = 0.05 + 0.72 * ratio + (fromSide ? 0.16 : 0) + (t.stepRem > 0 ? 0.15 : 0) + (t.sprint ? 0.1 : 0) - (t.brace ? 0.28 : 0) - (t.guard ? 0.06 : 0) + (f.arch.key === 'grappler' || f.arch.key === 'runner' ? 0.08 : 0);
  p += 0.12 * (f.gas - t.gas);
  if (t.clinch && t.clinch !== f.clinch) p += 0.18; // tied up by your teammate
  const combo = G.simTime < (t.tripWin || 0);
  if (H) p += 0.08 + (combo ? 0.22 : 0); // the shove-then-trip combo
  if (f.weapon && f.weapon.special === 'hook') p += 0.16; // hockey stick
  if (meleeRolesOn() && f.ai.role === 'runner') p += 0.08;
  p += 0.04 * perk(f, 'grapple.ankle') + (G.simTime < (f.chainT || 0) ? 0.25 : 0);
  if (chance(clamp(p, 0.05, 0.92))) {
    if (P) { hitMark('#f2c40f'); toast('Tripped!', 'big'); ev('trip', { ok: true, combo }); t.comboTrip = combo; }
    G.stats.tripsOk++;
    const dir = vnorm({ x: t.pos.x - f.pos.x + t.lean.x * 2, z: t.pos.z - f.pos.z + t.lean.z * 2 });
    t.noStep = 0.65; applyImpulse(t, dir, 1.45 * botScale(f, 1.35), { type: 'trip', by: f });
    if (t.clinch) breakClinch(t);
    AU.thud(0.6, vol(f));
  } else {
    f.action.failed = true; f.noStep = 0.3; applyImpulse(f, vnorm({ x: t.pos.x - f.pos.x, z: t.pos.z - f.pos.z }), 0.45);
    if (P) { toast('Trip failed', 'bad', t.brace ? 'They were braced' : ratio < 0.3 ? 'Too steady. Shove or hit them first' : 'So close. Again!'); ev('trip', { ok: false }); }
  }
}

function resolveGrab(f) {
  const P = f.isPlayer, H = humanFighter(f);
  // a seized polearm haft: grab again to twist it out of their hands
  if (f.haftOn && G.simTime < f.haftUntil && isUp(f.haftOn) && f.haftOn.weapon) {
    const t = f.haftOn; f.haftOn = null;
    if (chance(0.55 + 0.1 * (f.arch.grip - t.arch.grip) + (f.gas - t.gas) * 0.3)) { disarm(t, 'twisted out of their hands'); if (P) { toast('Yoinked the polearm!', 'big', 'They have to run for a reserve'); ev('disarm'); } else if (t.isPlayer) toast('Haft twisted away!', 'bad', 'Get to your weapon zone'); }
    else { if (P) toast('They held on', 'bad'); applyImpulse(f, vnorm({ x: f.pos.x - t.pos.x, z: f.pos.z - t.pos.z }), 0.35); }
    return;
  }
  const far = findTarget(f, 1.95, 1.0, false);
  if (far && far.weapon && far.weapon.haft && far.weapon.hands === 2 && dist2(far.pos, f.pos) > 1.0 && !f.clinch && !far.clinch) { // grab the haft of a polearm (legal: BR 3.5)
    if (chance(far.brace ? 0.35 : 0.6)) { f.haftOn = far; f.haftUntil = G.simTime + 1.6; far.cd = Math.max(far.cd, 1.2); if (far.action && far.action.kind === 'swing') far.action = null; AU.thud(0.5, vol(f));
      if (P) toast('Haft seized!', 'good', 'Grab again to twist it away'); else if (far.isPlayer) toast('They grabbed your haft!', 'info', 'Shove or back off'); feed(`${label(f)} grabs ${label(far)}'s polearm haft.`, 'BR 3.5', teamColor(f)); }
    else if (P) toast('Missed the haft', 'bad');
    return;
  }
  const t = findTarget(f, 0.95 + (H ? 0.3 : 0) + 0.15 * perk(f, 'grapple.longarms'), H ? 1.2 : 1.0, false);
  if (!t || t.clinch || f.clinch || t.state !== 'standing') { f.action.failed = true; if (P) toast('Grab missed', 'bad', t && t.clinch ? 'Already tied up' : 'Get closer first'); return; }
  const c = { a: f, b: t, t: 0, idle: 0 }; f.clinch = c; t.clinch = c; G.clinches.push(c);
  t.action = null; AU.thud(0.6, vol(f));
  if (P) { toast('Clinch!', 'good', 'Swing = knee · Trip = throw · Grab = disarm'); ev('grab'); }
  else if (t.isPlayer) toast('Grabbed!', 'info', 'Shove to break free, or trip to throw');
}
function resolveKnee(f) { // free-hand punch or knee inside the clinch (BR 3.1)
  const c = f.clinch; if (!c) return; const t = c.a === f ? c.b : c.a;
  const dir = vnorm({ x: t.pos.x - f.pos.x, z: t.pos.z - f.pos.z });
  applyImpulse(t, dir, 0.42 * f.arch.power * botScale(f, 1.35), { type: 'hit', by: f }); t.gas = Math.max(0, t.gas - 0.045); f.gas = Math.max(0, f.gas - 0.03);
  AU.thud(0.8, vol(f)); c.idle = Math.max(0, c.idle - 1.5);
  if (f.isPlayer) { hitMark('#ffffff'); toast('Knee', 'good'); ev('knee'); }
}
function resolveThrow(f) { // hip throw or trip from the clinch (BR 3.4)
  const c = f.clinch; if (!c) return; const t = c.a === f ? c.b : c.a; f.gas = Math.max(0, f.gas - 0.08);
  let p = 0.18 + 0.5 * (f.gas - t.gas) + 1.4 * vlen(t.lean) / FALL_L + (f.arch.grip - 1) * 0.5 - (t.brace ? 0.2 : 0) + (massF(f) - massF(t)) * 0.4 + (f.up ? 0.04 * (f.up.gauntlets || 0) : 0) + pfx(f, 'grip') + 0.1 * perk(f, 'grapple.grip');
  if ((perk(f, 'grapple.suplex') && t.gas < 0.4) || chance(clamp(p, 0.06, 0.88))) {
    breakClinch(f);
    const side = chance(0.5) ? 1 : -1; const d = vnorm({ x: t.pos.x - f.pos.x, z: t.pos.z - f.pos.z });
    const dir = vnorm({ x: d.x - d.z * side * 0.8, z: d.z + d.x * side * 0.8 });
    t.noStep = 0.7; applyImpulse(t, dir, 1.7 * botScale(f, 1.35) * (1 + 0.25 * perk(f, 'grapple.hiptoss')), { type: 'throw', by: f }); AU.thud(1, vol(f)); if (perk(f, 'grapple.chain')) f.chainT = G.simTime + 3;
    if (f.isPlayer) { hitMark('#f2c40f'); toast('Thrown!', 'big'); ev('throw'); }
  } else { f.action.failed = true; f.noStep = 0.25; applyImpulse(f, vnorm({ x: t.pos.x - f.pos.x, z: t.pos.z - f.pos.z }), 0.38); c.idle = Math.max(0, c.idle - 1); if (f.isPlayer) toast('Throw failed', 'bad', 'Wear them down with knees first'); }
}
function resolveDisarm(f) { // grabbing the haft or hilt, never the blade (BR 3.3)
  const c = f.clinch; if (!c) return; const t = c.a === f ? c.b : c.a;
  if (!t.weapon) { f.action.failed = true; return; }
  const p = (0.2 + 0.45 * (f.gas - t.gas) + (f.arch.grip - 1) * 0.4 + 0.15 * perk(f, 'grapple.pickpocket')) * (t.up ? 1 - 0.25 * (t.up.gauntlets || 0) : 1) * (1 - pfx(t, 'disarm'));
  if (chance(clamp(p, 0.05, 0.7))) { disarm(t, `taken by ${label(f)}`); if (f.isPlayer) { toast('Disarmed them!', 'big'); ev('disarm'); } } else { f.action.failed = true; c.idle = Math.max(0, c.idle - 1); if (f.isPlayer) toast('Disarm failed', 'bad'); }
}

function disarm(f, how) {
  if (!f.weapon) return;
  const lost=f.weapon, prop=dropWeaponProp(f);
  f.duelLostWeapon={weapon:lost,prop,intact:!(lost.haft&&f.kit.haft?.failed)};
  f.weapon = null; setWeaponModel(f); if (f.action && f.action.kind === 'swing') f.action = null;
  feed(`${label(f)} disarmed, weapon ${how}. ${standardDuel()?'Defend and visit your corner; the marshal will stop play if no legal replacement is available.':"A weapon lying flat can't be picked up."}`,standardDuel()?'Duel weapon recovery':'BR 3.5, 3.6',teamColor(f));
  if (f.spec.sidearm && !f.sidearmUsed && duelWeaponAllowed('short')) f.sidearmT = 1.3;
  AU.block('clash', 0.6, vol(f));
}

function updateRearm(f, dt) {
  if (f.weapon) return;
  if (f.sidearmT > 0) {
    f.sidearmT -= dt;
    if (f.sidearmT <= 0) { f.weapon = WEAPONS.short; f.sidearmUsed = true; setWeaponModel(f); AU.play('drawS0', 0.5 * vol(f)); feed(`${label(f)} draws the sidearm.`, 'BR 3.6', teamColor(f)); }
    return;
  }
  if (standardDuel() && !duelReserveAvailable(f)) { beginDuelWeaponStop(f); return; }
  const sd = sideOf(f), zn = W3.zones[sd];
  if (Math.hypot(f.pos.x - zn.x, f.pos.z - zn.z) < 1.5 && G.reserves[sd] > 0 && reserveAllowed(f)) {
    f.rearmT += dt;
    if (f.rearmT > 0.6) {
      f.rearmT = 0; handReserve(f);
    }
  } else f.rearmT = 0;
}

// ---------- armour wear ----------
function wearPiece(f, piece, amount) {
  const p = f.kit[piece]; if (!p) return;
  if (piece === 'haft' && !(f.weapon && f.weapon.haft && f.weapon.key === f.spec.weapon)) return;
  const mult = (p.tape ? TAPES[p.tape].wear : 1) * (G.mod && G.mod.glass ? 3 : 1) * pieceWearMult(f, piece);
  normalizeRepairPiece(p, piece);
  p.cond = Math.max(0, p.cond - amount * mult * (p.cleaned ? 0.95 : 1) * (f.isPlayer && piece !== 'haft' ? 1 - 0.03 * (shopState().lv.straps || 0) : 1));
  if (!p.fault && p.cond < 0.75) p.fault = piece === 'haft' ? 'wrap' : piece === 'helmet' ? 'dent' : piece === 'legs' ? 'fitting' : 'buckle';
  if (p.failed && p.covered && p.cond <= 0.12) { failPiece(f, piece); return; }
  if (p.failed) return;
  if (p.cond < 0.3 && chance(0.1 + (0.3 - p.cond) * 2.0)) failPiece(f, piece);
}
function failPiece(f, piece) {
  const p = f.kit[piece];
  repairRecordFault(f, piece, piece === 'haft' ? (p.fault === 'haft' ? 'haft' : 'wrap') : p.cond < 0.2 ? 'strap' : 'fitting');
  if (piece === 'haft') { if (!p.failed) { p.failed = true; if (f.isPlayer) feed('Your haft wrap is torn. Rewrap it before the next round.', 'WR 7.2.2', teamColor(f)); } return; }
  const melee = G.match && !G.match.duel && !G.match.training && G.phase === 'fight';
  if (melee) {
    if (p.failed && !p.covered) return;
    const newlyFailed = !p.failed;
    if (newlyFailed) G.stats.failures++;
    p.failed = true;
    if (p.cond > 0.12) {
      p.covered = true;
      if (newlyFailed) feed(`${label(f)} has loose ${PIECE_NAMES[piece].toLowerCase()}, but remains protected.`, 'BR 1.3.1', teamColor(f));
      return;
    }
    p.covered = false;
    if (piece === 'helmet') popHelmet(f);
    meleeArmourKnee(f, piece);
    return;
  }
  G.stats.failures++;
  if (piece === 'helmet') {
    if (p.failed) return;
    p.failed = true; popHelmet(f);
    if (armorStrike(f, piece)) return;
    emergencyArmourStop(f, piece);
    return;
  }
  const nm = PIECE_NAMES[piece].toLowerCase();
  if (p.failed) return;
  p.failed = true;
  p.covered = false;
  if (armorStrike(f, piece)) return;
  comm('armour', {}, 2); caption('strap', 'a strap snaps');
  emergencyArmourStop(f, piece);
}
function popHelmet(f) {
  const J = f.model; const helm = new THREE.Group();
  // The head group also contains face and hair meshes. Only the helmet shell falls.
  [...J.head.children].forEach(c => { if (c !== J.helmBand) J.head.remove(c); });
  mk(J.head, geo('coif', () => new THREE.SphereGeometry(0.12, 12, 10)), MAT.gambeson, 0, 0.11, 0).scale.setScalar(J.cute ? 1.4 : 1);
  mk(helm, geo('fallen_helmet', () => new THREE.SphereGeometry(0.14, 14, 10, 0, TAU, 0, Math.PI * 0.68)), J.cute ? J.strap : MAT.steel, 0, 0.08, 0);
  helm.position.set(f.pos.x + rand(-1, 1), 0.12, f.pos.z + rand(-1, 1)); helm.rotation.set(rand(0, 3), rand(0, 3), 1.4);
  W3.matchRoot.add(helm); G.props.push(helm);
}
function armorStrike(f, piece) {
  f.armorStrikes = (f.armorStrikes || 0) + 1;
  if (f.armorStrikes < 3) {
    feed(label(f) + ' has armour strike ' + f.armorStrikes + ' of 2. Repair it before returning.', 'BR 1.3.1', 'var(--card-red)');
    return false;
  }
  f.out = true;
  f.returnAt = -1;
  marshalCall('Armour failure', label(f) + ' has three armour strikes and loses.', 3);
  feed(label(f) + ' loses after the third armour strike.', 'REG 5.4.2', 'var(--card-red)');
  if (G.match && G.match.duel && G.phase === 'fight') {
    G.match.duelDQ = f.team;
    G.match.wins[1 - f.team] = 2;
    after(0.35, () => { if (G.phase === 'fight') endRound('duel'); });
  }
  return true;
}

// ---------- contact between bodies ----------
G.clinches = [];
function resolveCollisions(dt) {
  const fs = G.fighters;
  for (let i = 0; i < fs.length; i++) {
    const A = fs[i]; if (A.out) continue;
    for (let j = i + 1; j < fs.length; j++) {
      const B = fs[j]; if (B.out) continue;
      const aDown = isDown(A), bDown = isDown(B);
      if (aDown && bDown) continue;
      if (aDown || bDown) { bodyObstacle(aDown ? B : A, aDown ? A : B); continue; }
      if (A.clinch && A.clinch === B.clinch) continue;
      const dx = B.pos.x - A.pos.x, dz = B.pos.z - A.pos.z; const d = Math.hypot(dx, dz) || 0.001; const minD = A.radius + B.radius;
      if (d >= minD) continue;
      const nx = dx / d, nz = dz / d, ov = minD - d, tm = A.mass + B.mass;
      A.pos.x -= nx * ov * B.mass / tm; A.pos.z -= nz * ov * B.mass / tm;
      B.pos.x += nx * ov * A.mass / tm; B.pos.z += nz * ov * A.mass / tm;
      const rel = (A.vel.x - B.vel.x) * nx + (A.vel.z - B.vel.z) * nz;
      if (rel > 0) {
        if (rel > 1.4 && A.team !== B.team) { // a charge landing
          const imp = (rel - 1.4) * 0.34;
          applyImpulse(B, { x: nx, z: nz }, imp * 2 * A.mass / tm * (B.brace ? 0.55 : 1), { type: 'collision', by: A });
          applyImpulse(A, { x: -nx, z: -nz }, imp * 2 * B.mass / tm * (A.brace ? 0.55 : 1), { type: 'collision', by: B });
          if (rel > 2.2) AU.clang(0.5, Math.min(vol(A), vol(B)) * 0.8);
        }
        const share = rel * 0.5;
        A.vel.x -= nx * share; A.vel.z -= nz * share; B.vel.x += nx * share; B.vel.z += nz * share;
      }
    }
  }
  for (const f of fs) { if (!f.out && (f.state === 'standing' || f.state === 'posting')) clampToList(f); }
  // pinned: against the rail with an opponent on you
  for (const f of fs) {
    f.pinned = false; if (!isUp(f) || !f.atRail) continue;
    for (const o of fs) if (o.team !== f.team && isUp(o) && dist2(o.pos, f.pos) < f.radius + o.radius + 0.2) { f.pinned = true; break; }
  }
}
function bodyObstacle(S, D) {
  if (S.state !== 'standing' && S.state !== 'posting') return;
  const dx = S.pos.x - D.groundPos.x, dz = S.pos.z - D.groundPos.z; const d = Math.hypot(dx, dz) || 0.001; const minD = S.radius + 0.42;
  if (d >= minD) return;
  const nx = dx / d, nz = dz / d; S.pos.x += nx * (minD - d); S.pos.z += nz * (minD - d);
  const into = -(S.vel.x * nx + S.vel.z * nz);
  if (into > 1.6 && S.noStep <= 0) { applyImpulse(S, vnorm(S.vel), 0.45, { type: 'body', by: null }); S.noStep = 0.2; }
  if (into > 0) { S.vel.x += nx * into; S.vel.z += nz * into; }
}

function breakClinch(f) {
  const c = f.clinch; if (!c) return;
  c.a.clinch = null; c.b.clinch = null; const i = G.clinches.indexOf(c); if (i >= 0) G.clinches.splice(i, 1);
}
function updateClinches(dt) {
  for (const c of [...G.clinches]) {
    const { a, b } = c;
    if (a.state !== 'standing' || b.state !== 'standing' || G.phase !== 'fight') { breakClinch(a); continue; }
    c.t += dt; c.idle += dt;
    if (vlen(a.lean) > 0.2 || vlen(b.lean) > 0.2) c.idle = 0;
    // hold each other at grappling distance, drift with the stronger push
    const dx = b.pos.x - a.pos.x, dz = b.pos.z - a.pos.z; const d = Math.hypot(dx, dz) || 0.01; const want = 0.72;
    const corr = (d - want) * 0.5; a.pos.x += dx / d * corr; a.pos.z += dz / d * corr; b.pos.x -= dx / d * corr; b.pos.z -= dz / d * corr;
    a.wantFace = Math.atan2(dx, dz); b.wantFace = Math.atan2(-dx, -dz);
    const sa = a.mass * (0.4 + a.gas) * a.arch.grip, sb = b.mass * (0.4 + b.gas) * b.arch.grip;
    const vx = (a.move.x * sa + b.move.x * sb) / (sa + sb) * 0.9, vz = (a.move.z * sa + b.move.z * sb) / (sa + sb) * 0.9;
    a.vel.x = b.vel.x = vx; a.vel.z = b.vel.z = vz;
    if (c.idle >= BREAK_AFTER) { G.stats.breaks++; fieldBreak(c); }
  }
}
// Scoped recovery adapter: existing production match formats remain unchanged.
function standardDuel(m=G.match){return !!(m?.duel&&!m.pro&&!m.training&&!m.crownNPC);}
function duelWeaponAllowed(key,m=G.match){
 if(!standardDuel(m))return true;
 const w=WEAPONS[key];
 if(!w)return false;
 if(m.duelCat==='Polearm')return w.hands===2&&!!w.haft;
 if(m.duelCat==='Longsword')return w.hands===2&&!w.haft;
 return w.hands===1;
}
function matchScoreText(m=G.match){if(m.duelForfeit!=null)return `by technical decision (${m.technicalReason==='withdrawal'?'withdrawal':'equipment unavailable'}); ${m.pts[0]}–${m.pts[1]} recorded points`;return `${m.wins[0]}–${m.wins[1]} in rounds`;}
// Existing spares are finite. Exhaustion holds the clock; it does not create a
// third spare, add points, or make striking an unarmed duelist legal.
function duelReserveAvailable(f) {
  const side=sideOf(f), count=G.reserves[side], key=G.reserveKeys?.[side]?.[2-count];
  return count>0 && reserveAllowed(f) && !!WEAPONS[key] && duelWeaponAllowed(key);
}
function duelReturnableWeapon(f) {
  const lost=f.duelLostWeapon;
  return lost?.intact && lost.weapon && duelWeaponAllowed(lost.weapon.key) ? lost : null;
}
function beginDuelWeaponStop(f) {
  if (!standardDuel() || G.phase!=='fight' || G.weaponStop || f.weapon || f.sidearmT>0 || !isUp(f)) return;
  G.weaponStop={match:G.match,f,left:60,age:0,silent:!!G.attract}; G.phase='weapon-stop';
  for (const actor of G.fighters) { if(actor.clinch)breakClinch(actor);actor.action=null;actor.move={x:0,z:0};actor.vel={x:0,z:0};actor.guard=false; }
  if(G.weaponStop.silent)return; // Background festival bouts must never take over the player's menus.
  marshalCall('Stop fight.', 'Disarmed duelist. Clock stopped for a legal weapon check.', 3); setHud(false);
  const available=!!duelReturnableWeapon(f);
  msg('weapon check','Duel paused',`<p>No usable corner replacement is available for ${escTxt(label(f))}. The fight clock and score are held.</p><p>${available ? 'The marshal can return the same intact, category-legal weapon. No spare is added.' : 'No intact category-legal weapon is available. The marshal allows one minute to resolve the equipment problem; inability to continue results in a technical loss.'}</p><p id="duelWeaponClock" role="timer">1:00</p><p>Do not strike an unarmed opponent.</p>`, f.isPlayer ? [...(available ? [['Collect my weapon', finishDuelWeaponStop, true]] : []), ['Withdraw from this duel',()=>forfeitDuelWeaponStop('withdrawal')]] : []);
}
function finishDuelWeaponStop() {
  const stop=G.weaponStop;if(!stop||stop.match!==G.match)return false;
  const f=stop.f,lost=duelReturnableWeapon(f);if(!lost)return false;
  f.weapon=lost.weapon;f.duelLostWeapon=null;f.rearmT=0;
  if(lost.prop){lost.prop.removeFromParent();G.props=G.props.filter(p=>p!==lost.prop);}
  setWeaponModel(f);recalcBody(f);G.weaponStop=null;G.phase='fight';if(!stop.silent){showScreen(null);setHud(true);refreshTouchUI();}
  marshalCall('Fight.', 'Original weapon returned. Scores and reserve stock unchanged.', 2);return true;
}
function forfeitDuelWeaponStop(reason) {
  const stop=G.weaponStop;if(!stop||stop.match!==G.match)return;
  G.weaponStop=null;const m=G.match;m.duelForfeit=stop.f.team;m.technicalReason=reason;
  m.wins[1-stop.f.team]=2;G.phase='fight';if(!stop.silent){showScreen(null);setHud(true);}
  marshalCall('Technical decision', reason==='withdrawal'?'Competitor withdrew.':'No legal equipment after the one-minute allowance.',3);endRound('equipment');
}
function updateDuelWeaponStop(dt) {
  const stop=G.weaponStop;if(!stop)return;
  if(stop.match!==G.match){G.weaponStop=null;return;}
  stop.age+=dt;stop.left=Math.max(0,stop.left-dt);
  const timer=!stop.silent&&$('#duelWeaponClock');if(timer)timer.textContent=fmtClock(stop.left);
  if(!stop.f.isPlayer&&stop.age>=3&&duelReturnableWeapon(stop.f)){finishDuelWeaponStop();return;}
  if(stop.left===0){if(!finishDuelWeaponStop())forfeitDuelWeaponStop('equipment');}
}
// ===================================================================
// Fighting 2.0: layered on the fighter sim (06_fighter) and the team AI (08_ai).
//  - Directions matter: bots read which side a blow comes from and guard that side; a blow from the side they didn't
//    guard gets half through. Repeat the same side and they learn it; mix it up and they guess.
//  - Timed parry: a perfect block also gives a riposte (your next blow winds up much faster).
//  - Shield bash: a shove with a shield into a raised guard knocks the guard open.
//  - Feints: a wind-up you call off (guard during the wind-up) baits bots into blocking; the better bots feint you too.
//  - Momentum: a blow thrown while closing at speed hits harder. Hit stun: get struck mid-wind-up and the swing is lost
//    unless you're braced.
//  - Balance meter under the breath bar (trips already work against balance, not luck).
//  - Team play: bots peel a teammate who's being doubled.
//  - AI tiers: fairground bots are forgiving, bailey bots parry and feint, the King's Guard mixes everything.
// ===================================================================
// 1 = fairground (forgiving), 2 = bailey, 3 = king's court
const CHALLENGE_MILESTONES = [25, 50, 75, 80, 90, 100];
const CHALLENGE_MAX = Math.pow(1.12, 3) * Math.pow(1.20, 3);
function challengeLevel() {
  const level = G.match && G.match.challengeLevel != null ? G.match.challengeLevel : (typeof CAREER !== 'undefined' ? CAREER.level : 1);
  return clamp(Math.floor(Number(level) || 1), 1, 100);
}
function challengeStage(level = challengeLevel()) { return CHALLENGE_MILESTONES.filter(n => level >= n).length; }
function challengeFactor(level = challengeLevel()) {
  const stage = challengeStage(level);
  return Math.pow(1.12, Math.min(stage, 3)) * Math.pow(1.20, Math.max(0, stage - 3));
}
function botChallenge(f) {
  if (!f || f.isPlayer || f.vin || f.netUid || !G.match || G.match.training || G.match.attract || G.attract) return 0;
  if (f.team === 0 && !G.match.online && ((!G.match.versus && !G.match.ffa) || (G.match.local && G.match.local.startsWith('coop')))) return 0;
  return G.match.challengePressure || 0;
}
function botScale(f, cap) { return 1 + (cap - 1) * botChallenge(f); }
function aiTier(f) {
  const m = G.match; if (!m) return 1;
  if (m.training || m.attract) return 1;
  if (f && f.team === 0 && !m.online && ((!m.versus && !m.ffa) || (m.local && m.local.startsWith('coop')))) return 1;
  if (m.aiTier) return m.aiTier;
  if (m.trial) return m.trial === 'royal' ? 3 : 2;
  if (m.townBout && typeof TOWN !== 'undefined' && TOWN.boutArena) { const A = ARENAS.find(a => a.key === TOWN.boutArena); return A && A.district === 'ward' ? 3 : A && A.district === 'bailey' ? 2 : 1; }
  return Math.min(3, 1 + challengeStage());
}
const AI_TIER = {
  1: { read: 0.4, learn: 0.18, parry: 0.04, feint: 0, unfooled: 0, peel: 0.6 },
  2: { read: 0.58, learn: 0.25, parry: 0.14, feint: 0.12, unfooled: 0.35, peel: 1.2 },
  3: { read: 0.72, learn: 0.28, parry: 0.24, feint: 0.2, unfooled: 0.6, peel: 1.8 }
};
function tierProf(prof, f) {
  const k = aiTier(f); if (f.team === 0 && !(G.match && (G.match.ffa || G.match.online || (G.match.versus && !(G.match.local && G.match.local.startsWith('coop')))))) return prof;
  const growth = botChallenge(f);
  const tierReact = k === 3 ? 0.82 : k === 2 ? 0.92 : 1;
  const tierGuard = k === 3 ? 0.14 : k === 2 ? 0.07 : 0;
  const tierAggr = k === 3 ? 1.1 : k === 2 ? 1.04 : 1;
  return {
    ...prof,
    react: Math.max(0.11, prof.react * tierReact * (1 - 0.35 * growth)),
    guard: Math.min(0.92, prof.guard + tierGuard + 0.16 * growth),
    aggr: prof.aggr * tierAggr * (1 + 0.35 * growth)
  };
}
// which side will this blow come from? a bot guesses, better if it has seen you favour one side
function aiReadArc(f, e) {
  const T = AI_TIER[aiTier(f)], arc = e.action && e.action.arc || 'R2L', seen = f.ai.seen || [];
  const fav = seen.length >= 2 ? ['R2L', 'L2R', 'O'].map(a => [a, seen.filter(s => s === a).length]).sort((a, b) => b[1] - a[1])[0] : null;
  let p = T.read + (fav && fav[0] === arc ? T.learn * Math.min(1, fav[1] / 3) : 0);
  if (e.action && e.action.held) p -= 0.15; // a blow still being cocked is harder to read
  if (chance(clamp(p, 0.1, 0.92))) return arc;
  const others = ['R2L', 'L2R', 'O'].filter(a => a !== arc); return fav && fav[0] !== arc ? fav[0] : pick(others);
}
function noteArc(t, arc) { if (!t.ai) return; const s = t.ai.seen || (t.ai.seen = []); s.push(arc); if (s.length > 5) s.shift(); }
// called from resolveSwing at the guard check: how much of a guarded blow gets through, and is it a parry?
// the side a blow lands on, seen by the defender: the attacker's right-to-left arrives on your left
const ARC_SIDE = { R2L: 'L', L2R: 'R', O: 'H' };
function guardOutcome(f, t, a, bf) {
  noteArc(t, a.arc);
  if (t.isPlayer || t.netUid || t.vin || t.gdir) {
    const want = ARC_SIDE[a.arc] || 'H', g = t.gdir || 'mid';
    if (g === want) return { bf, parry: false };
    return { bf: (bf + 1) / 2, parry: false, wrong: g !== 'mid', mid: g === 'mid' };
  }
  if (!t.ai) return { bf, parry: false };
  const T = AI_TIER[aiTier(t)];
  if (t.ai.gdir && t.ai.gdir !== a.arc) return { bf: (bf + 1) / 2, parry: false, wrong: true }; // guarded the wrong side
  return { bf, parry: chance(T.parry) };
}
// momentum: closing speed toward the target, in m/s
function closingSpeed(f, t) { const d = vnorm({ x: t.pos.x - f.pos.x, z: t.pos.z - f.pos.z }); return Math.max(0, f.vel.x * d.x + f.vel.z * d.z); }
// a bot about to swing may feint instead (tier 2+)
function aiMaybeFeint(f) {
  const T = AI_TIER[aiTier(f)]; if (!T.feint || !f.action || f.action.kind !== 'swing') return;
  if (chance(T.feint)) f.action.feintAt = rand(0.06, Math.max(0.08, (f.action.wind || swingTimes(f).wind) * 0.7));
}
// someone called off a wind-up: bots who'd raised a guard for it may drop it (the better ones aren't fooled for long)
function feintCalled(f) {
  for (const o of G.fighters) {
    if (o.team === f.team || o.isPlayer || !o.ai || !isUp(o) || o.ai.guardT <= 0 || dist2(o.pos, f.pos) > 3) continue;
    if (chance(AI_TIER[aiTier(o)].unfooled)) o.ai.guardT = Math.min(o.ai.guardT, 0.08);
  }
  if (f.isPlayer) { MT.feints = (MT.feints || 0) + 1; }
}
// team play: a bonus for going after whoever is doubling one of my mates
function peelBonus(f, e, mates) {
  const T = AI_TIER[aiTier(f)];
  for (const m of mates) if (dist2(e.pos, m.pos) < 2.5 && facingDot(e, m) > 0.25) {
    let n = 0; for (const o of G.fighters) if (o.team === e.team && isUp(o) && dist2(o.pos, m.pos) < 2.5) n++;
    if (n >= 2) return T.peel;
  }
  return 0;
}
// ---------- officials: calls, fouls, cards (REG 2, 5, 6) ----------
G.timers = [];
function after(sec, fn) { G.timers.push({ at: G.simTime + sec, fn }); }
function runTimers() { const now = G.simTime; const due = G.timers.filter(t => t.at <= now); G.timers = G.timers.filter(t => t.at > now); due.forEach(t => t.fn()); }

function buildMarshals() {
  G.marshals.forEach(m => W3.matchRoot.remove(m.model.root));
  G.marshals = [];
  const { W, L } = LIST;
  const add = (role, x, z) => { const model = buildMarshalModel(role); const m = { role, pos: { x, z }, home: { x, z }, facing: 0, flagUp: 0, model, walk: 0 }; model.root.position.set(x, 0, z); W3.matchRoot.add(model.root); G.marshals.push(m); return m; };
  add('knight', -W / 2 + 1.3, 0);
  add('field', W / 2 - 1.6, -5); add('field', -W / 2 + 1.8, 6);
  for (const [x, z] of [[W / 2 + 1.0, -8], [W / 2 + 1.0, 8], [-W / 2 - 1.0, -8], [-W / 2 - 1.0, 8], [0, L / 2 + 1.0], [0, -L / 2 - 1.0]]) add('line', x, z);
}

function updateMarshals(dt) {
  const ups = G.fighters.filter(isUp);
  let cx = 0, cz = 0; ups.forEach(f => { cx += f.pos.x; cz += f.pos.z; }); if (ups.length) { cx /= ups.length; cz /= ups.length; }
  for (const m of G.marshals) {
    m.flagUp = Math.max(0, m.flagUp - dt * 0.6);
    let tx = m.home.x, tz = m.home.z;
    if (m.role === 'field' && ups.length) {
      // shadow the nearest knot of fighters from about 3.5 m away
      let best = null, bd = 1e9; for (const f of ups) { const d = dist2(f.pos, m.pos); if (d < bd) { bd = d; best = f; } }
      const off = vnorm({ x: m.home.x - best.pos.x, z: (m.home.z - best.pos.z) || 0.1 });
      tx = clamp(best.pos.x + off.x * 3.6, -LIST.W / 2 + 0.8, LIST.W / 2 - 0.8); tz = clamp(best.pos.z + off.z * 3.6, -LIST.L / 2 + 0.8, LIST.L / 2 - 0.8);
      if (m.breakTarget) { tx = m.breakTarget.x; tz = m.breakTarget.z; }
    } else if (m.role === 'knight') { tz = clamp(cz, -8, 8); }
    let mx = tx - m.pos.x, mz = tz - m.pos.z; const md = Math.hypot(mx, mz);
    for (const f of G.fighters) { if (f.out) continue; const p = isDown(f) ? f.groundPos : f.pos; const ax = m.pos.x - p.x, az = m.pos.z - p.z; const ad = Math.hypot(ax, az); if (ad < 1.4 && ad > 0.01) { mx += ax / ad * 2.5; mz += az / ad * 2.5; } }
    const ml = Math.hypot(mx, mz); const spd = m.role === 'line' ? 0 : (md > 0.3 ? 2.6 : 0);
    if (ml > 0.01 && spd > 0) { m.pos.x += mx / ml * spd * dt; m.pos.z += mz / ml * spd * dt; m.walk += dt * 7; }
    if (m.role !== 'line') { m.pos.x = clamp(m.pos.x, -LIST.W / 2 + 0.5, LIST.W / 2 - 0.5); m.pos.z = clamp(m.pos.z, -LIST.L / 2 + 0.5, LIST.L / 2 - 0.5); }
    const look = Math.atan2(cx - m.pos.x, cz - m.pos.z); m.facing += angDiff(m.facing, look) * Math.min(1, dt * 4);
    const J = m.model; J.root.position.set(m.pos.x, 0, m.pos.z); J.root.rotation.y = m.facing;
    if (J.ual) { animateUAL(J, spd > 0 && md > 0.3, md, m.flagUp, dt); continue; }
    const sw = spd > 0 && md > 0.3 ? Math.sin(m.walk) * 0.5 : 0; J.legL.rotation.x = sw; J.legR.rotation.x = -sw;
    J.shR.rotation.x = lerp(-0.3, -2.9, ease(m.flagUp)); J.shR.rotation.z = lerp(0, -0.3, m.flagUp);
  }
}
function raiseFlags(role) { G.marshals.forEach(m => { if (!role || m.role === role) m.flagUp = 1.3; }); }

function marshalCall(big, small, priority = 1, speak = true) {
  showCall(big, small); netEvent('c', big, small || '');
  if (speak && G.settings.voice && !G.attract) VOICE.say(big.replace(/[!.]/g, '') + (small && priority >= 2 && priority < 4 ? '. ' + small.replace(/\(.*?\)/g, '') : ''), priority);
}

// can any official see this? (REG 5: a foul in plain view is always called)
function foulVisibility(pos, off, vic) {
  let best = 0;
  for (const m of G.marshals) {
    const d = dist2(m.pos, pos); if (d > (m.role === 'line' ? 14 : 17)) continue;
    let block = 0;
    for (const o of G.fighters) {
      if (o === off || o === vic || !isUp(o)) continue;
      const ex = pos.x - m.pos.x, ez = pos.z - m.pos.z; const el = ex * ex + ez * ez || 1;
      const t = clamp(((o.pos.x - m.pos.x) * ex + (o.pos.z - m.pos.z) * ez) / el, 0, 1);
      const px = m.pos.x + ex * t - o.pos.x, pz = m.pos.z + ez * t - o.pos.z;
      if (Math.hypot(px, pz) < o.radius + 0.05 && t > 0.05 && t < 0.95) block++;
    }
    best = Math.max(best, (block === 0 ? 1 : block === 1 ? 0.45 : 0.08) * (d < 9 ? 1 : 0.8));
  }
  return best;
}

const FOULS = {
  grounded: { text: 'strike on a grounded fighter', cite: 'BR 4.12' },
  disarmed: { text: 'strike on a disarmed duelist', cite: 'Duels 4.5' },
  skull: { text: 'strike to the base of the skull', cite: 'BR 6' },
  knee: { text: 'strike to the back of the knee', cite: 'BR 6' },
  earlyRise: { text: 'got up before "All rise"', cite: 'REG 6.2.1' },
};
function reportFoul(off, vic, kind) {
  if (G.match && G.match.training) return; // no fouls in the yard
  if (G.match && G.match.duel && vic && G.phase === 'fight') duelScore(vic, DUEL_PTS.foul, 'Foul by the other fighter');
  G.stats.fouls++;
  const pos = vic ? (isDown(vic) ? vic.groundPos : vic.pos) : off.pos;
  const repeat = off.lastFoulT && G.simTime - off.lastFoulT < 25;
  off.lastFoulT = G.simTime;
  const seen = kind === 'earlyRise' ? 1 : foulVisibility(pos, off, vic);
  if (!chance(repeat ? Math.min(1, seen * 1.5) : seen)) {
    if (off.isPlayer) feed('That one went unseen behind the pile-up. Control is a skill.', 'BR 4', 'var(--dim)');
    return;
  }
  if (vic && isUp(vic)) vic.foulVictimT = G.simTime;
  raiseFlags(off.isPlayer ? null : 'field');
  penalize(off, FOULS[kind].text, FOULS[kind].cite, kind === 'earlyRise');
}

function penalize(f, text, cite, straightYellow) {
  const r = f.rec; const tk = f.club.key + '-' + f.num;
  const green = G.tourney && G.tourney.green[tk];
  let card;
  if (r.warnings === 0 && !straightYellow && perk(f, 'show.marshal') && G.match && !G.match.forgiven) { G.match.forgiven = true; feed('The marshal lets your first warning go with a look.', '', 'var(--marshal)'); return; }
  if (r.warnings === 0 && !straightYellow && !(G.match && G.match.warnedFor === tk)) { r.warnings++; card = 'warning'; }
  else { r.yellows++; card = (r.yellows >= 2 || green) ? 'red' : 'yellow'; }
  G.stats.cards += card === 'warning' ? 0 : 1;
  if (G.match) G.match.cards.push({ who: label(f), team: f.team, card, text, cite, round: G.match.round });
  const head = { warning: 'Warning', yellow: 'Yellow card', red: 'Red card' }[card];
  marshalCall(head, `${label(f)}: ${text}`, card === 'red' ? 3 : 2);
  if (card !== 'warning') comm(card === 'red' ? 'red' : 'card', { card: head, who: label(f) }, card === 'red' ? 3 : 2);
  feed(`${cardIcon(card)}${head} for ${label(f)}: ${text}${card === 'red' && green ? ' (green card from the kit check turns the yellow red)' : ''}.`, card === 'red' && green ? 'REG 6.4' : cite, card === 'red' ? 'var(--card-red)' : 'var(--marshal)');
  if (card === 'red') {
    r.red = true; f.redMatches = 2;
    if (isUp(f)) marshalGround(f, 'red card, out of the list', 'REG 6.3.3');
    if (G.match && G.match.duel && G.phase === 'fight') {
      // In a duel a red card is an immediate disqualification, not a
      // suspension that carries into the next round.  Award the match to the
      // other fighter and stop the current round so the red-carded fighter
      // cannot recover and win on points.
      G.match.duelDQ = f.team;
      G.match.wins[1 - f.team] = 2;
      f.out = true;
      f.returnAt = -1;
      after(0.35, () => { if (G.phase === 'fight') endRound('duel'); });
    }
    if (f.isPlayer) after(0.3, () => setStatus('Red card. You sit out the rest of this match and the next (REG 6.3.3).', 'var(--card-red)', 5));
  }
}
function cardIcon(card) {
  if (card === 'warning') return '';
  const c = { yellow: 'var(--marshal)', red: 'var(--card-red)', green: 'var(--card-green)' }[card];
  return `<span class="card" style="background:${c}"></span>`;
}

function fieldBreak(c) {
  const { a, b } = c; breakClinch(a);
  const dx = b.pos.x - a.pos.x, dz = b.pos.z - a.pos.z; const d = Math.hypot(dx, dz) || 1;
  const fm = G.marshals.filter(m => m.role === 'field').sort((m1, m2) => dist2(m1.pos, a.pos) - dist2(m2.pos, a.pos))[0];
  if (fm) { fm.flagUp = 1.6; fm.breakTarget = { x: (a.pos.x + b.pos.x) / 2 + dz / d * 0.8, z: (a.pos.z + b.pos.z) / 2 - dx / d * 0.8 }; after(1.6, () => { fm.breakTarget = null; }); }
  marshalCall('Break!', 'Passive clinch. Two steps apart.', 2);
  feed(`Field Marshal breaks the clinch between ${label(a)} and ${label(b)}.`, 'BR 4.10', 'var(--marshal)');
  for (const [f, s] of [[a, -1], [b, 1]]) { f.pos.x += dx / d * 0.55 * s; f.pos.z += dz / d * 0.55 * s; f.cd = 0.9; f.vel = { x: 0, z: 0 }; f.ai.next = 0.9; }
  after(1.0, () => { if (G.phase === 'fight') marshalCall('Fight.', '', 1); });
}
// ---------- animated officials: Quaternius' Universal Animation Library mannequin (CC0) ----------
// Marshals and squires walk, idle, talk and kneel with real motion-captured-style clips instead of stick legs.
const UAL = { ready: false, gltf: null, clips: {}, H: 1.83 };
function loadUAL() {
  if (typeof UAL_GLB === 'undefined' || typeof GLTFX === 'undefined' || UAL.loading) return; UAL.loading = true;
  try {
    const bin = atob(UAL_GLB); const u8 = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
    new GLTFX.GLTFLoader().parse(u8.buffer, '', g => {
      UAL.gltf = g; g.animations.forEach(a => UAL.clips[a.name] = a); UAL.ready = true;
      if (G.match && G.marshals.length) { buildMarshals(); rebuildCrew(); }
    }, e => { UAL.failed = String(e); });
  } catch (e) { UAL.failed = String(e); }
}
const UAL_AXIS = new THREE.Vector3(0, 0, 1); // the axis the right upper arm swings up around (tuned by eye)
function ualPerson(o) {
  const root = new THREE.Group(); const body = SkelUtils.clone(UAL.gltf.scene); root.add(body);
  body.scale.setScalar((o.h || 1.78) / UAL.H);
  const main = new THREE.MeshStandardMaterial({ color: o.main || '#1a1d21', roughness: 0.85 }), joints = new THREE.MeshStandardMaterial({ color: o.joints || '#2a2e33', roughness: 0.7 });
  const bones = {};
  body.traverse(n => {
    if (n.isMesh) { const pickM = m => m && /Joint/i.test(m.name) ? joints : main; n.material = Array.isArray(n.material) ? n.material.map(pickM) : pickM(n.material); n.castShadow = SHADOWS; n.frustumCulled = false; }
    if (n.isBone) bones[n.name] = n;
  });
  const mixer = new THREE.AnimationMixer(body), acts = {};
  for (const k in UAL.clips) acts[k] = mixer.clipAction(UAL.clips[k]);
  const J = { root, ual: true, mixer, acts, bones, cur: null, legL: new THREE.Object3D(), legR: new THREE.Object3D(), shR: new THREE.Object3D(), torso: new THREE.Object3D() };
  J.handR = bones.hand_r || root;
  J.play = (name, fade = 0.3) => { if (J.cur === name || !acts[name]) return; const a = acts[name]; a.reset(); a.setEffectiveWeight(1); a.fadeIn(fade).play(); if (J.cur) acts[J.cur].fadeOut(fade); J.cur = name; };
  J.play(o.anim || 'Idle_Loop', 0); acts[J.cur].time = Math.random() * 3;
  return J;
}
// a band, a cap, a staff with a flag; moose antlers on youth day
function ualMarshal(role) {
  const J = ualPerson({ main: role === 'knight' ? '#26344d' : '#16191c', joints: role === 'knight' ? '#1a2335' : '#2b3036', h: rand(1.72, 1.86) });
  const B = J.bones;
  if (B.upperarm_l) { const band = new THREE.Mesh(geo('ualband', () => new THREE.CylinderGeometry(0.062, 0.062, 0.09, 12, 1, true)), MAT.marshalYellow); band.material.side = THREE.DoubleSide; band.position.y = 0.12; B.upperarm_l.add(band); }
  if (B.Head && role === 'knight') { const cap = new THREE.Mesh(geo('ualcap', () => new THREE.SphereGeometry(0.105, 14, 8, 0, TAU, 0, Math.PI / 2)), MAT.marshalYellow); cap.position.set(0, 0.16, 0.01); cap.scale.set(1.12, 0.9, 1.2); B.Head.add(cap); }
  // the staff: held in the right hand, flag at the top
  const staff = new THREE.Group(); J.handR.add(staff); staff.position.set(0, 0.08, 0.02);
  mk(staff, geo('ualstaff', () => new THREE.CylinderGeometry(0.012, 0.012, 1.1, 6)), new THREE.MeshStandardMaterial({ color: role === 'knight' ? '#2a2d30' : '#e8e4da' }), 0, 0.3, 0);
  const flag = mk(staff, geo('flagcloth', () => new THREE.PlaneGeometry(0.42, 0.3)), new THREE.MeshStandardMaterial({ color: '#f2c40f', side: THREE.DoubleSide, roughness: 0.8, emissive: '#2e2400' }), 0.21, 0.72, 0, false);
  J.flag = flag; J.staff = staff;
  if (CUTE.on && B.Head) {
    const brown = cuteMat('#a4703f'), tan = cuteMat('#d9b48a');
    for (const sx of [-1, 1]) { const a = grp(B.Head, sx * 0.1, 0.2, 0); a.rotation.z = -sx * 0.5; mk(a, geo('c_antS', () => new THREE.CylinderGeometry(0.014, 0.018, 0.14, 6)), brown, 0, 0.06, 0); const palm = mk(a, geo('c_antP', () => new THREE.SphereGeometry(0.09, 12, 8)), tan, 0, 0.16, 0); palm.scale.set(1, 0.45, 0.25); }
    mk(B.Head, geo('c_mnose', () => new THREE.SphereGeometry(0.025, 10, 8)), cuteMat('#ff6f8a'), 0, 0.08, 0.11);
  }
  return J;
}
function ualSquire(club) {
  const J = ualPerson({ main: club.tabard, joints: '#2d3b52', h: rand(1.65, 1.82), anim: 'Idle_Loop' });
  const w = buildWeapon('sword', club); w.position.set(0, 0.08, 0.02); J.handR.add(w); J.reserve = w;
  return J;
}
// called each frame for a marshal using the mannequin: pick the clip from how far and fast they are moving
function animateUAL(J, moving, far, flagUp, dt) {
  J.play(flagUp > 0.05 ? 'Idle_Talking_Loop' : moving ? (far > 2.5 ? 'Jog_Fwd_Loop' : 'Walk_Loop') : 'Idle_Loop');
  J.mixer.update(dt);
  const ua = J.bones.upperarm_r; if (ua && flagUp > 0) ua.rotateOnAxis(UAL_AXIS, -2.4 * ease(Math.min(1, flagUp)));
}
function rebuildCrew() {
  if (!G.crew || !G.match) return;
  // squires keep their spots; swap the old models for animated ones
  const clubs = [CLUBS.reavers, CLUBS[G.match.opp]];
