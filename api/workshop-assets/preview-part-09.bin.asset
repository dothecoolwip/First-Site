// Fighter lookup has its own status. A failed query is never an absent link.
async function bosReadFighterInfo(info, uid) {
  const state = BOS.fighterProfile = { uid, status: 'loading', error: null };
  const read = async (table, columns, column, value) => {
    const result = await bosTimeout(BOS.sb.from(table).select(columns).eq(column, value).limit(1).maybeSingle(), 'Loading your fighter record');
    if (result.error) throw Error('Your fighter record could not be loaded. Retry; your account does not need to be recreated.');
    return result.data;
  };
  try {
    const link = await read('fighter_accounts', 'fighter_id', 'user_id', uid);
    let dir = null;
    if (link?.fighter_id) {
      dir = await read('fighter_directory', 'display_name, team_name, gender', 'id', link.fighter_id);
      if (!dir) throw Error('Your linked fighter directory entry could not be loaded. Retry, or ask BuhurtOS support to check the existing link.');
    }
    if (BOS.user?.id !== uid || BOS.fighterProfile !== state) return;
    info.fighter = link?.fighter_id || null; info.gender = dir?.gender || null;
    if (dir) { info.name = dir.display_name || info.name; info.team = dir.team_name || ''; }
    state.status = 'ready';
    // Career statistics are optional; their failure cannot revoke a valid link.
    if (info.fighter) try {
      const st = await read('fighter_career_stats', 'matches, wins, losses, golds, podiums, tournament_victories', 'fighter_id', info.fighter);
      if (st) Object.assign(info, { m: st.matches || 0, w: st.wins || 0, l: st.losses || 0, golds: st.golds || 0, podiums: st.podiums || 0, wins_t: st.tournament_victories || 0 });
    } catch (e) { /* The verified link is independent of optional statistics. */ }
  } catch (e) { if (BOS.fighterProfile === state) { state.status = 'error'; state.error = e.message; } }
}
async function bosRetryFighterInfo() {
  const uid = BOS.user?.id; if (!uid || BOS.fighterProfile?.status === 'loading') return;
  const info = { ...(BOS.info || {}) };
  await bosReadFighterInfo(info, uid);
  // No bosApply/cloudOnAuth here: retry must not restore or rewrite game saves.
  if (BOS.user?.id === uid && BOS.fighterProfile?.status === 'ready') BOS.info = info;
}
// your BuhurtOS name becomes your fighter's name; everyone online sees the BuhurtOS tick and your real record
function bosApply() {
  const I = BOS.info;
  if (I && I.name) { CAREER.name = String(I.name).slice(0, 20); saveCareer(); }
  try { lobbySet({ name: myName(), pr: myProfile() }); } catch (e) { }
  try { if (NET.room && !ONL.inMatch) NET.room.presence({ name: myName(), bos: !!I }); } catch (e) { }
  const t = $('#bosStatus'); if (t) t.textContent = I ? `Signed in with BuhurtOS as ${I.name}` : 'Not signed in';
  if (G.screen === 'msgScr' && $('#bosBox')) renderBosBox();
}
function bosRecord() { const I = BOS.info; return I && rosterEligible(I.fighter) ? { id: I.fighter, name: I.name, team: I.team, m: I.m, w: I.w, l: I.l, g: I.golds, p: I.podiums, tv: I.wins_t, linked: !!I.fighter } : null; }
// the sign-in box (shown in Play online and Settings)
function renderBosBox() {
  const box = $('#bosBox'); if (!box) return; box.innerHTML = '';
  const I = BOS.info;
  if (I) {
    box.append(h('div', { class: 'bosme' }, h('span', { class: 'bostick' }, '✓'), h('div', null, h('b', null, I.name), h('small', null, I.fighter ? `${I.team ? I.team + ' · ' : ''}${I.m} matches, ${I.w} wins${I.golds ? ', ' + I.golds + ' gold' : ''} on BuhurtOS` : BOS.fighterProfile?.status === 'error' ? 'Fighter record unavailable — retry at the Crown Herald' : BOS.fighterProfile?.status === 'loading' ? 'Loading fighter record…' : 'BuhurtOS account (no fighter linked yet)'))),
      h('button', { class: 'btn tape small', onclick: async () => { AU.click(); if (typeof presenceOffline === 'function') presenceOffline(); try { await (await bosClient()).auth.signOut({ scope: 'local' }); } catch (e) { } localStorage.removeItem(BOS_SESSION_KEY); sessionStorage.removeItem(BOS_SESSION_KEY); BOS.user = null; BOS.info = null; BOS.infoReady = null; BOS.testAdmin = false; creatorReset(); if (typeof cloudOnSignOut === 'function') cloudOnSignOut(); bosApply(); } }, 'Sign out'));
    return;
  }
  box.append(h('button', { class: 'btn primary flagtape bosbtn', onclick: () => { AU.click(); openBosSignIn(); } }, 'Sign in with BuhurtOS'));
}
function openBosSignIn(back) {
  const ret = back || (() => openOnlineHub());
  msg('buhurtos', 'Sign in with BuhurtOS', `<p>Use your BuhurtOS account. Your fighter name and real record show to other players.</p>
    <label class="runcode"><span>Email</span><input id="bosEmail" type="email" autocomplete="email" placeholder="you@example.com"></label>
    <label class="runcode"><span>Password</span><input id="bosPass" type="password" autocomplete="current-password"></label>
    <div class="bosalt"><button class="btn tape small" id="bosCode">Email me a sign-in code instead</button><button class="btn tape small" id="bosGoogle">Google</button><button class="btn tape small" id="bosDiscord">Discord</button></div>
    <p class="muted small" id="bosMsg"></p>`,
    [['Sign in', () => bosPassword(ret), true], ['Back', ret]]);
  const say = t => { const m = $('#bosMsg'); if (m) m.textContent = t; };
  $('#bosCode').onclick = async () => {
    const email = ($('#bosEmail').value || '').trim(); if (!email) { say('Type your email first.'); return; }
    say('Sending…');
    try { const { error } = await bosTimeout((await bosClient()).auth.signInWithOtp({ email, options: { shouldCreateUser: false } }), 'Sending your email code'); if (error) throw error; BOS.otpEmail = email; openBosCode(ret); } catch (e) { say('Couldn’t send a code: ' + (e.message || e)); }
  };
  const oauth = provider => () => bosOAuth(provider, say);
  $('#bosGoogle').onclick = oauth('google'); $('#bosDiscord').onclick = oauth('discord');
}
async function bosPassword(ret) {
  const email = ($('#bosEmail').value || '').trim(), password = $('#bosPass').value || '', say = t => { const m = $('#bosMsg'); if (m) m.textContent = t; };
  if (!email || !password) { say('Type your email and password.'); return; }
  say('Signing in…'); BOS.interactive = true;
  try { const { data, error } = await bosTimeout((await bosClient()).auth.signInWithPassword({ email, password }), 'Signing in'); if (error) throw error; BOS.user = data.user; await bosLoadInfo(); if (CLOUD.applying) return; toastMenu(`Signed in as ${myName()}`); ret(); }
  catch (e) { say(/invalid/i.test(e.message || '') ? 'Wrong email or password. (Signed up with Google or Discord? Use those buttons.)' : 'Couldn’t sign in: ' + (e.message || e)); }
  finally { BOS.interactive = false; }
}
function openBosCode(ret) {
  msg('buhurtos', 'Check your email', `<p>We sent a sign-in email to <b>${escTxt(BOS.otpEmail)}</b>. Type the code from it here.</p>
    <label class="runcode"><span>Code</span><input id="bosOtp" inputmode="numeric" maxlength="10" autocomplete="one-time-code" placeholder="123456"></label>
    <p class="muted small" id="bosMsg">If the email only has a link, open it on this device instead.</p>`,
    [['Sign in', async () => {
      const token = ($('#bosOtp').value || '').trim(), say = t => { $('#bosMsg').textContent = t; };
      BOS.interactive = true;
      try { const { data, error } = await bosTimeout((await bosClient()).auth.verifyOtp({ email: BOS.otpEmail, token, type: 'email' }), 'Checking your email code'); if (error) throw error; BOS.user = data.user; await bosLoadInfo(); if (CLOUD.applying) return; toastMenu(`Signed in as ${myName()}`); ret(); } catch (e) { say('That code didn’t work: ' + (e.message || e)); } finally { BOS.interactive = false; }
    }, true], ['Back', () => openBosSignIn(ret)]]);
}
// Steel & Tape cloud-save synchronisation. Existing st-* data remains the local/offline save.
// Every saved game key is included so future shops, inventories, upgrades and activities are covered.
// Linked cloud revisions use server-side compare-and-swap and an archive of the previous revision.
const CLOUD = { uid:null, revision:0, ready:false, holding:false, loading:null, busy:false, timer:null, lastHash:'', optedOut:false, offline:false, applying:false };
const CLOUD_META = 'steeltape-cloud-link-v1';
const CLOUD_BACKUP = 'steeltape-local-backup-v1-';
const CLOUD_OFFLINE_DIRTY = 'steeltape-offline-dirty-v1';
function cloudOfflineDirty(uid) {
  try {return JSON.parse(localStorage.getItem(CLOUD_OFFLINE_DIRTY) || 'null')?.uid === uid;}
  catch(e) {return false;}
}
function cloudMarkOfflineChange() {
  if (!CLOUD.offline && !cloudIsOffline()) return;
  const uid = CLOUD.uid || cloudReadMeta()?.uid;
  if (!uid) return;
  try {localStorage.setItem(CLOUD_OFFLINE_DIRTY, JSON.stringify({uid,at:new Date().toISOString()}));}
  catch(e) {console.warn('Offline sync marker unavailable',e);}
}
function cloudClearOfflineDirty(uid) {
  if (cloudOfflineDirty(uid)) localStorage.removeItem(CLOUD_OFFLINE_DIRTY);
}

const CLOUD_GUEST_BACKUP = 'steeltape-unlinked-guest-save-v1-';
function cloudPrepareGuestLink() {
  // A name is not proof of account ownership. Before sign-in preserve the ENTIRE
  // unlinked game save on this device, then attach it only to the authenticated UID.
  try {
    const snapshot = cloudSnapshot(), hash = cloudHash(snapshot);
    if (!cloudMeaningful(snapshot)) return true;
    const prior = [];
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith(CLOUD_GUEST_BACKUP)) prior.push(key);
    }
    prior.sort();
    if (prior.length) {
      try {
        const existing = JSON.parse(localStorage.getItem(prior[prior.length - 1]));
        if (existing && existing.hash === hash) return true;
      } catch (e) { /* make a fresh copy */ }
    }
    const key = CLOUD_GUEST_BACKUP + new Date().toISOString() + '-' + Math.floor(Math.random() * 10000);
    // Write new backup FIRST; never replace the only prior backup in place.
    localStorage.setItem(key, JSON.stringify({createdAt:new Date().toISOString(),hash,snapshot}));
    while (prior.length > 1) localStorage.removeItem(prior.shift());
    return true;
  } catch (error) {
    console.warn('Could not create additional guest backup. Existing local game data was not changed.',error);
    return false;
  }
}
function cloudIsOffline() { return typeof navigator !== 'undefined' && navigator.onLine === false; }
function cloudReadMeta() { try { return JSON.parse(localStorage.getItem(CLOUD_META) || 'null'); } catch (e) { return null; } }
function cloudWriteMeta(uid, revision, hash) {
  localStorage.setItem(CLOUD_META, JSON.stringify({ uid, revision, hash, at:new Date().toISOString() }));
}
function cloudSnapshot() {
  // All persistent gameplay keys (including ones added in later releases) form ONE
  // atomic versioned snapshot. Never silently omit a key that cannot be read.
  if (typeof CAREER !== 'undefined' && !CLOUD.applying) {
    const career = JSON.stringify(CAREER);
    if (!career) throw Error('Could not serialize your character; nothing was uploaded.');
    localStorage.setItem('st-career', career);
  }
  const snapshot = {};
  const keys = [];
  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);
    if (key && key.startsWith('st-') && !key.startsWith('st-cloud-')) keys.push(key);
  }
  keys.sort();
  for (const key of keys) {
    const raw = localStorage.getItem(key);
    if (raw === null) throw Error('A save section disappeared while preparing your backup: ' + key);
    try { snapshot[key] = JSON.parse(raw); }
    catch (error) { throw Error('Cannot safely back up unreadable section ' + key + '. Your local data was preserved.'); }
  }
  if (!snapshot['st-career'] || typeof snapshot['st-career'] !== 'object' || Array.isArray(snapshot['st-career']))
    throw Error('The character save is missing or invalid. Nothing was uploaded.');
