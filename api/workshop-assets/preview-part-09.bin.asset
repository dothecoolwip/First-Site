    add('bf_furnace', ...P(55, -0.83), -0.83 + Math.PI, 1.2, 1.6); add('mk_Anvil', ...P(50.5, -1.05), -1.05, 1.3, 0.6); add('mk_Whetstone', ...P(50.5, -1.1), 0, 1, 0.6); }
  add('fountainRoundDetail', 46, -212, 0, 1.6, 1.8);
