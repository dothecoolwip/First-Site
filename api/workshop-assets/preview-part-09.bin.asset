    const t = ((o.pos.x - f.pos.x) * dx + (o.pos.z - f.pos.z) * dz) / length2;
    return t > 0.08 && t < 0.92 && Math.hypot(o.pos.x - f.pos.x - t * dx, o.pos.z - f.pos.z - t * dz) < (o.radius || 0.3) * 0.7;
