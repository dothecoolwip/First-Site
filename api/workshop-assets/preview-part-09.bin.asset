      p.setY(i, y - 0.055);
      const rocky = x < -230 && y > 4, farmland = z > 185 && x > -280 && x < 60;
      c.set(rocky ? '#a6a08d' : farmland ? '#c5bf8b' : y > 7 ? '#9faa82' : '#b4c7a0').convertSRGBToLinear();
      colours[i * 3] = c.r; colours[i * 3 + 1] = c.g; colours[i * 3 + 2] = c.b;
