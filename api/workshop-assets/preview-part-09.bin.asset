}
function remoteHashMatches(snapshot,hash) {return cloudHash(snapshot)===hash;}
function cloudOnAuth(uid,retry) {
  if(!uid||location.hash==='#autotest')return Promise.resolve();
  if(CLOUD.loading && CLOUD.uid===uid)return CLOUD.loading;
  if(CLOUD.uid===uid && CLOUD.ready && !retry)return Promise.resolve();
  if(CLOUD.uid!==uid){ CLOUD.uid=uid;CLOUD.revision=0;CLOUD.ready=false;CLOUD.optedOut=false;CLOUD.offline=false;CLOUD.holding=false; }
  const promise=(async()=>{try{await cloudStart(uid,Boolean(retry));}catch(e){cloudProblem(uid,e);}})();
  CLOUD.loading=promise.finally(()=>{if(CLOUD.loading===done)CLOUD.loading=null;});
  const done=CLOUD.loading;
  return done;
}
function cloudOnSignOut() {
  CLOUD.uid=null;CLOUD.ready=false;CLOUD.holding=false;CLOUD.optedOut=false;CLOUD.offline=false;
  if(CLOUD.timer){clearTimeout(CLOUD.timer);CLOUD.timer=null;}
  const shade=document.getElementById('steeltapeCloudOverlay');if(shade)shade.remove();
}
function cloudSchedule() {
  if(!CLOUD.uid||!CLOUD.ready||CLOUD.optedOut||CLOUD.applying||cloudIsOffline())return;
  if(CLOUD.timer)clearTimeout(CLOUD.timer);
  CLOUD.timer=setTimeout(()=>{CLOUD.timer=null;cloudFlush();},3500);
}
async function cloudFlush() {
  if(!CLOUD.uid||!CLOUD.ready||CLOUD.optedOut||CLOUD.applying||CLOUD.busy)return;
  if(cloudIsOffline()){cloudProblem(CLOUD.uid,new Error('No internet connection'));return;}
  const uid=CLOUD.uid, snapshot=cloudSnapshot(),hash=cloudHash(snapshot);
  if(hash===CLOUD.lastHash)return;
  CLOUD.busy=true;
  try{
    const ok=await cloudCommit(uid,CLOUD.revision,snapshot);
    if(!ok && CLOUD.uid===uid){CLOUD.ready=false;await cloudStart(uid,true);}
  }catch(e){if(CLOUD.uid===uid){CLOUD.ready=false;cloudProblem(uid,e);}}
  finally{CLOUD.busy=false;if(CLOUD.uid===uid&&CLOUD.ready&&cloudHash(cloudSnapshot())!==CLOUD.lastHash)cloudSchedule();}
}
const cloudOriginalSet=store.set.bind(store),cloudOriginalDel=store.del.bind(store);
store.set=function(k,v){if(CLOUD.applying)return;cloudOriginalSet(k,v);cloudMarkOfflineChange();cloudSchedule();};
store.del=function(k){if(CLOUD.applying)return;cloudOriginalDel(k);cloudMarkOfflineChange();cloudSchedule();};
setInterval(()=>{if(CLOUD.ready)cloudFlush();else if(CLOUD.uid&&CLOUD.offline&&!cloudIsOffline()&&!CLOUD.loading)cloudOnAuth(CLOUD.uid,true);},25000);
window.addEventListener('offline',()=>{
  if(CLOUD.uid) cloudProblem(CLOUD.uid,new Error('Internet disconnected'));
});
window.addEventListener('online',()=>{
  if(CLOUD.uid){CLOUD.optedOut=false;CLOUD.offline=false;CLOUD.ready=false;cloudOnAuth(CLOUD.uid,true);}
  else if(typeof onbAccountRequired==='function'&&onbAccountRequired())setTimeout(()=>onbAccountGate(),0);
});
document.addEventListener('visibilitychange',()=>{if(document.hidden){if(typeof townSavePosition==='function')townSavePosition(true);cloudFlush();}});
window.addEventListener('pagehide',()=>{if(typeof townSavePosition==='function')townSavePosition(true);cloudFlush();});
// Steel & Tape testing powers only. BuhurtOS project administration is never granted here.
// The grant comes from Auth app_metadata, fetched with auth.getUser() after sign-in.
function testAdminApply(save = true) {
  if (typeof BOS === 'undefined' || !BOS.testAdmin) return;
  let changed = false;
  if (CAREER.level !== 100 || CAREER.xp !== 0) { CAREER.level = 100; CAREER.xp = 0; changed = true; }
  // Existing shops compare and subtract purse directly. Refill a generous test
  // balance on each save so buying anything never blocks this account.
  if (!Number.isFinite(CAREER.purse) || CAREER.purse < 100000000) { CAREER.purse = 1000000000; changed = true; }
  if (typeof skillsState === 'function') skillsState();
  if (changed && save) {
    if (typeof applyCosmeticUnlocks === 'function') applyCosmeticUnlocks();
    store.set('career', CAREER);
    if (typeof updateTitlePurse === 'function') updateTitlePurse();
  }
}
function testAdminRefresh() {
  const button = document.getElementById('townAdmin');
  if (button) button.hidden = !BOS.testAdmin;
  if (!BOS.testAdmin && typeof TOWN !== 'undefined') TOWN.testRunSpeed = 1;
  if (typeof townHudUpdate === 'function') townHudUpdate();
}
function testAdminTeleport(stall) {
  if (!BOS.testAdmin || !TOWN.on || !stall) return;
  if (!!stall.mine !== !!TOWN.mineOn) return;
  if (TOWN.spec) stopSpectating();
  if (typeof clearWaypoint === 'function') clearWaypoint();
  const pos = typeof freeNear === 'function' ? freeNear(stall.ax, stall.az) : [stall.ax, stall.az];
  TOWN.pos = { x: pos[0], z: pos[1] };
  TOWN.cam = null; TOWN.speed = 0; TOWN.winded = false; TOWN.stam = 1;
  if (typeof playtestAction === 'function') playtestAction('teleport', { destination: stall.V.name });
  closeVendor();
  toastMenu(`Teleported to ${stall.V.name}.`);
}
function openTestAdmin() {
  if (!BOS.testAdmin || !TOWN.on) return;
  townPanel('Test tools', box => {
    box.append(h('p', { class: 'muted' }, 'Game-only testing account: level 100, unlimited purchasing power, and endless village sprinting. These powers do not change BuhurtOS permissions.'));
    const recorderStatus = h('p', { class: 'muted small' }, playtestStatus());
    const recorder = h('div', { class: 'row townrow' });
    recorder.append(h('button', { class: 'btn primary flagtape small', onclick: () => playtestCapture() }, 'Take screenshot & note'));
    recorder.append(h('button', { class: 'btn tape small', onclick: async () => { if (PLAYTEST.id) await playtestStop(); else { PLAYTEST.stopped = false; await playtestStart(); } recorderStatus.textContent = playtestStatus(); } }, PLAYTEST.id ? 'Stop recording' : 'Start recording'));
    recorder.append(h('button', { class: 'btn tape small', onclick: () => { playtestFlush(); recorderStatus.textContent = playtestStatus(); } }, 'Sync now'));
    box.append(h('h3', null, 'Playtest recorder'), h('p', { class: 'muted small' }, 'Records your route every quarter second while moving, plus interactions. Screenshots and notes appear in the owner command post.'), recorderStatus, recorder);
    const speeds = h('div', { class: 'row townrow' });
    for (const value of [1, 1.5, 2, 3, 5]) {
      speeds.append(h('button', { class: 'btn tape small', onclick: () => {
        if (!BOS.testAdmin) return;
        TOWN.testRunSpeed = value;
        toastMenu(`Run speed ${value}×.`);
      } }, `${value}× speed`));
    }
    box.append(h('h3', null, 'Run speed'), speeds, h('h3', null, 'Teleport'));
    const places = TOWN.stalls.filter(s => !!s.mine === !!TOWN.mineOn && !s.player && !s.node && (!s.secret || secretFound(s.secret.key)));
    const list = h('div', { class: 'ups shop' });
    for (const stall of places) list.append(h('div', { class: 'up' },
      h('div', null, h('b', null, stall.V.name), h('div', { class: 'muted small' }, stall.V.role || 'Destination')),
      h('button', { class: 'btn primary flagtape small', onclick: () => testAdminTeleport(stall) }, 'Teleport')));
    box.append(list);
  });
}
// Super-admin playtest recorder. Samples the actual resolved position after collision.
const PLAYTEST = { id: null, starting: false, saving: false, stopped: false, pending: [], lastPoint: null, lastAt: 0, retryAt: 0, error: '', count: 0 };
const PLAYTEST_QUEUE_PREFIX = 'steeltape-playtest-queue:';
function playtestPersist() {
  if (!BOS.user?.id) return;
  try { localStorage.setItem(PLAYTEST_QUEUE_PREFIX + BOS.user.id, JSON.stringify({ id: PLAYTEST.id, pending: PLAYTEST.pending, count: PLAYTEST.count, stopped: PLAYTEST.stopped })); }
  catch (e) { PLAYTEST.error = 'Browser storage is full; keep this tab open until sync completes'; }
}
function playtestResume() {
  if (!BOS.testAdmin || !BOS.user?.id || PLAYTEST.id) return;
  try {
    const saved = JSON.parse(localStorage.getItem(PLAYTEST_QUEUE_PREFIX + BOS.user.id) || 'null');
    if (!saved || !saved.id || !Array.isArray(saved.pending)) return;
    PLAYTEST.id = saved.id; PLAYTEST.pending = saved.pending.filter(e => e.owner_id === BOS.user.id && e.session_id === saved.id);
    PLAYTEST.count = Number(saved.count) || 0; PLAYTEST.stopped = !!saved.stopped;
    if (PLAYTEST.pending.length) playtestFlush();
  } catch (e) { }
}
function playtestPlace() {
  if (typeof TOWN === 'undefined' || !TOWN.on || !TOWN.pos) return { x: null, z: null, facing: null, zone: '' };
  return { x: +TOWN.pos.x.toFixed(3), z: +TOWN.pos.z.toFixed(3), facing: +TOWN.face.toFixed(3), zone: TOWN.mineOn ? 'Deep mine' : (TOWN.district || 'Realm') };
}
function playtestStatus() {
  return PLAYTEST.starting ? 'Starting recorder…' : PLAYTEST.error ? `Sync issue: ${PLAYTEST.error} · ${PLAYTEST.pending.length} points waiting` : PLAYTEST.id ? `Recording · ${PLAYTEST.count} points · ${PLAYTEST.pending.length} waiting to sync` : PLAYTEST.stopped ? 'Stopped for this visit' : 'Ready to record';
}
function playtestEntry(kind, detail) {
  if (!BOS.testAdmin || !PLAYTEST.id || (PLAYTEST.stopped && kind !== 'stop')) return;
  PLAYTEST.pending.push({ session_id: PLAYTEST.id, owner_id: BOS.user.id, at: new Date().toISOString(), kind, ...playtestPlace(), detail: detail || {} });
  PLAYTEST.count++;
  playtestPersist();
  if (PLAYTEST.pending.length >= 30) playtestFlush();
}
function playtestAction(kind, detail) { playtestEntry(kind, detail); }
function playtestAuthReset() {
  PLAYTEST.id = null; PLAYTEST.pending = []; PLAYTEST.lastPoint = null;
  PLAYTEST.starting = false; PLAYTEST.saving = false; PLAYTEST.stopped = false;
  PLAYTEST.error = ''; PLAYTEST.count = 0;
}
async function playtestStart() {
  if (!BOS.testAdmin || !BOS.user?.id || PLAYTEST.id || PLAYTEST.starting || !TOWN.on) return;
  PLAYTEST.starting = true; PLAYTEST.error = '';
  try {
    const sb = await bosClient();
    const { data, error } = await sb.from('steeltape_playtest_sessions').insert({ owner_id: BOS.user.id, build_version: window.BUILD_VER || '', device: navigator.userAgent.slice(0, 300) }).select('id').single();
    if (error) throw error;
    PLAYTEST.id = data.id; PLAYTEST.stopped = false; PLAYTEST.count = 0; PLAYTEST.lastPoint = null;
    playtestPersist();
    playtestEntry('start', { mode: TOWN.mineOn ? 'mine' : 'realm' });
    playtestFlush();
  } catch (e) { PLAYTEST.error = e.message || String(e); PLAYTEST.retryAt = Date.now() + 10000; }
  finally { PLAYTEST.starting = false; }
}
async function playtestFlush() {
  if (!BOS.testAdmin || !PLAYTEST.id || PLAYTEST.saving || !PLAYTEST.pending.length || Date.now() < PLAYTEST.retryAt) return;
  PLAYTEST.saving = true;
  const batch = PLAYTEST.pending.slice(0, 100);
  try {
    const { error } = await (await bosClient()).from('steeltape_playtest_entries').insert(batch);
    if (error) throw error;
    PLAYTEST.pending.splice(0, batch.length); PLAYTEST.error = '';
    playtestPersist();
    PLAYTEST.retryAt = 0;
  } catch (e) { PLAYTEST.error = e.message || String(e); PLAYTEST.retryAt = Date.now() + 10000; }
  finally { PLAYTEST.saving = false; }
  if (PLAYTEST.pending.length && !PLAYTEST.error) setTimeout(playtestFlush, 0);
}
function playtestTick() {
  if (!BOS.testAdmin || !TOWN.on) return;
  if (PLAYTEST.stopped) return;
  if (!PLAYTEST.id) { if (!PLAYTEST.stopped && !PLAYTEST.starting && Date.now() >= PLAYTEST.retryAt) playtestStart(); return; }
  const now = Date.now(), p = playtestPlace();
  if (now - PLAYTEST.lastAt < 250) return;
  const old = PLAYTEST.lastPoint;
  if (!old || Math.hypot(p.x - old.x, p.z - old.z) >= 0.25 || p.zone !== old.zone || now - PLAYTEST.lastAt >= 5000) {
    playtestEntry('position', { mounted: !!TOWN.mounted, sprinting: TOWN.speed > 4, autoWalk: !!TRAVEL.auto });
    PLAYTEST.lastPoint = p; PLAYTEST.lastAt = now;
  }
}
async function playtestStop() {
  if (!PLAYTEST.id) { PLAYTEST.stopped = true; return; }
  if (!PLAYTEST.stopped) playtestEntry('stop');
  PLAYTEST.stopped = true;
  playtestPersist();
  await playtestFlush();
  if (PLAYTEST.pending.length) { toastMenu('Recorder has unsynced points. Stay online and retry.'); return; }
  const { error } = await (await bosClient()).from('steeltape_playtest_sessions').update({ ended_at: new Date().toISOString() }).eq('id', PLAYTEST.id);
  if (error) { PLAYTEST.error = error.message; toastMenu('Could not finish session. Retry when online.'); return; }
  PLAYTEST.id = null; PLAYTEST.lastPoint = null; PLAYTEST.error = '';
  playtestPersist();
  toastMenu('Playtest saved.');
}
async function playtestCapture() {
  if (!BOS.testAdmin || !TOWN.on) return;
  if (!PLAYTEST.id) await playtestStart();
  if (!PLAYTEST.id) { toastMenu('Recorder could not start. Check your connection.'); return; }
  let blob;
  try {
    const renderer = W3.renderer;
    renderer.render(W3.scene, W3.camera);
    blob = await new Promise(resolve => renderer.domElement.toBlob(resolve, 'image/jpeg', 0.88));
  } catch (e) { }
  if (!blob) { toastMenu('Could not capture the game view.'); return; }
  const position = playtestPlace(), captureAt = new Date().toISOString();
  const sessionId = PLAYTEST.id, noteId = crypto.randomUUID();
  const path = `${BOS.user.id}/${sessionId}/${noteId}.jpg`;
  let screenshotUploaded = false;
  const previewUrl = URL.createObjectURL(blob);
  townPanel('Screenshot note', box => {
    const preview = h('img', { src: previewUrl, alt: 'Captured game view', style: 'width:100%;max-height:42vh;object-fit:contain;background:#111' });
    const textarea = h('textarea', { rows: '5', maxlength: '4000', placeholder: 'What looks wrong here? What should change?' });
    const status = h('p', { class: 'muted small' }, `X ${position.x}, Z ${position.z} · ${position.zone}`);
    const save = h('button', { class: 'btn primary flagtape small', onclick: async () => {
      const body = textarea.value.trim();
      if (!body) { status.textContent = 'Write a note before saving.'; return; }
      save.disabled = true; status.textContent = 'Uploading screenshot and note…';
      try {
        const sb = await bosClient();
        if (!screenshotUploaded) {
          const uploaded = await sb.storage.from('steeltape-playtest').upload(path, blob, { contentType: 'image/jpeg', upsert: false });
          if (uploaded.error) throw uploaded.error;
          screenshotUploaded = true;
        }
        const { error } = await sb.from('steeltape_playtest_notes').insert({ id: noteId, session_id: sessionId, owner_id: BOS.user.id, at: captureAt, ...position, body, screenshot_path: path });
        if (error) throw error;
        playtestEntry('note', { noteId });
        URL.revokeObjectURL(previewUrl); closeVendor(); toastMenu('Screenshot and note saved to the admin panel.');
      } catch (e) { status.textContent = 'Save failed: ' + (e.message || e) + '. Try again.'; save.disabled = false; }
    } }, 'Save screenshot & note');
    box.append(preview, status, textarea, save);
  });
}
setInterval(playtestFlush, 5000);
window.addEventListener('online', playtestFlush);
window.addEventListener('pagehide', () => { if (PLAYTEST.id && PLAYTEST.pending.length) playtestFlush(); });
// ===================================================================
// BuhurtOS rosters: real teams and fighters (display names and team colours only, from the public steeltape-roster
// function; fighters who opted out of the card game are left out). Bots take real fighters' names first, and the
// rest come from a 200-name pool. A bot named after a real fighter has a soft glow in their club colour; when the real
// person is in the match themselves (signed in with BuhurtOS), their fighter gets the big glow and a banner.
// Live fights at real events show on the realm map and the nearest arena mirrors them.
// ===================================================================
const ROSTER_URL = BOS_URL + '/functions/v1/steeltape-roster';
const ROSTER = { teams: [], fighters: [], live: [], at: 0, loading: false, ok: false };
const ROSTER_VERSION = 2;
function rosterEligible(id) { return ROSTER.ok && ROSTER.fighters.some(f => f.id === id); }
function rosterAccept(d) {
  if (!d || d.version !== ROSTER_VERSION || d.scope !== 'hacsa' || !Array.isArray(d.teams) || !Array.isArray(d.fighters)) return false;
  const teams = d.teams.filter(t => t && typeof t.slug === 'string' && typeof t.name === 'string' && !/(?:^|[\s_-])(test|demo|sandbox)(?:$|[\s_-])/i.test(t.slug + ' ' + t.name));
  const slugs = new Set(teams.map(t => t.slug));
  const fighters = d.fighters.filter(f => f && typeof f.id === 'string' && typeof f.name === 'string' && slugs.has(f.team) && !/(?:^|[\s_-])(test|demo|sandbox)(?:$|[\s_-])/i.test(f.name));
  const ids = new Set(fighters.map(f => f.id));
  const live = (Array.isArray(d.live) ? d.live : []).filter(l => [l.a, l.b].every(s => s && slugs.has(s.team) && Array.isArray(s.fighters) && s.fighters.every(f => ids.has(f.id))));
  Object.assign(ROSTER, { teams, fighters, live, at: Date.now(), ok: true, rebranded: false });
  rosterReset(); rosterClubs(); rosterRebrand(); rosterLive();
  return true;
}
function rosterReset() {
  // Clear derived identities before rebuilding. Keep gameplay equipment and progress.
  const used = {};
  for (const [key, C] of Object.entries(CLUBS)) {
    if (key.startsWith('bos:') || key.startsWith('live:')) { delete CLUBS[key]; continue; }
    delete C.who; C.bos = null;
    if (key !== 'reavers') { C.name = C.full = 'Festival ' + (key.startsWith('ladder') ? 'Challengers' : 'Company'); C.short = 'FST'; }
    for (const s of C.roster || []) { delete s.bos; delete s.rn; delete s.keep; if (!s.player) s.name = poolName(used); }
  }
  for (const L of typeof LEAGUE_EXTRA !== 'undefined' ? LEAGUE_EXTRA : []) { L.name = 'Festival Company'; L.short = 'FST'; }
  // HACSA eligibility controls generated bots, not the player's saved team.
  // Roster loading or a removed bot affiliation must never rewrite CAREER.
  applyProfile();
  for (const f of G.fighters || []) if (!f.isPlayer && f.spec?.bos && !rosterEligible(f.spec.bos.id)) { f.spec = { ...f.spec, bos: null, keep: false }; f.name = f.spec.name = poolName(used); fighterGlow(f); }
}
const POOL_FIRST = ['Aiden', 'Ava', 'Blake', 'Brooke', 'Cody', 'Cassidy', 'Dylan', 'Dakota', 'Ethan', 'Emma', 'Finn', 'Faith', 'Garrett', 'Grace', 'Hunter', 'Hailey', 'Isaac', 'Ivy', 'Jace', 'Jade', 'Kyle', 'Kaitlyn', 'Logan', 'Lily', 'Mason', 'Madison', 'Nolan', 'Nora', 'Owen', 'Olivia', 'Parker', 'Paige', 'Quinn', 'Quincy', 'Riley', 'Reese', 'Spencer', 'Sierra', 'Tanner', 'Taylor', 'Tristan', 'Tessa', 'Wyatt', 'Willow', 'Brody', 'Bailey', 'Colton', 'Chloe', 'Dawson', 'Destiny', 'Easton', 'Ella', 'Gavin', 'Gemma', 'Holden', 'Harper', 'Jaxon', 'Josie', 'Kellan', 'Kenzie', 'Landon', 'Lacey', 'Maverick', 'Mya', 'Nash', 'Nevaeh', 'Rhett', 'Raelynn', 'Sawyer', 'Sadie', 'Travis', 'Tori', 'Brennan', 'Brynn', 'Dallas', 'Darcy', 'Emmett', 'Ember', 'Grady', 'Greta', 'Hayden', 'Hope', 'Jesse', 'Jolene', 'Keegan', 'Kira', 'Lane', 'Lexi', 'Marshall', 'Maeve', 'Reid', 'Rowan', 'Shane', 'Shelby', 'Ty', 'Tamsin', 'Wade', 'Wren', 'Zane', 'Zoey'];
const POOL_LAST = ['Anderson', 'Bergstrom', 'Bouchard', 'Brandt', 'Campbell', 'Chartrand', 'Dahl', 'Desjardins', 'Doucette', 'Dueck', 'Eriksen', 'Fehr', 'Fontaine', 'Friesen', 'Gagnon', 'Giesbrecht', 'Hamm', 'Halvorsen', 'Hiebert', 'Holt', 'Iverson', 'Janzen', 'Johansson', 'Klassen', 'Kowalchuk', 'Kozak', 'Lachance', 'Lindqvist', 'Loewen', 'MacLeod', 'Martens', 'McKenzie', 'Moreau', 'Neufeld', 'Nygaard', 'Olson', 'Ouellette', 'Penner', 'Petrenko', 'Pelletier', 'Quiring', 'Rempel', 'Robichaud', 'Rousseau', 'Sawatzky', 'Schmidt', 'Sorensen', 'Stewart', 'Thiessen', 'Toews', 'Tremblay', 'Unger', 'Vandale', 'Voth', 'Wiebe', 'Wozniak', 'Yaremko', 'Zacharias', 'Zimmer', 'Boychuk', 'Hrynyk', 'Melnyk', 'Sawchuk', 'Tkachuk', 'Fedoruk', 'Kostiuk', 'Prystupa', 'Shewchuk', 'Lavallee', 'Gauthier', 'Paquette', 'Beaulieu', 'Nicholson', 'Fraser', 'Gillis', 'Cameron', 'Murray', 'Ross', 'Grant', 'Bjornson', 'Magnusson', 'Thorsteinson', 'Gudmundson', 'Arnason', 'Olafson', 'Brekke', 'Haugen', 'Lunde', 'Solberg', 'Strand', 'Vik', 'Berg', 'Hagen', 'Dyck', 'Enns', 'Reimer', 'Wall', 'Harder', 'Peters', 'Krahn'];
function poolName(used) {
  for (let i = 0; i < 40; i++) { const n = pick(POOL_FIRST) + ' ' + pick(POOL_LAST); if (!used[n] && !ROSTER.fighters.some(f => f.name === n)) { used[n] = 1; return n; } }
  for (let i = 1; ; i++) { const n = 'Festival Fighter ' + i; if (!used[n] && !ROSTER.fighters.some(f => f.name === n)) { used[n] = 1; return n; } }
}
// load the roster: cached for a day, refreshed in the background; the live list refreshes every 30 s in town
function rosterLoad(force) {
  if (!ROSTER.ok) { try { const c = store.get('bosRoster', null); if (!c || Date.now() - c.at > 86400000 || !rosterAccept(c)) { store.set('bosRoster', null); rosterReset(); } else ROSTER.at = c.at; } catch (e) { rosterReset(); } }
  const stale = Date.now() - (ROSTER.at || 0) > (force ? 30000 : 86400000);
  if (!stale || ROSTER.loading || typeof fetch !== 'function') return;
  ROSTER.loading = true;
  fetch(ROSTER_URL, { cache: 'no-store' }).then(r => r.ok ? r.json() : null).then(d => {
    ROSTER.loading = false; if (!rosterAccept(d)) return;
    try { store.set('bosRoster', { version: ROSTER_VERSION, scope: 'hacsa', teams: ROSTER.teams, fighters: ROSTER.fighters, at: ROSTER.at }); } catch (e) { }
  }).catch(() => { ROSTER.loading = false; });
}
// a colour per team: their own if they set one, otherwise one picked from their name
const ROSTER_DEFAULT_COLS = ['#2C4A8C', '#E9ECEF'];
function teamColours(T) {
  const c = (T.colors || []).filter(Boolean);
  if (c.length >= 2 && !(c[0].toUpperCase() === ROSTER_DEFAULT_COLS[0] && c[1].toUpperCase() === ROSTER_DEFAULT_COLS[1])) return [c[0], c[1]];
  const r = seeded('team' + T.slug); return [TABARDS[Math.floor(r() * TABARDS.length)], TRIMS[Math.floor(r() * TRIMS.length)]];
}
// every BuhurtOS team becomes a club the town bouts can use: real names and colours, the built-in fighting styles
function rosterClubs() {
  const tmpl = CLUBS.wardens.roster;
  for (const T of ROSTER.teams) {
    const key = 'bos:' + T.slug; if (CLUBS[key]) continue;
    const [tab, trim] = teamColours(T), nm = String(T.name || T.slug).replace(/^The /, '');
    CLUBS[key] = { key, name: nm.length > 18 ? nm.split(' ').slice(-2).join(' ') : nm, full: T.name, short: (T.initial || nm.slice(0, 1)).toUpperCase() + nm.replace(/[^A-Z]/g, '').slice(1, 3).padEnd(2, 'X'), tabard: tab, trim, charge: ['chevron', 'cross', 'saltire', 'chief', 'quarterly', 'bend'][Math.floor(seeded(key)() * 6)], flag: trim, bos: T.slug,
      roster: tmpl.map(s => ({ ...s, player: false, captain: false })) };
  }
}
// the made-up clubs (Bow River Wardens, Ironwood Rabble, the league, the ladder's fighters) become real BuhurtOS teams
// and fighters as soon as the roster is known, so nobody fights an invented team. Stable per player (seeded by their team).
function rosterRebrand() {
  if (!ROSTER.ok || !ROSTER.teams.length) return;
  const mine = (CAREER.club && CAREER.club.bos) || null, rnd = seeded('rebrand:' + (mine || 'none'));
  const count = T => ROSTER.fighters.filter(f => f.team === T.slug).length;
  let pool = ROSTER.teams.filter(T => T.slug !== mine).sort((a, b) => count(b) - count(a) || a.slug.localeCompare(b.slug));
  if (!pool.length) pool = ROSTER.teams.slice();
  if (!pool.length) return;
  const shuffled = pool.slice(); for (let i = shuffled.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]]; }
  const brand = (key, T) => { const C = CLUBS[key]; if (!C || !T) return; rosterClubs(); const B = CLUBS['bos:' + T.slug]; if (!B) return; Object.assign(C, { name: B.name, full: B.full, short: B.short, tabard: B.tabard, trim: B.trim, charge: B.charge, bos: T.slug }); };
  const pickT = i => shuffled[i % shuffled.length];
  brand('wardens', pickT(0)); brand('rabble', pickT(1));
  if (typeof LEAGUE_EXTRA !== 'undefined') { if (typeof ensureLeagueClubs === 'function') ensureLeagueClubs(); LEAGUE_EXTRA.forEach((L, i) => { const T = pickT(2 + i), B = CLUBS['bos:' + T.slug]; if (!B) return; Object.assign(L, { name: B.name, short: B.short, tabard: B.tabard, trim: B.trim, charge: B.charge }); brand(L.key, T); }); }
