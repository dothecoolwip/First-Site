  if (f.state !== 'standing') return;
  f.sprint = PIN.sprint; f.brace = PIN.brace && !PIN.guard; f.guard = PIN.guard; f.gdir = PIN.guard ? PIN.gdir || 'mid' : null;
  if (E.has('retarget')) { E.delete('retarget'); cycleLock(f); }
