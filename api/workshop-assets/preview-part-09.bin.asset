// you (and other players) in town: an outfit from the wardrobe if you bought one, else the club-coloured mannequin
const OUTFIT_TEX = ['peasant', 'peasant2', 'peasant_light', 'ranger', 'ranger2'];
function lookPerson(L, ht) {
