  list.append(h('h4', null, 'Body'), mirror(),
    choice('Body style', [['male', 'Masculine'], ['female', 'Feminine']], L.frame || (BOS.info && BOS.info.gender === 'female' ? 'female' : 'male'), 'frame'),
    colours('Skin tone', SKIN_TONES, L.skin || SKIN_TONES[2], 'skin'));
