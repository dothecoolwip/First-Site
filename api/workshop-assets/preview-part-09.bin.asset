  for (const [x, z] of [[gx - 6.5, gz + 6.5], [gx + 6.5, gz + 6.5]]) { add('fireBasket', x, z, 0, 2, 0.4); flame(x, 1.75, z, '#7dffb0'); }
  for (const [k, x, z, ry] of [['skeleton', gx + 3.5, gz + 4, 2.4], ['zombie', gx - 3, gz + 4.5, 0.6], ['vampire', gx + 5.5, gz - 3, -0.5]]) { const p = add(k, x, z, ry, 1.6, 0.5); if (p) WORLD.bob.push({ o: p, k: 'sway', ph: x }); }
  for (const [x, z] of [[gx - 2, gz - 2], [gx + 2.5, gz + 1]]) { const gh = kpiece(R, 'ghost', x, 1, z, 0, 1.6); if (gh) WORLD.bob.push({ o: gh, k: 'float', ph: x, cx: x, cz: z }); }
  for (const [x, z] of [[30, -66], [58, -64], [36, -72], [54, -71], [28, -50]]) add(x % 2 ? 'fy_creepy_tree_1' : 'fy_creepy_tree_2', x, z, x, 1, 0.8);
  add('dp_cage', 58, -48, -0.6, 1, 0.8); add('dp_guillotine', 31, -60, 0.5, 1, 1.2); add('fy_cem_lamp', 37.6, -48.8, 0, 1.2, 0.3); add('fy_cem_lamp', 50.4, -48.8, 0, 1.2, 0.3);
  add('ps_tent', 60, -56, -0.6, 1.2, 1.8); add('ps_fire', 57.6, -58, 0, 1.6, 0.6); add('fy_ancient_tree_autumn', 20, -60, 0.4, 1, 2.2); add('nt_deadtree', 62, -40, 1, 1, 0.8);
}
// ===================================================================
// Festival bouts: while you walk the realm there's always a fight on at the arena nearest you.
// Real fighters on the real sim, but with no player, no prize, no stats and no awards (G.attract keeps all of that off).
// The town keeps G.phase === 'town'; the bout keeps its own phase and borrows G.phase only while its sim steps run.
// ===================================================================
const BOUT = { on: false, phase: '', next: false, acc: 0, inSim: false, label: '', vs: '', n: 0 };
const BOUT_TOUCH = () => IN.mode === 'touch' || (window.matchMedia && matchMedia('(pointer: coarse)').matches);
function boutPick() {
  const lad = Object.keys(CLUBS).filter(k => /^ladder\d+$/.test(k)), teams = ['reavers', 'wardens', 'rabble'];
  const two = arr => { const a = pick(arr); let b = pick(arr), g = 0; while (b === a && g++ < 20) b = pick(arr); return [a, b]; };
  const cat = pick(['men', 'men', 'women']), small = BOUT_TOUCH(), r = Math.random();
  BOUT.n++;
  if (r < 0.34 && lad.length > 1) { const [a, b] = two(lad); return { mode: 1, clubA: a, opp: b, category: cat, label: 'Adult duel' }; }
  const bosK = typeof rosterClubKeys === 'function' ? rosterClubKeys(3) : [];
  const [a, b] = bosK.length >= 2 && Math.random() < 0.7 ? two(bosK) : two(teams);
  if (r < 0.52) return { mode: 2, clubA: a, opp: b, category: cat, label: '2 v 2' };
  if (r < 0.74 || small) return { mode: 3, clubA: a, opp: b, category: cat, label: '3 v 3' };
  if (r < 0.92) return { mode: 5, clubA: a, opp: b, category: cat, label: '5 v 5 melee' };
  return { mode: 12, clubA: a, opp: b, category: cat, label: '12 v 12 massacre' };
}
// which arena the bout plays in: the nearest one to you (the Great Hall only when you're inside it)
function boutArenaFor(x, z) {
  if (TOWN.forceArena) return ARENAS.find(a => a.key === TOWN.forceArena) || ARENAS[0];
  const inHall = x > HALL.x0 && x < HALL.x1 && z > HALL.z0 && z < HALL.z1;
  let best = ARENAS[0], bd = 1e9; for (const A of ARENAS) { if (A.indoor && !inHall) continue; const d = Math.hypot(x - A.x, z - A.z); if (d < bd) { bd = d; best = A; } }
  return inHall ? ARENAS.find(a => a.indoor) : best;
}
function boutOff() { return W3.matchRoot ? W3.matchRoot.position : { x: 0, z: 0 }; }
function boutStart() {
  if (!TOWN.on) return;
  const Ar = boutArenaFor(TOWN.pos.x, TOWN.pos.z); TOWN.boutArena = Ar.key; W3.matchRoot.position.set(Ar.x, gy(Ar.x, Ar.z), Ar.z);
  const lv = typeof liveBoutPick === 'function' ? liveBoutPick(Ar) : null, o = lv || boutPick(), ph = G.phase, cat0 = G.category; BOUT.live = lv ? lv.live : null;
  G.attract = true; G.paused = false;
  try {
    setupMatch({ ...o, stage: 'Festival bout', attract: true, townBout: true });
    startRound();
  } catch (e) { console.warn('bout', e); BOUT.on = false; G.attract = false; G.phase = ph; return; }
  G.category = cat0; BOUT.phase = 'fight'; G.phase = ph; BOUT.on = true; BOUT.next = false; BOUT.acc = 0;
  const A = CLUBS[o.clubA] || CLUBS.reavers, B = CLUBS[o.opp];
  BOUT.label = o.label; BOUT.vs = o.mode === 1 ? `${G.fighters[0] ? G.fighters[0].name : A.name} vs ${G.fighters[1] ? G.fighters[1].name : B.name}` : `${A.name} vs ${B.full || B.name}`;
  boutHud();
}
function boutStop() {
  if (!BOUT.on) return;
  BOUT.on = false; BOUT.next = false; BOUT.phase = ''; G.attract = false; clearMatch(); TOWN.boutArena = null;
  const el = $('#townBout'); if (el) el.hidden = true;
}
// called from endRound's attract branch, inside the bout's sim step (G.phase is the bout's here)
function boutAfterRound() {
  const m = G.match; if (!m) return;
  const w = m.wins || [0, 0], best = m.mode === 1 ? 2 : 2;
  if (m.duelForfeit != null || w[0] >= best || w[1] >= best || m.round >= 3) { BOUT.next = true; if (TOWN.spec) unlock('spectator', true); return; } // match done: a new pairing walks on
  startRound(); G.phase = 'fight';
}
function boutTick(dt) {
  if (!BOUT.on || !TOWN.on) return;
  if (BOUT.next) { BOUT.next = false; boutStart(); return; }
  // walked off to another arena? the next pairing walks on there instead
  if ((G.frameN || 0) % 90 === 0 && TOWN.pos && !TOWN.forceArena) { const A = boutArenaFor(TOWN.pos.x, TOWN.pos.z); if (A.key !== TOWN.boutArena) { const o = boutOff(); if (Math.hypot(TOWN.pos.x - o.x, TOWN.pos.z - o.z) > 70 || A.indoor) { boutStop(); boutStart(); return; } } }
  if (!G.match) return;
  const ph = G.phase; G.phase = BOUT.phase; BOUT.inSim = true;
  try {
    BOUT.acc += Math.min(dt, 0.1); const h = 1 / 60; let n = 0;
    while (BOUT.acc >= h && n < 6) { simStep(h); BOUT.acc -= h; n++; }
    if (n >= 6) BOUT.acc = 0;
  } finally { BOUT.phase = G.phase; G.phase = ph; BOUT.inSim = false; }
  if ((G.frameN || 0) % 30 === 0) boutHud();
}
// how loud the list is from where you stand (sounds the bout makes go through this)
function boutEar(x, z) {
  if (!BOUT.inSim || !TOWN.pos) return 1;
  const o = boutOff(), ear = TOWN.spec ? W3.camera.position : TOWN.pos, d = Math.hypot(ear.x - (x || 0) - o.x, ear.z - (z || 0) - o.z);
  return clamp(1.1 - d / 34, 0, 0.75);
}
// a little "in the list" ticker when you're near the rope
function boutHud() {
  const el = $('#townBout'); if (!el) return;
  const o = boutOff(), near = !TOWN.spec && TOWN.on && BOUT.on && TOWN.pos && Math.abs(TOWN.pos.x - o.x) < LIST.W / 2 + 22 && Math.abs(TOWN.pos.z - o.z) < LIST.L / 2 + 22 && !G.screen;
  el.hidden = !near; if (!near) return;
  const m = G.match, w = m && m.wins ? m.wins : [0, 0];
  el.innerHTML = '';
  const Ar = ARENAS.find(a => a.key === TOWN.boutArena);
  el.append(h('small', null, (Ar ? Ar.name : 'In the list') + ' · ' + BOUT.label), h('b', null, BOUT.vs), h('span', { class: 'num' }, BOUT.live ? `Real score ${BOUT.live.score[0]}–${BOUT.live.score[1]} · ${BOUT.live.phase}` : m ? `Round ${m.round} · ${w[0]}–${w[1]}` : ''));
}
// ===================================================================
// Town map: a top-down drawing of the festival with every vendor, station and online player on it.
// The big one opens from the Map button (tap to set a waypoint); a small one sits in the corner while you walk.
// North (the castle, -z) is up.
// ===================================================================
const TMAP = { mini: null, miniT: 0, hits: [], view: null };
const TMAP_PLACES = [
  ['The list', 0, 0], ['Market', 0, 46], ['Forge yard', -46, 28], ['Tavern', 45, 14],
  ['Food stalls', 38, -8], ['Archery', 64, 10], ['Farm', 60, -16], ['Homes', -44, 48], ['Club camp', 46, 62], ['Graveyard', 44, -56], ['Pond', -56, 72], ['Festival gate', 0, 70], ['Deep Mine', -256, -42]
];
function tmapSites() { return [...ARENAS, TRAINING_GROUND]; }
function mapStallVisible(S) {
  return (!S.squireNPC || teamSquire().stage > 1) && !S.mine && !S.player && !S.node && !S.arena && (!S.secret || secretFound(S.secret.key)) &&
    (!S.hiddenTunnel || !!(CAREER.found && CAREER.found['tunnel:' + S.hiddenTunnel]) || !!(CAREER.bag && CAREER.bag.items && CAREER.bag.items.moon_map));
}
function placesDirectory(route) {
  const box = h('div', { class: 'places-directory' });
  const search = h('input', { type: 'search', placeholder: 'Search places & services', 'aria-label': 'Search places & services' });
  const list = h('div', { class: 'ups shop', 'aria-label': 'Places & services' });
  const draw = () => {
    list.replaceChildren(); const query = search.value.trim().toLowerCase();
    const rows = tmapSites().map(A => ({ name: A.name, icon: A.icon, role: A.practice ? 'Training' : 'Arena', x: A.entry[0], z: A.entry[1], description: A.gate && !gateOpen(A.gate) ? 'Gate locked' : '' }));
    for (const S of TOWN.stalls || []) if (mapStallVisible(S)) rows.push({ name: S.V.name, icon: S.V.icon || '•', role: S.V.role || 'Destination', x: S.ax, z: S.az, description: vendorBlurb(S.V.key) || '' });
    rows.sort((a, b) => Math.hypot(a.x - TOWN.pos.x, a.z - TOWN.pos.z) - Math.hypot(b.x - TOWN.pos.x, b.z - TOWN.pos.z));
    for (const r of rows) {
      if (!`${r.name} ${r.role} ${r.description}`.toLowerCase().includes(query)) continue;
      const district = districtAt(r.x, r.z);
      const desc = [r.description, district && district.name, `${Math.round(Math.hypot(r.x - TOWN.pos.x, r.z - TOWN.pos.z))} m away`].filter(Boolean).join(' · ');
      list.append(h('div', { class: 'up' }, h('div', null, h('b', null, `${r.icon} ${r.name} · ${district.name}`), h('div', { class: 'muted small' }, `${r.role} · ${desc}`)), h('button', { class: 'btn tape small', 'aria-label': `Route to ${r.name}, ${r.role} in ${district.name}`, onclick: () => route(r) }, 'Route')));
    }
    if (!list.children.length) list.append(h('p', { class: 'muted' }, 'No matching places or services.'));
  };
  search.oninput = draw; box.append(h('h3', null, 'Places & services'), search, list); draw(); return box;
}
function tmapMarkers() {
  const out = tmapSites().map(A => ({ x: A.x, z: A.z, icon: A.icon, name: A.name, kind: 'arena', A, far: true }));
  for (const S of TOWN.stalls || []) {
    if (S.mine) continue;
    if (S.player) { const O = WORLD.others && WORLD.others[S.player]; out.push({ x: O ? O.x : S.x, z: O ? O.z : S.z, icon: '', name: S.V.name, kind: 'player', S }); continue; }
    if (S.arena || (S.secret && !secretFound(S.secret.key)) || (S.hiddenTunnel && !(CAREER.found && CAREER.found['tunnel:' + S.hiddenTunnel]) && !(CAREER.bag && CAREER.bag.items && CAREER.bag.items.moon_map))) continue;
    if (S.node) { out.push({ x: S.x, z: S.z, icon: '', name: S.V.name, role: S.V.role, kind: 'node', col: S.node.N.col, S }); continue; }
    out.push({ x: S.x, z: S.z, icon: S.V.icon || '•', name: S.V.name, role: S.V.role, kind: S.station ? 'station' : 'vendor', key: S.V.key, far: S.V.key === 'mine:enter', S });
  }
  return out;
}
// draw the realm into ctx. view = { cx, cz, scale (px per metre), w, h, labels, round }
function drawTownMap(ctx, view) {
  const { w, h: H, scale: k } = view, cx = view.cx, cz = view.cz;
  const X = x => w / 2 + (x - cx) * k, Y = z => H / 2 + (z - cz) * k;
  ctx.save(); ctx.clearRect(0, 0, w, H);
  if (view.round) { ctx.beginPath(); ctx.arc(w / 2, H / 2, Math.min(w, H) / 2 - 1, 0, Math.PI * 2); ctx.clip(); }
  ctx.fillStyle = '#3f6630'; ctx.fillRect(0, 0, w, H);
  // the realm's open country, then the fairground's trodden meadow
  ctx.fillStyle = '#6f9a4e'; ctx.beginPath(); ctx.ellipse(X(0), Y(0), TOWN_RX * k, TOWN_RZ * k, 0, 0, Math.PI * 2); ctx.fill();
  // Broad elevation bands and forest belts reflect the actual heightfield and
  // wooded travel corridors instead of treating the expanded realm as empty lawn.
  const step = 40;
  for (let z = -TOWN_RZ; z < TOWN_RZ; z += step) for (let x = -TOWN_RX; x < TOWN_RX; x += step) {
    if ((x / TOWN_RX) ** 2 + (z / TOWN_RZ) ** 2 > 0.97) continue;
    const y = realmHeight(x + step / 2, z + step / 2);
    if (y < 3) continue;
    ctx.fillStyle = y > 10 ? 'rgba(116,119,91,.42)' : y > 6 ? 'rgba(128,151,92,.25)' : 'rgba(156,172,99,.15)';
    ctx.fillRect(X(x), Y(z), step * k + 1, step * k + 1);
  }
  ctx.fillStyle = 'rgba(36,75,38,.48)';
  COUNTRY_FORESTS.forEach(([x, z, r], j) => {
    ctx.beginPath();
    for (let i = 0; i <= 40; i++) {
      const a = i / 40 * Math.PI * 2;
