  const d = dist != null ? dist : Math.hypot(W.x - TOWN.pos.x, W.z - TOWN.pos.z);
  const ang = Math.atan2(W.x - TOWN.pos.x, W.z - TOWN.pos.z) - (TOWN.yaw + Math.PI);
