  const wood = tmat('#755536'), cord = tmat('#e6dcc0');
  const stakeGeo = geo('arena_rope_stake', () => new THREE.CylinderGeometry(0.055, 0.065, 1.15, 6));
  const cordGeo = geo('arena_rope_cord', () => new THREE.BoxGeometry(1, 0.04, 0.04));
