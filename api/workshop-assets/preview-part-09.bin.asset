  return [i === 7 || i === 0 || i === 1 ? 1 : 0, i >= 3 && i <= 5 ? 1 : 0, i >= 5 && i <= 7 ? 1 : 0, i >= 1 && i <= 3 ? 1 : 0];
}
function isXboxId(id) { return /xbox|x-box|xinput|045e/i.test(id || ''); }
