// ---------- utilities ----------
const TAU = Math.PI * 2;
const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
const lerp = (a, b, t) => a + (b - a) * t;
const rand = (a = 0, b = 1) => a + Math.random() * (b - a);
const chance = (p) => Math.random() < p;
const pick = (arr) => arr[(Math.random() * arr.length) | 0];
const damp = (cur, target, rate, dt) => lerp(cur, target, 1 - Math.exp(-rate * dt));
function angDiff(a, b) { let d = b - a; while (d > Math.PI) d -= TAU; while (d < -Math.PI) d += TAU; return d; }
function angTo(from, to) { return Math.atan2(to.x - from.x, to.z - from.z); }
function dist2(a, b) { const dx = a.x - b.x, dz = a.z - b.z; return Math.sqrt(dx * dx + dz * dz); }
function vlen(v) { return Math.sqrt(v.x * v.x + v.z * v.z); }
function vnorm(v) { const l = vlen(v) || 1; return { x: v.x / l, z: v.z / l }; }
function fwd(a) { return { x: Math.sin(a), z: Math.cos(a) }; }
const q3 = v => Math.round(v * 1000) / 1000;
function fmtClock(s) { s = Math.max(0, Math.ceil(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); }
function ease(t) { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); }

const $ = (sel, root = document) => root.querySelector(sel);
const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
function h(tag, attrs, ...kids) {
  const e = document.createElement(tag);
  if (attrs) for (const k in attrs) {
    const v = attrs[k];
    if (v == null || v === false) continue;
    if (k === 'class') e.className = v;
    else if (k === 'style') e.style.cssText = v;
    else if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
    else if (k === 'html') e.innerHTML = v;
    else e.setAttribute(k, v === true ? '' : v);
  }
  for (const kid of kids.flat()) if (kid != null && kid !== false) e.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
  return e;
}

// Refreshing a counter must not discard its nested horizontal/vertical viewport.
// Restore synchronously: a delayed restore would fight the next touch gesture.
function menuView(root, { reset = false } = {}) {
  const pathOf = el => { const path = []; while (el !== root) { const p = el.parentElement; if (!p) return null; path.unshift(Array.prototype.indexOf.call(p.children, el)); el = p; } return path; };
  const atPath = path => path && path.reduce((el, i) => el?.children[i], root);
  const active = root.contains(document.activeElement) ? document.activeElement : null;
  const focus = active && { el: active, key: active.dataset.menuKey, id: active.id, label: active.getAttribute('aria-label'), name: active.getAttribute('name'), tag: active.tagName, text: active.textContent, path: pathOf(active), start: active.selectionStart, end: active.selectionEnd };
  const scrolls = reset ? [] : [root, ...root.querySelectorAll('*')].filter(el => el === root || el.scrollTop || el.scrollLeft).map(el => ({ path: pathOf(el), top: el.scrollTop, left: el.scrollLeft }));
  const parents = []; for (let el = root.parentElement; el && el !== document.body; el = el.parentElement) if (el.scrollTop || el.scrollLeft) parents.push([el, el.scrollTop, el.scrollLeft]);
  root.style.overflowAnchor = 'none';
  return () => {
    if (reset) { root.scrollTop = 0; root.scrollLeft = 0; }
    else {
      if (focus) {
        const candidates = Array.from(root.querySelectorAll(focus.tag));
        const matches = candidates.filter(el => focus.key ? el.dataset.menuKey === focus.key : focus.id ? el.id === focus.id : focus.label ? el.getAttribute('aria-label') === focus.label : focus.name ? el.getAttribute('name') === focus.name : el.textContent === focus.text);
        const next = root.contains(focus.el) ? focus.el : matches.length === 1 ? matches[0] : matches.find(el => el === atPath(focus.path));
        if (next && !next.disabled) { next.focus({ preventScroll: true }); if (focus.start != null && next.setSelectionRange) { try { next.setSelectionRange(focus.start, focus.end); } catch (e) { /* number/range inputs do not expose a text selection */ } } }
      }
      for (const s of scrolls) { const el = atPath(s.path); if (el) { el.style.overflowAnchor = 'none'; el.scrollTop = s.top; el.scrollLeft = s.left; } }
      for (const [el, top, left] of parents) { el.scrollTop = top; el.scrollLeft = left; }
    }
  };
}
function redrawMenu(root, render, options) { const restore = menuView(root, options); try { return render(); } finally { restore(); } }

const store = {
  get(k, d) { try { const v = localStorage.getItem('st-' + k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem('st-' + k, JSON.stringify(v)); } catch (e) { /* storage unavailable */ } },
  del(k) { try { localStorage.removeItem('st-' + k); } catch (e) { } }
};

