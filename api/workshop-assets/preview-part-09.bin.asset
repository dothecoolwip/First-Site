  if (cam.near !== 0.4) { cam.near = 0.4; cam.updateProjectionMatrix(); }
  const wantFov = aspect < 0.8 ? 58 : aspect < 1.2 ? 50 : 42; if (Math.abs(cam.fov - wantFov) > 0.1) { cam.fov = wantFov; cam.updateProjectionMatrix(); }
