// ---------- photo mode: freeze the fight, fly the camera, add a filter or a poster frame, save a PNG ----------
const PHOTO = { on: false, yaw: 0, pitch: 0.35, dist: 4.5, target: new THREE.Vector3(), filter: 'none', frame: false, drag: null };
const PHOTO_FILTERS = { none: 'none', warm: 'sepia(.35) saturate(1.25) contrast(1.05)', mono: 'grayscale(1) contrast(1.2)', vivid: 'saturate(1.6) contrast(1.1)', film: 'sepia(.2) contrast(1.25) brightness(.95) saturate(.85)' };
function openPhoto() {
  if (!G.match) return;
  PHOTO.on = true; G.photo = true; if (NET.on) { onlinePauseRequest(true); resetTransientInput(); } else G.paused = true; hideAll(); setHud(false); $('#touch').hidden = true;
  const f = G.lastDown && !G.lastDown.out ? G.lastDown : G.player || G.fighters[0];
  PHOTO.target.set(f.pos.x, (f.body ? f.body.h : 1.8) * 0.6, f.pos.z); PHOTO.yaw = (G.player ? G.player.facing : 0) + Math.PI + 0.6; PHOTO.pitch = 0.3; PHOTO.dist = 4.5;
  $('#photo').hidden = false; renderPhotoUI();
}
function closePhoto() { if (RP.on) stopReplay(); PHOTO.on = false; G.photo = false; $('#photo').hidden = true; $('#gl').style.filter = ''; $('#photoFrame').hidden = true; togglePause(true); }
function renderPhotoUI() {
  const fs = $('#photoFilters'); fs.innerHTML = '';
  for (const [k, n] of [['none', 'Plain'], ['warm', 'Warm'], ['mono', 'B&W'], ['vivid', 'Vivid'], ['film', 'Film']]) fs.append(h('button', { 'aria-pressed': String(PHOTO.filter === k), onclick: () => { PHOTO.filter = k; renderPhotoUI(); AU.click(); } }, n));
  $('#gl').style.filter = PHOTO_FILTERS[PHOTO.filter] === 'none' ? '' : PHOTO_FILTERS[PHOTO.filter];
  $('#photoFrameBtn').setAttribute('aria-pressed', String(PHOTO.frame)); $('#photoFrame').hidden = !PHOTO.frame;
  $('#photoFrame .pfsub').textContent = G.match ? `${CLUBS.reavers.name} vs ${CLUBS[G.match.opp] ? CLUBS[G.match.opp].name : ''} · ${G.match.stage || ''}` : '';
}
function updatePhotoCam(dt) {
  const cam = W3.camera; const gp = currentPad && currentPad();
  if (gp) { const ax = gp.axes; const dz = v => Math.abs(v) > 0.18 ? v : 0; PHOTO.yaw -= dz(ax[2] || 0) * dt * 2; PHOTO.pitch = clamp(PHOTO.pitch + dz(ax[3] || 0) * dt * 1.5, -0.1, 1.4); PHOTO.target.x += (dz(ax[0]) * Math.cos(PHOTO.yaw) + dz(ax[1]) * Math.sin(PHOTO.yaw)) * dt * 3; PHOTO.target.z += (-dz(ax[0]) * Math.sin(PHOTO.yaw) + dz(ax[1]) * Math.cos(PHOTO.yaw)) * dt * 3; }
  const t = PHOTO.target, d = PHOTO.dist;
  cam.position.set(t.x + Math.sin(PHOTO.yaw) * Math.cos(PHOTO.pitch) * d, Math.max(0.15, t.y + Math.sin(PHOTO.pitch) * d), t.z + Math.cos(PHOTO.yaw) * Math.cos(PHOTO.pitch) * d);
  if (cam.near !== 0.1 || Math.abs(cam.fov - 45) > 0.1) { cam.near = 0.1; cam.fov = 45; cam.updateProjectionMatrix(); }
  cam.lookAt(t);
}
async function savePhoto() {
  const R = W3.renderer; R.autoClear = false; R.clear(); R.render(W3.scene, W3.camera);
  const src = R.domElement, c = document.createElement('canvas'); c.width = src.width; c.height = src.height; const x = c.getContext('2d');
  x.filter = PHOTO_FILTERS[PHOTO.filter]; x.drawImage(src, 0, 0); x.filter = 'none';
  if (PHOTO.frame) { // poster frame: tape strip title and the match line
    const W = c.width, H = c.height, u = Math.min(W, H);
    x.strokeStyle = '#ece8de'; x.lineWidth = u * 0.025; x.strokeRect(u * 0.03, u * 0.03, W - u * 0.06, H - u * 0.06);
    x.fillStyle = '#141516'; x.save(); x.translate(W * 0.06, H * 0.82); x.rotate(-0.03); x.fillRect(0, 0, W * 0.5, u * 0.11);
    x.fillStyle = '#ece8de'; x.font = `900 ${u * 0.075}px "Big Shoulders Display", Impact, sans-serif`; x.fillText('RED DEER RUMBLE 2026', u * 0.03, u * 0.085); x.restore();
    x.fillStyle = 'rgba(10,13,15,.75)'; x.fillRect(W * 0.06, H * 0.82 + u * 0.12, W * 0.6, u * 0.05); x.fillStyle = '#aab4b8'; x.font = `600 ${u * 0.032}px "Barlow Semi Condensed", sans-serif`; x.fillText($('#photoFrame .pfsub').textContent, W * 0.07, H * 0.82 + u * 0.157);
  }
  const blob = await new Promise(r => c.toBlob(r, 'image/png')); if (!blob) { toastMenu('Could not capture the photo.'); return; }
  const name = `buhurt-${Date.now()}.png`;
  try { const dl = window.claude && window.claude.use ? await window.claude.use('downloads') : null; if (dl) { await dl.save({ filename: name, data: blob }); toastMenu('Photo saved.'); return; } } catch (e) { if (e && e.code === 'declined') return; }
  try { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000); toastMenu('Photo saved.'); } catch (e) { toastMenu('Saving isn’t allowed here. Take a screenshot instead.'); }
}
function initPhoto() {
  const el = $('#photo');
  el.addEventListener('pointerdown', e => { if (e.target.closest('button,input')) return; PHOTO.drag = { x: e.clientX, y: e.clientY, pan: e.button === 2 || e.shiftKey }; el.setPointerCapture(e.pointerId); });
  el.addEventListener('pointermove', e => { const d = PHOTO.drag; if (!d) return; const dx = e.clientX - d.x, dy = e.clientY - d.y; d.x = e.clientX; d.y = e.clientY;
    if (d.pan) { PHOTO.target.x -= (dx * Math.cos(PHOTO.yaw)) * 0.01; PHOTO.target.z += (dx * Math.sin(PHOTO.yaw)) * 0.01; PHOTO.target.y = clamp(PHOTO.target.y + dy * 0.01, 0.2, 3); }
    else { PHOTO.yaw -= dx * 0.008; PHOTO.pitch = clamp(PHOTO.pitch + dy * 0.006, -0.1, 1.4); } });
  el.addEventListener('pointerup', () => PHOTO.drag = null);
  el.addEventListener('contextmenu', e => e.preventDefault());
  el.addEventListener('wheel', e => { PHOTO.dist = clamp(PHOTO.dist * (1 + Math.sign(e.deltaY) * 0.1), 1.2, 14); e.preventDefault(); }, { passive: false });
  $('#photoIn').onclick = () => PHOTO.dist = clamp(PHOTO.dist * 0.82, 1.2, 14);
  $('#photoOut').onclick = () => PHOTO.dist = clamp(PHOTO.dist * 1.22, 1.2, 14);
  $('#photoSave').onclick = () => { AU.click(); savePhoto(); };
  $('#photoExit').onclick = () => { AU.click(); closePhoto(); };
  $('#photoFrameBtn').onclick = () => { PHOTO.frame = !PHOTO.frame; renderPhotoUI(); AU.click(); };
  $('#btnPhoto').onclick = () => { AU.click(); openPhoto(); };
  $('#btnReplay').onclick = () => { AU.click(); openPhoto(); if (startReplay() && G.lastDown) { PHOTO.target.set(G.lastDown.groundPos.x, 0.9, G.lastDown.groundPos.z); PHOTO.dist = 4; } };
  $('#replayBtn').onclick = () => { AU.click(); RP.on ? stopReplay() : startReplay(); };
  $('#replayScrub').oninput = e => { if (!RP.on && !startReplay()) return; if (!RP.frames.length) return; const a = RP.frames[0].t, b = RP.frames[RP.frames.length - 1].t; RP.t = a + (b - a) * +e.target.value; RP.start = a; RP.end = b; };
}
// ---------- two players: local versus on one screen, and online duels through the page's room ----------

// Both use the same "virtual input" (VIN): movement, guard/brace/sprint, a swing counter with hold and arc, and action counters.

function newVin() { return { mx: 0, mz: 0, yaw: null, pitch: 0, cancel: 0, sp: 0, gd: 0, br: 0, sw: 0, sh: 0, arc: 'auto', e: { trip: 0, shove: 0, grab: 0, tackle: 0 } }; }

function vinAct(f, k, opp) {

  if (k === 'tackle') { if (f.weapon && !f.clinch) startAction(f, 'tackle', { target: opp }); return; }

  if (f.clinch) { startAction(f, k === 'trip' ? 'throw' : k === 'grab' ? 'disarm' : 'shove'); return; }

  if (!f.weapon && k === 'shove') return;

  startAction(f, k, { target: opp });

}

const NET_PROTOCOL = 3;

function validatedVin(raw, previous) {

  if (!raw || typeof raw !== 'object') return null;

  const counter = n => Number.isSafeInteger(n) && n >= 0 && n <= 1000000000;

  if (![raw.mx, raw.mz].every(Number.isFinite) || !counter(raw.sw) || !raw.e || !['trip', 'shove', 'grab', 'tackle'].every(k => counter(raw.e[k]))) return null;

  if (raw.yaw != null && !Number.isFinite(raw.yaw)) return null;

  if (raw.pitch != null && !Number.isFinite(raw.pitch)) return null;

  if (!['auto', 'R2L', 'L2R', 'O'].includes(raw.arc || 'auto') || ![0, 1, 2, 3, 4].includes(raw.gd || 0)) return null;

  const cancel = raw.cancel || 0; if (!counter(cancel)) return null;

  if (!counter(raw.orderSeq || 0) || (raw.order != null && !ORDERS[raw.order])) return null;

  if (previous && (raw.sw < previous.sw || raw.sw - previous.sw > 1 || cancel < previous.cancel || cancel - previous.cancel > 1 || Object.keys(previous.e).some(k => raw.e[k] < previous.e[k] || raw.e[k] - previous.e[k] > 1))) return null;

  const scale = Math.max(1, Math.hypot(raw.mx, raw.mz));

  return { ...raw, mx: raw.mx / scale, mz: raw.mz / scale, pitch: clamp(raw.pitch || 0, -0.75, 0.55), yaw: raw.yaw == null ? null : angDiff(0, raw.yaw), sw: raw.sw, cancel, sp: !!raw.sp, br: !!raw.br, sh: !!raw.sh, e: { ...raw.e } };

}

function neutralVin(V) { return { ...V, mx: 0, mz: 0, sp: false, gd: 0, br: false, sh: false, e: { ...V.e } }; }

function vinControl(f, V, dt) {

  if (V.expired || V.menuNeutral) { f.move = { x: 0, z: 0 }; f.guard = f.brace = f.sprint = false; if (f.action?.held) f.action.cancel = true; if (f.vinSeen) f.vinSeen.held = false; return; }

  V = validatedVin(V); if (!V) { f.move = { x: 0, z: 0 }; f.guard = f.brace = f.sprint = false; if (f.action?.held) f.action.cancel = true; return; }

  const S = f.vinSeen || (f.vinSeen = { sw: V.sw, cancel: 0, held: false, e: { ...V.e } });

  if (V.order && V.orderSeq > (S.orderSeq || 0)) { S.orderSeq = V.orderSeq; if (!NET.on || onlineCaptain(f.team)?.uid === f.netUid) setOrder(V.order, f); }

  f.aimPitch = Number.isFinite(V.pitch) ? clamp(V.pitch, -0.75, 0.55) : 0;

  if (V.cancel && V.cancel !== S.cancel) { S.cancel = V.cancel; S.held = false; if (f.action && f.action.kind === 'swing' && f.action.phase === 'windup') f.action.cancel = true; }

  if (f.state !== 'standing' || G.phase !== 'fight') { f.move = { x: 0, z: 0 }; S.sw = V.sw; S.e = { ...V.e }; S.held = false; return; }

  f.move = { x: V.mx || 0, z: V.mz || 0 }; f.sprint = !!V.sp; f.guard = !!V.gd; f.gdir = V.gd ? ({ 2: 'L', 3: 'R', 4: 'H' }[V.gd] || 'mid') : null; f.brace = !!V.br && !V.gd;

  let opp = null, bd = 1e9; for (const o of G.fighters) if (o.team !== f.team && isUp(o)) { const d = dist2(o.pos, f.pos); if (d < bd) { bd = d; opp = o; } }

  f.softTarget = opp;

  f.wantFace = V.yaw != null ? V.yaw : opp ? angTo(f.pos, opp.pos) : vlen(f.move) > 0.2 ? Math.atan2(f.move.x, f.move.z) : f.wantFace;

  if (f.clinch) f.wantFace = angTo(f.pos, (f.clinch.a === f ? f.clinch.b : f.clinch.a).pos);

  if (f.guard && f.action && f.action.kind === 'swing' && f.action.phase === 'windup') f.action.cancel = true;

  if (V.sw !== S.sw) { S.sw = V.sw; S.held = true; if (f.clinch) startAction(f, 'knee'); else if (f.weapon) startAction(f, 'swing', { held: true, arc: 'R2L', target: opp }); }

  const a = f.action;

  if (S.held && !V.sh) {

    S.held = false;

    if (a && a.kind === 'swing' && a.held) { let arc = V.arc || 'auto'; if (arc === 'auto') { f.swingSide *= -1; arc = f.swingSide > 0 ? 'R2L' : 'L2R'; } a.arc = arc; a.held = false; a.wind = swingTimes(f).wind + 0.0001; }

  } else if (S.held && a && a.kind === 'swing' && a.held && V.arc && V.arc !== 'auto') a.arc = V.arc;

  for (const k of ['trip', 'shove', 'grab', 'tackle']) { const c = V.e[k] || 0; if (c !== (S.e[k] || 0)) { S.e[k] = c; vinAct(f, k, opp); } }

}



// ---- local versus: two controllers, or keyboard (player 1) and a controller (player 2), one shared broadcast camera ----

const VS = { on: false, prev: [[], [], [], []], vins: [newVin(), newVin()], humans: [], kind: 'duel' };

function camRel(x, y, cam) { const d = new THREE.Vector3(); (cam || W3.camera).getWorldDirection(d); d.y = 0; d.normalize(); return { x: d.x * y - d.z * x, z: d.z * y + d.x * x }; }

function padVin(gp, V, slot) {

  const b = gp.buttons.map(x => x.pressed || x.value > 0.5), pv = VS.prev[slot], pressed = i => b[i] && !pv[i];

  const dz = (x, y) => { const m = Math.hypot(x, y); return m < 0.18 ? [0, 0] : [x, y]; };

  const [lx, ly] = dz(gp.axes[0] || 0, gp.axes[1] || 0), [rx, ry] = dz(gp.axes[2] || 0, gp.axes[3] || 0);

  const mv = camRel(lx, -ly, vsCam(slot)); V.mx = mv.x; V.mz = mv.z; V.sp = ly < -0.85 ? 1 : 0; const miss = gp.missing || [], noTrig = miss.includes(6) || miss.includes(7);

  V.gd = b[6] || (noTrig && b[4]) ? (rx > 0.45 ? 3 : rx < -0.45 ? 2 : ry < -0.5 ? 4 : (V.gd || 1)) : 0; V.br = b[0] ? 1 : 0;

  const rt = Math.max(gp.buttons[7] ? gp.buttons[7].value : 0, noTrig && b[5] ? 1 : 0);

  if (rt > 0.5 && !V.sh) { V.sw++; V.sh = 1; }

  if (V.sh) V.arc = rx > 0.45 ? 'R2L' : rx < -0.45 ? 'L2R' : ry < -0.5 ? 'O' : V.arc;

  if (rt < 0.25 && V.sh) V.sh = 0;

  if (pressed(1)) V.e.trip++; if (pressed(2)) V.e.shove++; if (noTrig ? pressed(miss.includes(11) ? 15 : 11) : (pressed(4) || pressed(5))) V.e.grab++; if (pressed(3)) V.e.tackle++;

  // Start on any pad pauses through readInput, which listens to every controller in use

  VS.prev[slot] = b;

}

function keyVin(V) {

  const k = IN.keys; let x = 0, y = 0;

  if (k.KeyW) y += 1; if (k.KeyS) y -= 1; if (k.KeyA) x -= 1; if (k.KeyD) x += 1;

  const mv = camRel(x, y, vsCam(0)), l = Math.hypot(mv.x, mv.z) || 1; V.mx = mv.x / Math.max(1, l); V.mz = mv.z / Math.max(1, l);

  V.sp = k.ShiftLeft ? 1 : 0; V.gd = k.KeyK ? (k.KeyA ? 2 : k.KeyD ? 3 : k.KeyW ? 4 : (V.gd || 1)) : 0; V.br = k.Space ? 1 : 0;

  if (k.KeyJ && !V.sh) { V.sw++; V.sh = 1; V.arc = 'auto'; } if (V.sh && k.KeyJ) V.arc = k.KeyA ? 'L2R' : k.KeyD ? 'R2L' : k.KeyW ? 'O' : V.arc;

  if (!k.KeyJ && V.sh) V.sh = 0;

  const once = (code, key) => { if (k[code] && !VS['k' + code]) V.e[key]++; VS['k' + code] = !!k[code]; };

  once('KeyL', 'trip'); once('KeyI', 'shove'); once('KeyU', 'grab'); once('KeyO', 'tackle');

}

function readVersus() {

  if (activeLayer()) { VS.vins.forEach(V => { if (!V.menuNeutral) Object.assign(V, neutralVin(V)); V.menuNeutral = true; }); return; }

  VS.vins.forEach(V => V.menuNeutral = false);

  const pads = seatPads();

  const n = VS.vins.length, useKb = pads.length < n; // not enough controllers: player 1 takes the keyboard

  for (let i = 0; i < n; i++) { const gp = pads[useKb ? i - 1 : i]; if (useKb && i === 0) keyVin(VS.vins[0]); else if (gp) padVin(gp, VS.vins[i], i); }

}

// local play: 2 to 4 people on one screen. kind: 'duel' (1v1), 'coop' (you two against bots), 'tag' (2v2, four players)

const LOCAL_KINDS = {

  duel: { name: 'Versus duel', players: 2, mode: 1, desc: 'One on one, open weapons, profight scoring.' },

  coop2: { name: 'Co-op 2v2', players: 2, mode: 2, desc: 'You two against a pair of bots.' },

  coop3: { name: 'Co-op 3v3', players: 2, mode: 3, desc: 'You two and a bot teammate against three bots.' },

  coop5: { name: 'Co-op 5v5', players: 2, mode: 5, desc: 'You two lead a full squad of bots.' },

  tag: { name: '2v2, four players', players: 4, mode: 2, desc: 'Two teams of two humans. Needs four controllers (or three and the keyboard).' },

};

const LOCAL_EXTRA = [['ffa2', '2P', 'Free-for-all', 'Two of you and four bots, everyone against everyone.'], ['ffa4', '4P', 'Free-for-all, four players', 'Four of you and two bots. Last one standing.'], ['bracket', '4-8', 'Friends\u2019 bracket', 'Type 4 or 8 names, duel it out, crown a champion.']];

function startVersus(kind) {

  kind = LOCAL_KINDS[kind] ? kind : (VS.kind || 'duel'); VS.kind = kind; const K = LOCAL_KINDS[kind];

  AU.init(); G.attract = false; G.tourney = null; REP.log = []; endTraining();

  const qm = {}; for (const k of (G.quickMods || store.get('quickMods', []))) qm[k] = true;

  setupMatch({ mod: qm, mode: K.mode, opp: 'wardens', stage: K.name, venue: G.quickVenue || W3.venue || 'arena', versus: true, pro: K.mode === 1, local: kind });

  VS.on = true; VS.vins = Array.from({ length: K.players }, newVin); VS.prev = [[], [], [], []]; SPLIT.init = [false, false, false, false];

  document.body.classList.toggle('split', SPLIT.on); document.body.classList.toggle('split4', SPLIT.on && K.players > 2); $('#splitLabels').innerHTML = '';

  const t0 = G.fighters.filter(f => f.team === 0), t1 = G.fighters.filter(f => f.team === 1);

  const humans = kind === 'tag' ? [t0[0], t1[0], t0[1], t1[1]] : kind === 'duel' ? [t0[0], t1[0]] : [t0[0], t0[1]];

  G.fighters.forEach(f => { f.isPlayer = false; delete f.combatProfile; }); G.player = null;

  humans.forEach((f, i) => { f.squireRecruited = squireActive(squireTeam(f.club)); f.ai.role = null; f.combatProfile = careerCombatProfile(); f.weapon = profileWeapon(f.spec.weapon, f.combatProfile); f.vin = VS.vins[i]; f.name = VS.names && VS.names[i] || 'Player ' + (i + 1); f.pslot = i; applyPick(f, i); f.weapon = profileWeapon(f.spec.weapon, f.combatProfile); recalcBody(f); });

  VS.humans = humans;

  if (VS.names) { $('#sbA').textContent = VS.names[0].slice(0, 4).toUpperCase(); $('#sbB').textContent = (VS.names[1] || 'P2').slice(0, 4).toUpperCase(); startRound(); beginFight(); return; }

  $('#sbA').textContent = kind === 'duel' ? 'P1' : kind === 'tag' ? 'P1·3' : 'YOU'; $('#sbB').textContent = kind === 'duel' ? 'P2' : kind === 'tag' ? 'P2·4' : CLUBS.wardens.short;

  startRound(); beginFight();

}

function openVersus() {

  const pads = padCount();

  const cards = Object.entries(LOCAL_KINDS).map(([k, K]) => `<button class="mode" data-local="${k}"><span class="big num">${K.players}P</span><b>${K.name}</b><span>${K.desc}</span></button>`).join('') + LOCAL_EXTRA.map(([k, n, t, d]) => `<button class="mode" data-local="${k}"><span class="big num">${n}</span><b>${t}</b><span>${d}</span></button>`).join('');

  msg('local play', 'Couch play', `<p>Plug a laptop into the TV (or cast your phone), connect controllers, pick a mode.</p>

    <div class="modes">${cards}</div>

    <div class="setrow"><span>View</span><div class="seg small" id="splitSeg"><button data-s="1" aria-pressed="${SPLIT.on}">Split screen</button><button data-s="0" aria-pressed="${!SPLIT.on}">Shared camera</button></div></div>

    <div class="ctrlgrid"><b>Controllers</b><span>Left stick moves, RT/ZR swings (right stick picks the arc), LT/ZL guards, bottom button braces, right button trips, left button shoves, top button tackles, a bumper grabs. Xbox, PlayStation and Switch Pro Controllers all work.</span>

    <b>Keyboard</b><span>With one controller short, player 1 plays on the keyboard: WASD move, hold J to swing (A, D or W picks the arc), K guard, Space brace, L trip, I shove, U grab, O tackle, Shift run.</span></div>

    <p class="muted">${pads ? pads + ' controller' + (pads > 1 ? 's' : '') + ' connected.' : 'No controller found yet: press a button on it.'}</p>`,

    [['Back', openModes, true]]);

  $$('#msgPanel [data-local]').forEach(b => b.onclick = () => { AU.click(); const k = b.dataset.local; if (k === 'bracket') return openBracket(); if (k.startsWith('ffa')) { const hu = k === 'ffa4' ? 4 : 2; return openPicks(hu, () => startFFA(6, hu)); } openPicks(LOCAL_KINDS[k].players, () => startVersus(k)); });

  $$('#splitSeg button').forEach(b => b.onclick = () => { SPLIT.on = b.dataset.s === '1'; store.set('split', SPLIT.on); $$('#splitSeg button').forEach(x => x.setAttribute('aria-pressed', String(x === b))); AU.click(); });

}



// ---- online duel: host runs the fight, the guest sends inputs; both share state through room presence ----

const NET = { on: false, role: null, room: null, code: '', vin: newVin(), remote: null, seq: 0, ev: [], lastEv: 0, sendT: 0, snap: null, peer: null };

function netEvent(...e) { if (NET.on && NET.role === 'host') { NET.ev.push([++NET.seq, ...e]); if (NET.ev.length > 10) NET.ev.shift(); } }

// Claude's room when the game runs on claude.ai and this viewer may use it; otherwise peer-to-peer

async function getRoom() { let r = null; try { r = window.claude && window.claude.use ? await window.claude.use('room') : null; } catch (e) { r = null; } return r || p2pRoom(); }

function myLoadout() { const L = G.loadout, w = loadoutWeapon(); return { squireRecruited: squireActive(), protocol: NET_PROTOCOL, combatProfile: careerCombatProfile(), creatorProof: creatorProof('combat'), helm: L.helm, weapon: w.key, base: w.base || null, shield: w.hands === 2 ? null : (L.shield === 'none' ? null : L.shield), height: L.height, build: L.build, heightValue: L.heightValue, massValue: L.massValue, gender: L.gender, sh: typeof lookLite === 'function' ? lookLite().sh : null, name: CAREER.name || 'Rival', bf: BOS.info && rosterEligible(BOS.info.fighter) ? BOS.info.fighter : null }; }

function applyLo(f, lo, cat) {

  if (!lo) return; f.squireRecruited = lo.squireRecruited === true; const wk = WEAPONS[lo.weapon] && lo.weapon !== 'custom' ? lo.weapon : (WEAPONS[lo.base] ? lo.base : 'sword'); f.spec = { ...f.spec, helm: lo.helm, weapon: wk, shield: lo.shield }; f.combatProfile = validateCombatProfile(lo.combatProfile); f.weapon = profileWeapon(wk, f.combatProfile); f.shield = lo.shield ? SHIELDS[lo.shield] : null;

  f.body = makeBody(cat, f.spec.arch, 'net' + lo.name, { height: lo.height, build: lo.build, heightValue: lo.heightValue, massValue: lo.massValue, gender: lo.gender }); f.appearance = { sh: lo.sh }; f.name = String(lo.name || 'Rival').slice(0, 20); f.bosReal = rosterEligible(lo.bf) ? { id: lo.bf } : null; f.creatorProof = lo.creatorProof || null; f.creatorVerified = false; resetFighterForRound(f);

}

async function openOnline() { return openOnlineHub(); }

const ST_CODE = ['standing', 'posting', 'falling', 'grounded', 'rising', 'kneeling'], AK = [null, 'swing', 'shove', 'trip', 'grab', 'knee', 'throw', 'disarm', 'tackle'], PH = ['windup', 'strike', 'recover', 'lunge'], ARC = ['R2L', 'L2R', 'O'];

const q = v => Math.round(v * 1000) / 1000;

function packF(f) { const a = f.action; return [q(f.pos.x), q(f.pos.z), q(f.facing), ST_CODE.indexOf(f.state), q(f.lean.x), q(f.lean.z), a ? AK.indexOf(a.kind) : 0, a ? PH.indexOf(a.phase) : 0, a ? ARC.indexOf(a.arc) : 0, a ? q(a.charge || 0) : 0, q(f.gas), q(f.fatigue || 0), q(f.groundPos.x), q(f.groundPos.z), q(f.fallDir.x), q(f.fallDir.z), q(f.fallT), q(f.gt || 0), (f.guard ? 1 : 0) | (f.brace ? 2 : 0) | (f.sprint ? 4 : 0) | (f.touched ? 8 : 0) | (f.weapon ? 16 : 0) | (f.out ? 32 : 0), q(f.vel.x), q(f.vel.z), q(f.bell), f.groundStyle === 'fall' ? 0 : f.groundStyle === 'kneel' ? 1 : 2, q(f.riseT || 0), a ? q(a.t || 0) : 0, f.gdir || null, q(f.aimPitch || 0), a ? a.id || 0 : 0, f.weapon ? f.weapon.key : null, f.shield ? f.shield.key : null]; }

function unpackF(f, s, dt) {

  if (s.length >= 30) { const wk = WEAPONS[s[28]] ? s[28] : null, sk = SHIELDS[s[29]] ? s[29] : null; if ((f.weapon?.key || null) !== wk || (f.shield?.key || null) !== sk) { f.weapon = wk ? profileWeapon(wk, combatProfile(f)) : null; f.shield = sk ? SHIELDS[sk] : null; setWeaponModel(f); setShieldModel(f); recalcBody(f); } }

  f.pos.x = damp(f.pos.x, s[0], 18, dt); f.pos.z = damp(f.pos.z, s[1], 18, dt); if (Math.hypot(f.pos.x - s[0], f.pos.z - s[1]) > 1.5) { f.pos.x = s[0]; f.pos.z = s[1]; }

  if (!f.isPlayer || !isCtl()) f.facing = s[2]; else f.facing = s[2];

  const st = ST_CODE[s[3]] || 'standing'; if (st === 'falling' && f.state !== 'falling') f.rag = null; f.state = st;

  f.lean.x = s[4]; f.lean.z = s[5];

  const kind = AK[s[6]];

  if (kind) { const phase = PH[s[7]] || 'windup'; const changed = !f.action || f.action.kind !== kind || f.action.phase !== phase || f.action.id !== s[27];

    if (changed) f.action = { id: s[27], kind, t: 0, phase };

    f.action.phase = phase; f.action.arc = ARC[s[8]] || 'R2L'; f.action.charge = s[9];

    f.action.t = Number.isFinite(s[24]) ? Math.max(0, s[24]) : changed ? 0 : f.action.t + dt;

  } else f.action = null;

  f.gdir = ['L', 'R', 'H', 'mid'].includes(s[25]) ? s[25] : null;

  f.aimPitch = Number.isFinite(s[26]) ? clamp(s[26], -0.75, 0.55) : 0;

  f.gas = s[10]; f.fatigue = s[11]; f.groundPos.x = s[12]; f.groundPos.z = s[13]; f.fallDir.x = s[14]; f.fallDir.z = s[15]; f.fallT = s[16]; f.gt = s[17];

  f.guard = !!(s[18] & 1); f.brace = !!(s[18] & 2); f.sprint = !!(s[18] & 4); f.touched = !!(s[18] & 8); f.out = !!(s[18] & 32);

  f.vel.x = s[19]; f.vel.z = s[20]; f.bell = s[21]; f.groundStyle = ['fall', 'kneel', 'sit'][s[22]] || 'fall'; f.riseT = s[23];

}

function netPlay(e) {

  const [, k, a, b, c, d] = e;

  if (k === 'h') { const p = new THREE.Vector3(a, b, c); AU.armourHit(1, 0.9); sparks(p, 10, 1); if (d > 1) flipFx('impact', p, 0.9, 0.22, '#fff6d8', true); if (G.player && dist2(G.player.pos, p) < 0.9) { flashHit(); impactFeel('taken', null, 1); } }

  else if (k === 'b') { AU.block('clash', 1, 0.9); sparks(new THREE.Vector3(a, b, c), 6, 0.8); }

  else if (k === 'd') { AU.crash(0.9); AU.cheer(1); dustPuff(a, b); flipFx(CUTE.on ? 'stars' : 'cloud', new THREE.Vector3(a, 0.5, b), 2.4, 1); }

  else if (k === 'c') showCall(a, b);

  else if (k === 't') toast(a, b, c);

}
// ---------- instant replay: the last ten seconds of every fighter, played back slowly from any angle ----------
const RP = { frames: [], max: 220, acc: 0, on: false, t: 0, speed: 0.35 };
function recordReplay(dt) {
  if (!G.match || G.attract || G.paused || !['fight', 'stopping'].includes(G.phase)) return;
  RP.accumulatedDt = (RP.accumulatedDt || 0) + dt;
  RP.acc += dt; if (RP.acc < 0.05) return; RP.acc = 0;
  if (NET.on && NET.role === 'guest') RP.guestTime = Math.max(G.simTime, (RP.guestTime == null ? G.simTime : RP.guestTime) + RP.accumulatedDt);
  const fr = { t: NET.on && NET.role === 'guest' ? RP.guestTime : G.simTime, f: [] }; RP.accumulatedDt = 0;
  for (const f of G.fighters) { const J = f.model; if (!J) continue; fr.f.push([f, J.root.visible, J.root.position.x, J.root.position.y, J.root.position.z, J.root.rotation.y, J.tilt.rotation.x, J.tilt.rotation.y, J.tilt.rotation.z, J.tilt.scale.y, ...POSE_KEYS.map(k => J.pose[k] || 0)]); }
  RP.frames.push(fr); if (RP.frames.length > RP.max) RP.frames.shift();
}
function clearReplay() { RP.frames.length = 0; RP.on = false; RP.guestTime = null; RP.acc = RP.accumulatedDt = 0; }
function startReplay() {
  if (RP.frames.length < 10) { toastMenu('Nothing to replay yet.'); return false; }
  const first = RP.frames[0].t, end = RP.frames[RP.frames.length - 1].t;
  if (!(end > first)) { toastMenu('Nothing to replay yet.'); return false; }
  RP.on = true; G.replay = true;
  // A short recording still plays its available span; stale takedown times are ignored.
  const downT = G.lastDownT > first && G.lastDownT <= end ? G.lastDownT : null;
  RP.t = RP.start = Math.max(first, downT == null ? end - 6 : downT - 2.5);
  RP.end = downT == null ? end : Math.min(end, downT + 2.5);
  $('#replayBtn').setAttribute('aria-pressed', 'true'); return true;
}
function stopReplay() { RP.on = false; G.replay = false; const b = $('#replayBtn'); if (b) b.setAttribute('aria-pressed', 'false'); for (const f of G.fighters) if (f.model) animateFighter(f, 0, G.realTime); }
function updateReplay(dt) {
  if (!RP.on) return;
  RP.t += dt * RP.speed; if (RP.t > RP.end) RP.t = RP.start; // loop the moment
  let i = RP.frames.findIndex(fr => fr.t >= RP.t); if (i <= 0) i = 1; const A = RP.frames[i - 1], B = RP.frames[i] || A, k = clamp((RP.t - A.t) / Math.max(1e-3, B.t - A.t), 0, 1);
  A.f.forEach((a, n) => {
    const b = B.f[n] && B.f[n][0] === a[0] ? B.f[n] : a, f = a[0], J = f.model; if (!J) return;
    J.root.visible = a[1]; J.root.position.set(lerp(a[2], b[2], k), lerp(a[3], b[3], k), lerp(a[4], b[4], k)); J.root.rotation.y = a[5] + angDiff(a[5], b[5]) * k;
    J.tilt.rotation.set(lerp(a[6], b[6], k), lerp(a[7], b[7], k), lerp(a[8], b[8], k)); J.tilt.scale.setScalar((J.scale || 1)); J.tilt.scale.y = lerp(a[9], b[9], k);
    const P = {}; POSE_KEYS.forEach((key, j) => P[key] = lerp(a[10 + j], b[10 + j], k)); applyPose(J, P, 1e6, 1);
    if (f.isPlayer) J.root.visible = true;
  });
  const sl = $('#replayScrub'); if (sl) sl.value = String(clamp((RP.t - RP.frames[0].t) / Math.max(0.1, RP.frames[RP.frames.length - 1].t - RP.frames[0].t), 0, 1));
}
// ---------- split screen for local versus (one TV, two players), and Nintendo controller layout ----------
const SPLIT = { on: true, cams: [], pos: [], look: [], init: [false, false, false, false] };
function splitActive() { return VS.on && SPLIT.on && G.match && G.match.versus && ['prefight', 'fight', 'stopping', 'between'].includes(G.phase) && !G.photo && !CAM.cine; }
function splitCams() {
  if (!SPLIT.cams.length) for (let i = 0; i < 2; i++) SPLIT.cams.push(new THREE.PerspectiveCamera(60, 1, 0.2, 400));
  return SPLIT.cams;
}
// each player's camera rides behind their fighter, looking past them at the nearest opponent
function splitLayout(i, n, W, H) {
  if (n <= 2) { const side = W >= H; return side ? [i ? W / 2 : 0, 0, W / 2, H] : [0, i ? 0 : H / 2, W, H / 2]; }
  return [(i % 2) * W / 2, i < 2 ? H / 2 : 0, W / 2, H / 2]; // quadrants: P1 top-left, P2 top-right, P3 bottom-left, P4 bottom-right
}
function updateSplitCams(dt) {
  const hum = VS.humans || [], n = hum.length, W = window.innerWidth, H = window.innerHeight;
  while (SPLIT.cams.length < n) SPLIT.cams.push(new THREE.PerspectiveCamera(60, 1, 0.2, 400));
  while (SPLIT.pos.length < n) { SPLIT.pos.push(new THREE.Vector3()); SPLIT.look.push(new THREE.Vector3()); }
  hum.forEach((f, i) => {
    if (!f) return; let o = null, bd = 1e9; for (const e of G.fighters) if (e.team !== f.team && !e.out) { const d = dist2(e.pos, f.pos) + (isUp(e) ? 0 : 6); if (d < bd) { bd = d; o = e; } }
    const base = isDown(f) ? f.groundPos : f.pos, ob = o ? (isDown(o) ? o.groundPos : o.pos) : { x: 0, z: 0 };
    const ang = o ? angTo(base, ob) : f.facing, hs = f.body.h / 1.8;
    const tp = new THREE.Vector3(base.x - Math.sin(ang) * 4.4, 2.3 * hs, base.z - Math.cos(ang) * 4.4);
    tp.x = clamp(tp.x, -LIST.W / 2 + 0.6, LIST.W / 2 - 0.6); tp.z = clamp(tp.z, -LIST.L / 2 + 0.6, LIST.L / 2 - 0.6); // stay inside the rails
    const tl = new THREE.Vector3((base.x * 2 + ob.x) / 3, 1.1 * hs, (base.z * 2 + ob.z) / 3);
    if (!SPLIT.init[i]) { SPLIT.pos[i].copy(tp); SPLIT.look[i].copy(tl); SPLIT.init[i] = true; }
    SPLIT.pos[i].lerp(tp, 1 - Math.exp(-6 * dt)); SPLIT.look[i].lerp(tl, 1 - Math.exp(-8 * dt));
    const c = SPLIT.cams[i], L = splitLayout(i, n, W, H), aspect = L[2] / L[3], fov = aspect > 1.2 ? 60 : 52;
    c.position.copy(SPLIT.pos[i]); c.lookAt(SPLIT.look[i]);
    if (Math.abs(c.aspect - aspect) > 0.001 || c.fov !== fov) { c.aspect = aspect; c.fov = fov; c.updateProjectionMatrix(); }
  });
}
function renderSplit(R) {
  const n = (VS.humans || []).length, W = window.innerWidth, H = window.innerHeight;
  R.setScissorTest(true);
  for (let i = 0; i < n; i++) { const [x, y, w, h2] = splitLayout(i, n, W, H); R.setViewport(x, y, w, h2); R.setScissor(x, y, w, h2); R.render(W3.scene, SPLIT.cams[i]); }
  R.setScissorTest(false); R.setViewport(0, 0, W, H);
  updateLocalFeedback();
}
function updateLocalFeedback() {
  const lab = $('#splitLabels'); if (!lab) return;
  const hum = VS.humans || [], n = hum.length, W = innerWidth, H = innerHeight;
  document.body.classList.toggle('couch', !!VS.on);
  lab.hidden = !VS.on || !!G.screen || !!G.photo;
  if (!VS.on) return;
  const layout = `${n}:${W}:${H}:${SPLIT.on}`;
  if (lab.childElementCount !== n || lab.dataset.layout !== layout) {
    lab.dataset.layout = layout; lab.replaceChildren();
    for (let i = 0; i < n; i++) {
      const [x,y,w,h2] = SPLIT.on ? splitLayout(i,n,W,H) : [i * W / n,0,W/n,H];
      lab.append(h('span', {class:'plabel',style:`left:${x+6}px;bottom:${y+h2-64}px;max-width:${w-12}px;font-size:.8rem;white-space:normal`},''));
    }
  }
  [...lab.children].forEach((el,i) => {
    const f=hum[i]; if (!f) return;
    el.textContent = `P${i+1} · Stamina ${Math.round(f.gas*100)}% · Balance ${Math.round((1-leanRatio(f))*100)}% · ${isDown(f)?'Down':f.guard?'Guard':f.action?f.action.kind:'Ready'}`;
  });
}
// movement for a player is relative to their own half of the screen
function vsCam(slot) { return splitActive() && SPLIT.cams[slot] ? SPLIT.cams[slot] : W3.camera; }

// ---- Switch Pro Controller and Joy-Cons: Nintendo letters by position, and the right-hand button confirms ----
const NIN = { on: false };
const NIN_MAP = { A: 'B', B: 'A', X: 'Y', Y: 'X', RT: 'ZR', LT: 'ZL', RB: 'R', LB: 'L', R3: 'RS', L3: 'LS', View: '−', Start: '+', Menu: '+' };
function isNintendo(gp) { return !!gp && /nintendo|pro controller|joy-?con|057e/i.test(gp.id || ''); }
function gpName(k) { return NIN.on ? (NIN_MAP[k] || k) : k; }
function checkNintendo() {
  const pref = G.settings.padLetters || 'auto';
  const on = pref === 'nin' ? true : pref === 'xbox' ? false : isNintendo(PADS.last); if (on === NIN.on) return;
  NIN.on = on; document.body.classList.toggle('nin', on);
  $$('.gp[data-k]').forEach(el => { el.textContent = gpName(el.dataset.k); });
  if (on && pref === 'auto' && typeof toastMenu === 'function') toastMenu('Switch controller: right button confirms. Xbox letters on yours? Settings, Button letters.');
}
// ---------- play online: see who's playing (and their stats), find a match, invite someone, or send a link ----------
// The global list is the peer-to-peer lobby (13g) where it can run, otherwise Claude's room. Everyone sets a small
// presence: name, what they're doing, profile stats (pr), `look` (the code of an open lobby, for Find a match) and
// `invite` (a lobby code addressed to one player). Fights themselves happen in a lobby room (13h).
const GAME_URL = 'https://claude.ai/artifact/2hhQkB83SkLC5ta9nNEnkN';
const LOBBY = { room: null, me: null, peers: [], rawPeers: null, pending: null, seen: {}, ready: false, invited: null, starting: null };
const MM = { searching: false };
const SESSION_START = Date.now();
const escTxt = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
function myName() { const n = (CAREER.name && CAREER.name !== 'You') ? CAREER.name : (store.get('lobbyName', '') || ''); return String(n || 'A fighter').slice(0, 20); }
function lobbyStatus() { return NET.on ? 'in an online fight' : NET.room ? (NET.role === 'host' && ONL.L && ONL.L.open ? 'in an open lobby' : 'in a lobby') : TOWN.on ? 'walking around town' : G.attract || G.screen === 'title' ? 'on the title screen' : G.phase === 'fight' ? 'in a fight' : 'in the menus'; }
// play time: counted while the game is on screen, saved with the career
setInterval(() => { if (document.visibilityState === 'visible') { CAREER.playSec = (CAREER.playSec || 0) + 1; if (CAREER.playSec % 30 === 0) saveCareer(); } }, 1000);
function fmtDur(sec) { sec = Math.max(0, Math.round(sec || 0)); const hh = Math.floor(sec / 3600), mm = Math.floor(sec % 3600 / 60); return hh ? `${hh} h ${mm} min` : mm ? `${mm} min` : `${sec} s`; }
function myProfile() {
  const s = CAREER.stats || {}, shop = typeof shopState === 'function' ? shopState() : {};
  const items = typeof bagState === 'function' ? bagState().items || {} : {};
  const talents = Object.entries(CAREER.skills || {}).filter(([, v]) => v > 0).map(([k, v]) => `${k}:${v}`);
  return { creatorProof: creatorProof('town'), m: s.matches || 0, w: s.wins || 0, td: s.takedowns || 0, hits: s.hits || 0, rw: s.rumbleWins || 0, t: Math.round(CAREER.playSec || 0), on: SESSION_START, wpn: (WEAPONS[G.loadout.weapon] || WEAPONS.mace).name, club: CAREER.club && CAREER.club.name || '', ach: Object.keys(CAREER.ach || {}).length, bos: bosRecord(), lv: CAREER.level || 1, rank: rankOf(CAREER.level || 1), talents, inventory: items, purchases: shop.owned || {}, spent: shop.spent || 0, purse: CAREER.purse || 0 };
}
async function claudeRoom() { try { return window.claude && window.claude.use ? await window.claude.use('room') : null; } catch (e) { return null; } }
function lobbySet(patch) { try { LOBBY.room && LOBBY.room.presence(patch); } catch (e) { } }
// A person can have several browser sessions, each with a different peer ID.
// Account IDs identify people; display names do not.
function lobbyDistinctPeers(peers) {
  const own = typeof BOS !== 'undefined' && BOS.user && BOS.user.id;
  const byAccount = new Map(), guests = [];
  for (const p of peers || []) {
    if (!p || p.isMe || p.kind !== 'viewer' || !p.presence || !p.presence.name) continue;
    const uid = typeof p.presence.bu === 'string' && p.presence.bu || null;
    if (uid && uid === own) continue;
    if (!uid) { guests.push(p); continue; }
    const prev = byAccount.get(uid);
    const rank = q => [q.presence.tw ? 1 : 0, Number(q.presence.pr && q.presence.pr.on) || 0, String(q.peer || '')];
    if (!prev) byAccount.set(uid, p);
    else {
      const a = rank(p), b = rank(prev);
      if (a[0] > b[0] || a[0] === b[0] && (a[1] > b[1] || a[1] === b[1] && a[2] > b[2])) byAccount.set(uid, p);
    }
  }
  return [...byAccount.values(), ...guests];
}
function lobbySyncPeers() {
  const next = lobbyDistinctPeers(LOBBY.rawPeers == null ? LOBBY.peers : LOBBY.rawPeers);
  const changed = next.length !== LOBBY.peers.length || next.some((p, i) => p.peer !== LOBBY.peers[i].peer);
  LOBBY.peers = next;
  if (changed) updateLobbyBadge();
  return next;
}
async function initLobby() {
  if (LOBBY.room) return LOBBY.room;
  if (LOBBY.starting) return LOBBY.starting;
  LOBBY.starting = (async () => {
    // everyone in one list: the peer-to-peer lobby works on the website and (where allowed) on claude.ai, so both see
    // each other. If this page can't load it, fall back to Claude's own room.
    let room = null;
    try { await loadPeerLib(); room = p2pLobby(); await room.ready; } catch (e) { try { room && room.leave(); } catch (er) { } room = await claudeRoom(); }
    if (!room) { LOBBY.starting = null; return null; }
    LOBBY.room = room;
    lobbySet({ name: myName(), st: lobbyStatus(), pr: myProfile(), bu: (typeof BOS !== 'undefined' && BOS.user && BOS.user.id) || null, invite: null, look: null, gd: CAREER.guild ? { id: CAREER.guild.id, name: CAREER.guild.name, tag: CAREER.guild.tag, col: CAREER.guild.col } : null });
    setInterval(() => lobbySet({ name: myName(), st: lobbyStatus(), pr: myProfile(), bu: (typeof BOS !== 'undefined' && BOS.user && BOS.user.id) || null }), 5000);
    room.onPeers(ch => {
      const me = ch.peers.find(p => p.isMe && p.sameTab); if (me) LOBBY.me = me.peer;
      LOBBY.rawPeers = ch.peers.filter(p => !p.isMe && p.kind === 'viewer' && p.presence && p.presence.name);
      LOBBY.peers = lobbyDistinctPeers(LOBBY.rawPeers);
      LOBBY.ready = true;
      try { guildCheck(LOBBY.peers); } catch (e) { }
      updateLobbyBadge();
      for (const p of LOBBY.peers) { // an invite addressed to this player
        const inv = p.presence.invite;
        if (!inv || inv.to !== LOBBY.me || !/^[A-Z]{4}$/.test(String(inv.code || ''))) continue;
        const key = p.peer + inv.code; if (LOBBY.seen[key]) continue; LOBBY.seen[key] = 1;
        LOBBY.pending = { from: String(p.presence.name || 'A friend').slice(0, 20), code: inv.code, peer: p.peer, throne: inv.throne || null };
        showInvite();
      }
      if (G.screen === 'msgScr' && $('#inviteList')) renderInviteList();
      if (G.screen === 'msgScr' && $('#lobInvite') && !ONL.inMatch) renderLobbyInvite();
    }, () => { });
    return room;
  })();
  return LOBBY.starting;
}
function updateLobbyBadge() {
  const n = LOBBY.peers.length;
  const b = $('#onlineBadge'); if (b) { b.hidden = !n; b.textContent = n + ' online'; }
  // the title screen lists everyone playing right now; tap a name for their stats, or the strip for Play online
  const np = $('#nowPlaying'); if (!np) return;
  np.hidden = !n;
  if (!n) return;
  const busy = p => /fight/.test(String(p.presence.st || ''));
  const list = LOBBY.peers.slice().sort((a, b) => (b.presence.look ? 2 : 0) - (a.presence.look ? 2 : 0) || (busy(a) ? 1 : 0) - (busy(b) ? 1 : 0));
  $('#npCount').textContent = `${n} playing now`;
  const box = $('#npNames'); box.innerHTML = '';
  list.forEach(p => box.append(h('i', { class: p.presence.look ? 'look' : busy(p) ? 'busy' : '', onclick: e => { e.stopPropagation(); AU.click(); openProfile(p); } }, String(p.presence.name || 'A fighter').slice(0, 20))));
}
// someone's stats: how long they've been on today and in total, matches, wins, takedowns
// a small person icon that opens someone's profile, shown beside Invite / Join
function profileBtn(p) {
  const b = h('button', { class: 'profbtn', title: 'View profile', 'aria-label': `View ${String(p.presence && p.presence.name || 'player')}'s profile`, onclick: e => { e.stopPropagation(); AU.click(); openProfile(p); } });
  b.innerHTML = '<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>';
  return b;
}
function openProfile(p, back) {
  const P = (p && p.presence) || {}, R = P.pr || {};
  const name = String(P.name || 'A fighter').slice(0, 20);
  const rate = R.m ? Math.round(100 * (R.w || 0) / R.m) + '%' : '–';
  const rows = [['Rank', R.lv ? `${R.rank || rankOf(R.lv)}, level ${R.lv}` : '–'], ['Online now for', R.on ? fmtDur((Date.now() - R.on) / 1000) : '–'], ['Total time played', R.t != null ? fmtDur(R.t) : '–'], ['Matches', R.m ?? '–'], ['Wins', R.w ?? '–'], ['Win rate', rate], ['Takedowns', R.td ?? '–'], ['Clean hits', R.hits ?? '–'], ['Rumbles won', R.rw ?? '–'], ['Achievements', R.ach ?? '–'], ['Favourite weapon', R.wpn || '–'], ['Club', R.club || '–'], ['Right now', P.st || '–']];
  const talentHtml = Array.isArray(R.talents) && R.talents.length ? `<p class="small"><b>Talents:</b> ${R.talents.map(escTxt).join(', ')}</p>` : '<p class="muted small">No talents spent yet.</p>';
  const invHtml = R.inventory && Object.keys(R.inventory).length ? `<p class="small"><b>Inventory:</b> ${Object.entries(R.inventory).map(([k, v]) => `${escTxt(k)} × ${escTxt(v)}`).join(', ')}</p>` : '<p class="muted small"><b>Inventory:</b> empty</p>';
  const buyHtml = R.purchases && Object.keys(R.purchases).length ? `<p class="small"><b>Purchases:</b> ${Object.keys(R.purchases).map(escTxt).join(', ')} · ${fmtMoney(R.spent || 0)} spent</p>` : '<p class="muted small"><b>Purchases:</b> none</p>';
  const B = R.bos && rosterEligible(R.bos.id) ? R.bos : null; // their BuhurtOS account and real record, if they signed in with it
  const bosHtml = B ? `<div class="bosrec"><b><span class="bostick">✓</span> BuhurtOS: ${escTxt(B.name)}</b><span>${B.linked ? `${B.team ? escTxt(B.team) + ' · ' : ''}${B.m} real matches, ${B.w} wins${B.l ? ', ' + B.l + ' losses' : ''}${B.g ? ' · ' + B.g + ' gold' : ''}${B.p ? ' · ' + B.p + ' podiums' : ''}${B.tv ? ' · ' + B.tv + ' tournaments won' : ''}` : 'Signed in, no fighter record linked yet'}</span></div>` : '';
  const canJoin = /^[A-Z]{4}$/.test(String(P.look || ''));
  const btns = [];
  if (canJoin) btns.push(['Join their lobby', () => joinLobby(P.look), true]);
  else if (p && p.peer && LOBBY.peers.includes(p)) btns.push(['Invite to a fight', () => sendInvite(p), true]);
  if (p && p.peer && CAREER.guild && LOBBY.peers.includes(p) && !(P.gd && P.gd.id === CAREER.guild.id)) btns.push([`Invite to [${CAREER.guild.tag}]`, () => { guildInvite(p); }]);
  btns.push(['Back', back || (() => (NET.room && !ONL.inMatch ? renderLobby() : openOnlineHub()))]);
  msg('player', (B ? '✓ ' : '') + name, `${bosHtml}<div class="profgrid">${rows.map(([k, v]) => `<span>${k}</span><b>${escTxt(v)}</b>`).join('')}</div>${talentHtml}${invHtml}${buyHtml}${p && p.guest ? '<p class="muted small">Guest player</p>' : ''}`, btns);
}
// a profile for someone in a lobby: use their global-list entry if we can find it, else what the lobby knows
function openProfileByUid(uid, x) {
  if (x && x.me) { openProfile({ presence: { name: myName(), st: lobbyStatus(), pr: myProfile() } }); return; }
  const p = LOBBY.peers.find(q => q.presence && q.presence.name === x.name);
  openProfile(p || { presence: { name: x.name, st: 'in your lobby', pr: null } });
}
// someone invited you: answer now if you're in the menus, or as soon as the fight in progress is over
function showInvite() {
  const P = LOBBY.pending; if (!P) return;
  if ((G.phase === 'fight' && !G.attract && !G.paused) || NET.on) { toast(`${P.from} wants to fight you online`, 'big', 'Answer after this fight'); return; }
  LOBBY.pending = null; AU.cheer && AU.cheer(0.5);
  const crown = P.throne && (P.throne.seat === 'king' || P.throne.seat === 'queen') ? P.throne : null;
  msg('invite', crown ? `Defend your ${crown.seat} crown!` : `${escTxt(P.from)} invited you!`, crown
    ? `<p><b>${escTxt(P.from)}</b> challenges you for the ${crown.seat} title. This is a one-on-one crown fight. If you lose, the title passes to them.</p>`
    : `<p><b>${escTxt(P.from)}</b> invited you to their lobby. Pick your side and kit there.</p>`,
    [['Join', () => joinLobby(P.code), true], ['No thanks', openOnlineHub]]);
}
// ---- Find a match: join an open lobby, or open one and wait for others
async function findMatch() {
  AU.click(); await initLobby();
  const open = LOBBY.peers.filter(p => /^[A-Z]{4}$/.test(String(p.presence.look || '')) && !/online fight/.test(String(p.presence.st || '')));
  if (open.length) { joinLobby(open[0].presence.look); return; }
  await hostLobby(true);
}
function stopSearch() { MM.searching = false; }
// ---- the Play online screen
async function openInvite() { return openOnlineHub(); }
async function openOnlineHub() {
  AU.init(); initLobby();
  if (NET.room && !ONL.inMatch) { renderLobby(); return; } // already in a lobby: go back to it
  msg('play online', 'Play online', `
    <div id="bosBox" class="bosbox"></div>
    <div class="hubbtns"><button class="btn primary flagtape big" id="mmFind">Find a match</button><button class="btn tape big" id="mkLobby">Make a lobby</button></div>
    <p class="muted small">Find a match puts you in an open lobby with whoever's looking. Make a lobby to invite friends, pick teams and add bots.</p>
    <h4 class="invh">Playing now <span class="muted small">(tap a name for their stats)</span></h4>
    <div id="inviteList" class="invlist"></div>
    <div class="invrow2">
      <label class="runcode"><span>Have a code?</span><input id="netCode2" maxlength="4" placeholder="ABCD" autocomplete="off"></label>
      <button class="btn tape" id="invJoin">Join</button>
    </div>
    <label class="runcode invname"><span>Your name</span><input id="lobbyName" maxlength="20" autocomplete="off" value="${escTxt(myName() === 'A fighter' ? '' : myName())}" placeholder="What other players see"></label>`,
    [['Back', toTitle]]);
  $('#mmFind').onclick = findMatch;
  $('#mkLobby').onclick = () => { AU.click(); hostLobby(false); };
  $('#invJoin').onclick = () => { const c = ($('#netCode2').value || '').trim().toUpperCase(); if (!/^[A-Z]{4}$/.test(c)) { toastMenu('Codes are four letters.'); return; } joinLobby(c); };
  const nm = $('#lobbyName'); if (nm) nm.onchange = () => { store.set('lobbyName', nm.value.trim().slice(0, 20)); lobbySet({ name: myName() }); };
  renderInviteList(); renderBosBox();
}
function renderInviteList() {
  const box = $('#inviteList'); if (!box) return;
  box.innerHTML = '';
  if (!LOBBY.ready) { box.append(h('p', { class: 'muted' }, 'Looking for players…')); return; }
  const list = LOBBY.peers.slice().sort((a, b) => (b.presence.look ? 1 : 0) - (a.presence.look ? 1 : 0));
  if (!list.length) { box.append(h('p', { class: 'muted' }, 'Nobody else is online right now. Make a lobby and send a friend the link.')); return; }
  for (const p of list) {
    const P = p.presence, R = P.pr || {}, open = /^[A-Z]{4}$/.test(String(P.look || '')), busy = /online fight/.test(String(P.st || ''));
    const btn = busy ? h('span', { class: 'muted small' }, 'busy')
      : open ? h('button', { class: 'btn primary flagtape small', onclick: () => { AU.click(); joinLobby(P.look); } }, 'Join')
        : h('button', { class: 'btn ' + (LOBBY.invited === p.peer ? 'tape' : 'primary flagtape') + ' small', onclick: () => sendInvite(p) }, LOBBY.invited === p.peer ? 'Invited ✓' : 'Invite');
    const sub = `${String(P.st || '').slice(0, 30)}${R.on ? ' · on ' + fmtDur((Date.now() - R.on) / 1000) : ''}${R.m != null ? ' · ' + R.w + ' wins' : ''}`;
    box.append(h('div', { class: 'invrow' + (open ? ' looking' : '') }, h('button', { class: 'invwho linkish', onclick: () => { AU.click(); openProfile(p); } }, h('b', null, (R.bos ? '✓ ' : '') + String(P.name).slice(0, 20)), h('small', null, sub)), h('span', { class: 'invacts' }, profileBtn(p), btn)));
  }
}
// inviting someone opens your lobby (if you haven't one) and sends them its code
async function sendInvite(p, crown) {
  AU.click(); await initLobby();
  if (!(NET.room && NET.role === 'host')) { const ok = await hostLobby(false); if (!ok) return; }
  if (crown) { ONL.L = Object.assign(lobbyL(), { n: 1, bots: [0, 0], cat: crown.seat === 'queen' ? 'women' : 'men', venue: 'hall', throne: crown }); hostSync(); }
  LOBBY.invited = p.peer;
  lobbySet({ name: myName(), invite: { to: p.peer, code: NET.code, t: Date.now(), throne: crown || null } });
  toastMenu(`Invite sent to ${String(p.presence.name).slice(0, 20)}`);
  if (G.screen === 'msgScr' && $('#lobTeams')) renderLobbyInvite(); else renderLobby();
}
async function shareInvite() {
  if (!NET.code) return;
  const link = inviteUrl(NET.code);
  const text = link ? `Come fight in BUHURT: Steel & Tape! Tap to join my lobby: ${link}` : `Come fight in BUHURT: Steel & Tape! Open ${GAME_URL} , tap Play online and join with code ${NET.code}`;
  try { if (navigator.share) { await navigator.share({ title: 'BUHURT lobby', text }); return; } } catch (e) { if (e && e.name === 'AbortError') return; }
  try { await navigator.clipboard.writeText(text); toastMenu('Invite copied. Paste it in a message to your friend.'); } catch (e) { toastMenu(`Tell your friend the code ${NET.code}`); }
}
// ---------- online play anywhere: a peer-to-peer stand-in for Claude's room, used when that room isn't available ----------
// Same small API as the room (presence, onPeers, peers, join, leave), carried over WebRTC with PeerJS's free public
// matchmaker. join('duel-abcd'): the first one in claims the name and waits; the second finds it and connects.
// There is no lobby list this way, so friends join with the code or the link.
const P2P = { p: null };
function loadPeerLib() {
  if (window.Peer) return Promise.resolve(window.Peer);
  if (P2P.p) return P2P.p;
  const urls = ['https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js', 'https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js'];
  P2P.p = new Promise((res, rej) => {
    const next = i => {
      if (i >= urls.length) { P2P.p = null; rej(new Error('Could not load the online library')); return; }
      const s = document.createElement('script'); s.src = urls[i]; s.async = true;
      s.onload = () => window.Peer ? res(window.Peer) : next(i + 1); s.onerror = () => next(i + 1); document.head.append(s);
    };
    next(0);
  });
  return P2P.p;
}
function p2pRoom() {
  return { p2p: true, presence: () => Promise.resolve(), onPeers: () => () => { }, peers: () => [], emit: () => Promise.resolve(), on: () => () => { }, join: name => p2pJoin(name), leave() { } };
}
// A room for up to 20: the first one in claims the code's peer name and becomes the hub of a star; everyone else
// connects to it. The hub forwards its own presence to all, and a slimmed copy of everyone's presence (no inputs,
// no snapshots) so every page can show the whole lobby.
async function p2pJoin(name) {
  const Peer = await loadPeerLib();
  const id = 'buhurt-steel-tape-' + String(name).toLowerCase().replace(/[^a-z0-9-]/g, '');
  let mine = {}, peer = null, isHub = false, hubConn = null, hubP = {}, others = {}, myId = null, relayT = 0;
  const conns = {}, pres = {}, subs = [];
  const view = (pid, me, p) => ({ peer: pid, isMe: me, sameTab: me, kind: 'viewer', guest: false, by: null, presence: p || {}, updatedAt: Date.now() });
  const slim = p => { if (!p) return {}; const o = {}; for (const k in p) if (k !== 'vin' && k !== 's' && k !== 'mk' && k !== 'ev' && k !== 'm') o[k] = p[k]; return o; };
  const snap = () => {
    const out = [view(myId || 'me', true, mine)];
    if (isHub) for (const pid in pres) out.push(view(pid, false, pres[pid]));
    else { if (hubConn && hubConn.open) out.push(view(hubConn.peer, false, hubP)); for (const pid in others) if (pid !== myId && (!hubConn || pid !== hubConn.peer)) out.push(view(pid, false, others[pid])); }
    return out;
  };
  const notify = (left = []) => { const peers = snap(); subs.slice().forEach(f => { try { f({ peers, joined: [], left, updated: [] }); } catch (e) { } }); };
  const relay = () => { if (relayT) return; relayT = setTimeout(() => { relayT = 0; const m = {}; for (const pid in pres) m[pid] = slim(pres[pid]); m[myId] = slim(mine); for (const pid in conns) { const c = conns[pid]; if (c.open) try { c.send({ t: 'r', m }); } catch (e) { } } }, 200); };
  peer = await new Promise((res, rej) => {
    const t = setTimeout(() => rej(new Error('timeout')), 15000);
    const host = new Peer(id, { debug: 0 });
    host.on('open', () => {
      clearTimeout(t); isHub = true; myId = id;
      host.on('connection', c => {
        if (Object.keys(conns).length >= 19) { c.on('open', () => { try { c.send({ t: 'full' }); c.close(); } catch (e) { } }); return; } // 20 people at most
        conns[c.peer] = c;
        c.on('open', () => { try { c.send({ t: 'p', p: mine }); } catch (e) { } relay(); });
        c.on('data', m => { if (m && m.t === 'p') { const first = !pres[c.peer]; pres[c.peer] = m.p || {}; notify(); if (first || !m.p.vin) relay(); } });
        const gone = () => { if (!conns[c.peer]) return; delete conns[c.peer]; const had = pres[c.peer]; delete pres[c.peer]; notify([view(c.peer, false, had || {})]); relay(); };
        c.on('close', gone); c.on('error', gone);
      });
      res(host);
    });
    host.on('error', e => {
      if (e && e.type === 'unavailable-id') { // someone holds this code already: join them
        try { host.destroy(); } catch (er) { }
        const g = new Peer({ debug: 0 });
        g.on('open', gid => {
          clearTimeout(t); myId = gid; const c = g.connect(id, { reliable: true }); hubConn = c;
          c.on('open', () => { try { c.send({ t: 'p', p: mine }); } catch (er) { } notify(); });
          c.on('data', m => { if (!m) return; if (m.t === 'p') { hubP = m.p || {}; notify(); } else if (m.t === 'r') { others = m.m || {}; notify(); } else if (m.t === 'full') { toastMenu('That lobby is full (20 people).'); } });
          c.on('close', () => { const hp = hubP; hubConn = null; notify([view(id, false, hp)]); });
          c.on('error', () => { });
          res(g);
        });
        g.on('error', er => { clearTimeout(t); rej(er); });
      } else if (!isHub && !hubConn) { clearTimeout(t); rej(e); }
    });
  });
  return {
    p2p: true,
    presence(patch) {
      mine = { ...mine }; for (const k in patch) { if (patch[k] === null) delete mine[k]; else mine[k] = patch[k]; }
      if (isHub) { for (const pid in conns) { const c = conns[pid]; if (c.open) try { c.send({ t: 'p', p: mine }); } catch (e) { } } if (!patch.s) relay(); }
      else if (hubConn && hubConn.open) { try { hubConn.send({ t: 'p', p: mine }); } catch (e) { } }
      return Promise.resolve();
    },
    onPeers(f) { subs.push(f); setTimeout(() => f({ peers: snap(), joined: snap(), left: [], updated: [] }), 0); return () => { const i = subs.indexOf(f); if (i >= 0) subs.splice(i, 1); }; },
    peers: snap, emit: () => Promise.resolve(), on: () => () => { },
    leave() { try { hubConn && hubConn.close(); } catch (e) { } for (const pid in conns) try { conns[pid].close(); } catch (e) { } try { peer && peer.destroy(); } catch (e) { } },
  };
}
// a link with #join=ABCD drops the friend straight into the host's fight
function checkJoinLink() {
  const m = /join=([A-Za-z]{4})/.exec(location.hash || '') || /[?&]join=([A-Za-z]{4})/.exec(location.search || '');
  if (!m) return;
  const code = m[1].toUpperCase();
  try { history.replaceState(null, '', location.pathname + location.search.replace(/[?&]join=[A-Za-z]{4}/, '')); } catch (e) { }
  setTimeout(() => { AU.init(); joinLobby(code); }, 800);
}
function inviteUrl(code) {
  const onClaude = /claude\.ai|claudeusercontent|anthropic/.test(location.hostname) || location.protocol === 'file:' || location.protocol === 'about:';
  return onClaude ? null : location.origin + location.pathname + '#join=' + code;
}

// ---- a lobby without a server: the first player online becomes the "hub" (a well-known peer name) and keeps the
// list of who's online; everyone else connects to it, sends their presence and gets the list back. If the hub's
// player leaves, the others notice the dropped connection and one of them takes over. Same API as the room.
const HUB_ID = 'buhurt-steel-tape-lobby-v1';
function p2pLobby() {
  let mine = {}, list = {}, myId = null, member = null, conn = null, hub = null, dead = false, fails = 0, schedT = 0;
  const hubConns = {}, hubMembers = {}, subs = [];
  let okRes, okRej; const ready = new Promise((a, b) => { okRes = a; okRej = b; }); setTimeout(() => okRej(new Error('timeout')), 10000);
  const view = () => Object.entries(list).map(([pid, p]) => ({ peer: pid, isMe: pid === myId, sameTab: pid === myId, kind: 'viewer', guest: false, by: null, presence: p || {}, updatedAt: Date.now() }));
  const notify = () => { const peers = view(); subs.slice().forEach(f => { try { f({ peers, joined: [], left: [], updated: [] }); } catch (e) { } }); };
  const sched = () => { if (schedT) return; schedT = setTimeout(() => { schedT = 0; for (const id in hubConns) { const c = hubConns[id]; if (c.open) try { c.send({ t: 'list', m: hubMembers }); } catch (e) { } } }, 250); };
  const becomeHub = Peer => new Promise(res => {
    const h = new Peer(HUB_ID, { debug: 0 }); let done = false; const fin = v => { if (!done) { done = true; res(v); } };
    h.on('open', () => {
      hub = h;
      h.on('connection', c => {
        c.on('data', m => { if (m && m.t === 'p') { hubMembers[c.peer] = m.p || {}; hubConns[c.peer] = c; sched(); } });
        const gone = () => { delete hubMembers[c.peer]; delete hubConns[c.peer]; sched(); };
        c.on('close', gone); c.on('error', gone);
      });
      fin(true);
    });
    h.on('error', e => { if (e && e.type === 'unavailable-id') { try { h.destroy(); } catch (er) { } fin(false); } else fin(!!hub); });
    h.on('disconnected', () => { try { if (!h.destroyed) h.reconnect(); } catch (er) { } });
    setTimeout(() => fin(false), 8000);
  });
  const retry = () => {
    if (dead) return; conn = null; fails++;
    list = myId ? { [myId]: mine } : {}; notify();
    setTimeout(start, 500 + Math.random() * 1500 * Math.min(fails, 4));
  };
  const connectToHub = () => {
    const c = member.connect(HUB_ID, { reliable: true }); conn = c; let opened = false;
    const to = setTimeout(() => { if (!opened && conn === c) { try { c.close(); } catch (e) { } retry(); } }, 7000);
    c.on('open', () => { opened = true; clearTimeout(to); fails = 0; try { c.send({ t: 'p', p: mine }); } catch (e) { } });
    c.on('data', m => { if (m && m.t === 'list' && m.m && typeof m.m === 'object') { list = m.m; notify(); } });
    c.on('close', () => { if (conn === c) retry(); });
    c.on('error', () => { if (conn === c) { clearTimeout(to); retry(); } });
  };
  const start = async () => {
    if (dead) return;
    const Peer = await loadPeerLib();
    if (!hub) await becomeHub(Peer);
    if (!dead) connectToHub();
  };
  (async () => {
    try {
      const Peer = await loadPeerLib();
      member = new Peer({ debug: 0 });
      member.on('open', id => { myId = id; okRes(true); list = { [id]: mine }; notify(); start(); });
      member.on('disconnected', () => { try { if (!member.destroyed) member.reconnect(); } catch (e) { } });
      member.on('error', e => { if (!myId) okRej(e); });
    } catch (e) { okRej(e); }
  })();
  return {
    p2p: true, lobby: true, ready,
    presence(patch) { mine = { ...mine }; for (const k in patch) { if (patch[k] === null) delete mine[k]; else mine[k] = patch[k]; } if (myId) list = { ...list, [myId]: mine }; if (conn && conn.open) { try { conn.send({ t: 'p', p: mine }); } catch (e) { } } return Promise.resolve(); },
    onPeers(f) { subs.push(f); setTimeout(() => f({ peers: view(), joined: view(), left: [], updated: [] }), 0); return () => { const i = subs.indexOf(f); if (i >= 0) subs.splice(i, 1); }; },
    peers: view, emit: () => Promise.resolve(), on: () => () => { },
    join: name => p2pJoin(name),
    leave() { dead = true; try { conn && conn.close(); member && member.destroy(); hub && hub.destroy(); } catch (e) { } },
  };
}
// ---------- online fights for 1 to 20 people: a lobby first (teams, bots, kit), then the host runs the fight ----------

// Everyone in a lobby room sets a presence: role (host/guest), uid, name, lo (kit), team, ready. The host's presence also

// carries the lobby settings (L). When the host starts, its presence carries the match spec (S) for a few seconds; every

// page builds the identical match from S, then guests send inputs (vin) and the host sends snapshots (s) of everyone.

const ONL = { me: Math.random().toString(36).slice(2, 10), L: null, peers: [], inMatch: false, ready: false, team: 0, vins: {}, remote: {}, go: 0, S: null, lastGo: 0, renderT: 0, hostSeen: false, roleSeq: 0, roleSeqSeen: {} };

const MAX_HUMANS = 20;

const ONL_WEAPONS = [['sword', 'heater', 'Sword & shield'], ['sword', 'buckler', 'Sword & buckler'], ['longsword', null, 'Longsword'], ['polearm', null, 'Polearm'], ['axe', 'heater', 'Axe & shield'], ['mace', 'heater', 'Mace & shield'], ['longaxe', null, 'Long axe']];

const ONL_HELMS = ['greathelm', 'pigface', 'sallet', 'barbute', 'kettle'];

function onlineKit() { return Object.assign({ w: 0, helm: G.loadout.helm || 'pigface' }, store.get('onlineKit', {})); }

function myLo() { const lo = myLoadout(), k = onlineKit(), W = ONL_WEAPONS[k.w] || ONL_WEAPONS[0]; return { ...lo, weapon: W[0], shield: W[1], helm: HELMS[k.helm] ? k.helm : 'pigface', base: null, name: myName() }; }

function lobbyL() { return Object.assign({ n: 3, bots: [null, null], roles: [[], []], venue: G.quickVenue || W3.venue || 'arena', cat: G.category, open: false }, ONL.L || {}); }

function hostPeer() { return ONL.peers.find(p => p.presence && p.presence.role === 'host'); }

// the people in the lobby, host first, then in the order they joined

function lobbyHumans() {

  const out = []; const seen = new Set();

  for (const p of ONL.peers) {

    const P = p.presence || {}; if (!P.uid || (P.role !== 'host' && P.role !== 'guest') || seen.has(P.uid)) continue; seen.add(P.uid);

    out.push({ uid: P.uid, account: P.account || null, bos: !!P.bos, name: String(P.name || 'A fighter').slice(0, 20), team: P.team === 1 ? 1 : 0, lo: P.lo, level: clamp(Math.floor(Number(P.level) || 1), 1, 100), ready: !!P.ready, host: P.role === 'host', me: P.uid === ONL.me, peer: p.peer });

  }

  return out.sort((a, b) => (b.host ? 1 : 0) - (a.host ? 1 : 0)).slice(0, MAX_HUMANS);

}

function teamCounts(L, hum) {

  const h = [0, 1].map(t => hum.filter(x => x.team === t).length), n = Math.max(L.n, h[0], h[1], 1);

  const bots = [0, 1].map(t => { const free = n - h[t]; const b = L.bots[t]; return b == null ? free : clamp(b, 0, free); });

  return { h, n, bots, total: [h[0] + bots[0], h[1] + bots[1]] };

}

function myPresence(extra) { return Object.assign({ protocol: NET_PROTOCOL, role: NET.role, uid: ONL.me, account: BOS.user && BOS.user.id || null, name: myName(), bos: !!BOS.info, lo: myLo(), level: clamp(CAREER.level || 1, 1, 100), team: ONL.team, ready: NET.role === 'host' ? true : ONL.ready }, extra || {}); }

function newCode() { return Array.from({ length: 4 }, () => 'ABCDEFGHJKLMNPQRSTUVWXYZ'[(Math.random() * 24) | 0]).join(''); }



// ---- host: open a lobby (open = anyone tapping Find a match may join)

async function hostLobby(open) {

  const lob = await initLobby(); if (!lob) { toastMenu('Could not reach the online service.'); return false; }

  if (NET.room && NET.role === 'host' && !ONL.inMatch) { if (open) setLobbyOpen(true); renderLobby(); return true; }

  if (NET.room) netLeave();

  const code = newCode();

  let r; try { r = await lob.join('lobby-' + code.toLowerCase()); } catch (e) { toastMenu('Could not reach the online service. Check the internet connection and try again.'); return false; }

  Object.assign(NET, { room: r, role: 'host', code, on: false, seq: 0, ev: [], lastEv: 0 });

  ONL.L = Object.assign(lobbyL(), store.get('onlineL', {}), { open: !!open }); ONL.team = 0; ONL.inMatch = false; ONL.vins = {}; ONL.remote = {}; ONL.go = 0; ONL.S = null; ONL.roleSeqSeen = {};

  r.presence(myPresence({ L: ONL.L, go: 0 }));

  NET.unsub = r.onPeers(ch => { ONL.peers = ch.peers; hostPeers(ch); });

  setLobbyOpen(!!open);

  renderLobby(); return true;

}

function setLobbyOpen(open) { ONL.L = Object.assign(lobbyL(), { open }); hostSync(); lobbySet({ look: open ? NET.code : null, st: lobbyStatus() }); }

function hostSync() { if (NET.role === 'host' && NET.room && !ONL.inMatch) { store.set('onlineL', { n: ONL.L.n, bots: ONL.L.bots, roles: ONL.L.roles, venue: ONL.L.venue }); try { NET.room.presence(myPresence({ L: ONL.L, go: 0, S: null, s: null })); } catch (e) { } } }

function onlineCaptain(team) { return lobbyHumans().find(h => h.team === team) || null; }

function onlineBotRole(team, slot, role) {

  if (ONL.inMatch || !NET.room || !['auto', 'tank', 'rook', 'runner'].includes(role)) return;

  const captain = onlineCaptain(team);

  const L = NET.role === 'host' ? lobbyL() : Object.assign(lobbyL(), (hostPeer() || { presence: {} }).presence.L || {});

  if (!captain || captain.uid !== ONL.me || slot < 0 || slot >= teamCounts(L, lobbyHumans()).bots[team]) return;

  if (NET.role !== 'host') { NET.room.presence(myPresence({ roleEdit: { team, slot, role, seq: ++ONL.roleSeq } })); return; }

  const roles = (ONL.L.roles || [[], []]).map(row => Array.isArray(row) ? row.slice() : []);

  roles[team][slot] = role === 'auto' ? null : role; ONL.L.roles = roles; hostSync(); lobbyRefresh();

}

function hostPeers(ch) {

  for (const p of ch.peers) { const P = p.presence || {};

    if (P.role === 'guest' && P.uid && P.vin && P.protocol === NET_PROTOCOL) {

      if (ONL.inMatch && !G.fighters.some(f => f.netUid === P.uid && f.netPeer === p.peer)) continue;

      const old = ONL.remote[P.uid];

      if (Number.isSafeInteger(P.vin.seq) && P.vin.seq > (old?.seq || 0)) {

        const value = validatedVin(P.vin, old?.value);

        if (value) ONL.remote[P.uid] = { value, seq: P.vin.seq, pause: !!P.pauseRequested, at: performance.now() };

      }

    } }

  if (!ONL.inMatch) for (const p of ch.peers) {

    const P = p.presence || {}, R = P.roleEdit;

    if (!P.uid || !R || !Number.isInteger(R.seq) || R.seq <= (ONL.roleSeqSeen[P.uid] || 0)) continue;

    ONL.roleSeqSeen[P.uid] = R.seq;

    const captain = onlineCaptain(R.team), C = teamCounts(lobbyL(), lobbyHumans());

    if (!captain || captain.uid !== P.uid || P.team !== R.team || !Number.isInteger(R.slot) || R.slot < 0 || R.slot >= C.bots[R.team] || !['auto', 'tank', 'rook', 'runner'].includes(R.role)) continue;

    const roles = (ONL.L.roles || [[], []]).map(row => Array.isArray(row) ? row.slice() : []);

    roles[R.team][R.slot] = R.role === 'auto' ? null : R.role; ONL.L.roles = roles; hostSync();

  }

  for (const p of ch.left || []) { // someone left: in a fight, a bot takes over their fighter

    const f = ONL.inMatch && G.fighters.find(x => x.netPeer === p.peer); if (f) { f.vin = null; f.netUid = null; toast(`${f.name} left: a bot takes over`, 'bad'); }

  }

  if (!ONL.inMatch) lobbyRefresh();

}

// ---- guest: join a lobby by code

async function joinLobby(code) {

  code = String(code || '').toUpperCase(); if (!/^[A-Z]{4}$/.test(code)) return;

  const lob = await initLobby(); if (!lob) { toastMenu('Could not reach the online service.'); return; }

  if (NET.room) netLeave(); stopSearch();

  msg('lobby', `Joining ${code}…`, '<p>Finding the lobby…</p>', [['Cancel', () => { netLeave(); openOnlineHub(); }]]);

  let r; try { r = await lob.join('lobby-' + code.toLowerCase()); } catch (e) { toastMenu('Could not reach that lobby. Check the code.'); openOnlineHub(); return; }

  Object.assign(NET, { room: r, role: 'guest', code, on: false, lastEv: 0, vin: newVin(), snap: null });

  ONL.inMatch = false; ONL.ready = false; ONL.team = 1; ONL.lastGo = 0; ONL.hostSeen = false;

  r.presence(myPresence());

  NET.unsub = r.onPeers(ch => { ONL.peers = ch.peers; guestPeers(ch); });

  setTimeout(() => { if (NET.code === code && NET.role === 'guest' && !ONL.hostSeen) { toastMenu('That lobby isn’t open any more.'); netLeave(); openOnlineHub(); } }, 15000);

}

function netJoin(room, code) { return joinLobby(code); } // older callers (links, invites)

function guestPeers(ch) {

  const host = hostPeer();

  if (host && !ONL.hostSeen) { // first look at the lobby: take the emptier side, unless it's full

    ONL.hostSeen = true; NET.peer = host.peer;

    const hum = lobbyHumans(); if (hum.length > MAX_HUMANS || (hum.length === MAX_HUMANS && !hum.some(x => x.me))) { toastMenu('That lobby is full (20 people).'); netLeave(); openOnlineHub(); return; }

    const c = [0, 1].map(t => hum.filter(x => x.team === t && !x.me).length); ONL.team = c[1] <= c[0] ? 1 : 0;

    try { NET.room.presence(myPresence()); } catch (e) { }

    if (!(P0 => P0.go && P0.S)(host.presence)) renderLobby();

  }

  if (host && (ch.left || []).some(p => p.peer === host.peer)) { netDropped(); return; }

  if (!host && ONL.hostSeen && (ch.left || []).length) { netDropped(); return; }

  if (!host) return;

  const P = host.presence;

  if (P.go && P.S && P.go !== ONL.lastGo) { ONL.lastGo = P.go; buildOnlineMatch(P.S); return; }

  if (ONL.inMatch && NET.on && P.s) NET.snap = P;

  if (ONL.inMatch && !P.go) { backToLobbyLocal(); return; }

  if (!ONL.inMatch) lobbyRefresh();

}



// ---- the lobby screen

function lobbyRefresh() { if (G.screen === 'msgScr' && $('#lobTeams')) { const now = performance.now(); if (now - ONL.renderT < 150) { clearTimeout(ONL.rt); ONL.rt = setTimeout(lobbyRefresh, 160); return; } ONL.renderT = now; renderLobbyParts(); } }

function renderLobby() {

  const host = NET.role === 'host';

  msg('lobby', `Lobby ${NET.code}`, `<div class="lobtop"><span class="muted">Code <b class="num lobcode">${NET.code}</b></span><span id="lobCount" class="muted"></span></div>

    <div class="lobteams" id="lobTeams"></div>

    <div id="lobSettings" class="lobset"></div>

    <h4 class="invh">Your kit</h4>

    <div class="lobkit" id="lobKit"></div>

    <h4 class="invh">Invite</h4>

    <div id="lobInvite" class="invlist"></div>`,

    host ? [['Start fight', hostStart, true], ['Leave', leaveLobby]] : [[ONL.ready ? 'Not ready' : 'Ready', toggleReady, true], ['Leave', leaveLobby]]);

  renderLobbyParts(); renderKit();

}

function renderLobbyParts() {

  const host = NET.role === 'host', L = host ? lobbyL() : Object.assign(lobbyL(), (hostPeer() || { presence: {} }).presence.L || {});

  const hum = lobbyHumans(), C = teamCounts(L, hum);

  const cnt = $('#lobCount'); if (cnt) cnt.textContent = `${hum.length} of ${MAX_HUMANS} people · ${C.total[0]} v ${C.total[1]} · Challenge level ${Math.max(1, ...hum.map(x => x.level))} (highest human)`;

  const box = $('#lobTeams'); if (!box) return; box.innerHTML = '';

  ['Reavers', 'Wardens'].forEach((tn, t) => {

    const col = h('div', { class: 'lobteam t' + t }, h('h5', null, `${tn} · ${C.total[t]}`));

    for (const x of hum.filter(y => y.team === t)) {

      const W = ONL_WEAPONS.find(w => x.lo && w[0] === x.lo.weapon && (w[1] || null) === (x.lo.shield || null));

      col.append(h('button', { class: 'lobp' + (x.me ? ' me' : ''), onclick: () => openProfileByUid(x.uid, x) }, h('b', null, (x.bos ? '✓ ' : '') + x.name + (x.me ? ' (you)' : '')), h('small', null, `${x.host ? 'host · ' : ''}${W ? W[2] : (x.lo && WEAPONS[x.lo.weapon] ? WEAPONS[x.lo.weapon].name : '')}${x.host || x.ready ? ' · ready ✓' : ' · not ready'}`)));

    }

    if (C.bots[t]) col.append(h('div', { class: 'lobbots' }, `+ ${C.bots[t]} bot${C.bots[t] === 1 ? '' : 's'}`));

    if (C.n > 1) for (let slot = 0; slot < C.bots[t]; slot++) {

      const cur = ((L.roles || [[], []])[t] || [])[slot] || 'auto';

      const sel = h('select', { class: 'bot-role-select', 'aria-label': `${tn} bot ${slot + 1} role`, disabled: onlineCaptain(t)?.uid !== ONL.me, onchange: e => onlineBotRole(t, slot, e.target.value) });

      for (const role of ['auto', 'tank', 'rook', 'runner']) sel.append(h('option', { value: role, selected: role === cur }, role === 'auto' ? `Auto (${MELEE_ROLES[MELEE_ROLE_PATTERN[slot % MELEE_ROLE_PATTERN.length]]})` : MELEE_ROLES[role]));

      col.append(h('label', { class: 'bot-role-row' }, h('span', null, `Bot ${slot + 1}`), sel));

    }

    const mine = hum.find(y => y.me);

    if (mine && mine.team !== t && C.h[t] < C.n) col.append(h('button', { class: 'btn tape small', onclick: () => { ONL.team = t; AU.click(); try { NET.room.presence(myPresence(host ? { L: ONL.L } : {})); } catch (e) { } lobbyRefresh(); } }, 'Join this side'));

    box.append(col);

  });

  const set = $('#lobSettings'); if (!set) return; set.innerHTML = '';

  if (!host) { set.append(h('p', { class: 'muted small' }, `${C.n} a side · ${VENUES[L.venue] ? VENUES[L.venue].name : ''} · ${L.cat}. The host sets these and starts the fight.`)); return; }

  const step = (label, val, min, max, fn) => h('div', { class: 'stepper' }, h('span', null, label), h('button', { class: 'btn tape small', disabled: val <= min ? true : null, onclick: () => { AU.click(); fn(val - 1); } }, '−'), h('b', { class: 'num' }, String(val)), h('button', { class: 'btn tape small', disabled: val >= max ? true : null, onclick: () => { AU.click(); fn(val + 1); } }, '+'));

  set.append(step('People a side', C.n, Math.max(1, C.h[0], C.h[1]), 10, v => { ONL.L.n = v; ONL.L.bots = [null, null]; hostSync(); lobbyRefresh(); }));

  for (const t of [0, 1]) set.append(step(`Bots, ${t ? 'Wardens' : 'Reavers'}`, C.bots[t], 0, C.n - C.h[t], v => { const b = ONL.L.bots.slice(); b[t] = v; ONL.L.bots = b; hostSync(); lobbyRefresh(); }));

  const seg = (label, opts, cur, fn) => { const s = h('div', { class: 'seg small' }); for (const [v, n] of opts) s.append(h('button', { 'aria-pressed': String(cur === v), onclick: () => { AU.click(); fn(v); } }, n)); return h('div', { class: 'setrow' }, h('span', null, label), s); };

  set.append(seg('Arena', Object.values(VENUES).map(V => [V.key, V.name]), L.venue, v => { ONL.L.venue = v; hostSync(); lobbyRefresh(); }));

  set.append(seg('Division', [['men', 'Adult'], ['youth', 'Kids']], L.cat === 'youth' ? 'youth' : 'men', v => { ONL.L.cat = v; hostSync(); lobbyRefresh(); }));

  set.append(seg('Find a match', [['1', 'Open to anyone'], ['0', 'Friends only']], L.open ? '1' : '0', v => { setLobbyOpen(v === '1'); lobbyRefresh(); }));

  renderLobbyInvite();

}

function renderKit() {

  const box = $('#lobKit'); if (!box) return; box.innerHTML = ''; const k = onlineKit();

  const ws = h('div', { class: 'chips' }); ONL_WEAPONS.forEach((W, i) => ws.append(h('button', { class: 'chip', 'aria-pressed': String(k.w === i), onclick: () => { store.set('onlineKit', { ...onlineKit(), w: i }); AU.click(); kitChanged(); } }, W[2])));

  const hs = h('div', { class: 'chips' }); ONL_HELMS.forEach(hk => hs.append(h('button', { class: 'chip', 'aria-pressed': String(k.helm === hk), onclick: () => { store.set('onlineKit', { ...onlineKit(), helm: hk }); AU.click(); kitChanged(); } }, HELMS[hk] ? HELMS[hk].name : hk)));

  box.append(h('div', { class: 'muted small' }, 'Weapon'), ws, h('div', { class: 'muted small' }, 'Helm'), hs);

}

function kitChanged() { renderKit(); try { NET.room.presence(myPresence(NET.role === 'host' ? { L: ONL.L } : {})); } catch (e) { } lobbyRefresh(); }

function renderLobbyInvite() {

  const box = $('#lobInvite'); if (!box) return; box.innerHTML = '';

  const inLobby = new Set(lobbyHumans().map(x => x.name));

  const list = LOBBY.peers.filter(p => !/online fight|in a lobby/.test(String(p.presence.st || '')) || !inLobby.has(p.presence.name));

  for (const p of list.slice(0, 12)) {

    const sent = LOBBY.invited === p.peer;

    box.append(h('div', { class: 'invrow' }, h('button', { class: 'invwho linkish', onclick: () => openProfile(p) }, h('b', null, String(p.presence.name).slice(0, 20)), h('small', null, String(p.presence.st || '').slice(0, 30))),

      h('span', { class: 'invacts' }, profileBtn(p), h('button', { class: 'btn ' + (sent ? 'tape' : 'primary flagtape') + ' small', onclick: () => sendInvite(p) }, sent ? 'Invited ✓' : 'Invite'))));

  }

  box.append(h('button', { class: 'btn tape small', onclick: () => { AU.click(); shareInvite(); } }, 'Send a link'));

}

function toggleReady() { ONL.ready = !ONL.ready; try { NET.room.presence(myPresence()); } catch (e) { } renderLobby(); }

function leaveLobby() { lobbySet({ look: null, invite: null }); LOBBY.invited = null; netLeave(); openOnlineHub(); }



// ---- start: the host turns the lobby into a match spec everyone builds the same way

function hostStart() {

  const L = lobbyL(), hum = lobbyHumans(), C = teamCounts(L, hum);

  if (L.throne) {

    const challenger = hum.find(x => x.account === L.throne.challenger), holder = hum.find(x => x.account === L.throne.holder);

    if (C.total[0] !== 1 || C.total[1] !== 1 || hum.length !== 2 || !challenger || !holder || challenger.team === holder.team) { toastMenu('A crown duel must be one signed-in challenger against the current title holder, with no bots.'); return; }

  }

  if (C.total[0] < 1 || C.total[1] < 1) { toastMenu('Each side needs at least one fighter: add a bot.'); return; }

  const H = []; for (const t of [0, 1]) hum.filter(x => x.team === t).forEach((x, i) => H.push({ uid: x.uid, account: x.account, t, i, lo: x.lo, peer: x.peer }));

  if (hum.some(h => !h.lo || h.lo.protocol !== NET_PROTOCOL)) { toastMenu('A player needs to update the game before Ready.'); return; }

  const S = { protocol: NET_PROTOCOL, counts: C.total, venue: L.throne ? 'hall' : L.venue, cat: L.throne ? (L.throne.seat === 'queen' ? 'women' : 'men') : L.cat, H, roles: L.roles || [[], []], throne: L.throne || null, challengeLevel: Math.max(1, ...hum.map(x => x.level)) };

  ONL.go = Date.now(); ONL.S = S; lobbySet({ look: null, st: 'in an online fight' }); LOBBY.invited = null;

  buildOnlineMatch(S);

}

function buildOnlineMatch(S) {

  if (S.protocol != null && S.protocol !== NET_PROTOCOL) { toastMenu('Update the game before joining this match.'); return; }

  G.attract = false; G.tourney = null; REP.log = []; endTraining();

  const catWas = G.category; G.category = S.cat || G.category;

  const N = Math.max(S.counts[0], S.counts[1], 1);

  setupMatch({ mode: N, opp: 'wardens', stage: `Online ${S.counts[0]} v ${S.counts[1]}`, venue: S.venue, online: true, challengeLevel: clamp(Number(S.challengeLevel) || 1, 1, 100), pro: N === 1 });

  G.category = catWas;

  for (const t of [0, 1]) { const team = G.fighters.filter(f => f.team === t); for (const f of team.slice(S.counts[t])) { W3.matchRoot.remove(f.model.root); G.fighters.splice(G.fighters.indexOf(f), 1); } }

  G.fighters.forEach(f => { f.isPlayer = false; delete f.combatProfile; f.vin = null; f.netUid = null; f.netPeer = null; }); G.player = null;

  for (const hm of S.H) {

    const f = G.fighters.filter(x => x.team === hm.t)[hm.i]; if (!f) continue;

    applyLo(f, hm.lo, G.match.category); f.netUid = hm.uid; f.netPeer = hm.peer; f.ai.role = null; f.isPlayer = hm.uid === ONL.me; f.spec.player = f.isPlayer;

    const identityPeer = ONL.peers.find(p => p.presence?.uid === hm.uid);

    f.creatorVerified = !f.isPlayer && !!identityPeer && creatorRemote(f.creatorProof, 'combat', identityPeer.peer);

    W3.matchRoot.remove(f.model.root); buildFighterModel(f); W3.matchRoot.add(f.model.root);

    if (hm.uid === ONL.me) { f.isPlayer = true; G.player = f; }

    else if (NET.role === 'host') f.vin = ONL.vins[hm.uid] = ONL.vins[hm.uid] || newVin();

  }

  refreshPlayerCorner();

  for (const t of [0, 1]) {

    const bots = G.fighters.filter(f => f.team === t && !f.netUid).sort((a, b) => a.idx - b.idx);

    bots.forEach((f, i) => { const role = S.roles && S.roles[t] && S.roles[t][i]; f.ai.roleManual = MELEE_ROLES[role] ? role : null; });

    assignMeleeRoles(t);

  }

  G.match.netSpec = S; G.match.duel = N === 1 && S.counts[0] === 1 && S.counts[1] === 1; buildPips();

  if (S.throne) G.match.throneDuel = S.throne;

  $('#sbA').textContent = 'RVR'; $('#sbB').textContent = 'WDN';

  ONL.inMatch = true; NET.on = true; NET.pauseRequested = false; NET.ev = []; NET.lastEv = 0; NET.snap = null;

  startRound();

  if (NET.role === 'host') beginFight();

  else { hideAll(); setHud(true); G.phase = 'prefight'; refreshTouchUI(); if (G.player) FP.yaw = G.player.facing; }

}

// ---- during the fight

function netTick(dt) {

  if (!NET.on || !NET.room) return;

  NET.sendT -= dt;

  if (NET.role === 'host') {

    const humans = G.match?.netSpec?.H || [];

    G.paused = onlineCoop() && humans.every(h => h.uid === ONL.me ? NET.pauseRequested : ONL.remote[h.uid]?.pause && performance.now() - ONL.remote[h.uid].at <= 500);

    for (const uid in ONL.vins) {

      const V = ONL.vins[uid], R = ONL.remote[uid];

      if (R && performance.now() - R.at <= 500) { Object.assign(V, R.value, { e: { ...R.value.e } }); V.expired = false; }

      else if (!V.expired) { Object.assign(V, neutralVin(V)); V.expired = true; }

    }

    const big = G.fighters.length > 8;

    if (NET.sendT <= 0) {

      NET.sendT = big ? 0.08 : 0.05; const m = G.match; if (!m) return;

      const s = G.fighters.map(f => { const a = packF(f); return big ? a.map(v => typeof v === 'number' ? Math.round(v * 100) / 100 : v) : a; });

      NET.room.presence({ protocol: NET_PROTOCOL, paused: G.paused, role: 'host', simTime: q(G.simTime), go: ONL.go, S: Date.now() - ONL.go < 5000 ? ONL.S : null, L: null, s, reserveKeys: G.reserveKeys, reserves: G.reserves, m: [q(m.clock), m.pts[0], m.pts[1], m.wins[0], m.wins[1], m.round, ['prefight', 'fight', 'stopping', 'between', 'over', 'tactics'].indexOf(G.phase), m.overtime ? 1 : 0], mk: G.marshals.map(k => [q(k.pos.x), q(k.pos.z), q(k.facing), q(k.flagUp)]), ev: NET.ev });

    }

  } else {

    const V = NET.vin; V.mx = PIN.move.x; V.mz = PIN.move.z; V.yaw = isCtl() ? FP.yaw : null; V.pitch = isCtl() ? FP.pitch : 0; V.sp = PIN.sprint ? 1 : 0; V.gd = PIN.guard ? ({ L: 2, R: 3, H: 4 }[PIN.gdir] || 1) : 0; V.br = PIN.brace ? 1 : 0;

    if (IN.swingStart) { IN.swingStart = false; V.sw++; V.sh = 1; V.arc = 'auto'; }

    if (V.sh) { let pv = null; if (IN.pad.id !== null) pv = arcFromDrag(IN.pad.dx, IN.pad.dy, 16); else if (IN.mouse.down) pv = arcFromDrag(IN.mouse.adx, IN.mouse.ady, 22); else if (IN.gp.rtDown) pv = PIN.rx > 0.45 ? 'R2L' : PIN.rx < -0.45 ? 'L2R' : PIN.ry < -0.5 ? 'O' : null; if (pv && pv !== 'auto') V.arc = pv; }

    if (IN.swingRelease) { if (IN.swingRelease !== 'auto') V.arc = IN.swingRelease; V.sh = 0; IN.swingRelease = null; }

    for (const k of ['trip', 'shove', 'grab', 'tackle']) if (IN.edges.has(k)) { IN.edges.delete(k); V.e[k]++; }

    if (G.screen || G.photo) { V.mx = V.mz = V.gd = 0; V.sp = V.br = V.sh = false; }

    if (NET.sendT <= 0) { NET.sendT = 0.05; V.seq = (V.seq || 0) + 1; NET.room.presence({ protocol: NET_PROTOCOL, pauseRequested: !!NET.pauseRequested, role: 'guest', uid: ONL.me, name: myName(), team: ONL.team, vin: V }); }

    const P = NET.snap; if (!P || !P.s) return; G.paused = onlineCoop() && !!P.paused;

    if (Number.isFinite(P.simTime)) G.simTime = Math.max(G.simTime, P.simTime);

    if (Array.isArray(P.reserveKeys) && Array.isArray(P.reserves)) syncReserveRack(P.reserveKeys, P.reserves);

    G.fighters.forEach((f, i) => P.s[i] && unpackF(f, P.s[i], dt));

    const m = G.match, M = P.m; if (!M) return; m.clock = M[0]; m.pts = [M[1], M[2]]; const won = [M[3], M[4]]; m.round = M[5]; m.overtime = !!M[7];

    const ph = ['prefight', 'fight', 'stopping', 'between', 'over', 'tactics'][M[6]] || 'fight';

    if (ph !== G.phase) { if (ph === 'over' && G.phase !== 'over') { m.wins = won; G.phase = 'over'; netGuestEnd(); return; } G.phase = ph; refreshTouchUI(); }

    m.wins = won;

    (P.mk || []).forEach((k, i) => { const mm = G.marshals[i]; if (mm) { mm.pos.x = k[0]; mm.pos.z = k[1]; mm.facing = k[2]; mm.flagUp = k[3]; } });

    for (const e of P.ev || []) { if (e[0] <= NET.lastEv) continue; NET.lastEv = e[0]; netPlay(e); }

  }

}

function resultTitle(m) {

  const t = G.player ? G.player.team : 0, won = m.wins[t] > m.wins[1 - t], drawn = m.wins[0] === m.wins[1];

  return [drawn ? 'Draw' : won ? 'Your side wins' : 'Your side loses', `<p>${m.wins[t]}–${m.wins[1 - t]} in rounds.</p>`];

}

function onlineMatchEnd() { // host

  const [title, body] = resultTitle(G.match); if (!G.match.rewarded) { G.match.rewarded = true; progressMatch(G.match, title === 'Your side wins'); } if (typeof throneOnlineEnd === 'function') throneOnlineEnd(G.match);

  msg('online', title, body + '<p class="muted">Back to the lobby to go again, change sides or add bots.</p>', [['Back to lobby', hostBackToLobby, true], ['Leave', () => { netLeave(); toTitle(); }]]);

}

function netGuestEnd() {

  const [title, body] = resultTitle(G.match); if (!G.match.rewarded) { G.match.rewarded = true; progressMatch(G.match, title === 'Your side wins'); } if (typeof throneOnlineEnd === 'function') throneOnlineEnd(G.match);

  setHud(false); msg('online', title, body + '<p class="muted">The lobby opens again when the host is ready.</p>', [['Leave', () => { netLeave(); toTitle(); }, true]]);

}

function hostBackToLobby() {

  ONL.inMatch = false; NET.on = false; ONL.go = 0; ONL.S = null;

  startAttract(); hostSync(); if (ONL.L.open) setLobbyOpen(true); lobbySet({ st: 'in a lobby' }); renderLobby();

}

function backToLobbyLocal() { ONL.inMatch = false; NET.on = false; ONL.ready = false; startAttract(); try { NET.room.presence(myPresence()); } catch (e) { } renderLobby(); }

function netDropped() {

  if (!NET.room) return;

  const wasOver = G.phase === 'over' && ONL.inMatch;

  netLeave(); if (wasOver) return;

  toastMenu('The host left the lobby.'); toTitle();

}

function netLeave() { try { NET.unsub && NET.unsub(); NET.room && NET.room.leave(); } catch (e) { } Object.assign(NET, { on: false, room: null, role: null, unsub: null, code: '' }); ONL.inMatch = false; ONL.peers = []; }
