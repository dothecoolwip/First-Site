  if (J.identityKey === key) return;
  J.identityKey = key; f.realGlow = false;
  for (const child of [...J.root.children]) if (child.userData.identity) { J.root.remove(child); child.geometry?.dispose(); if (child.material?.map && child.material.map !== GLOW_TEX) child.material.map.dispose(); child.material?.dispose(); }
  J.glow = J.banner = null;
  if (!real && !bot) return;
  const col = new THREE.Color(creator ? '#ffd45c' : f.club && f.club.tabard || '#f2c40f').lerp(new THREE.Color('#ffffff'), creator ? 0.1 : real ? 0.25 : 0.35);
  const m = new THREE.SpriteMaterial({ map: glowTex(), color: col, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: real ? 0.75 : 0.32 });
  const s = new THREE.Sprite(m); s.position.y = 1.05; s.scale.set(real ? 2.6 : 1.7, real ? 3.4 : 2.4, 1); s.renderOrder = 2; J.root.add(s); J.glow = s;
  s.userData.identity = true;
  if (real) {
    const t0 = Math.random() * 6; s.onBeforeRender = () => { const k = performance.now() / 1000 + t0; m.opacity = creator ? 0.3 + 0.07 * Math.sin(k * 2) : 0.6 + 0.25 * Math.sin(k * 3); s.scale.set((creator ? 2.1 : 2.6) + 0.15 * Math.sin(k * 2), (creator ? 2.7 : 3.4) + 0.2 * Math.sin(k * 2), 1); };
    // a pillar of light and a banner with their name
    const beam = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.55, 4.2, 14, 1, true), new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.16, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide }));
    beam.position.y = 2.1; if (!creator) J.root.add(beam); else { beam.geometry.dispose(); beam.material.dispose(); }
    beam.userData.identity = true;
    const c = cvs(512, 128), x = c.getContext('2d'); x.fillStyle = f.club && f.club.tabard || '#6d1b28'; x.fillRect(0, 0, 512, 128); x.strokeStyle = '#f2c40f'; x.lineWidth = 8; x.strokeRect(4, 4, 504, 120);
    x.fillStyle = '#fff'; x.font = '900 42px "Big Shoulders Display", sans-serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText(String(creator ? 'Garrett Robson' : f.name || '').toUpperCase().slice(0, 18), 256, 38, 480); x.font = creator ? '800 44px system-ui' : '700 26px system-ui'; x.fillStyle = '#f2c40f'; x.fillText(creator ? 'Creator' : '★ THE REAL ONE ★', 256, 94, 480);
    const ban = new THREE.Sprite(new THREE.SpriteMaterial({ map: texFrom(c), transparent: true, depthWrite: false })); ban.scale.set(1.4, 0.35, 1); ban.position.y = 2.75; ban.renderOrder = 6; J.root.add(ban); J.banner = ban;
    ban.userData.identity = true; ban.userData.label = creator ? 'Creator' : 'THE REAL ONE';
    if (creator) { ban.scale.set(1.8, 0.45, 1); ban.position.y = 2.65; }
    f.realGlow = true;
  }
}
// a takedown by the real person gets the crowd roaring
function realTakedown(by) { if (by && by.realGlow) { try { AU.cheer(1.6); } catch (e) { } } }
// live events: open lyst fields become LIVE flags on the arenas (first field the Dome, then the others)
function rosterLive() {
  const order = ['dome', 'peasant', 'forest', 'beach', 'castle', 'hall'];
  for (const A of ARENAS) { A.live = false; A.liveText = ''; A.liveMatch = null; }
  (ROSTER.live || []).slice(0, 6).forEach((L, i) => {
    const A = ARENAS.find(a => a.key === order[i]); if (!A || !L.a || !L.b) return;
    A.live = true; A.liveMatch = L; A.liveText = `LIVE at ${L.event || 'a real event'}: ${L.a.name} ${L.score[0]}–${L.score[1]} ${L.b.name}`;
  });
}
// the bout at an arena with a live fight mirrors it: the real names and teams, bots acting it out, the real score
function liveBoutPick(A) {
  const L = A && A.liveMatch; if (!L) return null;
  const mk2 = (side, key) => { const T = side.team && ROSTER.teams.find(t => t.slug === side.team); const base = T && CLUBS['bos:' + T.slug] || CLUBS.wardens;
    CLUBS[key] = { ...base, key, name: String(side.name).slice(0, 22), full: side.name, roster: base.roster.map((s, i) => ({ ...s, player: false, name: side.fighters[i] ? side.fighters[i].name : s.name, keep: !!side.fighters[i], bos: side.fighters[i] ? { id: side.fighters[i].id, team: side.team } : null })) }; return key; };
  const n = Math.max(1, Math.min(5, Math.max(L.a.fighters.length, L.b.fighters.length) || 1));
  return { mode: n === 4 ? 5 : n, clubA: mk2(L.a, 'live:a'), opp: mk2(L.b, 'live:b'), category: /wom|fem/i.test(L.category) ? 'women' : 'men', label: `LIVE · ${L.comp || L.event}`, live: L };
}
// Cosmetic identity is verified separately from player names and permissions.
const CREATOR_IDENTITY = { proofs: {}, pending: false, nextAttempt: 0, remote: new Map() };
function creatorLocal() { return !!(BOS.creator && BOS.user && BOS.creatorUser === BOS.user.id); }
function creatorProof(audience) {
  const p = CREATOR_IDENTITY.proofs[audience];
  const subject = audience === 'town' ? LOBBY.me : ONL.peers.find(x => x.isMe && x.sameTab)?.peer;
  return creatorLocal() && p && p.subject === subject && p.exp > Date.now() ? p.proof : null;
}
function creatorReset() {
  BOS.creator = false; BOS.creatorUser = null; CREATOR_IDENTITY.proofs = {}; CREATOR_IDENTITY.nextAttempt = 0;
  creatorRefreshCharacters();
}
async function creatorIssue() {
  if (!creatorLocal() || !BOS.sb || CREATOR_IDENTITY.pending) return;
  if (Date.now() < CREATOR_IDENTITY.nextAttempt) return;
  CREATOR_IDENTITY.nextAttempt = Date.now()+30000;
  CREATOR_IDENTITY.pending = true;
  const uid = BOS.user.id;
  try {
    const { data } = await BOS.sb.auth.getSession();
    if (!data.session?.access_token) return;
    const combatPeer = ONL.peers.find(p => p.isMe && p.sameTab)?.peer;
    for (const [audience, subject] of [['town', LOBBY.me], ['combat', combatPeer]]) {
      if (!subject) continue;
      const old = CREATOR_IDENTITY.proofs[audience];
      if (old && old.subject === subject && old.exp > Date.now()+60000) continue;
      const r = await fetch(BOS_URL+'/functions/v1/steeltape-identity', {method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+data.session.access_token},body:JSON.stringify({action:'issue',audience,subject})});
      if (!r.ok) continue;
      const result = await r.json();
      if (!creatorLocal() || BOS.user.id !== uid) return;
      if (result.role === 'Creator' && result.proof) CREATOR_IDENTITY.proofs[audience] = {...result,subject};
    }
    lobbySet({pr:myProfile()});
    if (NET.room) NET.room.presence({lo:myLo()});
  } catch (e) { /* An unavailable identity service never grants a remote badge. */ }
  finally { CREATOR_IDENTITY.pending = false; }
}
function creatorRemote(proof, audience, subject) {
  if (!proof || typeof proof !== 'string' || proof.length > 2048 || !subject) return false;
  const key = audience + ':' + subject + ':' + proof, now = Date.now(), cached = CREATOR_IDENTITY.remote.get(key);
  if (cached && cached.until > now) return cached.role === 'Creator';
  if (CREATOR_IDENTITY.remote.size >= 128) CREATOR_IDENTITY.remote.delete(CREATOR_IDENTITY.remote.keys().next().value);
  CREATOR_IDENTITY.remote.set(key,{until:now+10000,role:null});
  fetch(BOS_URL+'/functions/v1/steeltape-identity',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'verify',proof,audience,subject})})
    .then(r => r.ok ? r.json() : null).then(d => {
      CREATOR_IDENTITY.remote.set(key,{role:d?.role === 'Creator' && d.exp > Date.now() ? 'Creator' : null,until:d?.exp > Date.now() ? Math.min(d.exp,Date.now()+120000) : Date.now()+30000});
      creatorRefreshCharacters();
    }).catch(() => { CREATOR_IDENTITY.remote.set(key,{role:null,until:Date.now()+30000}); });
  return false;
}
function creatorRefreshCharacters() {
  if (typeof TOWN !== 'undefined' && TOWN.me) fighterGlow({model:TOWN.me,isPlayer:true,spec:{player:true},name:myName(),club:CLUBS.reavers});
  if (typeof WORLD !== 'undefined') for (const O of Object.values(WORLD.others)) {
    const p = O.p, creator = creatorRemote(p?.presence?.pr?.creatorProof,'town',p?.peer);
    fighterGlow({model:O.J,spec:{},creatorVerified:creator,name:p?.presence?.name,club:null});
  }
  if (typeof G !== 'undefined') for (const f of G.fighters || []) {
    if (f.netUid && f.netUid !== ONL.me) {
      const peer = ONL.peers.find(p => p.presence?.uid === f.netUid);
      const proof = peer ? peer.presence?.lo?.creatorProof : f.creatorProof;
      f.creatorVerified = !!peer && creatorRemote(proof,'combat',peer.peer);
    }
    fighterGlow(f);
  }
}
setInterval(() => { creatorIssue(); creatorRefreshCharacters(); }, 1000);
// ===================================================================
// First time in: a 5 v 5 test fight with nothing but the button hints, then "want some help learning?", then the
// character creator, then a skippable tour of the realm when you walk in. Anyone who played before the creator existed
// gets the creator (and the tour) the next time they open the game.
// ===================================================================
const ONB = { tour: null, awaitingAuth: false, startup: true, fresh: !store.get('career', null) };
const ONB_AUTH_RETURN = 'steeltape-auth-return-v1';
function onbReadAuthReturn() {
  try {
    const value = JSON.parse(sessionStorage.getItem(ONB_AUTH_RETURN) || 'null');
    return value?.v === 1 && Date.now() - value.at < 60 * 60 * 1000 ? value : null;
  } catch (e) { return null; }
}
function onbSaveAuthReturn() {
  const stage = onbStage();
  sessionStorage.setItem(ONB_AUTH_RETURN, JSON.stringify({ v: 1, at: Date.now(), stage,
    step: stage === 'done' || stage === 'tour' ? 'game' : CAREER.teamPicked ? 'fighter' : 'team' }));
}
function onbClearAuthReturn() { try { sessionStorage.removeItem(ONB_AUTH_RETURN); } catch (e) { } }
function startupStatus(text) { const el = $('#startupStatus'); if (el) el.textContent = text; }
function startupDone() { if (!ONB.startup) return; ONB.startup = false; const el = $('#startup'); if (el) el.hidden = true; }
function onbStage() {
  if (CAREER.onboard) return CAREER.onboard;
  if (CAREER.stats.matches > 0) return 'create';
  if (ONB.fresh) {
    // A returning account can have a session on this browser but no local game save yet.
    let session = false;
    try { session = !!sessionStorage.getItem('buhurt-game-buhurtos'); } catch (e) { }
    return BOS.user || session ? 'create' : 'choice';
  }
  return 'fight';
}
function onbSet(st) { CAREER.onboard = st; saveCareer(); }
// Production game policy: no guest play beyond the first instructional fight.
// Tests that run from file: explicitly opt in to their isolated mock accounts.
function onbAccountRequired() {
  // Never allow a hosted game URL parameter to bypass sign-in.
  if (location.protocol === 'file:' && window.__steeltapeTest && !window.__onboard) return false;
  return !['choice', 'fight'].includes(onbStage());
}
function onbAccountGate(forceAccount) {
  // Direct entry to the town requires a linked account even if the tutorial is unfinished.
  if (location.protocol === 'file:' && window.__steeltapeTest && !window.__onboard) return false;
  if (BOS.recovering) return true;
  if (BOS.booting) {
    ONB.awaitingAuth = true;
    if (ONB.startup) { startupStatus('Checking your BuhurtOS sign-in…'); return true; }
    if (!(G.screen === 'msgScr' && $('#msgPanel')?.textContent.includes('Restoring your account'))) {
      msg('account', 'Restoring your account', '<p>Checking your BuhurtOS sign-in and saved fighter…</p>', []);
      const back = $('#msgPanel .back'); if (back) back.hidden = true;
    }
    return true;
  }
  if (!forceAccount && !onbAccountRequired()) return false;
  // Offline is the one exception: keep playing from the device save, even
  // if sign-in or the cloud cannot be reached. Require sign-in on reconnect.
  if (typeof cloudIsOffline === 'function' && cloudIsOffline()) return false;
  if (BOS.user) {
    if (location.protocol === 'file:' && window.__steeltapeTest) return false;
    if (typeof CLOUD !== 'undefined' && !CLOUD.ready && !CLOUD.offline) {
      ONB.awaitingAuth = true;
      if (!CLOUD.loading && !CLOUD.holding) cloudOnAuth(BOS.user.id, true);
      if (ONB.startup) { startupStatus('Restoring your fighter and inventory…'); return true; }
      if (!CLOUD.holding && !(G.screen === 'msgScr' && $('#msgPanel')?.textContent.includes('Cloud save'))) {
        msg('link save', 'Connecting your game save', '<p>Checking your saved character and inventory before you continue. Your local progress is still on this device.</p>', []);
      }
      return true;
    }
    return false;
  }
  ONB.awaitingAuth = true;
  // This backup is local and temporary. A cloud save is only linked after verified login.
  if (typeof cloudPrepareGuestLink === 'function') cloudPrepareGuestLink();
  if (!(G.screen === 'msgScr' && $('#bosEmail'))) creatorSignIn();
  startupDone();
  return true;
}
function onbResumeAfterAuth() {
  if (BOS.booting || BOS.interactive || BOS.recovering || CLOUD.applying) return;
  if (!ONB.awaitingAuth || (!BOS.user && !(typeof cloudIsOffline === 'function' && cloudIsOffline()))) return;
  if (typeof CLOUD !== 'undefined' && !CLOUD.ready && !CLOUD.offline && !(location.protocol === 'file:' && window.__steeltapeTest)) return;
  ONB.awaitingAuth = false;
  if (onbReadAuthReturn()) onbAfterAccount();
