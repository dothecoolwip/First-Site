function roleTank(f, mates) { return mates.filter(m => m.ai && m.ai.role === 'tank' && isUp(m)).sort((a, b) => dist2(a.pos, f.pos) - dist2(b.pos, f.pos))[0] || null; }
function allyUnderPressure(f, mates, enemies) {
