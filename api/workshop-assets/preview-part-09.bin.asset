  return true;
}
// a card's "make it" side: label, whether you can, and a tooltip of what's missing
function craftInfo(skill, R) {
  const L = tradeLevel(skill), lvOk = L >= R.lvl, matOk = tradeCanPay(R.cost);
  return { can: lvOk && matOk, why: !lvOk ? `${TRADE_SKILLS[skill].name} ${R.lvl} needed (you're ${L})` : matOk ? '' : 'Short of materials', lvOk };
}
// the Trades tab: six skills with bars, then the satchel
function renderTrades(box) {
  const t = tradeState();
  box.append(h('p', { class: 'muted small' }, 'Skills you get better at by doing them. Gather round the festival, then work the furnace, the anvil and the Artificer’s bench. Everything the vendors sell for gold can be made here instead.'));
  const grid = h('div', { class: 'tradegrid' });
  for (const k in TRADE_SKILLS) {
    const S = TRADE_SKILLS[k], P = tradeProgress(k), tool = S.tool ? `${TOOL_TIERS[t.tools[S.tool]]} ${TOOLS[S.tool].name.toLowerCase()}` : null;
    const next = Object.values(NODES).filter(n => n.skill === k && n.lvl > P.L).sort((a, b) => a.lvl - b.lvl)[0];
    grid.append(h('div', { class: 'tradecard' }, h('div', { class: 'th' }, h('span', { class: 'ticon' }, S.icon), h('div', null, h('b', null, S.name), h('small', null, `Level ${P.L}${P.L >= TRADE_CAP ? ' (max)' : ''}`)), h('span', { class: 'tlv num' }, P.L)),
      h('div', { class: 'tbar' }, h('i', { style: `width:${Math.round(P.f * 100)}%` })),
      h('div', { class: 'muted small' }, P.L >= TRADE_CAP ? 'Mastered.' : `${P.xp} / ${P.need} xp to level ${P.L + 1}`),
      h('div', { class: 'muted small' }, S.desc), tool ? h('div', { class: 'small' }, `Tool: ${tool}`) : null, next ? h('div', { class: 'small muted' }, `Next: ${next.name} at level ${next.lvl}`) : null));
  }
  box.append(grid);
  box.append(h('h3', null, 'Satchel'));
  const inv = Object.keys(MATS).filter(m => have(m) > 0);
  if (!inv.length) box.append(h('p', { class: 'muted small' }, 'Empty. Go and gather something: copper, ash and herbs grow round the fairground; the quarry and the best timber are out in the Old Woods (follow the west road).'));
  const sat = h('div', { class: 'satchel' });
  for (const m of inv) sat.append(h('div', { class: 'satitem', style: `--c:${MATS[m].col}` }, h('span', { class: 'si' }, MATS[m].icon), h('b', { class: 'num' }, have(m)), h('span', null, MATS[m].name)));
  box.append(sat, h('p', { class: 'muted small' }, `${t.gathered} things gathered, ${t.made} things made.`));
}
// the blacksmith's furnace: ore into ingots, and the gathering tools, all paid in materials
function renderFurnace(list, row) {
  const t = tradeState();
  list.append(h('p', { class: 'muted small' }, 'Forging. Ore and fuel from the quarry go in, ingots come out. The anvil cards above take ingots instead of gold. Tools here make gathering faster and open harder veins.'));
  for (const R of SMELT) {
    const M = MATS[R.id];
    row(`Smelt ${M.name.toLowerCase()}`, `Have ${have(R.id)}`, `One ${M.name.toLowerCase()} for the anvil.`, null, false, null, '', h('span', { class: 'bigicon', style: `--c:${M.col}` }, M.icon), { skill: 'forging', R, apply: () => { give(R.id, 1); }, label: 'Smelt' });
  }
  for (const k in TOOLS) {
    const tier = t.tools[k] || 0, R = TOOL_RECIPES[tier + 1];
    row(`${TOOL_TIERS[tier]} ${TOOLS[k].name.toLowerCase()}`, tier >= 3 ? 'Best' : `Tier ${tier}`, R ? `Next: ${TOOL_TIERS[tier + 1].toLowerCase()} ${TOOLS[k].name.toLowerCase()}. Wider sweet spot, better yield, opens tier ${tier + 1} nodes.` : 'As good as a tool gets.', tier >= 3 ? 'Best' : null, false, null, '', h('span', { class: 'bigicon' }, TOOLS[k].icon), R ? { skill: 'forging', R, apply: () => { t.tools[k] = tier + 1; toastMenu(`${TOOL_TIERS[tier + 1]} ${TOOLS[k].name.toLowerCase()} made.`); }, label: 'Forge it' } : null);
  }
}
// Persistent career equipment and the shared fault-driven workshop.
const REPAIR_FAULTS = {
  handoff: { name: 'Safe corner handoff', steps: ['Collect the reserve', 'Keep outside the rail', 'Present the handle', 'Check the fighter has it'] },
  strap: { name: 'Torn strap', part: 'straps', steps: ['Thread the first loop', 'Thread the second loop', 'Set strap tension', 'Secure the end'] },
  buckle: { name: 'Loose buckle', steps: ['Seat the strap', 'Tighten into the gold range', 'Secure the buckle'] },
  fitting: { name: 'Loose fitting', part: 'fittings', steps: ['Align the fitting', 'Fasten the first mount', 'Fasten the second mount', 'Check stability'] },
  wrap: { name: 'Damaged grip wrap', steps: ['Rip', 'Wrap', 'Smooth'] },
  dent: { name: 'Dented armour', steps: ['Straighten the first dent', 'Straighten the second dent', 'Check the plate'] },
  clean: { name: 'Dirty equipment', steps: ['Brush the first area', 'Wipe the second area', 'Finish cleaning'] },
  haft: { name: 'Snapped haft', part: 'hafts', steps: ['Remove the broken haft', 'Fit the spare haft', 'Secure the attachment', 'Check stability'] }
};
function careerMatch(m = G.match) { return !!m && !m.training && !m.online && !m.versus && !m.kids && !m.attract && !m.townBout && !m.test && !G.attract && !G.autoflow; }
function normalizeRepairPiece(p, key) {
  p.cond = clamp(Number.isFinite(p.cond) ? p.cond : 1, 0, 1);
  p.failed = !!p.failed; p.covered = !!p.covered; p.temporary = !!p.temporary;
  if (!REPAIR_FAULTS[p.fault]) p.fault = p.failed ? key === 'haft' ? 'wrap' : 'strap' : p.cond < 0.75 ? key === 'haft' ? 'wrap' : 'buckle' : null;
  if (!p.work || !REPAIR_FAULTS[p.work.fault] || !Number.isInteger(p.work.index)) p.work = null;
  return p;
}
function equipmentState() {
  if (!CAREER.equipment) {
    const tourney = store.get('tourney', null), old = store.get('run', null) || store.get('season', null) || (tourney?.kits?.[4] ? { kit: tourney.kits[4], weapon: G.loadout.weapon } : null), kit = old?.kit;
    CAREER.equipment = { version: 1, armour: {}, weapons: {} };
    if (kit) { for (const k of ['helmet', 'armL', 'armR', 'legs']) if (kit[k]) CAREER.equipment.armour[k] = JSON.parse(JSON.stringify(kit[k])); if (kit.haft) CAREER.equipment.weapons[old.weapon || G.loadout.weapon] = JSON.parse(JSON.stringify(kit.haft)); }
  }
  const E = CAREER.equipment;
  E.version = 1; E.armour = E.armour || {}; E.weapons = E.weapons || {};
  for (const k of ['helmet', 'armL', 'armR', 'legs']) E.armour[k] = normalizeRepairPiece(E.armour[k] || { cond: 1 }, k);
  return E;
}
function careerKit(spec) {
  const E = equipmentState(), weapon = spec.weapon;
  E.weapons[weapon] = normalizeRepairPiece(E.weapons[weapon] || { cond: 1 }, 'haft');
  return JSON.parse(JSON.stringify({ ...E.armour, haft: E.weapons[weapon] }));
}
function storeCareerKit(kit, weapon) {
  if (!kit || !weapon) return;
  const E = equipmentState();
  for (const k of ['helmet', 'armL', 'armR', 'legs']) if (kit[k]) E.armour[k] = normalizeRepairPiece(JSON.parse(JSON.stringify(kit[k])), k);
  if (kit.haft) E.weapons[weapon] = normalizeRepairPiece(JSON.parse(JSON.stringify(kit.haft)), 'haft');
  saveCareer();
}
function persistPlayerKit() {
  const m = G.match, p = G.player; if (!p || !careerMatch(m) || REP.workshop) return;
  storeCareerKit(p.kit, m.careerWeapon || p.spec.weapon);
  if (G.run && m.run && !m.season && G.run.code === m.run) { G.run.kit = JSON.parse(JSON.stringify(p.kit)); G.run.weapon = p.spec.weapon; store.set('run', G.run); }
  if (m.season) { const S = store.get('season', null); if (S) { S.kit = JSON.parse(JSON.stringify(p.kit)); store.set('season', S); } }
  if (G.tourney) saveTourney();
}
function repairRecordFault(f, piece, fault) {
  const p = f.kit[piece]; normalizeRepairPiece(p, piece);
  if (p.fault !== fault) p.work = null;
  p.fault = fault; p.temporary = false; p.cleaned = false;
  if (f.isPlayer) persistPlayerKit();
}
function repairFinish(q, tape) {
  const p = REP.player.kit[REP.piece], fault = REP.task?.fault || p.fault || (REP.piece === 'haft' ? 'wrap' : 'strap');
  const definition = REPAIR_FAULTS[fault];
  // Consume a replacement once it is actually fitted, not at task selection.
  const work = p.work;
  if (definition.part && !work?.installed && !repairInstallPart(p, fault)) return false;
  q = clamp(q * (CAREER.skills?.['show.tape'] ? 1.15 : 1) * (1 + shopFx('tapeQ')) * (squireGoodCare() ? 1.05 : 1), 0, 1);
  if (fault === 'clean') { p.cleaned = true; }
  else {
    p.cond = Math.max(p.cond, REP.proper ? 0.85 + 0.15 * q : Math.min(0.7, p.cond + 0.35 + 0.35 * q));
    p.failed = false; p.covered = false; p.temporary = !REP.proper;
    p.fault = REP.proper ? null : fault;
    if (tape) p.tape = tape;
  }
  p.work = null;
  if (fault === 'wrap' && tape && !REP.training) useTape(tape);
  if (!REP.training) logTape(REP.piece, tape || 'black', q);
  if (REP.training) { const S = teamSquire(); S.training[fault] = true; saveCareer(); }
  else if (REP.workshop) { storeCareerKit(REP.player.kit, REP.player.spec.weapon); syncServicedKit(REP.player.kit, REP.player.spec.weapon); }
  else persistPlayerKit();
  repPop(REP.proper ? 'SERVICED' : fault === 'clean' ? 'CLEAN' : 'SAFE · TEMPORARY', '#62c462');
  $('#benchMsg').textContent = `${PIECE_SHORT[REP.piece][0]}: ${Math.round(p.cond * 100)}%. ${p.temporary ? 'Proper servicing still needed in town.' : 'Workshop task complete.'}`;
  REP.task = null; finishPiece(); renderDrawer(); return true;
}
function repairInstallPart(p, fault) {
  const kind = REPAIR_FAULTS[fault].part; if (!kind || REP.training || p.work?.installed) return true;
  const B = squireBook();
  if (!REP.proper && kind === 'straps' && REP.fieldSpares > 0) REP.fieldSpares--;
  else if (B.stock[kind] > 0) B.stock[kind]--;
  else if (kind !== 'hafts' && !REP.proper && p.failed) { /* Free essential armour safety materials. */ }
  else { $('#benchMsg').textContent = `You need a spare ${kind === 'hafts' ? 'haft' : kind === 'straps' ? 'strap' : 'fitting kit'}. Buy supplies at the quartermaster. Basic armour safety repairs remain free in field breaks.`; return false; }
  if (p.work) p.work.installed = true; saveCareer(); return true;
}
function startRepairTask(fault) {
  const p = REP.player.kit[REP.piece], D = REPAIR_FAULTS[fault];
  if (!D) return;
  if (D.part && !REP.training && !p.work?.installed && !squireBook().stock[D.part] && !(D.part === 'straps' && !REP.proper && REP.fieldSpares > 0) && !(!REP.proper && p.failed && D.part !== 'hafts')) { $('#benchMsg').textContent = `Needs one spare ${D.part}. Buy supplies at the quartermaster or workshop before starting. Free manual essential armour safety fixes are still available.`; return; }
  const old = p.work, resume = old && old.fault === fault && old.proper === !!REP.proper;
  const offset = ((REP.lastLayout || 0) + 1 + Math.floor(Math.random() * 4)) % 8; REP.lastLayout = offset;
  const targets = resume ? old.targets : D.steps.map((_, i) => ({ x: 0.22 + ((i * 3 + offset) % 7) * 0.09, y: i % 2 ? 0.65 : 0.36 }));
  p.work = resume ? old : { fault, proper: !!REP.proper, index: 0, score: 0, targets, installed: !!old?.installed };
  REP.task = { fault, targets, index: p.work.index, score: p.work.score };
  REP.step = 'task'; REP.ripT = 0; setSteps('task'); renderRepairActions(); repairTaskMessage(); drawBench();
}
function repairTaskMessage() {
  const T = REP.task; if (!T) return;
  const gesture = T.fault === 'clean' ? 'Brush back and forth over the marked area.' : ['strap', 'haft'].includes(T.fault) ? 'Drag along the guide, then secure the highlighted fastening.' : T.fault === 'buckle' ? 'Drag to tighten; finish when the marker is in the gold.' : T.fault === 'dent' ? 'Tap the marked dent when the marker is in the gold.' : 'Align the part, then tap its fasteners.';
  $('#benchMsg').textContent = REPAIR_FAULTS[T.fault].name + ': ' + REPAIR_FAULTS[T.fault].steps[T.index] + '. ' + (squireBook().assisted ? 'Press Next guided action.' : gesture);
  $('#steps').replaceChildren(...REPAIR_FAULTS[T.fault].steps.map((s, i) => h('span', { class: i < T.index ? 'done' : i === T.index ? 'on' : '' }, `${i + 1} ${s}`)));
}
function saveWrapWork() {
  if (!['rip', 'wrap', 'smooth'].includes(REP.step) || REP.training) return;
  const p = REP.player.kit[REP.piece]; p.work = { fault: 'wrap', index: 0, proper: !!REP.proper, step: REP.step, wraps: REP.wraps, wrinkles: REP.wrinkles, q: REP.q, side: REP.side, sloppy: REP.sloppy, tape: REP.tape };
  const signature = REP.piece + REP.step + REP.wraps.length + ':' + REP.wrinkles.filter(w => w.gone).length;
  if (REP.wrapSaved === signature) return; REP.wrapSaved = signature;
  if (REP.workshop) storeCareerKit(REP.player.kit, REP.player.spec.weapon); else persistPlayerKit();
}
function repairTaskInput(p, assisted = false) {
  const T = REP.task; if (!T || REP.step !== 'task') return;
  const point = T.targets[T.index], d = Math.hypot(p.x - point.x, p.y - point.y);
  if (!assisted && d > 0.14) { $('#benchMsg').textContent = 'Aim for the large highlighted guide. No materials lost.'; return; }
  const timed = ['buckle', 'dent'].includes(T.fault), q = assisted ? 1 : clamp(1 - d * 1.2 - (timed ? Math.abs(ripNeedle() - 0.5) * 0.3 : 0), 0.6, 1);
  const pc = REP.player.kit[REP.piece];
  if (REPAIR_FAULTS[T.fault].part && T.index === 1 && !repairInstallPart(pc, T.fault)) return;
  T.score += q; T.index++; pc.work.index = T.index; pc.work.score = T.score;
  AU.wrap(); if (REP.workshop && !REP.training) storeCareerKit(REP.player.kit, REP.player.spec.weapon); else if (!REP.training) persistPlayerKit();
  if (T.index >= T.targets.length) { repairFinish(T.score / T.targets.length); renderRepairActions(); }
  else repairTaskMessage();
}
function repairTaskPointer(p, moving) {
  const T = REP.task; if (!T) return;
  const target = T.targets[T.index], d = Math.hypot(p.x - target.x, p.y - target.y);
  const drag = T.fault === 'clean' || (['strap','haft'].includes(T.fault) && T.index < 2) || (T.fault === 'buckle' && T.index === 1);
  if (!moving) { REP.taskDrag = { last: p, distance: 0 }; if (!drag) repairTaskInput(p); return; }
  if (!REP.taskDrag || !REP.ptr) return;
  REP.taskDrag.distance += Math.hypot(p.x - REP.taskDrag.last.x, p.y - REP.taskDrag.last.y); REP.taskDrag.last = p;
  if (drag && d < 0.14 && REP.taskDrag.distance >= (T.fault === 'clean' ? 0.3 : 0.12)) { REP.taskDrag.distance = 0; repairTaskInput(p); }
}
function renderRepairActions() {
  let box = $('#repairActions'); if (!box) { box = h('div', { id: 'repairActions', class: 'repair-actions' }); $('#bench').parentElement.after(box); }
  box.replaceChildren();
  const assisted = h('input', { type: 'checkbox', checked: !!squireBook().assisted, onchange: e => { squireBook().assisted = e.target.checked; saveCareer(); renderRepairActions(); } });
  box.append(h('label', null, assisted, ' Guided repair actions'));
  if (REP.task) { const part = REPAIR_FAULTS[REP.task.fault].part; if (part) box.append(h('span', { class: 'muted' }, `Materials: ${squireBook().stock[part]} ${part} stored${!REP.proper && part !== 'hafts' && REP.player.kit[REP.piece].failed ? ' · free essential safety materials available' : ''}`)); }
  if (REP.step === 'task' && REP.task) box.append(h('button', { class: 'btn primary', onclick: () => { const T = REP.task; if (T) repairTaskInput(T.targets[T.index], true); } }, squireBook().assisted ? 'Next guided action' : 'Complete highlighted action (keyboard/controller)'));
  if (REP.step === 'rip') box.append(h('button', { class: 'btn', onclick: () => benchDown({ x: 0.5, y: 0.5 }) }, 'Rip tape'));
  if (REP.step === 'wrap') box.append(h('button', { class: 'btn', onclick: () => { const x = ZONE.a + Math.min(REP.wraps.length, 4) * (ZONE.b - ZONE.a) / 4; benchMove({ x, y: 0.2 }); benchMove({ x, y: 0.8 }); } }, 'Lay next wrap'));
  if (REP.step === 'smooth') box.append(h('button', { class: 'btn', onclick: () => { const w = REP.wrinkles.find(w => !w.gone); if (w) benchMove({ x: w.x, y: w.y }); } }, 'Smooth next bubble'));
  if (!REP.step && REP.proper && REP.piece) box.append(h('button', { class: 'btn', onclick: () => startRepairTask('clean') }, 'Clean this item (optional)'));
}
function drawRepairTask(ctx, W, H) {
  const T = REP.task, D = REPAIR_FAULTS[T.fault];
  ctx.fillStyle = T.fault === 'haft' || REP.piece === 'haft' ? '#8d653b' : '#8f999e';
  ctx.beginPath(); ctx.roundRect(W * 0.12, H * 0.22, W * 0.76, H * 0.55, H * 0.1); ctx.fill();
  if (['strap','buckle'].includes(T.fault)) { ctx.fillStyle = '#694629'; ctx.fillRect(W * 0.12, H * 0.42, W * 0.76, H * 0.17); ctx.strokeStyle = '#d0a45b'; ctx.lineWidth = 6; ctx.strokeRect(W * 0.72, H * 0.36, W * 0.08, H * 0.29); }
  if (T.fault === 'haft') { ctx.fillStyle = '#392311'; ctx.fillRect(W * 0.48, H * 0.24, W * 0.04, H * 0.5); ctx.strokeStyle = '#dbc49a'; ctx.beginPath(); ctx.moveTo(W * 0.45,H * 0.52);ctx.lineTo(W * 0.55,H * 0.46);ctx.stroke(); }
  if (T.fault === 'fitting') { ctx.fillStyle = '#d6dce0'; ctx.fillRect(W * 0.35,H * 0.31,W * 0.3,H * 0.38); }
  if (['dent','clean'].includes(T.fault)) for (let i=T.index;i<T.targets.length;i++) { const p=T.targets[i]; ctx.fillStyle = T.fault === 'clean' ? '#4e4029' : '#566066';ctx.beginPath();ctx.ellipse(p.x*W,p.y*H,W*.09,H*.1,.2,0,TAU);ctx.fill(); }
  ctx.strokeStyle = '#d4b44a'; ctx.lineWidth = 6; ctx.beginPath();
  T.targets.forEach((p, i) => { if (!i) ctx.moveTo(p.x * W, p.y * H); else ctx.lineTo(p.x * W, p.y * H); }); ctx.stroke();
  T.targets.forEach((p, i) => { ctx.fillStyle = i < T.index ? '#62c462' : i === T.index ? '#f2c40f' : '#43494b'; ctx.beginPath(); ctx.arc(p.x * W, p.y * H, Math.max(22, H * 0.085), 0, TAU); ctx.fill(); ctx.fillStyle = '#111'; ctx.font = `${Math.max(18, H * 0.075)}px sans-serif`; ctx.textAlign = 'center'; ctx.fillText(String(i + 1), p.x * W, p.y * H + 7); });
  ctx.fillStyle = '#fff'; ctx.font = `${Math.max(15, H * 0.065)}px sans-serif`; ctx.textAlign = 'center'; ctx.fillText(D.name + ' · ' + PIECE_SHORT[REP.piece][0], W / 2, H * 0.12);
  if (['buckle', 'dent'].includes(T.fault)) { ctx.fillStyle = '#f2c40f'; ctx.fillRect(W * 0.43, H * 0.86, W * 0.14, 12); ctx.fillStyle = '#ff3d8b'; ctx.fillRect(W * (0.15 + ripNeedle() * 0.7), H * 0.83, 5, 28); }
}
function syncServicedKit(kit, weapon) {
  for (const key of ['season', 'run']) { const X = store.get(key, null); if (X?.kit) { for (const k of ['helmet', 'armL', 'armR', 'legs']) X.kit[k] = JSON.parse(JSON.stringify(kit[k])); if ((X.weapon || G.loadout.weapon) === weapon) X.kit.haft = JSON.parse(JSON.stringify(kit.haft)); store.set(key, X); } }
  const T = store.get('tourney', null); if (T?.kits?.[4]) { T.kits[4] = JSON.parse(JSON.stringify(kit)); store.set('tourney', T); }
  if (G.run?.kit) { for (const k of ['helmet', 'armL', 'armR', 'legs']) G.run.kit[k] = JSON.parse(JSON.stringify(kit[k])); if ((G.run.weapon || G.loadout.weapon) === weapon) G.run.kit.haft = JSON.parse(JSON.stringify(kit.haft)); }
  if (G.tourney?.kits?.[4]) G.tourney.kits[4] = JSON.parse(JSON.stringify(kit));
  if (!REP.workshop && G.player && careerMatch()) { for (const k of ['helmet', 'armL', 'armR', 'legs']) G.player.kit[k] = JSON.parse(JSON.stringify(kit[k])); if (G.player.spec.weapon === weapon) G.player.kit.haft = JSON.parse(JSON.stringify(kit.haft)); }
}
function openTownRepair(weapon, trainingFault, safety = false) {
  const previous = { player: G.player, match: G.match, phase: G.phase, busy: TOWN.busy }, spec = playerSpec(CLUBS.reavers.roster[0]); spec.weapon = weapon || spec.weapon;
  const kit = careerKit(spec); if (trainingFault) { kit[trainingFault === 'wrap' ? 'haft' : 'armL'] = { cond: 0.25, fault: trainingFault, failed: true }; }
  G.player = { ...previous.player, spec, kit, pos: { x: TOWN.pos.x, z: TOWN.pos.z }, model: null }; G.match = null; G.phase = 'workshop';
  TOWN.busy = true; $('#townHud').hidden = true; $('#townPrompt').hidden = true;
  openRepair(0, () => { if (!trainingFault && previous.player && careerMatch(previous.match)) previous.player.kit = careerKit(previous.player.spec); G.player = previous.player; G.match = previous.match; G.phase = previous.phase; TOWN.busy = previous.busy; if (TOWN.on) $('#townHud').hidden = false; openWorkshop(); }, { proper: !safety, untimed: true, workshop: true, training: !!trainingFault });
  if (trainingFault) { REP.piece = trainingFault === 'wrap' ? 'haft' : 'armL'; if (trainingFault === 'wrap') startTaping(REP.roll); else startRepairTask(trainingFault); }
}
function workshopQuote(kit, keys) {
  const B = squireBook(), parts = {}; let wear = 0;
  for (const k of keys) { const p = kit[k]; normalizeRepairPiece(p, k); wear += p.failed ? 1 : Math.max(0, 1 - p.cond); const part = REPAIR_FAULTS[p.fault]?.part; if (part && !p.work?.installed) parts[part] = (parts[part] || 0) + 1; }
  const missing = Object.fromEntries(Object.entries(parts).map(([k, n]) => [k, Math.max(0, n - B.stock[k])]));
  const price = { straps: 25, fittings: 20, hafts: 40 }, entitlement = B.serviceCredits > 0;
  const labour = entitlement ? 0 : Math.round(wear * 220 * (1 - 0.1 * (squireActive() ? Math.min(3, shopState().squires || 0) : 0)) / 10) * 10;
  const supplies = Object.entries(missing).reduce((sum, [k, n]) => sum + price[k] * n, 0);
  return { labour, supplies, parts, missing, total: labour + supplies, entitlement };
}
function paidWorkshopRepair(weapon, keys, personal) {
  if (personal && !squireActive()) return false;
  const kit = careerKit({ weapon }), q = workshopQuote(kit, keys); if (!keys.length || !spend(q.total, personal ? 'Your squire' : 'The armourer')) return false;
  const B = squireBook(); for (const [part, count] of Object.entries(q.parts)) B.stock[part] = Math.max(0, B.stock[part] - count);
  if (q.entitlement) B.serviceCredits--;
  for (const k of keys) { Object.assign(kit[k], { cond: 1, failed: false, covered: false, temporary: false, fault: null, work: null }); }
  storeCareerKit(kit, weapon); syncServicedKit(kit, weapon); return true;
}
function openWorkshop() {
  townPanel('Repair workshop', box => {
    const S = teamSquire(), E = equipmentState(), weapon = G.loadout.weapon;
    box.append(h('p', null, 'Field fixes are temporary (up to 70%). Proper servicing is untimed and can restore 100%. Manual safety work always has basic armour materials.'));
    const choices = h('select', { id: 'workshopWeapon', 'aria-label': 'Weapon to service' });
    for (const key of new Set([weapon, ...Object.keys(E.weapons)])) if (WEAPONS[key]) choices.append(h('option', { value: key, selected: key === weapon }, WEAPONS[key].name)); box.append(choices);
    const rows = h('div', { class: 'ups' }); box.append(rows);
    const draw = () => {
      rows.replaceChildren(); const wk = choices.value, kit = careerKit({ weapon: wk }), all = [];
      for (const k of ['helmet', 'armL', 'armR', 'legs', ...(WEAPONS[wk].haft ? ['haft'] : [])]) {
        const p = kit[k], need = p.cond < 1 || p.fault || p.temporary || p.failed;
        rows.append(h('p', null, `${PIECE_SHORT[k][0]}: ${Math.round(p.cond * 100)}% · ${p.failed ? 'UNSAFE' : p.temporary ? 'Safe · temporary repair' : 'Safe'} · ${p.fault ? REPAIR_FAULTS[p.fault].name : 'General wear'}`));
        if (need) { all.push(k); const q = workshopQuote(kit, [k]); rows.append(h('button', { class: 'btn', onclick: () => { paidWorkshopRepair(wk, [k], squireActive()); draw(); } }, `${squireActive() ? S.name : 'Armourer'}: ${PIECE_SHORT[k][0]} · labour ${q.labour}, parts ${q.supplies} · total ${q.total}`)); }
      }
      rows.append(h('button', { class: 'btn primary', onclick: () => openTownRepair(wk) }, 'Use the manual bench · untimed'));
      rows.append(h('button', { class: 'btn', onclick: () => openTownRepair(wk, null, true) }, 'Basic manual safety fixes · free armour materials · temporary'));
      if (all.length) { const q = workshopQuote(kit, all); rows.append(h('button', { class: 'btn', onclick: () => { paidWorkshopRepair(wk, all, squireActive()); draw(); } }, `Repair all · labour ${q.labour}, missing parts ${q.supplies} · total ${q.total}`)); }
    };
    choices.onchange = draw; draw();
    if (S.stage === 5) {
      for (const fault of ['strap', 'wrap']) box.append(h('button', { class: 'btn', onclick: () => openTownRepair('longaxe', fault) }, `Practise ${fault} repair · free training materials`));
      box.append(h('button', { class: 'btn', onclick: () => openTownRepair('longaxe', 'handoff') }, 'Practise a safe reserve handoff · training only'));
      box.append(h('button', { class: 'btn primary', disabled: !(S.training.strap && S.training.wrap && S.training.handoff), onclick: () => { squireStage(S, 5); openSquire(); } }, 'Finish corner training'));
    }
    const stock = squireBook().stock; box.append(h('p', null, `Supplies: ${stock.straps} straps · ${stock.fittings} fittings · ${stock.hafts} hafts · ${stock.meals} meals`));
    for (const [part, cost] of [['straps', 25], ['fittings', 20], ['hafts', 40]]) box.append(h('button', { class: 'btn', onclick: () => { squireBuy(part); openWorkshop(); } }, `Buy spare ${part} · ${cost}`));
  });
}
// ===================================================================

// Inventory: one bag with slots (materials stack to 99) and an equipment panel showing everything you wear and carry.

// Opens from Your fighter → Inventory and the bag button in the town HUD. A full bag stops gathering with a message.

// Materials still live in tradeState().inv (so trades and recipes are unchanged); the bag just counts their slots.

// ===================================================================

const BAG_STACK = 99, BAG_MAX = 50;

const MAT_ICON = { copper_ore:'ore_copper', iron_ore:'ore_iron', coal:'stone', silver_ore:'ore_silver', gold_ore:'ore_gold', crystal:'crystal', ash:'wood', oak:'wood', hickory:'wood', bone:'bone', copper_ingot:'ore_copper', iron_ingot:'ore_iron', steel_ingot:'ore_iron', silver_ingot:'ore_silver', gold_ingot:'ore_gold' };

const EQUIP_ICON = { Weapon:'weapon', 'Weapon look':'weapon', Shield:'shield', Helmet:'helmet', Outfit:'chest', Hat:'helmet', Footwear:'boots', Cape:'chest', 'In hand':'weapon', Pickaxe:'hammer', Axe:'axe', Sickle:'axe', Writs:'book' };

function bagState() { const b = CAREER.bag || (CAREER.bag = { size: 30, items: {} }); if (!b.items) b.items = {}; return b; }

// loot that isn't a material: documents and keepsakes from hidden places and tourneys

const BAG_ITEMS = {

  map_scrap: { name: 'Torn map scrap', icon: '🗺️', desc: 'Smudged ink: a mill, a wall, and a line between them.', stack: 1 },

  royal_seal: { name: 'Royal seal', icon: '🔏', desc: 'Wax and gold. Proof you’ve been somewhere you shouldn’t.', stack: 1 },

  old_coin: { name: 'Old coins', icon: '🪙', desc: 'From the bottom of a chest. Worth a little to the Land agent.', stack: 99 },

  glowmoss: { name: 'Glowmoss vial', icon: '🧪', desc: 'A dim green glow from the secret market. A collectible oddity, not a combat boost.', stack: 10 },

  moon_map: { name: 'Moon-ink map', icon: '🌙', desc: 'Marks both secret tunnel entrances on your surface map.', stack: 1 }

};

function bagSlots() {

  const t = tradeState(), b = bagState(); let n = 0;

  for (const m in t.inv) if (t.inv[m] > 0) n += Math.ceil(t.inv[m] / BAG_STACK);

  for (const k in b.items) if (b.items[k] > 0) n += Math.ceil(b.items[k] / ((BAG_ITEMS[k] && BAG_ITEMS[k].stack) || 1));

  return n;

}

// how many more of this material fit

function bagRoom(mat) { const have0 = tradeState().inv[mat] || 0, part = have0 % BAG_STACK ? BAG_STACK - have0 % BAG_STACK : 0; return part + Math.max(0, bagState().size - bagSlots()) * BAG_STACK; }

function bagAdd(key, n) { const b = bagState(); b.items[key] = (b.items[key] || 0) + n; saveCareer(); }

function bagDrop(mat, n) { const t = tradeState(); t.inv[mat] = Math.max(0, (t.inv[mat] || 0) - n); saveCareer(); }

// everything you wear and carry, slot by slot

function equipRows() {

  const L = lookState(), s = shopState(), t = tradeState(), lo = G.loadout || {};

  const nm = (slot, key) => { const it = LOOKS[slot] && LOOKS[slot].find(x => x[0] === key); return it ? it[1] : '—'; };

  const wk = lo.weapon || 'sword', fam = typeof wskinFamOf === 'function' ? wskinFamOf(wk) : wk, sk = s.wskin && s.wskin[fam];

  return [

    ['⚔️', 'Weapon', `${(WEAPONS[wk] || {}).name || wk}${s.wq && s.wq[wk] ? ', ' + QUAL_NAMES[s.wq[wk]] : ''}`],

    ['✨', 'Weapon look', sk && typeof wskinName === 'function' ? wskinName(sk) : 'Plain steel'],

    ['🛡️', 'Shield', lo.shield ? (SHIELDS[lo.shield] || {}).name || lo.shield : 'None'],

    ['⛑️', 'Helmet', lo.helm ? (HELMS[lo.helm] || {}).name || lo.helm : '—'],

    ['👕', 'Outfit', L.outfit && L.outfit !== 'none' ? nm('outfit', L.outfit) : 'Club tunic'],

    ['🎩', 'Hat', nm('hat', L.hat)], ['🥾', 'Footwear', nm('foot', L.foot)], ['🧥', 'Cape', nm('cape', L.cape)], ['✋', 'In hand', nm('hand', L.hand)], ['🐾', 'Pet', nm('pet', L.pet)],

    ['⛏️', 'Pickaxe', TOOL_TIERS[t.tools.pick || 0]], ['🪓', 'Axe', TOOL_TIERS[t.tools.axe || 0]], ['🌾', 'Sickle', TOOL_TIERS[t.tools.sickle || 0]],

    ['🐴', 'Horse', s.owned.horse ? (s.owned.horse === 'white' ? 'White destrier' : 'Bay horse') : TOWN.horseRent ? 'Hired for today' : 'None'],

    ['📜', 'Writs', [CAREER.writs && CAREER.writs.bailey ? 'Bailey' : null, CAREER.writs && CAREER.writs.royal ? 'Royal' : null].filter(Boolean).join(', ') || 'None yet']

  ];

}

function renderInventory(box) {

  const supplies = squireBook().stock; box.append(h('h4', null, 'Corner supplies'), h('p', { class: 'muted' }, `Meals: ${supplies.meals} · Spare straps: ${supplies.straps} · Fitting kits: ${supplies.fittings} · Spare hafts: ${supplies.hafts}`));

  const t = tradeState(), b = bagState(), used = bagSlots();

  box.append(h('div', { class: 'invhead' }, h('b', null, 'Your bag'), h('span', { class: 'invbar' }, h('i', { style: `width:${Math.min(100, used / b.size * 100)}%` })), h('span', { class: 'num muted' }, `${used} / ${b.size} slots`)));

  if (used >= b.size) box.append(h('p', { class: 'small vtiernote' }, 'Your bag is full: gathering stops until you make room. Use materials at the furnace and anvil, or drop some. The Land agent sells a bigger bag.'));

  const grid = h('div', { class: 'invgrid' }), info = h('div', { class: 'invinfo muted small' }, 'Tap a slot to see what it is.');

  const tile = (icon, n, name, col, onPick, art) => { const el = h('button', { class: 'invslot', style: col ? `--c:${col}` : '', title: name, onclick: () => { grid.querySelectorAll('.invslot').forEach(x => x.classList.remove('on')); el.classList.add('on'); onPick(); } }, libraryIcon(art, 42) || h('span', { class: 'si' }, icon), n > 1 ? h('b', { class: 'num' }, String(n)) : null); grid.append(el); };

  for (const m of Object.keys(MATS)) {

    let left = t.inv[m] || 0;

    while (left > 0) {

      const n = Math.min(BAG_STACK, left); left -= n;

      tile(MATS[m].icon, n, MATS[m].name, MATS[m].col, () => {

        info.innerHTML = ''; info.append(h('b', null, `${MATS[m].name} × ${t.inv[m] || 0}`), h('span', null, ` ${MATS[m].kind === 'ore' ? 'Smelt it at the furnace.' : MATS[m].kind === 'bar' ? 'Forge with it at the anvil.' : 'Used in recipes at the vendors.'}`),

          h('button', { class: 'btn tape small', onclick: () => { bagDrop(m, Math.min(BAG_STACK, t.inv[m] || 0)); box.innerHTML = ''; renderInventory(box); } }, 'Drop a stack'));

      }, MAT_ICON[m]);

    }

  }

  for (const k in b.items) if (b.items[k] > 0 && BAG_ITEMS[k]) { const I = BAG_ITEMS[k]; tile(I.icon, b.items[k], I.name, '#c9b48a', () => { info.innerHTML = ''; info.append(h('b', null, I.name), h('span', null, ' ' + I.desc)); }, k === 'old_coin' ? 'coin' : 'book'); }

  const s = shopState();

  for (const B of BOOSTS) { const left = s.boost[B.key] || 0; if (left) tile('🧪', left, B.name, '#7fc46a', () => { info.innerHTML = ''; info.append(h('b', null, B.name), h('span', null, ` ${left} match${left === 1 ? '' : 'es'} left. ${B.desc}`)); }); }

  for (let i = used; i < b.size; i++) grid.append(h('span', { class: 'invslot empty' }));

  box.append(grid, info);

  box.append(h('h4', null, 'Equipment'));

  const eq = h('div', { class: 'inveq' });

  for (const [icon, slot, val] of equipRows()) eq.append(h('div', { class: 'inveqrow' }, libraryIcon(EQUIP_ICON[slot], 26) || h('span', { class: 'si' }, icon), h('small', null, slot), h('b', null, val)));

  box.append(eq, h('p', { class: 'muted small' }, 'Change what you wear at Madame Velour’s wardrobe, weapon looks at the Artificer, tools at the furnace.'));

  if (typeof renderSecrets === 'function') renderSecrets(box);

}
// ---------- screens, matches, the Red Deer Rumble ----------

const SCREENS = ['title', 'howto', 'settings', 'tactics', 'sheetScr', 'repair', 'msgScr', 'pause', 'modes', 'ladder', 'career', 'townShop', 'creator'];

function showScreen(id) {
  if (G.screen === 'career' && id !== 'career') { G.careerLastTab=G.careerTab; G.careerViewRestore=menuView($('#career')); }

  if (id === 'howto') { renderHow(G.helpKind || IN.mode); selectTab($('#howTabs'), 'controls'); }

  if (id) { const oh = document.getElementById('onbHints'); if (oh) oh.hidden = true; }

  if (id === 'title' && G.hub && typeof TOWN !== 'undefined') { if (TOWN.on) { id = null; setTimeout(() => { refreshTouchUI(); townHudUpdate(); townPrompt(); }, 0); } else { enterTown(TOWN.returnTo); return; } } SCREENS.forEach(s => { $('#' + s).hidden = s !== id; }); G.screen = id; if (id && (IN.mode === 'pad' || IN.mode === 'kb')) setTimeout(() => { if (G.screen === id) { if (document.activeElement && document.activeElement !== document.body && !$('#' + id).contains(document.activeElement)) document.activeElement.blur(); if (IN.mode === 'pad') focusFirst(); } }, 30); updateLegend(); }

function setHud(on) {

  // Festival bouts reuse the fight simulation while the player remains in town.

  // Their scoreboard and camera controls must never cover the town controls.

  $('#hud').hidden = !on || (typeof TOWN !== 'undefined' && TOWN.on);

  refreshTouchUI();

}



const STAGES = [{ opp: 'wardens', name: 'Semi-final' }, { opp: 'rabble', name: 'Final' }];



function clearMatch() {

  persistPlayerKit();

  G.repairStop = false; G.weaponStop = null;

  for (const f of G.fighters) if (f.model) W3.matchRoot.remove(f.model.root);

  for (const p of G.props) W3.matchRoot.remove(p); G.props = [];

  (G.crew || []).forEach(o => W3.matchRoot.remove(o)); G.crew = [];

  G.fighters = []; G.clinches = []; G.timers = []; G.player = null; G.lastDown = null;

}



function rosterFor(club, mode, isA) {

  const r = club.roster;

  if (mode === 'train') return isA ? [r[0]] : r.slice(0, 2);

  if (mode === 12 || mode === 21) return bigRoster(club, mode);

  if (typeof mode === 'number' && (mode === 4 || mode > 5)) return bigRoster(club, mode).slice(0, mode); // online sides of any size

  if (mode === 5) return r;

  if (mode === 3) return isA ? [r[0], r[1], r[3]] : [r[0], r[1], r[2]];

  if (mode === 2) return isA ? [r[0], r[2]] : [r[0], r[3]];

  return [r[0]];

}

// starting spots: x across the list, z = how far back from your own start line

function slotsFor(n) {

  if (n === 21) { const out = []; for (let r = 0; r < 3; r++) for (let c = 0; c < 7; c++) out.push({ x: -7.2 + c * 2.4, z: r * 1.7 }); return out; }

  if (n === 12) { const xs = [-6.5, -3.9, -1.3, 1.3, 3.9, 6.5]; return xs.map(x => ({ x, z: 0 })).concat(xs.map(x => ({ x: x + 1.3 * Math.sign(x) * 0, z: 1.8 }))); }

  if (n === 5) return [-2.6, 0, 2.6, -5.2, 5.2].map(x => ({ x, z: 0 }));

  if (n === 3) return [-2.2, 0, 2.2].map(x => ({ x, z: 0 }));

  if (n === 2) return [-1.6, 1.6].map(x => ({ x, z: 0 }));

  if (n > 1) { const out = [], per = n > 7 ? Math.ceil(n / 2) : n; for (let i = 0; i < n; i++) { const row = Math.floor(i / per), c = i % per, w = Math.min(per, n - row * per); out.push({ x: (c - (w - 1) / 2) * 2.3, z: row * 1.8 }); } return out; }

  return [{ x: 0, z: 0 }];

}



G.loadout = Object.assign({ helm: 'pigface', weapon: 'mace', shield: 'heater', height: 'avg', build: 'medium' }, store.get('loadout', {}));

G.category = store.get('category', 'men');

// the weapon you actually carry: fantasy and special pieces never get past a kit check (Rumble, Duel Ladder)

function loadoutWeapon() { const w = WEAPONS[G.loadout.weapon] || WEAPONS.mace; return w.fantasy && (G.tourney || G.strict) ? WEAPONS.mace : w; }

function playerSpec(spec) {

  const L = G.loadout; const w = loadoutWeapon();

  return { ...spec, helm: L.helm, weapon: w.key, shield: w.hands === 2 || (G.mod && G.mod.noshield) ? null : (L.shield === 'none' ? null : L.shield) };

}

// duels are fought within one weapon category (sword and shield, sword and buckler, longsword, polearm); only profight mixes them

function duelStyle(spec) {

  const w = WEAPONS[spec.weapon] || WEAPONS.sword, hist = !w.fantasy;

  if (w.hands === 2 && w.haft) return { cat: 'Polearm', weapon: hist ? spec.weapon : 'polearm', shield: null };

  if (w.hands === 2) return { cat: 'Longsword', weapon: hist ? spec.weapon : 'longsword', shield: null };

  const sh = spec.shield || null;

  return { cat: sh === 'heater' ? 'Sword and shield' : sh === 'buckler' ? 'Sword and buckler' : 'Single weapon', weapon: hist ? spec.weapon : 'sword', shield: sh };

}

function matchDuelOpponent() {

  const m = G.match, p = G.player; if (!m || !m.duel || m.pro || !p) return;

  const st = duelStyle(p.spec); m.duelCat = st.cat;

  for (const f of G.fighters) if (f.team === 1) { f.spec = { ...f.spec, weapon: st.weapon, shield: st.shield }; f.weapon = WEAPONS[st.weapon]; f.shield = st.shield ? SHIELDS[st.shield] : null; resetFighterForRound(f); }

}

function setupMatch(o) {

  if (typeof TOWN !== 'undefined' && TOWN.on && !o.townBout) { TOWN.matchExit = TOWN.pos ? { x: TOWN.pos.x, z: TOWN.pos.z } : null; townTeardown(); } // a fight started from town: put the town away (a festival bout runs inside it)

  clearMatch(); clearReplay(); COMM.q = []; { const ce = $('#comm'); if (ce) { ce.textContent = ''; ce.classList.remove('on'); } } if (KID.on && !o.kids) { KID.on = false; KID.objs.forEach(x => W3.matchRoot.remove(x)); KID.objs = []; if (KID.pig) { W3.matchRoot.remove(KID.pig.g); KID.pig = null; } $('#lSkip').hidden = false; $('#lesson').hidden = true; }

  $('#lExit').onclick = lExitDefault; dropPhoto();

  G.strict = !!(G.tourney || o.ladder != null); if (!o.attract) resetMatchTally();

  if (!o.versus) { VS.on = false; G.bracket = null; VS.names = null; document.body.classList.remove('split', 'split4'); const sl = $('#splitLabels'); if (sl) sl.innerHTML = ''; } if (!o.online && !o.townBout && NET.on) netLeave();

  G.mod = o.mod || {}; if (!o.run) { G.run = null; G.boon = null; } if (!o.daily && !o.run) { G.shareKind = 'match'; G.shareExtra = {}; }

  setVenue(o.venue || (o.attract ? W3.venue : 'arena'));

  setWeather(o.weather || (o.attract ? 'clear' : (VENUES[W3.venue] && VENUES[W3.venue].weather) || 'clear'));

  const cat = o.category || G.category; const usedNames = {};

  setCuteDeco(cat === 'youth'); // kid-size fighters, foam kit and rubber weapons: set before anyone is built

  const A = (o.clubA && CLUBS[o.clubA]) || CLUBS.reavers, B = CLUBS[o.opp];

  for (const [club, team] of [[A, 0], [B, 1]]) {

    const ros = rosterFor(club, o.mode, team === 0); const slots = slotsFor(ros.length);

    ros.forEach((spec0, i) => {

      let spec = spec0;

      if (G.mod.noshield && spec.shield) spec = { ...spec, shield: null };

      if (team === 1 && o.mode === 1 && !o.pro && !o.attract && G.player) { const st = duelStyle(G.player.spec); spec = { ...spec, weapon: st.weapon, shield: st.shield }; }

      if (spec.player && team === 0 && !o.attract) spec = playerSpec(spec);

      else if ((club.key === 'rival' || spec.keep) && spec.bos && rosterEligible(spec.bos.id)) { usedNames[spec.name] = 1; }

      else if (spec.ladder != null && typeof ladderWho === 'function' && ladderWho(spec.ladder, cat)) { const W = ladderWho(spec.ladder, cat); spec = { ...spec, name: W.name, bos: { id: W.id, team: W.team } }; }

      else if (spec.ladder != null) { spec = { ...spec, name: poolName(usedNames), bos: null }; }

      else if (typeof rosterName === 'function' && (spec.rn = rosterName(club, spec, cat, usedNames, o))) spec = { ...spec, name: spec.rn.name, bos: spec.rn.bos };

      else { const pool = NAMES[cat]; let k = (club.key.length * 7 + spec.num * 3 + (cat === 'men' ? 0 : 5)) % pool.length; let guard = 0; while (usedNames[pool[k]] && guard++ < pool.length) k = (k + 1) % pool.length; usedNames[pool[k]] = 1; spec = { ...spec, name: pool[k] }; }

      usedNames[spec.name] = 1;

      const body = makeBody(cat, spec.arch, club.key + spec.num + cat, spec.player && team === 0 && !o.attract ? G.loadout : null);

      let kit = null;

      if (G.tourney && team === 0) kit = G.tourney.kits[spec.num] || (G.tourney.kits[spec.num] = spec.player ? boostKit(freshKit(spec, true)) : freshKit(spec, false));

      else if (G.run && spec.player && team === 0 && !o.attract) kit = G.run.kit; // Gauntlet: the damage carries

      else if (spec.player && team === 0) kit = careerMatch(o) ? careerKit(spec) : freshKit(spec, true);

      const f = createFighter(spec, club, team, i, kit || freshKit(spec, false), body);

      if (spec.player && team === 0 && !o.attract) { f.isPlayer = true; G.player = f; }

      if (spec.player && team === 0 && careerMatch(o)) for (const k of Object.keys(kit)) normalizeRepairPiece(kit[k], k);

      const sl = slots[i]; const x = team === 0 ? sl.x : -sl.x; const back = LIST.L / 2 - 3 + sl.z;

      f.home = { x, z: team === 0 ? back : -back };

      if (G.tourney && team === 0) f.redMatches = G.tourney.reds[spec.num] || 0;

      G.fighters.push(f);

      buildFighterModel(f); W3.matchRoot.add(f.model.root);

    });

  }

  // support crew holding reserves outside each weapon zone (BR 3.6.2)

  G.crew = []; G.reserveAll = [[], []];

  [A, B].forEach((club, t) => {

    const zn = W3.zones[t]; const sx = Math.sign(zn.x);

    if (t === 0 && G.player && !squireActive(squireTeam(A))) return;

    const s = UAL.ready ? ualSquire(club) : buildSupportModel(club); s.root.position.set(zn.x + sx * 1.9, 0, zn.z); s.root.rotation.y = sx > 0 ? -Math.PI / 2 : Math.PI / 2; s.root.userData = { name: t === 0 && G.player ? teamSquire(squireTeam(A)).name : teamSquire(squireTeam(club)).name, squire: t, ual: !!s.ual, J: s.ual ? s : null }; if (t === 0 && G.player) { const label = townLabel(teamSquire(squireTeam(A)).name, 'Your corner squire', '#f2c40f'); label.userData.cornerLabel = true; label.position.y = 2.4; s.root.add(label); } W3.matchRoot.add(s.root); G.crew.push(s.root);

    for (let i = 0; i < 2; i++) { const w = buildWeapon('sword', club); w.position.set(zn.x + sx * 0.95, 0.62, zn.z - 0.6 + i * 1.1); w.rotation.set(0, 0, sx * 0.22); W3.matchRoot.add(w); G.crew.push(w); G.reserveAll[t].push(w); }

  });

  buildMarshals();

  G.match = { ...o, challengeLevel: clamp(Math.floor(Number(o.challengeLevel == null ? CAREER.level : o.challengeLevel) || 1), 1, 100), duelCat: o.mode === 1 && G.player ? duelStyle(G.player.spec).cat : null, category: cat, wins: [0, 0], round: 0, results: [], cards: [], takedowns: [0, 0], clock: ROUND_TIME, champion: false, playerHits: 0, duel: o.mode === 1 && !o.attract, pts: [0, 0], cute: cat === 'youth', metrics: { start: G.simTime, actions: [{}, {}], hits: [0, 0], whiffs: [0, 0], guards: [0, 0] } };

  G.match.squireTeam = squireTeam(A); G.match.careerWeapon = G.player?.spec.weapon; refreshPlayerCorner();

  G.match.challengePressure = clamp((challengeFactor(G.match.challengeLevel) - 1) / (CHALLENGE_MAX - 1), 0, 1);

  assignMeleeRoles(0); assignMeleeRoles(1);

  $('#sbA').textContent = A.short; $('#sbB').textContent = B.short;

  buildPips();

}



function resetFighterForRound(f) {

  Object.assign(f, {

    state: 'standing', vel: { x: 0, z: 0 }, lean: { x: 0, z: 0 }, leanV: { x: 0, z: 0 }, gas: 1, bell: 0, action: null, cd: 0, noStep: 0, stepRem: 0, stepCd: 0,

    clinch: null, graceUntil: -1, plantCd: 0, rearmT: 0, sidearmT: 0, sidearmUsed: false, brace: false, guard: false, sprint: false, touched: false, fallT: 0,

    groundStyle: 'fall', returnAt: -1, armorKnee: false, foulVictimT: -9, earlyRiseT: 0, earlyWarned: false, earlyCarded: false, softTarget: null, lastCause: null, fatigue: (f.fatigue || 0) * 0.55, tiredWarn: 0, unbreakUsed: false, secondUsed: false, buffT: 0, comboN: 0, chainT: 0

  });

  f.ai.target = null; f.ai.next = rand(0, 0.4); f.move = { x: 0, z: 0 };

  f.pos = { ...f.home }; f.facing = f.wantFace = f.ffaFace != null ? f.ffaFace : f.team === 0 ? Math.PI : 0;

  if (f.isPlayer) { FP.yaw = f.facing; FP.pitch = -0.06; f.lookYaw = f.facing; CAM.tpInit = false; IN.lock = null; }

  // weapon back in hand; a torn haft wrap keeps the weapon out (WR 7.2.2)

  let wk = f.spec.weapon;

  if (f.kit.haft.failed) { if (f.isPlayer || G.attract) wk = 'sword'; else { f.kit.haft.failed = false; f.kit.haft.cond = 0.7; } }

  f.weapon = f.isPlayer && f.kit.haft.failed && !squireActive() ? null : humanFighter(f) ? profileWeapon(wk, combatProfile(f)) : WEAPONS[wk]; f.shield = f.weapon?.hands === 2 ? null : SHIELDS[f.spec.shield] || null; recalcBody(f);

  for (const k in f.kit) if (k !== 'haft' && f.kit[k].failed && !f.kit[k].covered && !f.isPlayer) { f.kit[k].failed = false; f.kit[k].cond = Math.max(f.kit[k].cond, 0.55); f.kit[k].tape = 'black'; }

  if (f.kit.helmet.failed && !f.isPlayer) { f.kit.helmet.failed = false; f.kit.helmet.cond = Math.max(f.kit.helmet.cond, 0.5); }

  // rebuild the model (helmet back on, weapon, tape)

