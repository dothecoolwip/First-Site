function folkOutfit(role, i) {
  const fem = i % 2 === 1, M = fem ? 'Female_' : 'Male_';
  if (role === 'guard' || role === 'gateguard') return { outfit: 'Male_Ranger', tex: 'ranger2', tint: '#c9d3ff' };
  if (role === 'smith') return { outfit: 'Male_Peasant', tex: 'peasant2' };
