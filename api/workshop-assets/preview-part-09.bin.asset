  { const w = mk(R, new THREE.CircleGeometry(1, 48), lmat({ color: '#315967', roughness: 0.75, metalness: 0 }), L.x, 0.06, L.z, false); w.rotation.x = -Math.PI / 2; w.scale.set(L.rx, L.rz, 1); TOWN.lake = w; }
