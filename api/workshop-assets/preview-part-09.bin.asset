// ---------- game data (rules cited from the design doc; numbers marked tuning are game design) ----------
const LIST = { W: 20, L: 30 }; // list size in metres (tuning)
const ROUND_TIME = 300;        // 5-minute round clock (REG 4.2)
const BREAK_AFTER = 10;
