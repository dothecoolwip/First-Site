  else { ctx.fillStyle = 'rgba(18,31,25,.8)'; ctx.fillRect(w - 37, 8, 29, 33); ctx.font = '700 17px system-ui'; ctx.textAlign = 'center'; ctx.fillStyle = '#f7e7b8'; ctx.fillText('N', w - 22, 31); }
