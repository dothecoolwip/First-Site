        tris.push({ p: [a.y, a.z, b.y, b.z, d.y, d.z], depth: (a.x + b.x + d.x) / 3, c: `rgb(${Math.min(255, col.r * 255 * sh) | 0},${Math.min(255, col.g * 255 * sh) | 0},${Math.min(255, col.b * 255 * sh) | 0})` });
