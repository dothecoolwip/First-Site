  const a0 = p && p !== f ? Math.atan2(p.pos.x - fp.x, p.pos.z - fp.z) + Math.PI * 0.55 : f.facing + Math.PI * 0.7;
  CAM.cine = { t: 0, dur, f, a0, from: W3.camera.position.clone(), look: new THREE.Vector3(fp.x, 1.2, fp.z) };
