const names=["preview-part-00.bin", "preview-part-01.bin", "preview-part-02.bin", "preview-part-03.bin", "preview-part-04.bin", "preview-part-05.bin", "preview-part-06.bin", "preview-part-07.bin", "preview-part-08.bin", "preview-part-09.bin"];
try{const buffers=await Promise.all(names.map(async n=>{const r=await fetch('/map-editor/'+n,{cache:'no-store',credentials:'same-origin'});if(!r.ok)throw Error('Owner session expired. Return to /admin.html.');return new Uint8Array(await r.arrayBuffer());}));const data=new Uint8Array(buffers.reduce((n,b)=>n+b.length,0));let offset=0;for(const b of buffers){data.set(b,offset);offset+=b.length;}new Function(new TextDecoder().decode(data))();}catch(e){document.body.textContent=e.message;throw e;}